{
  "name": "LUC",
  "scopeName": "source.luc",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()",
      "name": "entity.name.function.luc"
    },
    {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.luc"
    },
    {
      "match": "(==|~=|<=|>=|\\.\\.|[+\\-*/%^#=<>])",
      "name": "keyword.operator.luc"
    },
    {
      "match": "[{}\\[\\]()]",
      "name": "punctuation.definition.bracket.luc"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "--\\[\\[[\\s\\S]*?\\]\\]",
          "name": "comment.block.luc"
        },
        {
          "match": "--.*$",
          "name": "comment.line.double-dash.luc"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.luc",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.luc"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.luc",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.luc"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b(0[xX][0-9a-fA-F]+|[0-9]+(\\.[0-9]*)?([eE][+-]?[0-9]+)?)\\b",
          "name": "constant.numeric.luc"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(and|break|do|else|elseif|end|for|function|goto|if|in|local|not|or|repeat|return|then|until|while)\\b",
          "name": "keyword.control.luc"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false|nil)\\b",
          "name": "constant.language.luc"
        }
      ]
    }
  }
}