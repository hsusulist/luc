{
  "name": "luc-language-support",
  "displayName": "LUC Language Support",
  "description": "Syntax highlighting and file icons for the LUC programming language.",
  "version": "0.1.0",
  "publisher": "luc-language",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "luc",
        "aliases": [
          "LUC",
          "luc"
        ],
        "extensions": [
          ".luc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "luc",
        "scopeName": "source.luc",
        "path": "./syntaxes/luc.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "luc-icons",
        "label": "LUC Icons",
        "path": "./icons/luc-icon-theme.json"
      }
    ]
  }
}