create Point = {}
Point.__index = Point
create function newp(x, y) return setmetatable({ "x": x, "y": y }, Point) end
function Point:add(o) return newp(self.x + o.x, self.y + o.y) end
function Point:len2() return self.x * self.x + self.y * self.y end
create t = os.now()
create p = newp(0, 0)
create d = newp(1, 2)
create s = 0
repeat 1, 2000000 as i do
    p = p:add(d)
    s = s + p:len2() * 1e-12
end
print("method", s, os.now() - t)
