create t = os.now()
create bodies = []
repeat 1, 5 as i do
    list.append(bodies, { "x": i * 1.0, "y": i * 0.5, "z": i * 0.25, "vx": 0.0, "vy": 0.0, "vz": 0.0, "m": 1.0 + i })
end
create n = len(bodies)
repeat 1, 200000 as step do
    repeat 1, n as i do
        create bi = bodies[i]
        repeat 1, n as j0 do
            create j = j0
            if j > i then
                create bj = bodies[j]
                create dx, dy, dz = bi.x - bj.x, bi.y - bj.y, bi.z - bj.z
                create d2 = dx * dx + dy * dy + dz * dz + 0.01
                create mag = 0.001 / (d2 * math.sqrt(d2))
                bi.vx = bi.vx - dx * bj.m * mag
                bi.vy = bi.vy - dy * bj.m * mag
                bi.vz = bi.vz - dz * bj.m * mag
                bj.vx = bj.vx + dx * bi.m * mag
                bj.vy = bj.vy + dy * bi.m * mag
                bj.vz = bj.vz + dz * bi.m * mag
            end
        end
    end
    repeat 1, n as i do
        create b = bodies[i]
        b.x = b.x + 0.001 * b.vx
        b.y = b.y + 0.001 * b.vy
        b.z = b.z + 0.001 * b.vz
    end
end
print("nbody", bodies[0].x, os.now() - t)
