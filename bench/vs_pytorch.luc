-- lanternl side of the lanternl vs PyTorch comparison.
-- Run through bench/vs_pytorch.sh, which downloads the data and runs both sides.
-- The model and training settings must match bench/vs_pytorch.py.

import ai
ai.use("gpu")

create f = io.open("bench/data.txt", "rb")
create text = f:read("*a")
f:close()

create GRAPH  = os.getenv("GRAPH") == "1"
create SMALL  = os.getenv("SMALL") == "1"     -- tiny model: dim 64, 2 layers, batch 8 x 64
create NAME   = (GRAPH and "lanternl+graph" or "lanternl") .. (SMALL and " (S)" or "")
create EPOCHS = 2
create VAL    = 0.1

create m = ai.LMTrain({ "data": text, "dim": SMALL and 64 or 128, "layers": SMALL and 2 or 4,
                        "heads": 4, "ffn": SMALL and 128 or 256,
                        "max_seq": SMALL and 64 or 128, "batch_size": SMALL and 8 or 32,
                        "epochs": EPOCHS, "lr": 3e-3,
                        "val_split": VAL, "seed": 1, "hints": false, "graph": GRAPH })

create t0 = os.now()
m:run()
create secs = os.now() - t0

create toks = len(text) * (1 - VAL)
create h = m.history
create ep2 = h[len(h)].time - h[len(h) - 1].time
print(string.format("RESULT %-15s | total %5.1f s | epoch 2 %5.1f s = %6.0f tok/s | train %.4f | val %.4f",
    NAME, secs, ep2, toks / ep2, m.loss, m.val_loss))
print("SAMPLE " .. NAME .. " |")
print(m:generate("ROMEO:", 200))
