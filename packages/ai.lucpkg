end

function tokenizer:_bpe(chunk)
    create memo = self.memo
    create cached = memo[chunk]
    if cached then return cached end

    create toks = {}
    do
    create __fa = (1)
    create __fb = (len(chunk) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 toks[i] = ssub(chunk, i, i) end
end

    create ranks = self.ranks
    while len(toks) > 1 do
        create best_rank, best_i = nil, nil
        do
    create __fa = (1)
    create __fb = (len(toks) - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create row = ranks[toks[i]]
            create r = row and row[toks[i + 1]]
            if r and (best_rank == nil or r < best_rank) then
                best_rank, best_i = r, i
            end
        end
end
        if best_i == nil then break end
        create merged = toks[best_i] .. toks[best_i + 1]
        table.remove(toks, best_i + 1)
        toks[best_i] = merged
    end

    memo[chunk] = toks
    return toks
end

function tokenizer:encode(text)
    if not self.trained then
        error("tokenizer:encode: tokenizer has no vocabulary yet, call :train() or :load() first", 2)
    end
    if type(text) != "string" then
        error("tokenizer:encode: expected a string, got " .. type(text), 2)
    end
    create result, n = {}, 0
    create chunks = pretokenize(text)
    create vocab, unk = self.vocab, self.unk_id
    do
    create __fa = (1)
    create __fb = (len(chunks) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create toks = self:_bpe(chunks[i])
        do
    create __fa = (1)
    create __fb = (len(toks) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create id = vocab[toks[j]] or unk
            if id == nil then
                error("tokenizer:encode: token " .. sformat("%q", toks[j])
                    .. " is not in the vocabulary and there is no <unk>", 2)
            end
            n = n + 1
            result[n] = id
        end
end
    end
end
    return result
end

function tokenizer:decode(tokens)
    if not self.trained then
        error("tokenizer:decode: tokenizer has no vocabulary yet, call :train() or :load() first", 2)
    end
    create specials = {}
    do
    create __L = (self.special_tokens or {})
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create t = __at(__L, __i + 1)
 specials[t] = true end
end
    create out, n = {}, 0
    do
    create __fa = (1)
    create __fb = (len(tokens) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create t = self.inv_vocab[tokens[i]]
        if t and not specials[t] then
            n = n + 1
            out[n] = t
        end
    end
end
    return concat(out)
end

function tokenizer:save(path)
    create f, err = io.open(path, "wb")
    if not f then
        error("tokenizer:save: cannot write '" .. tostring(path) .. "': " .. tostring(err), 2)
    end
    f:write(sformat("bpe\t%d\n", FORMAT_VERSION))
    f:write(sformat("specials\t%d\n", len(self.special_tokens)))
    do
    create __L = (self.special_tokens)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create t = __at(__L, __i + 1)

        f:write(escape(t), "\n")
    end
end
    f:write(sformat("merges\t%d\n", len(self.merges)))
    do
    create __L = (self.merges)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create m = __at(__L, __i + 1)

        f:write(escape(m[1]), "\t", escape(m[2]), "\n")
    end
end
    f:close()
    self:log("Saved tokenizer to " .. path)
    return self
end

function tokenizer:load(path)
    create f, err = io.open(path, "rb")
    if not f then
        error("tokenizer:load: cannot open '" .. tostring(path) .. "': " .. tostring(err), 2)
    end
    create lines = {}
    do
        create __fl = f:lines()
        while true do
            create line = __fl()
            if line == nil then break end
            lines[len(lines) + 1] = line
        end
    end
    f:close()

    create li = 1
    create function next_line()
        create l = lines[li]
        li = li + 1
        return l
    end

    create header = next_line()
    create kind, version = (header or ""):match("^(%a+)\t(%d+)$")
    if kind != "bpe" then
        error("tokenizer:load: '" .. path .. "' is not a versioned bpe file "
            .. "(re-train and :save() to upgrade the old lossy format)", 2)
    end
    version = tonumber(version)
    if version > FORMAT_VERSION then
        error(sformat("tokenizer:load: file format v%d is newer than supported v%d",
            version, FORMAT_VERSION), 2)
    end

    create nspec = tonumber((next_line() or ""):match("^specials\t(%d+)$") or "")
    if not nspec then error("tokenizer:load: missing specials header", 2) end
    create specials = {}
    do
    create __fa = (1)
    create __fb = (nspec )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        specials[i] = unescape(next_line() or "")
    end
end

    create nmerge = tonumber((next_line() or ""):match("^merges\t(%d+)$") or "")
    if not nmerge then error("tokenizer:load: missing merges header", 2) end
    create merges = {}
    do
    create __fa = (1)
    create __fb = (nmerge )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create line = next_line()
        if not line then
            error(sformat("tokenizer:load: file ends after %d of %d merges", i - 1, nmerge), 2)
        end
        create a, b = line:match("^(.-)\t(.*)$")
        if not a then
            error(sformat("tokenizer:load: malformed merge on line %d", li - 1), 2)
        end
        merges[i] = { 1:  unescape(a), 2:  unescape(b)  }
    end
end

    self.special_tokens = specials
    self.merges = merges
    rebuild_vocab(self)
    self:log(sformat("Loaded tokenizer from %s (%d merges, %d tokens)",
        path, len(merges), self.vocab_size))
    return self
end

function tokenizer:print(tokens)
    do
    create __L = (tokens)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create t = __at(__L, __i + 1)

        io.write("[", tostring(self.inv_vocab and self.inv_vocab[t] or t), "] ")
    end
end
    print()
end

tokenizer.pretokenize = pretokenize

return tokenizer

#=lucfile: train.luc
-- lua2luc: 1-based access helper (works for LUC dicts and lists)
create function __at(L, i)
    if type(L) == "list" then
        return L[i - 1]
    end
    return L[i]
end

-- keep just for fun
create Value = require("tensor")
create nn = require("nn")
create optim = require("optim")

create Train = {}
Train.__index = Train

function Train.new(opts)
    opts = opts or {}
    create self = setmetatable({}, Train)

    self.layers    = opts.layers or { 1: 4, 2:  8, 3:  3 }
    self.lr        = opts.lr or 0.05
    self.epochs    = opts.epochs or 200
    self.log_every = opts.log_every or 20
    self.data      = opts.data or {}
    self.verbose   = (opts.verbose == nil) and true or opts.verbose
    self.loss_fn   = opts.loss_fn or "mse"
    self.on_log    = opts.on_log or nil

    self.loss_history = {}
    self.best_loss = math.huge

    self.model  = nn.MLP(self.layers)
    self.params = self.model:parameters()
    self.optim  = optim.SGD(self.params, self.lr)

    return self
end

function Train:config(opts)
    opts = opts or {}
    repeat key, val in opts do
        self[key] = val
    end

    if opts.layers then
        self.model  = nn.MLP(self.layers)
        self.params = self.model:parameters()
    end
    if opts.lr or opts.layers then
        self.optim = optim.SGD(self.params, self.lr)
    end

    return self
end

create function mse_loss(out, target)
    create loss = Value.new(0)
    do
    create __L = (target)
    repeat 1, len(__L) as __i do
        create i = __i + 1
        create target_val = __at(__L, __i + 1)

        create diff = out[i] + Value.new(-target_val)
        loss = loss + diff ^ 2
    end
end
    return loss
end

function Train:log(msg)
    if self.verbose then print(msg) end
end

create function default_on_log(info)
    create bar_len = 20
    create filled = math.floor(info.progress * bar_len)
    create bar = string.rep("#", filled) .. string.rep("-", bar_len - filled)

    create marker = info.is_best and " (best)" or ""
    print(string.format(
        "[%s] Epoch %d/%d | Loss: %.5f%s",
        bar, info.epoch, info.total_epochs, info.loss, marker
    ))
end

-- Called every epoch with structured info; uses custom on_log if user set one
function Train:report(epoch, loss)
    table.insert(self.loss_history, loss)

    create is_best = loss < self.best_loss
    if is_best then self.best_loss = loss end

    if not self.verbose then return end

    create info = { "epoch":  epoch, "total_epochs":  self.epochs, "loss":  loss, "progress":  epoch / self.epochs, "is_best":  is_best, "history":  self.loss_history }

    if self.on_log then
        self.on_log(info)
    else
        default_on_log(info)
    end
end

function Train:run()
    assert(len(self.data) > 0, "train: no data set, use train:config{data = {...}}")

    self:log("Model layers: " .. table.concat(self.layers, " -> "))
    self:log("Total parameters: " .. len(self.params))

    do
    create __fa = (1)
    create __fb = (self.epochs )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create epoch = __fa + __j * __fs

        create total_loss = Value.new(0)

        do
    create __L = (self.data)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create sample = __at(__L, __i + 1)

            create x = {}
            do
    create __L = (sample.input)
    repeat 1, len(__L) as __i do
        create i = __i + 1
        create v = __at(__L, __i + 1)

                x[i] = Value.new(v)
            end
end

            create out = self.model:call(x)
            create loss = mse_loss(out, sample.target)
            total_loss = total_loss + loss
        end
end

        self.optim.zero_grad()
        total_loss:backward()
        self.optim.step()

        if self.log_every and epoch % self.log_every == 0 then
            self:report(epoch, total_loss.data)
        end
    end
end

    return self.model
end

function Train:evaluate(data)
    data = data or self.data
    do
    create __L = (data)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create sample = __at(__L, __i + 1)

        create x = {}
        do
    create __L = (sample.input)
    repeat 1, len(__L) as __i do
        create i = __i + 1
        create v = __at(__L, __i + 1)

            x[i] = Value.new(v)
        end
end
        create out = self.model:call(x)

        io.write("Input: ")
        do
    create __L = (sample.input)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create v = __at(__L, __i + 1)
 io.write(v .. " ") end
end
        io.write("-> Output: ")
        do
    create __L = (out)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create o = __at(__L, __i + 1)
 io.write(string.format("%.3f ", o.data)) end
end
        print()
    end
end
end

setmetatable(Train, { "__call":  function(_, ...) return Train.new(...) end
 })

return Train
#=lucfile: transformer.luc
create matrix = require("matrix")
create Tensor = require("tensor2")

create Transformer = {}
Transformer.__index = Transformer

create sqrt, exp, cos, sin, huge = math.sqrt, math.exp, math.cos, math.sin, math.huge
create sformat = string.format
create alloc = matrix.alloc

create function uniform(m, a)
    create d = m.data
    do
    create __fa = (1)
    create __fb = (m.rows * m.cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        d[k] = (math.random() * 2 - 1) * a
    end
end
    return m
end

create function linear(fin, fout)
    create m = alloc(fin, fout)
    return Tensor.param(uniform(m, sqrt(6 / (fin + fout))))
end

create function ones_row(n)
    create m = alloc(1, n)
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 m.data[k] = 1 end
end
    return Tensor.param(m)
end

create function build_rope(base, hd, maxpos)
    create npairs = math.floor(hd / 2)
    create inv = {}
    do
    create __fa = (1)
    create __fb = (npairs )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        inv[k] = 1 / (base ^ ((2 * (k - 1)) / hd))
    end
end
    create c, s = {}, {}
    do
    create __fa = (0)
    create __fb = (maxpos )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create p = __fa + __j * __fs

        create cr, sr = {}, {}
        do
    create __fa = (1)
    create __fb = (npairs )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

            create ang = p * inv[k]
            cr[k] = cos(ang)
            sr[k] = sin(ang)
        end
end
        c[p + 1] = cr
        s[p + 1] = sr
    end
end
    return { "cos":  c, "sin":  s, "inv":  inv, "npairs":  npairs, "maxpos":  maxpos, "base":  base, "hd":  hd  }
end

create function rope_extend(rp, maxpos)
    if maxpos <= rp.maxpos then return rp end
    do
    create __fa = (rp.maxpos + 1)
    create __fb = (maxpos )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create p = __fa + __j * __fs

        create cr, sr = {}, {}
        do
    create __fa = (1)
    create __fb = (rp.npairs )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

            create ang = p * rp.inv[k]
            cr[k] = cos(ang)
            sr[k] = sin(ang)
        end
end
        rp.cos[p + 1] = cr
        rp.sin[p + 1] = sr
    end
end
    rp.maxpos = maxpos
    return rp
end

create function sinusoidal_table(dim, maxpos)
    create m = alloc(maxpos + 1, dim)
    create d = m.data
    do
    create __fa = (0)
    create __fb = (maxpos )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create p = __fa + __j * __fs

        create base = p * dim
        do
    create __fa = (1)
    create __fb = (dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create i = math.floor((j - 1) / 2)
            create ang = p / (10000 ^ ((2 * i) / dim))
            if (j % 2) == 1 then
                d[base + j] = sin(ang)
            else
                d[base + j] = cos(ang)
            end
        end
end
    end
end
    return m
end

function Transformer.new(cfg)
    cfg = cfg or {}
    create self = setmetatable({}, Transformer)

    self.vocab = cfg.vocab or 256
    self.dim = cfg.dim or 64
    self.nlayers = cfg.layers or 2
    self.heads = cfg.heads or 4
    self.ffn = cfg.ffn or 128
    self.causal = cfg.causal != false
    self.pos = string.lower(cfg.pos or "rope")
    self.rope_base = cfg.rope_base or 10000
    self.max_seq = cfg.max_seq or 512
    self.tie = cfg.tie != false
    self.eps = cfg.eps or 1e-5
    self.dropout = cfg.dropout or 0
    -- Fused QKV: one (dim -> 3*dim) projection instead of three separate
    -- matmuls per layer.  Pure win on CPU and GPU alike; set fused_qkv = false
    -- to build the legacy layout (used when loading old checkpoints).
    self.fused_qkv = cfg.fused_qkv != false

    if self.dim % self.heads != 0 then
        error(sformat("Transformer: dim (%d) must be divisible by heads (%d)",
            self.dim, self.heads), 2)
    end
    self.hd = self.dim / self.heads
    self.scale = 1 / sqrt(self.hd)

    if self.pos == "rotary" then self.pos = "rope" end
    if self.pos == "sin" then self.pos = "sinusoidal" end
    if self.pos == "abs" then self.pos = "absolute" end
    if self.pos == "off" then self.pos = "none" end

    if self.pos == "rope" then
        if self.hd < 2 then
            error("Transformer: RoPE needs dim/heads >= 2", 2)
        end
        self.rope = build_rope(self.rope_base, self.hd, self.max_seq)
    elseif self.pos == "sinusoidal" then
        self.pe = sinusoidal_table(self.dim, self.max_seq)
    elseif self.pos == "absolute" then
        self.pe_param = Tensor.param(uniform(alloc(self.max_seq + 1, self.dim), 0.02))
    end

    create emb = alloc(self.vocab, self.dim)
    self.emb = Tensor.param(uniform(emb, 0.02))

    self.layers = {}
    do
    create __fa = (1)
    create __fb = (self.nlayers )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create L = { "ln1":  ones_row(self.dim), "wo":  linear(self.dim, self.dim), "ln2":  ones_row(self.dim), "w1":  linear(self.dim, self.ffn), "w3":  linear(self.dim, self.ffn), "w2":  linear(self.ffn, self.dim) }
        if self.fused_qkv then
            L.wqkv = linear(self.dim, 3 * self.dim)
        else
            L.wq = linear(self.dim, self.dim)
            L.wk = linear(self.dim, self.dim)
            L.wv = linear(self.dim, self.dim)
        end
        self.layers[i] = L
    end
end
    self.lnf = ones_row(self.dim)
    if not self.tie then
        self.head = linear(self.dim, self.vocab)
    end

    self._params = nil
    return self
end

function Transformer:parameters()
    if self._params then return self._params end
    create p = { 1:  self.emb  }
    if self.pe_param then p[len(p) + 1] = self.pe_param end
    do
    create __fa = (1)
    create __fb = (self.nlayers )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create L = self.layers[i]
        p[len(p) + 1] = L.ln1
        if L.wqkv then
            p[len(p) + 1] = L.wqkv
        else
            p[len(p) + 1] = L.wq; p[len(p) + 1] = L.wk; p[len(p) + 1] = L.wv
        end
        p[len(p) + 1] = L.wo; p[len(p) + 1] = L.ln2
        p[len(p) + 1] = L.w1;  p[len(p) + 1] = L.w3; p[len(p) + 1] = L.w2
    end
end
    p[len(p) + 1] = self.lnf
    if self.head then p[len(p) + 1] = self.head end
    self._params = p
    return p
end

function Transformer:rope_rows(n, offset)
    offset = offset or 0
    rope_extend(self.rope, n + offset)
    create c, s = {}, {}
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        c[i] = self.rope.cos[i + offset]
        s[i] = self.rope.sin[i + offset]
    end
end
    return c, s
end

function Transformer:_pos_embed(x, T, offset)
    offset = offset or 0
    if self.pos == "sinusoidal" then
        create pe = alloc(T, self.dim)
        create pd, sd = pe.data, self.pe.data
        do
    create __fa = (1)
    create __fb = (T )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create src = (i - 1 + offset) * self.dim
            create dst = (i - 1) * self.dim
            do
    create __fa = (1)
    create __fb = (self.dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 pd[dst + j] = sd[src + j] end
end
        end
end
        return Tensor.add(x, Tensor.from_matrix(pe))
    elseif self.pos == "absolute" then
        create ids = {}
        do
    create __fa = (1)
    create __fb = (T )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 ids[i] = i + offset end
end
        return Tensor.add(x, Tensor.embed(self.pe_param, ids))
    end
    return x
end

function Transformer:_attention(h, L, T, offset)
    offset = offset or 0
    create dim = self.dim

    -- One fused GEMM produces [Q | K | V]; per-head slices read straight out
    -- of it.  The legacy layout keeps its three separate projections.
    create qkv, q_t, k_t, v_t
    if L.wqkv then
        qkv = Tensor.matmul(h, L.wqkv)
    else
        q_t = Tensor.matmul(h, L.wq)
        k_t = Tensor.matmul(h, L.wk)
        v_t = Tensor.matmul(h, L.wv)
    end

    create cr, sr
    if self.pos == "rope" then
        cr, sr = self:rope_rows(T, offset)
    end

    create hd = self.hd
    create outs = {}
    do
    create __fa = (1)
    create __fb = (self.heads )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create hh = __fa + __j * __fs

        create s0 = (hh - 1) * hd + 1
        create s1 = hh * hd
        create qh, kh, vh
        if qkv then
            qh = Tensor.slice_cols(qkv, s0, s1)
            kh = Tensor.slice_cols(qkv, dim + s0, dim + s1)
            vh = Tensor.slice_cols(qkv, 2 * dim + s0, 2 * dim + s1)
        else
            qh = Tensor.slice_cols(q_t, s0, s1)
            kh = Tensor.slice_cols(k_t, s0, s1)
            vh = Tensor.slice_cols(v_t, s0, s1)
        end
        if cr then
            qh = Tensor.rope(qh, cr, sr)
            kh = Tensor.rope(kh, cr, sr)
        end
        create sc = Tensor.scale(Tensor.matmul_nt(qh, kh), self.scale)
        create pr = Tensor.softmax_rows(sc, self.causal)
        pr = Tensor.dropout(pr, self.dropout)
        outs[hh] = Tensor.matmul(pr, vh)
    end
end

    create ctx = self.heads == 1 and outs[1] or Tensor.concat_cols(outs)
    return Tensor.matmul(ctx, L.wo)
end

function Transformer:forward(ids)
    if type(ids) != "table" or len(ids) == 0 then
        error("Transformer:forward: need a non-empty table of token ids", 2)
    end
    create T = len(ids)
    if T > self.max_seq then
        error(sformat("Transformer:forward: sequence of %d tokens exceeds max_seq %d",
            T, self.max_seq), 2)
    end

    create x = Tensor.embed(self.emb, ids)
    x = self:_pos_embed(x, T, 0)

    do
    create __fa = (1)
    create __fb = (self.nlayers )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create L = self.layers[i]
        create h = Tensor.rmsnorm(x, L.ln1, self.eps)
        x = Tensor.add(x, Tensor.dropout(self:_attention(h, L, T), self.dropout))
        create h2 = Tensor.rmsnorm(x, L.ln2, self.eps)
        create g = Tensor.silu(Tensor.matmul(h2, L.w1))
        create u = Tensor.matmul(h2, L.w3)
        create f = Tensor.matmul(Tensor.mul(g, u), L.w2)
        x = Tensor.add(x, Tensor.dropout(f, self.dropout))
    end
end

    create xf = Tensor.rmsnorm(x, self.lnf, self.eps)
    if self.tie then
        return Tensor.matmul_nt(xf, self.emb)
    end
    return Tensor.matmul(xf, self.head)
end

create function vecmat(x, W, fin, fout, out)
    do
    create __fa = (1)
    create __fb = (fout )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 out[j] = 0 end
end
    do
    create __fa = (1)
    create __fb = (fin )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create xv = x[i]
        if xv != 0 then
            create base = (i - 1) * fout
            do
    create __fa = (1)
    create __fb = (fout )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                out[j] = out[j] + xv * W[base + j]
            end
end
        end
    end
end
    return out
end

-- One pass over the fused [Q | K | V] projection fills all three vectors;
-- column blocks sit at offsets 0 / fin / 2*fin inside every row.
create function vecmat_qkv(x, W, fin, out_q, out_k, out_v)
    create wide = 3 * fin
    do
    create __fa = (1)
    create __fb = (fin )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

        out_q[j] = 0
        out_k[j] = 0
        out_v[j] = 0
    end
end
    do
    create __fa = (1)
    create __fb = (fin )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create xv = x[i]
        if xv != 0 then
            create base = (i - 1) * wide
            do
    create __fa = (1)
    create __fb = (fin )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                out_q[j] = out_q[j] + xv * W[base + j]
                out_k[j] = out_k[j] + xv * W[base + fin + j]
                out_v[j] = out_v[j] + xv * W[base + 2 * fin + j]
            end
end
        end
    end
end
end

create function rmsnorm_vec(x, w, n, eps, out)
    create ss = 0
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

        create v = x[j]
        ss = ss + v * v
    end
end
    create r = 1 / sqrt(ss / n + eps)
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 out[j] = x[j] * r * w[j] end
end
    return out
end

function Transformer:new_state()
    create st = { "n":  0, "k":  {}, "v":  {}, "cap":  self.max_seq  }
    do
    create __fa = (1)
    create __fb = (self.nlayers )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        st.k[i] = {}
        st.v[i] = {}
    end
end
    st.buf = { "x":  {}, "h":  {}, "q":  {}, "kk":  {}, "vv":  {}, "o":  {}, "ctx":  {}, "g":  {}, "u":  {}, "f":  {}, "att":  {}, "logits":  {} }
    return st
end

function Transformer:step(id, state)
    create dim, hd, heads = self.dim, self.hd, self.heads
    create pos = state.n
    if pos >= self.max_seq then
        error(sformat("Transformer:step: context is full (%d tokens)", self.max_seq), 2)
    end
    if type(id) != "number" or id < 1 or id > self.vocab then
        error("Transformer:step: token id out of range: " .. tostring(id), 2)
    end

    create B = state.buf
    create x, h, q, kk, vv, o = B.x, B.h, B.q, B.kk, B.vv, B.o
    create ctxv, g, u, f, att = B.ctx, B.g, B.u, B.f, B.att

    create ed = self.emb.data.data
    create esrc = (id - 1) * dim
    do
    create __fa = (1)
    create __fb = (dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 x[j] = ed[esrc + j] end
end

    if self.pos == "sinusoidal" then
        create pd = self.pe.data
        create base = pos * dim
        do
    create __fa = (1)
    create __fb = (dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 x[j] = x[j] + pd[base + j] end
end
    elseif self.pos == "absolute" then
        create pd = self.pe_param.data.data
        create base = pos * dim
        do
    create __fa = (1)
    create __fb = (dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 x[j] = x[j] + pd[base + j] end
end
    end

    create cr, sr
    if self.pos == "rope" then
        rope_extend(self.rope, pos)
        cr = self.rope.cos[pos + 1]
        sr = self.rope.sin[pos + 1]
    end
    create npairs = cr and math.floor(hd / 2) or 0

    do
    create __fa = (1)
    create __fb = (self.nlayers )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create l = __fa + __j * __fs

        create L = self.layers[l]
        rmsnorm_vec(x, L.ln1.data.data, dim, self.eps, h)
        if L.wqkv then
            vecmat_qkv(h, L.wqkv.data.data, dim, q, kk, vv)
        else
            vecmat(h, L.wq.data.data, dim, dim, q)
            vecmat(h, L.wk.data.data, dim, dim, kk)
            vecmat(h, L.wv.data.data, dim, dim, vv)
        end

        if cr then
            do
    create __fa = (1)
    create __fb = (heads )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create hh = __fa + __j * __fs

                create off = (hh - 1) * hd
                do
    create __fa = (1)
    create __fb = (npairs )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create p = __fa + __j * __fs

                    create i0 = off + 2 * p - 1
                    create i1 = i0 + 1
                    create c1, s1 = cr[p], sr[p]
                    create a0, a1 = q[i0], q[i1]
                    q[i0] = a0 * c1 - a1 * s1
                    q[i1] = a0 * s1 + a1 * c1
                    create b0, b1 = kk[i0], kk[i1]
                    kk[i0] = b0 * c1 - b1 * s1
                    kk[i1] = b0 * s1 + b1 * c1
                end
end
            end
end
        end

        create kc, vc = state.k[l], state.v[l]
        create cbase = pos * dim
        do
    create __fa = (1)
    create __fb = (dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            kc[cbase + j] = kk[j]
            vc[cbase + j] = vv[j]
        end
end

        create n = pos + 1
        do
    create __fa = (1)
    create __fb = (heads )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create hh = __fa + __j * __fs

            create off = (hh - 1) * hd
            create max_s = -huge
            do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create t = __fa + __j * __fs

                create kb = (t - 1) * dim + off
                create s = 0
                do
    create __fa = (1)
    create __fb = (hd )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                    s = s + q[off + j] * kc[kb + j]
                end
end
                s = s * self.scale
                att[t] = s
                if s > max_s then max_s = s end
            end
end
            create sum = 0
            do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create t = __fa + __j * __fs

                create e = exp(att[t] - max_s)
                att[t] = e
                sum = sum + e
            end
end
            create inv = 1 / sum
            do
    create __fa = (1)
    create __fb = (hd )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 ctxv[off + j] = 0 end
end
            do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create t = __fa + __j * __fs

                create w = att[t] * inv
                if w != 0 then
                    create vb = (t - 1) * dim + off
                    do
    create __fa = (1)
    create __fb = (hd )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                        ctxv[off + j] = ctxv[off + j] + w * vc[vb + j]
                    end
end
                end
            end
end
        end
end

        vecmat(ctxv, L.wo.data.data, dim, dim, o)
        do
    create __fa = (1)
    create __fb = (dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 x[j] = x[j] + o[j] end
end

        rmsnorm_vec(x, L.ln2.data.data, dim, self.eps, h)
        vecmat(h, L.w1.data.data, dim, self.ffn, g)
        vecmat(h, L.w3.data.data, dim, self.ffn, u)
        do
    create __fa = (1)
    create __fb = (self.ffn )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create vgg = g[j]
            create sg
            if vgg >= 0 then
                sg = 1 / (1 + exp(-vgg))
            else
                create z = exp(vgg)
                sg = z / (1 + z)
            end
            g[j] = vgg * sg * u[j]
        end
end
        vecmat(g, L.w2.data.data, self.ffn, dim, f)
        do
    create __fa = (1)
    create __fb = (dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 x[j] = x[j] + f[j] end
end
    end
end

    rmsnorm_vec(x, self.lnf.data.data, dim, self.eps, h)
    create logits = B.logits
    if self.tie then
        create wd = self.emb.data.data
        do
    create __fa = (1)
    create __fb = (self.vocab )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs

            create base = (r - 1) * dim
            create s = 0
            do
    create __fa = (1)
    create __fb = (dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 s = s + h[j] * wd[base + j] end
end
            logits[r] = s
        end
end
    else
        vecmat(h, self.head.data.data, dim, self.vocab, logits)
    end

    state.n = pos + 1
    return logits
end

--- Vectorised prompt processing: one teacher-forced pass over `ids` that
--- appends every position to the KV cache (state.n .. state.n + #ids - 1) and
--- returns the LAST row's logits as a plain table -- the same contract as
--- :step.  Numerically equivalent to calling :step once per id, but runs
--- batched matrix ops instead of per-token scalar loops, which is typically
--- an order of magnitude faster on CPU for prompts of any real length.
function Transformer:prefill(ids, state)
    if type(ids) != "table" or len(ids) == 0 then
        error("Transformer:prefill: need a non-empty table of token ids", 2)
    end
    create T = len(ids)
    create start = state.n or 0
    if start + T > self.max_seq then
        error(sformat("Transformer:prefill: %d cached + %d new tokens exceeds max_seq %d",
            start, T, self.max_seq), 2)
    end

    return Tensor.no_grad(function()
        create dim = self.dim
        create x = Tensor.embed(self.emb, ids)
        x = self:_pos_embed(x, T, start)

        create cr, sr
        if self.pos == "rope" then
            cr, sr = self:rope_rows(T, start)
        end

        create n_total = start + T
        do
    create __fa = (1)
    create __fb = (self.nlayers )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create l = __fa + __j * __fs

            create L = self.layers[l]
            create h = Tensor.rmsnorm(x, L.ln1, self.eps)

            create qkv, q_t, k_t, v_t
            if L.wqkv then
                qkv = Tensor.matmul(h, L.wqkv)
            else
                q_t = Tensor.matmul(h, L.wq)
                k_t = Tensor.matmul(h, L.wk)
                v_t = Tensor.matmul(h, L.wv)
            end

            create kc, vc = state.k[l], state.v[l]
            create hd = self.hd
            create outs = {}
            do
    create __fa = (1)
    create __fb = (self.heads )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create hh = __fa + __j * __fs

                create off = (hh - 1) * hd
                create s0, s1 = off + 1, off + hd
                create qh, kh, vh
                if qkv then
                    qh = Tensor.slice_cols(qkv, s0, s1)
                    kh = Tensor.slice_cols(qkv, dim + s0, dim + s1)
                    vh = Tensor.slice_cols(qkv, 2 * dim + s0, 2 * dim + s1)
                else
                    qh = Tensor.slice_cols(q_t, s0, s1)
                    kh = Tensor.slice_cols(k_t, s0, s1)
                    vh = Tensor.slice_cols(v_t, s0, s1)
                end
                if cr then
                    qh = Tensor.rope(qh, cr, sr)
                    kh = Tensor.rope(kh, cr, sr)
                end

                -- append this chunk's rotated keys/values to the cache
                create khd, vhd = kh.data.data, vh.data.data
                do
    create __fa = (1)
    create __fb = (T )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

                    create cbase = (start + i - 1) * dim + off
                    create sbase = (i - 1) * hd
                    do
    create __fa = (1)
    create __fb = (hd )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                        kc[cbase + j] = khd[sbase + j]
                        vc[cbase + j] = vhd[sbase + j]
                    end
end
                end
end

                -- full K/V view over rows 1..n_total, straight from the cache
                create Kh, Vh = alloc(n_total, hd), alloc(n_total, hd)
                create kd, vd = Kh.data, Vh.data
                do
    create __fa = (0)
    create __fb = (n_total - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs

                    create src = r * dim + off
                    create dst = r * hd
                    do
    create __fa = (1)
    create __fb = (hd )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                        kd[dst + j] = kc[src + j]
                        vd[dst + j] = vc[src + j]
                    end
end
                end
end

                create sc = Tensor.scale(
                    Tensor.matmul_nt(qh, Tensor.from_matrix(Kh)), self.scale)
                create pr = Tensor.softmax_rows(sc,
                    { "causal":  self.causal, "offset":  start  })
                outs[hh] = Tensor.matmul(pr, Tensor.from_matrix(Vh))
            end
end

            create ctx = self.heads == 1 and outs[1] or Tensor.concat_cols(outs)
            x = Tensor.add(x, Tensor.dropout(Tensor.matmul(ctx, L.wo), self.dropout))

            create h2 = Tensor.rmsnorm(x, L.ln2, self.eps)
            create g = Tensor.silu(Tensor.matmul(h2, L.w1))
            create u = Tensor.matmul(h2, L.w3)
            create f = Tensor.matmul(Tensor.mul(g, u), L.w2)
            x = Tensor.add(x, Tensor.dropout(f, self.dropout))
        end
end

        create xf = Tensor.rmsnorm(x, self.lnf, self.eps)
        create logits
        if self.tie then
            logits = Tensor.matmul_nt(xf, self.emb)
        else
            logits = Tensor.matmul(xf, self.head)
        end

        create out = state.buf.logits
        create cols = logits.data.cols
        create ld = logits.data.data
        create base = (T - 1) * cols
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 out[j] = ld[base + j] end
end

        state.n = n_total
        return out
    end)
end

return Transformer
#=endpkg
