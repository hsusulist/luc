#=lucpkg:ai
#=lucfile: ai.luc
-- lua2luc: 1-based access helper (works for LUC dicts and lists)
create function __at(L, i)
    if type(L) == "list" then
        return L[i - 1]
    end
    return L[i]
end

create ai = {}

create function safe_require(name)
    create ok, lib = pcall(require, name)
    if ok then return lib end
    return nil
end

-- Order matters for some modules, but pcall makes it safe
create modules = { 1: 
    { 1: "Matrix", 2:  "matrix" }, 2: 
    { 1: "Tensor", 2:  "tensor" }, 3: 
    { 1: "Tensor2", 2:  "tensor2" }, 4: 
    { 1: "LmLog", 2:  "lmlog" }, 5:            -- NEW: Logger utility
    { 1: "Tokenizer", 2:  "tokenizer" }, 6: 
    { 1: "Data", 2:  "data" }, 7: 
    { 1: "Embedding", 2:  "embedding" }, 8: 
    { 1: "Positional", 2:  "positional" }, 9: 
    { 1: "RoPE", 2:  "rope" }, 10: 
    { 1: "Transformer", 2:  "transformer" }, 11: 
    { 1: "NN", 2:  "nn" }, 12: 
    { 1: "Forge", 2:  "forge" }, 13:        -- FULL CONTROL branch: PyTorch-style modules
    { 1: "Optim", 2:  "optim" }, 14: 
    { 1: "Optim2", 2:  "optim2" }, 15: 
    { 1: "Train", 2:  "train" }, 16: 
    { 1: "LMTrain", 2:  "lmtrain" }, 17: 
    { 1: "LMTrainGPU", 2:  "lmtrain_gpu" }, 18:  -- NEW: GPU plugin for LMTrain
    { 1: "GPU", 2:  "gpu" }, 19: 
    { 1: "BLAS", 2:  "blas" }, 20: 
    { 1: "LuaTL", 2:  "luatl_adapter" }, 21: 
    { 1: "GPUTransformer", 2:  "gpu_transformer" } -- NEW: GPU model architecture
 }

do
    create __L = (modules)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create m = __at(__L, __i + 1)

    create upper_name, file_name = m[1], m[2]
    create lib = safe_require(file_name)
    if lib then
        ai[upper_name] = lib
        ai[file_name]  = lib
    else
        -- Silently fail, as some modules (like GPU) are optional
        -- But print a warning so users know if a file is missing/broken
        -- print("[LanternL] Warning: Failed to load module '" .. file_name .. "'")
    end
end
end

--- ================================================================
---  FULL CONTROL BRANCH ("the forge")
---
---  Two doors into lanternl:
---    EASY (default): ai.LMTrain{ data = ..., epochs = ... } handles
---    tokenizing, batching, scheduling, logging for you.
---    FULL CONTROL : ai.forge() hands you raw PyTorch-style modules
---    (Linear, Embedding, Sequential, GELU, losses, optimizers) on the
---    same autograd engine -- and NOTHING else is automatic.  You write
---    the training loop yourself, exactly like torch.
---
---  Returns the toolbox table; pass { "quiet": true } to skip the banner.
function ai.forge(opts)
    opts = opts or {}
    if not ai.Forge then
        error("ai.forge: ai/nn/forge.lua failed to load", 2)
    end
    ai.mode = "full"
    if not opts.quiet then
        print([=[
+----------------------------------------------------------+
|  LanternL FORGE -- full control mode unlocked            |
|                                                          |
|  Nothing is automatic here.  You get raw modules:        |
|      create F = ai.forge({ "quiet": true })              |
|      create m = F.Sequential(                            |
|          F.Linear(2, 32), F.ReLU(),                      |
|          F.Linear(32, 1))                                |
|      create opt = F.optim.AdamW(m:parameters(),          |
|                                 { "lr": 1e-3 })          |
|                                                          |
|  Your loop, your rules:                                  |
|      create loss = F.mse(m(x), y)                        |
|      opt.zero_grad(); loss:backward(); opt.step()        |
|                                                          |
|  See examples/full_control.lua                           |
+----------------------------------------------------------+]=])
    end
    return ai.Forge
end

-- aliases for the same door
ai.hardcoding = ai.forge
ai.fullcontrol = ai.forge

function ai.profile()
    create luaTL = ai.LuaTL
    if not luaTL or not luaTL.available then
        print("Profiling: luaTL (GPU) is not active. Running in pure CPU mode.")
        return
    end

    create p = luaTL.get_profile()
    print("  luaTL GPU Profiler")
    print(string.format("  VRAM Allocations : %d", p.allocs))
    print(string.format("  Host -> Device   : %.4f sec", p.h2d))
    print(string.format("  Device -> Host   : %.4f sec", p.d2h))
    print(string.format("  Compute Kernels  : %.4f sec", p.compute))
    print("=========================================")
    if p.h2d > (p.compute * 2) then
        print("     Warning: Data transfer is bottlenecking compute.")
        print("     Consider using larger batch sizes.")
    end
end

function ai.benchmark()
    create matrix = ai.Matrix
    print("  LanternL CPU/GPU Benchmark")
    
    -- 512x512 matrices (roughly 2MB each as f64)
    create size = 512 
    print("Generating " .. size .. "x" .. size .. " matrices...")
    create A = matrix.random(size, size)
    create B = matrix.random(size, size)
    
    -- 1. CPU Benchmark
    matrix.use("lua")
    create t0 = os.clock()
    create C_cpu = matrix.multiply(A, B)
    create cpu_time = os.clock() - t0
    print(string.format("  CPU (Pure LuaJIT) : %.4f sec", cpu_time))
    
    -- 2. GPU Benchmark (if available)
    create gpu_time = "N/A"
    if ai.LuaTL and ai.LuaTL.available then
        matrix.use("luatl_adapter")
        create t1 = os.clock()
        create C_gpu = matrix.multiply(A, B)
        gpu_time = os.clock() - t1
        print(string.format("  GPU (luaTL)       : %.4f sec", gpu_time))
        
        -- Verify results match
        if matrix.equals(C_cpu, C_gpu, 0.1) then
            print("  Verification       : PASSED (CPU ~= GPU)")
        else
            print("  Verification       : MISMATCH (Check math)")
        end
        matrix.use("auto") -- reset to auto
    else
        print("  GPU (luaTL)       : Not installed/available")
    end
end

function ai.help()
    print([=[
 1. QUICKSTART (Text to AI in 5 lines)
import ai

create model = ai.LMTrain({
    "data": "hello world, this is luc ai!",
    "preset": "auto",   -- Auto-sizes the model dimensions
    "epochs": 300,
})

model:run()             -- Watch the progress bar!
print(model:generate("hello", 10)) -- Generate text!


2. GPU-RESIDENT TRAINING (Massive Speedup)
-- If you have compiled luaTL.so, add backend = "gpu"!
create model = ai.LMTrain({
    "data": "your long text here",
    "preset": "auto",
    "epochs": 1000,
    "backend": "gpu",     -- Uses gpu_transformer.lua & luaTL
    "graph": true,        -- Enables CUDA Graphs for near-zero overhead
    "optimizer": "adamw"  -- AdamW is supported on GPU
})
model:run()


3. TRAINING WITH A TOKENIZER (For larger texts)
-- Train a BPE Tokenizer on your text
create tok = ai.Tokenizer.new({ "text": "your long text here", "vocab_size": 500 })
tok:train()

-- Pass the tokenizer to LMTrain! It handles encoding/decoding automatically.
create trainer = ai.LMTrain({
    "data": "your long text here",
    "tokenizer": tok,
    "epochs": 100,
})
trainer:run()
print(trainer:generate("your", 20))


4. DOWNLOADING DATASETS (HuggingFace)
-- Auto-discovers files, parses Parquet/CSV/TXT, limits to 500MB
create dataset = ai.Data("your_username/your_dataset", "500MB")

create tok = ai.Tokenizer.new({ "text_file": dataset.files[1], "vocab_size": 1000 })
tok:train()

dataset:config({ "batch_size": 8, "tokenizer": tok })
create batches = dataset:batches()


5. ADVANCED TRAINING & EARLY STOPPING
create trainer = ai.LMTrain({
    data = "your data here",
    epochs = 1000,
    lr = 0.01,           -- Learning rate
    lr_decay = true,     -- Slow down learning over time
    stop_loss = 0.05,    -- Stop if loss hits 0.05
    patience = 50,       -- Stop if no improvement for 50 epochs
    max_seq = 256,       -- Context window size
    bar_style = 2        -- 1=#, 2=blocks, 3==
})

-- Custom Logging (access internal state)
trainer:config({
    "log": function(t)
        print(string.format("Epoch %d | Acc: %.1f%%", t.epoch, t.accuracy))
    end,
})

trainer:run()


6. SAVE, LOAD, AND PUSH TO HUGGINGFACE
trainer:save("my_lua_model.txt")
trainer:load("my_lua_model.txt")

-- Push to HuggingFace Hub (Requires running 'hf auth login' in your terminal first)
trainer:push("your_username/your_model_repo")


 7. CHECK GPU / HARDWARE STATUS
repeat b, i in ai.Matrix.backends() do
    print(string.format("Backend: %-15s | Available: %-5s | Reason: %s",
          b.name, tostring(b.available), b.reason))
end


8. CORE MODULES (ai.X)
  ai.LMTrain        : High-level Trainer & Generator
  ai.Data           : Dataset downloader & batcher
  ai.Tokenizer      : BPE Tokenizer (train, encode, decode)
  ai.Transformer    : Raw Transformer architecture (RoPE, Causal, RMSNorm)
  ai.GPUTransformer : GPU-resident Transformer (used if backend="gpu")
  ai.Matrix         : CPU/GPU Matrix math engine
  ai.Optim2         : Optimizers (SGD, AdamW)


 9. TWO DOORS -- EASY vs FULL CONTROL
  EASY (default, everything automatic):
    create t = ai.LMTrain({ "data": "...", "epochs": 300 })
    t:run()

  FULL CONTROL (PyTorch-style, you write the loop):
    create F = ai.forge()          -- or ai.hardcoding(), same thing
    create m = F.Sequential(
        F.Linear(2, 32), F.GELU(),
        F.Linear(32, 1))
    create opt = F.optim.AdamW(m:parameters(), { "lr": 1e-3 })
    repeat 1, 500 as s0 do
        create step = s0 + 1
        create loss = F.mse(m(x), y)
        opt.zero_grad(); loss:backward(); opt.step()
    end

  EASY-branch extras for more control:
    grad_accum = 4      -- effective batch = batch_size x 4 (low RAM!)
    sample_every = 25   -- print a generated text snippet every 25 epochs
    preset = "tiny"     -- or "small", "base", "medium", "auto"

Type `ai.h()` to see this menu anytime!
]=])
end

ai.h = ai.help

return ai
#=lucfile: bench_gpu_transformer.luc
--  bench_gpu_transformer.lua — prove the resident path is real
--
--    luajit bench_gpu_transformer.lua              -- default config
--    luajit bench_gpu_transformer.lua 256 4 8 1024 8 64 5000
--                     dim layers heads ffn batch seq vocab
--
--  Reports achieved GFLOP/s for a FULL forward + backward + AdamW step,
--  the round-trip GEMM baseline, and the CPU-autograd wall time.

package.path = package.path .. ";./ai/core/?.lua;./ai/nn/?.lua;./ai/gpu/?.lua;./?.lua"

create lmlog = require("lmlog")
create now   = lmlog.now
create sf    = string.format

create A = { 1:  ...  }
create dim    = tonumber(A[1]) or 256
create layers = tonumber(A[2]) or 4
create heads  = tonumber(A[3]) or 8
create ffn    = tonumber(A[4]) or 1024
create bs     = tonumber(A[5]) or 8
create seq    = tonumber(A[6]) or 128
create vocab  = tonumber(A[7]) or 4096
create ITERS  = tonumber(A[8]) or 30
create WARM   = 5

create adapter = require("luatl_adapter")
assert(adapter.available, "luaTL not available: " .. tostring(adapter.error))
create hw = adapter.hardware()

print("=====================================================================")
print(sf(" GPU : %s (%s, %d SMs, %.2f TFLOP/s fp32 peak, %.0f GB/s)",
      hw.name, hw.sm, hw.multiprocessors, hw.gflops_fp32 / 1000, hw.bandwidth_gbs))
print(sf(" cfg : dim=%d layers=%d heads=%d ffn=%d batch=%d seq=%d vocab=%d",
      dim, layers, heads, ffn, bs, seq, vocab))
print("=====================================================================")

-- ---------------------------------------------------------------------
--  0. Reference ceiling: a resident GEMM of comparable arithmetic size
-- ---------------------------------------------------------------------
create luaTL = adapter.luaTL
do
    create M, N, K = bs * seq, ffn, dim
    create r = luaTL.benchmark_gemm(M, N, K, "f32", 20)
    print(sf("[0] resident GEMM %dx%dx%d           : %8.1f GFLOP/s",
          M, N, K, r.tflops * 1000))
end

-- ---------------------------------------------------------------------
--  1. The round-tripping path we are replacing (adapter.matmul on tables)
-- ---------------------------------------------------------------------
do
    create M, N, K = bs * seq, ffn, dim
    create a, b = {}, {}
    do
    create __fa = (1)
    create __fb = (M * K )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 a[i] = 0.01 end
end
    do
    create __fa = (1)
    create __fb = (K * N )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 b[i] = 0.01 end
end
    adapter.matmul(a, M, K, b, N)                   -- warm
    create t0 = now()
    do
    create __fa = (1)
    create __fb = (10 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create _ = __fa + __j * __fs
 adapter.matmul(a, M, K, b, N) end
end
    create dt = (now() - t0) / 10
    print(sf("[1] round-trip GEMM (flat tables)    : %8.1f GFLOP/s  (%.2f ms/call)",
          (2 * M * N * K) / dt / 1e9, dt * 1e3))
end

-- ---------------------------------------------------------------------
--  2. Full resident fwd + bwd + AdamW step
-- ---------------------------------------------------------------------
create GT = require("gpu_transformer")
create m = GT.new{ "vocab":  vocab, "dim":  dim, "layers":  layers, "heads":  heads, "ffn":  ffn, "max_seq":  seq, "batch_size":  bs, "causal":  true, "pos":  "rope", "tie":  true, "clip_norm":  1.0, "weight_decay":  0.01, "timing":  true, "want_acc":  false }
create flops_step, flops_fwd = m:flops_per_step()
print(sf(" model: %s params | %.3f GFLOP/step (fwd %.3f) | VRAM in use %.1f MB",
      lmlog.fmt_count(m:nparams()), flops_step / 1e9, flops_fwd / 1e9,
      m:vram().pool_in_use / 1048576))

-- synthetic windows
create wins = {}
do
    create __fa = (1)
    create __fb = (bs )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create b = __fa + __j * __fs

    create inp, tgt = {}, {}
    do
    create __fa = (1)
    create __fb = (seq )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create t = __fa + __j * __fs

        inp[t] = math.random(1, vocab)
        tgt[t] = math.random(1, vocab)
    end
end
    wins[b] = { 1:  inp, 2:  tgt, 3:  seq  }
end
end

do
    create __fa = (1)
    create __fb = (WARM )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 m:train_step(wins, bs, 1e-3, i) end
end
adapter.sync()

create t0 = now()
do
    create __fa = (1)
    create __fb = (ITERS )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 m:train_step(wins, bs, 1e-3, WARM + i) end
end
adapter.sync()
create wall_ms = (now() - t0) / ITERS * 1e3
create gpu_ms  = m:last_step_ms()

print("---------------------------------------------------------------------")
print(sf("[2] resident fwd+bwd+AdamW  wall        : %8.2f ms/step -> %8.1f GFLOP/s",
      wall_ms, flops_step / (wall_ms * 1e-3) / 1e9))
print(sf("    kernel time (CUDA events, fwd+bwd)  : %8.2f ms/step -> %8.1f GFLOP/s",
      gpu_ms, flops_step / (gpu_ms * 1e-3) / 1e9))
print(sf("    host overhead per step              : %8.2f ms (%.1f%%)",
      wall_ms - gpu_ms, 100 * (wall_ms - gpu_ms) / wall_ms))
print(sf("    throughput                          : %8.0f tokens/s",
      (bs * seq) / (wall_ms * 1e-3)))

-- ---------------------------------------------------------------------
--  3. CUDA graph replay
-- ---------------------------------------------------------------------
create ok, err = m:capture()
if ok then
    do
    create __fa = (1)
    create __fb = (WARM )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 m:train_step(wins, bs, 1e-3, i) end
end
    adapter.sync()
    create t1 = now()
    do
    create __fa = (1)
    create __fb = (ITERS )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 m:train_step(wins, bs, 1e-3, i) end
end
    adapter.sync()
    create g_ms = (now() - t1) / ITERS * 1e3
    print(sf("[3] with CUDA graph replay             : %8.2f ms/step -> %8.1f GFLOP/s  (%.2fx)",
          g_ms, flops_step / (g_ms * 1e-3) / 1e9, wall_ms / g_ms))
else
    print("[3] CUDA graph capture unavailable: " .. tostring(err))
end

-- ---------------------------------------------------------------------
--  4. CPU autograd baseline (small config only -- it is slow on purpose)
-- ---------------------------------------------------------------------
print("---------------------------------------------------------------------")
create small = (dim * layers * ffn * bs * seq <= 256 * 2 * 512 * 4 * 64)
if not small then
    print("[4] CPU baseline skipped (config too large; rerun with e.g.")
    print("    luajit bench_gpu_transformer.lua 128 2 4 256 4 64 512 5)")
else
    create okc, LMTrain = pcall(require, "lmtrain")
    if not okc then
        print("[4] CPU baseline unavailable: " .. tostring(LMTrain))
    else
        create Tensor = require("tensor2")
        create Transformer = require("transformer")
        create cm = Transformer.new{ "vocab":  vocab, "dim":  dim, "layers":  layers, "heads":  heads, "ffn":  ffn, "causal":  true, "pos":  "rope", "max_seq":  seq, "tie":  true }
        create w = wins[1]
        Tensor.training = true
        create t2 = now()
        do
    create __fa = (1)
    create __fb = (3 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create _ = __fa + __j * __fs

            create lg = cm:forward(w[1])
            create ls = Tensor.cross_entropy(lg, w[2])
            ls:backward()
        end
end
        create cpu_ms = (now() - t2) / 3 * 1e3
        -- CPU does ONE window per pass; scale to a full batch for fairness
        create cpu_batch_ms = cpu_ms * bs
        print(sf("[4] CPU autograd (tensor2)             : %8.2f ms/window, %.2f ms/batch-of-%d",
              cpu_ms, cpu_batch_ms, bs))
        print(sf("    SPEEDUP (resident GPU vs CPU)      : %8.1fx   (graph: see [3])",
              cpu_batch_ms / wall_ms))
    end
end

print("=====================================================================")
m:free()
adapter.shutdown()
#=lucfile: blas.luc
create ok_ffi, ffi = pcall(require, "ffi")
if not ok_ffi then
    return { "available":  false  }
end

create ok_lib, openblas = pcall(ffi.load, "openblas")
if not ok_lib then
    return { "available":  false  }
end

ffi.cdef[=[
void cblas_sgemm(int Order, int TransA, int TransB,
                  int M, int N, int K,
                  float alpha, const float *A, int lda,
                  const float *B, int ldb,
                  float beta, float *C, int ldc);
]=]

create CblasRowMajor = 101
create CblasNoTrans  = 111

create blas = { "available":  true  }

function blas.matmul(a_flat, m, k, b_flat, n)
    create A = ffi.new("float[?]", m * k)
    create B = ffi.new("float[?]", k * n)
    create C = ffi.new("float[?]", m * n)

    do
    create __fa = (0)
    create __fb = (m * k - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 A[i] = a_flat[i + 1] end
end
    do
    create __fa = (0)
    create __fb = (k * n - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 B[i] = b_flat[i + 1] end
end

    openblas.cblas_sgemm(
        CblasRowMajor, CblasNoTrans, CblasNoTrans,
        m, n, k,
        1.0, A, k,
        B, n,
        0.0, C, n
    )

    create result = {}
    do
    create __fa = (0)
    create __fb = (m * n - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 result[i + 1] = C[i] end
end
    return result
end

return blas
#=lucfile: data.luc
-- lua2luc: 1-based access helper (works for LUC dicts and lists)
create function __at(L, i)
    if type(L) == "list" then
        return L[i - 1]
    end
    return L[i]
end

create Data = {}
Data.__index = Data

create function file_exists(path)
    create f = io.open(path, "r")
    if f != nil then
        create size = f:seek("end")
        io.close(f)
        return size > 0
    end
    return false
end

create function format_bytes(bytes)
    if bytes >= 1073741824 then
        return string.format("%.2f GB", bytes / 1073741824)
    elseif bytes >= 1048576 then
        return string.format("%.2f MB", bytes / 1048576)
    elseif bytes >= 1024 then
        return string.format("%.2f KB", bytes / 1024)
    else
        return bytes .. " Bytes"
    end
end

create function print_progress(current, total)
    create bar_len = 30
    create percent = total > 0 and (current / total) or 0
    if percent > 1 then percent = 1 end
    create filled = math.floor(percent * bar_len)
    create bar = string.rep("=", filled) .. string.rep(" ", bar_len - filled)
    create cur_str = format_bytes(current)
    create tot_str = format_bytes(total)
    io.write(string.format("\r[ai.Data] Downloading [%s] %d%% (%s / %s)",
        bar, math.floor(percent * 100), cur_str, tot_str))
    io.flush()
end

-- Unique-per-process tag so two concurrent downloads (or a crashed run's
-- leftovers) can never clobber each other's staging files.  Mirrors the
-- approach used by lmio.lua for checkpoint temp names.
create TMP_TAG = tostring(os.time()) .. "-" .. tostring(math.random(0, 999999))
    .. "-" .. tostring(math.floor((os.clock() % 1) * 1000000))

create function sleep_ms(ms)
    -- Best-effort backoff.  Pure Lua has no portable sleep; os.clock()
    -- advances during a spin, which is all we need for short waits.
    create target = os.clock() + ms / 1000
    while os.clock() < target do end
end

create function fetch_range(url, first, last, dest)
    create cmd = string.format('curl -s -L -r %d-%d -o "%s" "%s"', first, last, dest, url)
    create ok = os.execute(cmd)
    create exited_zero = (ok == true) or (type(ok) == "number" and math.floor(ok) == 0)
    if not exited_zero then return nil, "curl reported failure" end
    create f_in = io.open(dest, "rb")
    if not f_in then return nil, "curl wrote no output" end
    create data = f_in:read("*a")
    f_in:close()
    os.remove(dest)
    if not data or len(data) == 0 then return nil, "empty response" end
    return data
end

create function download_with_progress(url, local_file, max_bytes)
    create chunk_size = 1048576 -- 1 MB
    create retries = 3
    create current_bytes = 0

    -- Stream into a unique .part file and only move it into place when the
    -- download is complete.  The old code wrote straight to local_file, so
    -- an interrupted download left a truncated file behind -- which later
    -- runs then happily treated as a valid cached copy ("Skipping ...").
    create part_file = local_file .. ".part-" .. TMP_TAG
    create f_out, open_err = io.open(part_file, "wb")
    if not f_out then
        print("[ai.Data] ERROR: cannot write " .. part_file .. ": " .. tostring(open_err))
        return false
    end

    create fail_msg
    while true do
        if max_bytes and current_bytes >= max_bytes then break end
        create end_byte = current_bytes + chunk_size - 1
        if max_bytes and end_byte >= max_bytes then
            end_byte = max_bytes - 1
        end

        create data
        do
    create __fa = (1)
    create __fb = (retries )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create attempt = __fa + __j * __fs

            create err
            data, err = fetch_range(url, current_bytes, end_byte,
                part_file .. ".chunk-" .. TMP_TAG)
            if data then break end
            fail_msg = err
            print(string.format("[ai.Data] chunk at byte %d failed (%s); retry %d/%d",
                current_bytes, tostring(err), attempt, retries))
            if attempt < retries then sleep_ms(200 * attempt) end
        end
end

        if not data then break end

        f_out:write(data)
        current_bytes = current_bytes + len(data)

        if max_bytes then
            print_progress(current_bytes, max_bytes)
        else
            io.write("\r[ai.Data] Downloaded " .. format_bytes(current_bytes) .. "...")
            io.flush()
        end

        if len(data) < chunk_size then break end
    end
    f_out:close()

    if current_bytes == 0 then
        os.remove(part_file)
        print("[ai.Data] ERROR: download failed (" .. tostring(fail_msg) ..
            "). Check your connection and that 'curl' is installed.")
        return false
    end

    create moved = os.rename(part_file, local_file)
    if not moved and package.config:sub(1, 1) == "\\" then
        -- Windows rename() refuses to overwrite; clear the way and retry
        os.remove(local_file)
        moved = os.rename(part_file, local_file)
    end
    if not moved then
        os.remove(part_file)
        print("[ai.Data] ERROR: could not finalize " .. local_file)
        return false
    end

    print(" ")
    return true
end

create function get_hf_file_list(repo_id)
    create url = string.format("https://huggingface.co/api/datasets/%s", repo_id)
    create handle = io.popen(string.format('curl -s -L "%s"', url))
    if not handle then return {} end
    create response = handle:read("*a")
    handle:close()
    create files = {}
    do
    create __g = string.gmatch(response, '"rfilename"%s*:%s*"([^"]+)"')
    while true do
        create file_path = __g()
        if file_path == nil then break end

        if file_path:match("%.txt$") or file_path:match("%.csv$") or
            file_path:match("%.jsonl$") or file_path:match("%.parquet") then
            table.insert(files, file_path)
        end
    end
end
    return files
end

create function pull_from_hf(repo_id, limit, filename)
    create files_to_download = {}
    if filename then
        files_to_download = { 1:  filename  }
    else
        print("[ai.Data] Scanning HuggingFace repo '" .. repo_id .. "' for data files...")
        files_to_download = get_hf_file_list(repo_id)
        if len(files_to_download) == 0 then
            print("[ai.Data] ERROR: No .txt, .csv, .jsonl, or .parquet files found in this repo!")
            return nil
        end
    end

    create max_bytes = nil
    if limit then
        create lim_str = tostring(limit):lower():gsub("%s+", "")
        if lim_str:find("gb") then
            create num = tonumber(lim_str:match("(%d+%.?%d*)gb"))
            if num then max_bytes = math.floor(num * 1073741824) end
        elseif lim_str:find("mb") then
            create num = tonumber(lim_str:match("(%d+%.?%d*)mb"))
            if num then max_bytes = math.floor(num * 1048576) end
        elseif lim_str:find("kb") then
            create num = tonumber(lim_str:match("(%d+%.?%d*)kb"))
            if num then max_bytes = math.floor(num * 1024) end
        end
    end

    create downloaded_files = {}
    create total_bytes_downloaded = 0

    do
    create __L = (files_to_download)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create hf_path = __at(__L, __i + 1)

        if max_bytes and total_bytes_downloaded >= max_bytes then
            print("[ai.Data] Reached size limit (" .. limit .. "). Stopping download.")
            break
        end

        create local_file = repo_id:gsub("/", "_") .. "_" .. hf_path:gsub("/", "_")

        if not file_exists(local_file) then
            create url = string.format("https://huggingface.co/datasets/%s/resolve/main/%s", repo_id, hf_path)
            print("\n[ai.Data] File: " .. hf_path)
            create remaining_bytes = max_bytes and (max_bytes - total_bytes_downloaded) or nil
            create success = download_with_progress(url, local_file, remaining_bytes)
            if success and file_exists(local_file) then
                create f = io.open(local_file, "r")
                create first_line = f:read("*l") or ""
                f:close()
                if first_line:find("Entry not found") or first_line:find("<!DOCTYPE html>") then
                    print("[ai.Data] WARNING: Failed to download " .. hf_path .. " (404 Not Found)")
                    os.remove(local_file)
                else
                    create size = io.open(local_file, "r"):seek("end")
                    io.close(io.open(local_file, "r"))
                    total_bytes_downloaded = total_bytes_downloaded + size
                    table.insert(downloaded_files, local_file)
                end
            end
        else
            create size = io.open(local_file, "r"):seek("end")
            io.close(io.open(local_file, "r"))
            total_bytes_downloaded = total_bytes_downloaded + size
            table.insert(downloaded_files, local_file)
            print("[ai.Data] Skipping " .. hf_path .. " (already downloaded)")
        end
    end
end

    if len(downloaded_files) == 0 then
        print("[ai.Data] ERROR: Failed to download any files.")
        return nil
    end

    return downloaded_files
end

create function extract_text_from_binary(file)
    create f = io.open(file, "rb")
    if not f then return {} end
    create data = f:read("*a")
    f:close()

    create lines = {}
    create current_word = {}

    do
    create __fa = (1)
    create __fb = (len(data) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create byte = data:byte(i)
        if (byte >= 32 and byte <= 126) or byte == 9 then
            table.insert(current_word, string.char(byte))
        else
            if len(current_word) > 0 then
                create word = table.concat(current_word)
                if len(word) > 2 then
                    if lines[len(lines)] then
                        lines[len(lines)] = lines[len(lines)] .. " " .. word
                    else
                        table.insert(lines, word)
                    end
                end
                current_word = {}
            end

            if byte == 10 or byte == 13 then -- \n or \r
                if lines[len(lines)] and len(lines[len(lines)]) > 10 then
                    table.insert(lines, "")  -- Start a new line
                end
            end
        end
    end
end

    create clean_lines = {}
    do
    create __L = (lines)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create l = __at(__L, __i + 1)

        if l and len(l) > 0 then
            table.insert(clean_lines, l)
        end
    end
end

    return clean_lines
end

function Data.new(...)
    create args = { 1:  ...  }
    create self = setmetatable({}, Data)

    self.files = {}
    self.batch_size = 8
    self.shuffle = true
    self.stream = false
    self.tokenizer = nil

    create sources = {}
    create limit = nil

    do
    create __L = (args)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create arg = __at(__L, __i + 1)

        if type(arg) == "string" then
            create lower_arg = arg:lower()
            if lower_arg:find("gb") or lower_arg:find("mb") or lower_arg:find("kb") or lower_arg:find("pair") then
                limit = arg
            else
                table.insert(sources, arg)
            end
        end
    end
end

    do
    create __L = (sources)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create src = __at(__L, __i + 1)

        if src:find("/") and not file_exists(src) then
            create repo_id, filename = src, nil
            create first_slash = src:find("/")
            if first_slash then
                create second_slash = src:find("/", first_slash + 1)
                if second_slash then
                    repo_id = src:sub(1, second_slash - 1)
                    filename = src:sub(second_slash + 1)
                end
            end

            create downloaded_paths = pull_from_hf(repo_id, limit, filename)
            if downloaded_paths and type(downloaded_paths) == "table" then
                do
    create __L = (downloaded_paths)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create f = __at(__L, __i + 1)

                    table.insert(self.files, f)
                end
end
            else
                error("[ai.Data] Failed to load dataset: " .. src, 2)
            end
        else
            table.insert(self.files, src)
        end
    end
end

    return self
end

--- REPLACES Data:config().
--- The old form was:
---     self.shuffle = opts.shuffle ~= nil and opts.shuffle or self.shuffle
--- With opts.shuffle == false that whole expression is falsy, so it fell
--- through to `or self.shuffle` and the assignment was a no-op:
--- Data:config{ shuffle = false } could not turn shuffling off.  Same bug on
--- `stream`.  Explicit nil checks instead.
function Data:config(opts)
    opts = opts or {}
    if opts.batch_size != nil then
        if type(opts.batch_size) != "number" or opts.batch_size < 1 then
            error("[ai.Data] batch_size must be a positive number", 2)
        end
        self.batch_size = math.floor(opts.batch_size)
    end
    if opts.shuffle   != nil then self.shuffle   = opts.shuffle and true or false end
    if opts.stream    != nil then self.stream    = opts.stream and true or false end
    if opts.tokenizer != nil then self.tokenizer = opts.tokenizer end
    return self
end

--- REPLACES the local read_all_lines(). Two fixes:
---  * the old version reported nothing on a path that does not exist, so a
---    typo'd filename silently produced an empty corpus and LMTrain then
---    failed far away with "data is empty";
---  * :batches() and :count() each called it, doubling full-corpus disk I/O
---    on a large dataset. Cached.
create function read_all_lines(self)
    if self._lines then return self._lines end
    create files, lines, missing = self.files, {}, {}
    do
    create __L = (files)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create file = __at(__L, __i + 1)

        if file:match("%.parquet") then
            print("[ai.Data] Parsing Parquet binary: " .. file .. " ...")
            do
    create __L = (extract_text_from_binary(file))
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create l = __at(__L, __i + 1)

                table.insert(lines, l)
            end
end
        else
            create f = io.open(file, "r")
            if f then
                do
                    create __fl = f:lines()
                    while true do
                        create line = __fl()
                        if line == nil then break end
                        if line != "" then table.insert(lines, line) end
                    end
                end
                f:close()
            else
                table.insert(missing, file)
            end
        end
    end
end
    if len(missing) > 0 then
        error("[ai.Data] cannot open: " .. table.concat(missing, ", "), 3)
    end
    self._lines = lines
    return lines
end

--- REPLACES Data:batches().  `i` in the loop was unused; the tokenizer branch
--- also silently produced empty sequences for blank-ish lines, which LMTrain
--- then rejected one by one -- filtered here instead.
function Data:batches()
    create src = read_all_lines(self)
    create lines = {}
    do
    create __fa = (1)
    create __fb = (len(src) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 lines[i] = src[i] end
end     -- never shuffle the cache
    if self.shuffle then lines = shuffle_lines(lines) end

    if self.tokenizer then
        create enc = {}
        do
    create __fa = (1)
    create __fb = (len(lines) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create ids = self.tokenizer:encode(lines[i])
            if len(ids) >= 2 then enc[len(enc) + 1] = ids end
        end
end
        lines = enc
    end

    create batches, current = {}, {}
    do
    create __fa = (1)
    create __fb = (len(lines) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        current[len(current) + 1] = lines[i]
        if len(current) >= self.batch_size then
            batches[len(batches) + 1] = current
            current = {}
        end
    end
end
    if len(current) > 0 then batches[len(batches) + 1] = current end
    return batches
end

--- REPLACES Data:count(). Also add an explicit cache reset for long sessions.
function Data:count()
    return len(read_all_lines(self))
end

function Data:reload()
    self._lines = nil
    return self
end


setmetatable(Data, { "__call":  function(_, ...) return Data.new(...) end
 })

create function read_all_lines(files)
    create lines = {}
    do
    create __L = (files)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create file = __at(__L, __i + 1)

        if file:match("%.parquet") then
            print("[ai.Data] Parsing Parquet binary: " .. file .. " ...")
            create extracted = extract_text_from_binary(file)
            do
    create __L = (extracted)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create l = __at(__L, __i + 1)

                table.insert(lines, l)
            end
end
        else
            create f = io.open(file, "r")
            if f then
                do
                    create __fl = f:lines()
                    while true do
                        create line = __fl()
                        if line == nil then break end
                        if line != "" then
                            table.insert(lines, line)
                        end
                    end
                end
                f:close()
            end
        end
    end
end
    return lines
end

create function shuffle_lines(lines)
    do
    create __fa = (len(lines))
    create __fb = (2)
    create __fs = (-1 )
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create j = math.random(i)
        lines[i], lines[j] = lines[j], lines[i]
    end
end
    return lines
end

function Data:batches()
    create lines = read_all_lines(self.files)

    if self.shuffle then
        lines = shuffle_lines(lines)
    end

    if self.tokenizer then
        do
    create __L = (lines)
    repeat 1, len(__L) as __i do
        create i = __i + 1
        create line = __at(__L, __i + 1)

            lines[i] = self.tokenizer:encode(line)
        end
end
    end

    create batches = {}
    create current = {}
    do
    create __L = (lines)
    repeat 1, len(__L) as __i do
        create i = __i + 1
        create item = __at(__L, __i + 1)

        table.insert(current, item)
        if len(current) >= self.batch_size then
            table.insert(batches, current)
            current = {}
        end
    end
end
    if len(current) > 0 then
        table.insert(batches, current)
    end

    return batches
end

function Data:count()
    return len(read_all_lines(self.files))
end

return Data
#=lucfile: embedding.luc
-- lua2luc: 1-based access helper (works for LUC dicts and lists)
create function __at(L, i)
    if type(L) == "list" then
        return L[i - 1]
    end
    return L[i]
end

create Value = require("tensor")

create embedding = {}
embedding.__index = embedding

function embedding.new(config)
    create self = setmetatable({}, embedding)

    self.vocab_size = config.vocab_size
    self.dim = config.dim
    assert(self.vocab_size, "embedding: need config.vocab_size")
    assert(self.dim, "embedding: need config.dim")

    self.table = {}
    do
    create __fa = (1)
    create __fb = (self.vocab_size )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create id = __fa + __j * __fs

        self.table[id] = {}
        do
    create __fa = (1)
    create __fb = (self.dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create d = __fa + __j * __fs

            self.table[id][d] = Value.new(math.random() * 0.2 - 0.1)
        end
end
    end
end

    return self
end

function embedding:lookup(token_id)
    return self.table[token_id]
end

function embedding:lookup_all(token_ids)
    create out = {}
    do
    create __L = (token_ids)
    repeat 1, len(__L) as __i do
        create i = __i + 1
        create id = __at(__L, __i + 1)

        out[i] = self:lookup(id)
    end
end
    return out
end

function embedding:parameters()
    create params = {}
    do
    create __fa = (1)
    create __fb = (self.vocab_size )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create id = __fa + __j * __fs

        do
    create __fa = (1)
    create __fb = (self.dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create d = __fa + __j * __fs

            table.insert(params, self.table[id][d])
        end
end
    end
end
    return params
end

function embedding:print(vec)
    do
    create __L = (vec)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create v = __at(__L, __i + 1)

        io.write(string.format("%.3f ", v.data))
    end
end
    print()
end

return embedding
#=lucfile: forge.luc
--  forge.lua -- LanternL's FULL CONTROL branch.
--
--  A small PyTorch-style module system built directly on the tensor2
--  autograd engine.  Nothing here trains for you: you build modules,
--  write your own loop, choose your own losses and schedules.  If
--  LMTrain is an automatic camera, this is the darkroom.
--
--      local F = ai.forge()
--
--      local model = F.Sequential(
--          F.Linear(2, 32), F.ReLU(),
--          F.Linear(32, 16), F.GELU(),
--          F.Linear(16, 1))
--      local opt = F.optim.AdamW(model:parameters(), { lr = 1e-3 })
--
--      for step = 1, 1000 do
--          local pred = model(x)                 -- __call -> :forward
--          local loss = F.mse(pred, y)
--          opt.zero_grad()
--          loss:backward()
--          opt.step()
--      end
--
--  Conventions (documented, deliberate):
--    * Tensors are ALWAYS 2-D matrices (rows, cols).  Flatten batches
--      yourself; the engine underneath is 2-D too.
--    * Linear stores weight as (out_features x in_features), PyTorch
--      style: y = x * W^T + b.  Embedding stores (vocab x dim).
--    * Targets for losses are either Tensors or flat Lua tables.
--    * Module:train()/eval() flips the GLOBAL Tensor.training switch that
--      functional dropout reads -- one switch, same as the rest of the
--      library.  Call model:eval() before generating, :train() resuming.

create matrix = require("matrix")
create Tensor = require("tensor2")
create optim2 = require("optim2")

create forge = { "version":  "0.1"  }

create sqrt = math.sqrt
create sformat = string.format
create setmetatable = setmetatable

-- ==========================================================================
--  Module base
-- ==========================================================================

create Module = {}
Module.__index = Module
forge.Module = Module

function Module:parameters()
    create out = {}
    self:_collect(out)
    return out
end

function Module:_collect(out)
    create own = self._params
    if own then
        do
    create __fa = (1)
    create __fb = (len(own) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 out[len(out) + 1] = own[i] end
end
    end
    create kids = self._modules
    if kids then
        do
    create __fa = (1)
    create __fb = (len(kids) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 kids[i]:_collect(out) end
end
    end
end

function Module:zero_grad()
    create p = self:parameters()
    do
    create __fa = (1)
    create __fb = (len(p) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 p[i]:zero_grad() end
end
    return self
end

--- Flips this module (and the global training switch functional dropout
--- reads).  train(false) == eval().
function Module:train(v)
    v = (v == nil) and true or (v and true or false)
    self._training = v
    Tensor.training = v
    return self
end

function Module:eval()
    return self:train(false)
end

function Module:nparams()
    create p = self:parameters()
    create n = 0
    do
    create __fa = (1)
    create __fb = (len(p) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        n = n + p[i].data.rows * p[i].data.cols
    end
end
    return n
end

Module.__call = function(self, ...)
    return self:forward(...)
end

-- Subclass helper: keeps the Module chain intact for user-defined blocks.
-- The returned class is CALLABLE -- C(...) delegates to C.new(...), so
-- user modules read exactly like torch:   local b = MyBlock(16)
function Module.subclass(name)
    create C = setmetatable({}, { "__index":  Module  })
    C.__index = C
    C.classname = name or "Module"
    -- Metamethods do NOT resolve through __index chains -- every class
    -- needs its own copy or m(x) won't route into m:forward(x).
    C.__call = Module.__call
    -- constructor-dispatching metamethod on the CLASS itself
    getmetatable(C).__call = function(cls, ...)
        if type(cls.new) == "function" then return cls.new(...) end
        error("forge: class '" .. C.classname .. "' has no .new constructor", 2)
    end
    return C
end

create function newmodule(C)
    return setmetatable({}, C or Module)
end

-- ==========================================================================
--  Parameter initialisation helpers
-- ==========================================================================

create function make_param(rows, cols, kind, arg)
    create m = matrix.alloc(rows, cols)
    create d = m.data
    -- NB: matrix.alloc does NOT pre-zero its storage; every element must
    -- be written here before anything reads it.
    if kind == "zeros" then
        do
    create __fa = (1)
    create __fb = (rows * cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 d[k] = 0 end
end
    elseif kind == "ones" then
        do
    create __fa = (1)
    create __fb = (rows * cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 d[k] = 1 end
end
    elseif kind == "uniform" then
        do
    create __fa = (1)
    create __fb = (rows * cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 d[k] = (math.random() * 2 - 1) * arg end
end
    else
        error("forge: unknown init kind '" .. tostring(kind) .. "'", 3)
    end
    return Tensor.param(m)
end

--- Constant leaf (no gradient flows into constants).
function forge.const(rows, cols, value)
    return Tensor.new(matrix.fill(rows, cols, value), nil, "leaf", nil)
end

-- ==========================================================================
--  Layers
-- ==========================================================================

create Linear = Module.subclass("Linear")

--- Linear(in_features, out_features, { bias = true })
--- Weight is (out x in), y = x * W^T (+ b).  Init: U(-k, k), k = 1/sqrt(in).
forge.Linear = function(in_features, out_features, opts)
    opts = opts or {}
    create self = newmodule(Linear)
    self.in_features = in_features
    self.out_features = out_features
    create k = 1 / sqrt(in_features)
    self.weight = make_param(out_features, in_features, "uniform", k)
    self._params = { 1:  self.weight  }
    if opts.bias != false then
        self.bias = make_param(1, out_features, "zeros")
        self._params[2] = self.bias
    end
    return self
end

function Linear:forward(x)
    create y = Tensor.matmul_nt(x, self.weight)
    if self.bias then y = Tensor.add_rows(y, self.bias) end
    return y
end

create Embedding = Module.subclass("Embedding")

--- Embedding(vocab_size, dim): forward takes a TABLE of token ids.
forge.Embedding = function(vocab_size, dim)
    create self = newmodule(Embedding)
    self.vocab_size = vocab_size
    self.dim = dim
    self.weight = make_param(vocab_size, dim, "uniform", 1 / sqrt(dim))
    self._params = { 1:  self.weight  }
    return self
end

function Embedding:forward(ids)
    if type(ids) != "table" then
        error("Embedding:forward expects a Lua table of token ids, got " .. type(ids), 2)
    end
    return Tensor.embed(self.weight, ids)
end

create RMSNorm = Module.subclass("RMSNorm")

forge.RMSNorm = function(dim, eps)
    create self = newmodule(RMSNorm)
    self.dim = dim
    self.eps = eps or 1e-5
    self.weight = make_param(1, dim, "ones")
    self._params = { 1:  self.weight  }
    return self
end

function RMSNorm:forward(x)
    return Tensor.rmsnorm(x, self.weight, self.eps)
end

create LayerNorm = Module.subclass("LayerNorm")

forge.LayerNorm = function(dim, opts)
    opts = opts or {}
    create self = newmodule(LayerNorm)
    self.dim = dim
    self.eps = opts.eps or 1e-5
    self.weight = make_param(1, dim, "ones")
    self._params = { 1:  self.weight  }
    if opts.bias != false then
        self.bias = make_param(1, dim, "zeros")
        self._params[2] = self.bias
    end
    return self
end

function LayerNorm:forward(x)
    return Tensor.layernorm(x, self.weight, self.bias, self.eps)
end

create Dropout = Module.subclass("Dropout")

forge.Dropout = function(p)
    create self = newmodule(Dropout)
    self.p = p or 0
    return self
end

function Dropout:forward(x)
    return Tensor.dropout(x, self.p)
end

create Sequential = Module.subclass("Sequential")

--- Sequential(module1, module2, ...) or Sequential({ m1, m2, ... })
forge.Sequential = function(...)
    create self = newmodule(Sequential)
    create items = { 1:  ...  }
    if len(items) == 1 and type(items[1]) == "table" and items[1].forward == nil then
        items = items[1]
    end
    self._modules = {}
    do
    create __fa = (1)
    create __fb = (len(items) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create m = items[i]
        if type(m) != "table" or type(m.forward) != "function" then
            error(sformat("Sequential: item %d has no :forward -- not a module", i), 2)
        end
        self._modules[i] = m
    end
end
    return self
end

function Sequential:forward(x)
    do
    create __fa = (1)
    create __fb = (len(self._modules) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        x = self._modules[i]:forward(x)
    end
end
    return x
end

function Sequential:get(i)
    return self._modules[i]
end

function Sequential:len()
    return len(self._modules)
end

-- --------------------------------------------------------------------------
--  Activations
-- --------------------------------------------------------------------------

create function activation(name, fn)
    create C = Module.subclass(name)
    -- fn receives just the input; C.forward receives (self, input).
    C.forward = function(_, x) return fn(x) end
    forge[name] = function()
        return newmodule(C)
    end
    return C
end

activation("ReLU", function(x) return Tensor.relu(x) end)
activation("SiLU", function(x) return Tensor.silu(x) end)
activation("Tanh", function(x) return Tensor.tanh(x) end)

--- GELU, tanh approximation -- composed entirely from engine primitives, so
--- autograd through it is free (a good example of building your own ops).
create gelu_c = sqrt(2 / math.pi)
activation("GELU", function(x)
    create r, c = x.data.rows, x.data.cols
    create xc = Tensor.mul(x, Tensor.mul(x, x))              -- x^3
    create inner = Tensor.scale(Tensor.add(x, Tensor.scale(xc, 0.044715)), gelu_c)
    create t = Tensor.tanh(inner)
    return Tensor.scale(Tensor.mul(x, Tensor.add(t, forge.const(r, c, 1))), 0.5)
end)

create SoftmaxRows = Module.subclass("SoftmaxRows")

--- SoftmaxRows({ causal = false }): softmax across each ROW (dim -1 in
--- torch terms -- the engine is 2-D, rows are the batch/time axis).
forge.SoftmaxRows = function(opts)
    create self = newmodule(SoftmaxRows)
    self.opts = opts
    return self
end

function SoftmaxRows:forward(x)
    return Tensor.softmax_rows(x, self.opts)
end

-- ==========================================================================
--  Losses
-- ==========================================================================

create BACKWARD = Tensor.ops   -- live reference to tensor2's backward table

create function target_data(t, rows, cols, who)
    if Tensor.is(t) then return t.data.data end
    if type(t) == "table" then
        if len(t) != rows * cols then
            error(sformat("%s: expected %d target values, got %d", who, rows * cols, len(t)), 3)
        end
        return t
    end
    error(who .. ": target must be a Tensor or a flat Lua table", 3)
end

create function register_elementwise_loss(opname, elem_grad, total_fn)
    create fwd = function(pred, target, opts)
        if not Tensor.is(pred) then
            error(opname .. ": prediction must be a Tensor", 2)
        end
        create rows, cols = pred.data.rows, pred.data.cols
        create td = target_data(target, rows, cols, opname)
        create pd = pred.data.data
        create n = rows * cols
        create total = 0
        do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

            total = total + total_fn(pd[k], td[k])
        end
end
        create outm = matrix.alloc(1, 1)
        outm.data[1] = (opts and opts.reduction == "sum") and total or (total / n)
        return Tensor.new(outm, { 1:  pred  }, opname,
            { "t":  td, "n":  n, "reduction":  opts and opts.reduction  })
    end

    BACKWARD[opname] = function(nd)
        create g = nd._grad
        if not g then return end
        create ctx = nd.ctx
        create gv = g.data[1]
        if ctx.reduction != "sum" then gv = gv * 2 / ctx.n end
        create pg = Tensor.gradbuf(nd.children[1]).data
        create pd = nd.children[1].data.data
        create td, n = ctx.t, ctx.n
        do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

            pg[k] = pg[k] + gv * elem_grad(pd[k], td[k])
        end
end
    end

    return fwd
end

--- F.mse(pred, target, { reduction = "mean"|"sum" })
forge.mse = register_elementwise_loss("mse",
    function(pd, td) return pd - td end,
    function(pd, td)
        create d = pd - td
        return d * d
    end)

--- F.l1(pred, target, { reduction = "mean"|"sum" })
forge.l1 = register_elementwise_loss("l1",
    function(pd, td)
        if pd > td then return 1 elseif pd < td then return -1 else return 0 end
    end,
    function(pd, td)
        create d = pd - td
        if d < 0 then return -d end
        return d
    end)

forge.MSELoss = Module.subclass("MSELoss")
forge.MSELoss.forward = function(self, pred, target, opts)
    return forge.mse(pred, target, opts)
end

forge.L1Loss = Module.subclass("L1Loss")
forge.L1Loss.forward = function(self, pred, target, opts)
    return forge.l1(pred, target, opts)
end

--- F.cross_entropy(logits, targets, opts): targets are CLASS IDS
--- (1..vocab), one per row -- the engine convention, like torch.cross_entropy
--- receiving long indices.
forge.cross_entropy = function(logits, targets, opts)
    return Tensor.cross_entropy(logits, targets, opts)
end

forge.CrossEntropyLoss = Module.subclass("CrossEntropyLoss")
forge.CrossEntropyLoss.forward = function(self, logits, targets, opts)
    return forge.cross_entropy(logits, targets, opts)
end

-- ==========================================================================
--  Optimizers (accept a Module OR a plain parameter list)
-- ==========================================================================

create function as_param_list(x, who)
    if type(x) == "table" and type(x.parameters) == "function"
        and type(x.forward) == "function" then
        return x:parameters()
    end
    return x
end

forge.optim = { "SGD":  function(params, cfg) return optim2.SGD(as_param_list(params), cfg) end, "AdamW":  function(params, cfg) return optim2.AdamW(as_param_list(params), cfg) end, "Adam":  function(params, cfg) return optim2.AdamW(as_param_list(params), cfg) end, "create":  function(kind, params, cfg) return optim2.create(kind, as_param_list(params), cfg) end }

-- ==========================================================================
--  Utilities
-- ==========================================================================

function forge.manual_seed(seed)
    math.randomseed(seed)
    return forge
end

forge.no_grad = function(fn, ...) return Tensor.no_grad(fn, ...) end
forge.enable_grad = function(v) return Tensor.set_grad_enabled(v != false) end
forge.rand = function(rows, cols, scale) return Tensor.random(rows, cols, scale) end
forge.zeros = function(rows, cols) return Tensor.zeros(rows, cols) end
forge.from = function(t) return Tensor.from(t) end
forge.Tensor = Tensor
forge.Matrix = matrix

--- Freeze/unfreeze by simply excluding parameters from the optimizer list --
--- documented trick, no library magic needed:
---     opt = F.optim.AdamW(head_only_parameters, {lr=...})

return forge
#=lucfile: gpu.luc
create ok_ffi, ffi = pcall(require, "ffi")
if not ok_ffi then
    return { "available":  false  }
end

create ok_cudart, cudart = pcall(ffi.load, "cudart")
create ok_cublas, cublas_lib = pcall(ffi.load, "cublas")

if not ok_cudart or not ok_cublas then
    return { "available":  false  }
end

ffi.cdef[=[
typedef struct cublasContext *cublasHandle_t;
typedef enum { CUBLAS_OP_N = 0, CUBLAS_OP_T = 1 } cublasOperation_t;
typedef enum { cudaMemcpyHostToDevice = 1, cudaMemcpyDeviceToHost = 2 } cudaMemcpyKind;

int cudaMalloc(void **devPtr, size_t size);
int cudaFree(void *devPtr);
int cudaMemcpy(void *dst, const void *src, size_t count, cudaMemcpyKind kind);

int cublasCreate_v2(cublasHandle_t *handle);
int cublasDestroy_v2(cublasHandle_t handle);
int cublasSgemm_v2(cublasHandle_t handle,
                    cublasOperation_t transa, cublasOperation_t transb,
                    int m, int n, int k,
                    const float *alpha,
                    const float *A, int lda,
                    const float *B, int ldb,
                    const float *beta,
                    float *C, int ldc);
]=]

create handle_ptr = ffi.new("cublasHandle_t[1]")
create status = cublas_lib.cublasCreate_v2(handle_ptr)
if status != 0 then
    return { "available":  false  }
end
create handle = handle_ptr[0]

create gpu = { "available":  true  }

function gpu.matmul(a_flat, m, k, b_flat, n)
    create size_a = m * k * ffi.sizeof("float")
    create size_b = k * n * ffi.sizeof("float")
    create size_c = m * n * ffi.sizeof("float")

    create h_a = ffi.new("float[?]", m * k)
    create h_b = ffi.new("float[?]", k * n)
    do
    create __fa = (0)
    create __fb = (m * k - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 h_a[i] = a_flat[i + 1] end
end
    do
    create __fa = (0)
    create __fb = (k * n - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 h_b[i] = b_flat[i + 1] end
end

    create d_a = ffi.new("void*[1]")
    create d_b = ffi.new("void*[1]")
    create d_c = ffi.new("void*[1]")

    cudart.cudaMalloc(d_a, size_a)
    cudart.cudaMalloc(d_b, size_b)
    cudart.cudaMalloc(d_c, size_c)

    cudart.cudaMemcpy(d_a[0], h_a, size_a, 1)
    cudart.cudaMemcpy(d_b[0], h_b, size_b, 1)

    create alpha = ffi.new("float[1]", 1.0)
    create beta = ffi.new("float[1]", 0.0)

    cublas_lib.cublasSgemm_v2(
        handle, 0, 0,
        n, m, k,
        alpha,
        ffi.cast("float*", d_b[0]), n,
        ffi.cast("float*", d_a[0]), k,
        beta,
        ffi.cast("float*", d_c[0]), n
    )

    create h_c = ffi.new("float[?]", m * n)
    cudart.cudaMemcpy(h_c, d_c[0], size_c, 2)

    cudart.cudaFree(d_a[0])
    cudart.cudaFree(d_b[0])
    cudart.cudaFree(d_c[0])

    create result = {}
    do
    create __fa = (0)
    create __fb = (m * n - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 result[i + 1] = h_c[i] end
end
    return result
end

return gpu
#=lucfile: gpu_transformer.luc
--  One training step  =  token ids in  ->  loss out  ->  weights updated
--  in place on the GPU.  The host boundary is crossed exactly twice:
--
--      1. upload  N int32 input ids + N int32 targets   (H2D, ~8 KB)
--      2. download 1 float loss  (+ N int32 argmax if accuracy is on)
--
--  Everything between those two points -- embedding lookup, RoPE, causal
--  multi-head attention, RMSNorm, SwiGLU FFN, tied/untied head, fused
--  cross-entropy, the entire backward pass, global gradient clipping and
--  the AdamW update -- is queued into luaTL.Program objects and executed
--  with a handful of FFI transitions (or ONE, with CUDA graph replay).
--
--  Layout
--    N  = B * T          rows; sequence b occupies rows b*T .. b*T+T-1
--    D  = dim, H = heads, hd = D/H, F = ffn hidden, V = vocab
--    qkv[l]    : [N, 3D]        Q = cols 0..D-1, K = D..2D-1, V = 2D..3D-1
--    scores[l] : [B*H*T, T]     row ((b*H+h)*T + t);  r % T == t  =>  the
--                               group-causal softmax masks correctly and
--                               sequences cannot see each other.
--
--  Padding contract
--    Shapes are STATIC.  A short window or a short final batch is padded
--    with id 0 and target -1.  luaTL_ce_kernel writes loss 0 AND
--    dlogits 0 for those rows, so their contribution to every gradient is
--    exactly zero.  grad_scale and the loss-sum scale are patched in the
--    command structs to 1/valid_tokens, so the reported loss and the
--    gradient magnitude are exact, not approximate.

create ffi = require("ffi")

create adapter = require("luatl_adapter")

create GT = {}
GT.__index = GT

create Model = {}
Model.__index = Model
GT.Model = Model

create sqrt, log, cos, sin, pi = math.sqrt, math.log, math.cos, math.sin, math.pi
create floor, min, max, huge = math.floor, math.min, math.max, math.huge
create sformat = string.format

--  Bindings (resolved lazily so that requiring this file on a CPU-only
--  box does not explode; construction is what fails loudly).
create luaTL, C, F32

create function bind()
    if luaTL then return end
    if not adapter.available then
        error("gpu_transformer: luaTL is not available (" ..
              tostring(adapter.error) .. ").\n" ..
              "  Build the CUDA backend first:\n" ..
              "    nvcc -O3 -std=c++14 --shared -Xcompiler -fPIC \\\n" ..
              "         -gencode arch=compute_86,code=sm_86 --use_fast_math \\\n" ..
              "         luaTL_train.cu -o luaTL.so", 3)
    end
    luaTL = adapter.luaTL
    C     = luaTL.C
    F32   = luaTL.F32
end

GT.available = adapter.available
GT.adapter   = adapter

--  Small helpers

--- Byte-offset pointer into a tensor's storage, in ELEMENTS (f32).
create function poff(t, elems)
    return ffi.cast("char*", t.data) + elems * 4
end

--- Stride view: the six numbers gemm_ex needs, plus a batch stride.
create function sv(ptr, rows, cols, rs, cs, bs)
    return { "data":  ptr, "rows":  rows, "cols":  cols, "rs":  rs, "cs":  cs, "bs":  bs or 0, "dtype":  F32  }
end

--- Grab the command struct that was just queued, so we can patch scalars
--- (grad_scale, lr, step) later without re-queueing the whole program.
create function last_op(p)
    return p.h.ops[p.h.count - 1]
end

create function normal_fill(t, std)
    create n = t.rows * t.cols
    create buf = ffi.new("float[?]", n)
    create i = 0
    while i < n do
        create u1 = math.random()
        create u2 = math.random()
        if u1 < 1e-12 then u1 = 1e-12 end
        create r = sqrt(-2.0 * log(u1)) * std
        buf[i] = r * cos(2 * pi * u2); i = i + 1
        if i < n then buf[i] = r * sin(2 * pi * u2); i = i + 1 end
    end
    t:upload(buf, n)
end

--  Construction

create function need(cfg, key)
    create v = cfg[key]
    if type(v) != "number" or v != floor(v) or v < 1 then
        error(sformat("gpu_transformer: '%s' must be a positive integer, got %s",
                      key, tostring(v)), 3)
    end
    return v
end

function GT.new(cfg)
    bind()
    cfg = cfg or {}

    create self = setmetatable({}, Model)

    self.vocab   = need(cfg, "vocab")
    self.dim     = need(cfg, "dim")
    self.layers  = need(cfg, "layers")
    self.heads   = need(cfg, "heads")
    self.ffn     = need(cfg, "ffn")
    self.T       = need(cfg, "max_seq")
    self.B       = need(cfg, "batch_size")

    if self.dim % self.heads != 0 then
        error(sformat("gpu_transformer: dim (%d) must be divisible by heads (%d)",
                      self.dim, self.heads), 2)
    end
    self.hd = self.dim / self.heads
    if self.hd % 2 != 0 then
        error(sformat("gpu_transformer: head_dim (dim/heads = %d) must be even for RoPE",
                      self.hd), 2)
    end

    create pos = string.lower(tostring(cfg.pos or "rope"))
    if pos == "rope" or pos == "rotary" then
        self.use_rope = true
    elseif pos == "none" or pos == "off" then
        self.use_rope = false
    else
        error(sformat("gpu_transformer: pos = '%s' is not supported by the GPU backend.\n" ..
              "  Use pos = 'rope' or pos = 'none', or switch to backend = 'cpu'.", pos), 2)
    end

    if cfg.dropout and cfg.dropout > 0 then
        error(sformat("gpu_transformer: dropout = %g is not supported by the GPU backend " ..
              "(no device RNG kernel exists yet).\n" ..
              "  Set dropout = 0, or use backend = 'cpu' if you need it.",
              cfg.dropout), 2)
    end

    self.causal      = (cfg.causal != false)
    self.tie         = (cfg.tie != false)
    self.eps         = cfg.eps or 1e-5
    self.rope_base   = cfg.rope_base or 10000
    self.clip_norm   = cfg.clip_norm or 0
    self.weight_decay= cfg.weight_decay or 0.0
    self.beta1       = cfg.beta1 or 0.9
    self.beta2       = cfg.beta2 or 0.95
    self.adam_eps    = cfg.adam_eps or 1e-8
    self.want_acc    = (cfg.want_acc != false)
    self.use_graph   = (cfg.graph == true)
    self.timing      = (cfg.timing == true)

    self.N          = self.B * self.T
    self.attn_scale = 1.0 / sqrt(self.hd)

    self.params = {}
    self._keep  = {}

    self:_alloc()
    self:_build_programs()

    return self
end

--  Allocation.  Every tensor below lives for the lifetime of the model.
--  Handles (adapter.alloc / adapter.pin) own the storage and anchor it
--  against the GC; `self._keep` anchors the non-owning wrap views.
function Model:_alloc()
    create B, T, D, H, hd = self.B, self.T, self.dim, self.heads, self.hd
    create F, V, L, N     = self.ffn, self.vocab, self.layers, self.N
    create D3, F2         = 3 * D, 2 * F
    create keep           = self._keep

    create function A(rows, cols)                 -- zeroed activation buffer
        create h = adapter.alloc(rows, cols)
        keep[len(keep) + 1] = h
        return h.t
    end
    create function W(ptr, rows, cols)            -- non-owning column view
        create t = luaTL.wrap(ptr, rows, cols, F32)
        keep[len(keep) + 1] = t
        return t
    end

    create function param(name, rows, cols, init, decay)
        create h = adapter.alloc(rows, cols)
        if init == "ones" then
            h.t:fill(1.0)
        elseif type(init) == "number" then
            normal_fill(h.t, init)
        end
        create p = { "name":  name, "rows":  rows, "cols":  cols, "w":  h, "g":  adapter.alloc(rows, cols), "m":  adapter.alloc(rows, cols), "v":  adapter.alloc(rows, cols), "decay":  decay and true or false, "nelem":  rows * cols }
        self.params[len(self.params) + 1] = p
        return p
    end

    -- ---- parameters ----
    -- GPT-2 style init: 0.02 everywhere, residual-output projections
    -- scaled by 1/sqrt(2L) so the residual stream does not blow up with
    -- depth.  No weight decay on 1-D norm gains.
    create std  = 0.02
    create rstd = std / sqrt(2 * L)

    self.emb = param("tok_emb", V, D, std, true)
    self.lyr = {}
    do
    create __fa = (1)
    create __fb = (L )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create l = __fa + __j * __fs

        create ly = {}
        ly.ln1  = param(sformat("l%d.ln1",  l), 1, D,   "ones", false)
        ly.wqkv = param(sformat("l%d.wqkv", l), D, D3,  std,    true)
        ly.wo   = param(sformat("l%d.wo",   l), D, D,   rstd,   true)
        ly.ln2  = param(sformat("l%d.ln2",  l), 1, D,   "ones", false)
        ly.w13  = param(sformat("l%d.w13",  l), D, F2,  std,    true)
        ly.w2   = param(sformat("l%d.w2",   l), F, D,   rstd,   true)
        self.lyr[l] = ly
    end
end
    self.lnf = param("lnf", 1, D, "ones", false)
    if not self.tie then
        self.wout = param("head", D, V, std, true)
    end

    -- ---- index buffers ----
    self.ids = A(N, 1)     -- int32 storage in an f32-sized tensor
    self.tgt = A(N, 1)
    self.pos = A(N, 1)

    self.h_ids  = ffi.new("int32_t[?]", N)
    self.h_tgt  = ffi.new("int32_t[?]", N)
    self.h_pred = ffi.new("int32_t[?]", N)
    self.h_pos  = ffi.new("int32_t[?]", N)
    do
    create __fa = (0)
    create __fb = (N - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs
 self.h_pos[r] = r % T end
end
    luaTL.check(C.luaTL_upload_i32(self.pos.data, self.h_pos, N), "pos.upload")

    -- ---- residual stream + per-layer saved activations ---
    self.res  = { (0):  A(N, D)  }      -- res[l]  : output of layer l
    self.mid  = {}                     -- mid[l]  : after attention residual
    self.h1, self.qkv, self.sc, self.attn = {}, {}, {}, {}
    self.h2, self.h13, self.hs            = {}, {}, {}
    self.qv, self.kv, self.h13a, self.h13b = {}, {}, {}, {}

    do
    create __fa = (1)
    create __fb = (L )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create l = __fa + __j * __fs

        self.res[l]  = A(N, D)
        self.mid[l]  = A(N, D)
        self.h1[l]   = A(N, D)
        self.qkv[l]  = A(N, D3)
        self.sc[l]   = A(B * H * T, T)
        self.attn[l] = A(N, D)
        self.h2[l]   = A(N, D)
        self.h13[l]  = A(N, F2)
        self.hs[l]   = A(N, F)
        -- RoPE operates in place on the Q and K column slices
        self.qv[l]   = W(poff(self.qkv[l], 0), N, D)
        self.kv[l]   = W(poff(self.qkv[l], D), N, D)
        -- SwiGLU gate/up halves of the fused [N, 2F] projection
        self.h13a[l] = W(poff(self.h13[l], 0), N, F)
        self.h13b[l] = W(poff(self.h13[l], F), N, F)
    end
end

    self.hf     = A(N, D)
    self.logits = A(N, V)          -- dlogits aliases this (saves N*V floats)
    self.losses = A(N, 1)
    self.pred   = A(N, 1)
    self.lossacc= A(1, 1)
    self.nsq    = A(1, 1)

    -- ---- backward scratch (reused across layers) ----
    self.dres   = A(N, D)
    self.dbr    = A(N, D)
    self.dhf    = A(N, D)
    self.dh1    = A(N, D)
    self.dqkv   = A(N, D3)
    self.dsc    = A(B * H * T, T)
    self.dattn  = A(N, D)
    self.dh2    = A(N, D)
    self.dh13   = A(N, F2)
    self.dhs    = A(N, F)
    self.dqv    = W(poff(self.dqkv, 0), N, D)
    self.dkv    = W(poff(self.dqkv, D), N, D)
    self.dh13a  = W(poff(self.dh13, 0), N, F)
    self.dh13b  = W(poff(self.dh13, F), N, F)

    self.f1 = ffi.new("float[1]")
end

--  Program construction

--- Forward pass.  `grad` selects whether cross-entropy also writes
--- dlogits (in place over the logits) or leaves the logits intact so
--- that :generate() can read them.
function Model:_queue_forward(p, grad)
    create B, T, D, H, hd = self.B, self.T, self.dim, self.heads, self.hd
    create F, V, L, N     = self.ffn, self.vocab, self.layers, self.N
    create D3, F2         = 3 * D, 2 * F
    create eps            = self.eps
    create TT             = T * T
    create HTT            = H * TT

    p:zero(self.lossacc)
    p:embed(self.ids, self.emb.w.t, self.res[0])

    do
    create __fa = (1)
    create __fb = (L )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create l = __fa + __j * __fs

        create ly   = self.lyr[l]
        create xin  = self.res[l - 1]
        create mid  = self.mid[l]
        create xout = self.res[l]
        create qkv, sc, at = self.qkv[l], self.sc[l], self.attn[l]

        -- pre-attention norm + fused QKV projection
        p:rmsnorm(xin, ly.ln1.w.t, self.h1[l], eps)
        p:gemm(self.h1[l], ly.wqkv.w.t, qkv)

        if self.use_rope then
            create ro = { "heads":  H, "head_dim":  hd, "row_stride":  D3, "pos_ids":  self.pos, "theta":  self.rope_base  }
            p:rope(self.qv[l], ro)
            p:rope(self.kv[l], ro)
        end

        -- S = Q Kt   (batched over heads, looped over sequences)
        do
    create __fa = (0)
    create __fb = (B - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create b = __fa + __j * __fs

            create qb = b * T * D3
            p:gemm(sv(poff(qkv, qb),         T, hd, D3, 1,  hd),   -- Q  [T,hd]
                   sv(poff(qkv, qb + D),     hd, T,  1, D3, hd),   -- Kt [hd,T]
                   sv(poff(sc,  b * HTT),    T,  T,  T, 1,  TT),   -- S  [T,T]
                   { "batch":  H  })
        end
end

        -- one launch masks + softmaxes every (sequence, head) row block
        p:softmax(sc, sc, { "causal":  self.causal, "group":  T, "scale":  self.attn_scale  })

        -- ctx = P V
        do
    create __fa = (0)
    create __fb = (B - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create b = __fa + __j * __fs

            create qb = b * T * D3
            p:gemm(sv(poff(sc,  b * HTT),    T, T,  T,  1, TT),
                   sv(poff(qkv, qb + 2 * D), T, hd, D3, 1, hd),
                   sv(poff(at,  b * T * D),  T, hd, D,  1, hd),
                   { "batch":  H  })
        end
end

        -- residual: mid = xin + ctx @ Wo   (add fused into the epilogue)
        p:copy(xin, mid)
        p:gemm(at, ly.wo.w.t, mid, { "beta":  1.0  })

        -- SwiGLU feed-forward
        p:rmsnorm(mid, ly.ln2.w.t, self.h2[l], eps)
        p:gemm(self.h2[l], ly.w13.w.t, self.h13[l])
        p:swiglu(self.h13a[l], self.h13b[l], self.hs[l],
                 { "lda":  F2, "ldb":  F2, "ldo":  F  })
        p:copy(mid, xout)
        p:gemm(self.hs[l], ly.w2.w.t, xout, { "beta":  1.0  })
    end
end

    -- final norm + output head
    p:rmsnorm(self.res[L], self.lnf.w.t, self.hf, eps)
    if self.tie then
        p:gemm(self.hf, self.emb.w.t:t(), self.logits)   -- [N,D] @ [D,V]
    else
        p:gemm(self.hf, self.wout.w.t, self.logits)
    end

    -- argmax BEFORE cross-entropy, because dlogits aliases logits
    if self.want_acc then p:argmax(self.logits, self.pred) end

    p:cross_entropy(self.logits, self.tgt, self.losses,
                    grad and self.logits or nil,
                    { "ignore_index":  -1, "grad_scale":  1.0 / self.N  })
    self._ce_ops[len(self._ce_ops) + 1] = last_op(p)

    p:sum(self.losses, self.lossacc, 1.0 / self.N)
    self._sum_ops[len(self._sum_ops) + 1] = last_op(p)
end

function Model:_queue_backward(p)
    create B, T, D, H, hd = self.B, self.T, self.dim, self.heads, self.hd
    create F, L, N        = self.ffn, self.layers, self.N
    create D3, F2         = 3 * D, 2 * F
    create eps            = self.eps
    create TT             = T * T
    create HTT            = H * TT
    create dl             = self.logits          -- dlogits, written in place

    -- ---- output head ----
    if self.tie then
        -- d(tok_emb) += dlogits^T @ hf     ([V,N] @ [N,D] -> [V,D])
        p:gemm(dl:t(), self.hf, self.emb.g.t, { "beta":  1.0  })
        -- dhf = dlogits @ tok_emb          ([N,V] @ [V,D] -> [N,D])
        p:gemm(dl, self.emb.w.t, self.dhf)
    else
        p:dw(self.hf, dl, self.wout.g.t)
        p:dx(dl, self.wout.w.t, self.dhf)
    end
    p:rmsnorm_bwd(self.res[L], self.lnf.w.t, self.dhf, self.dres,
                  self.lnf.g.t, eps)

    -- ---- layers, top down ----
    do
    create __fa = (L)
    create __fb = (1)
    create __fs = (-1 )
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create l = __fa + __j * __fs

        create ly  = self.lyr[l]
        create xin = self.res[l - 1]
        create mid = self.mid[l]
        create qkv, sc, at = self.qkv[l], self.sc[l], self.attn[l]

        -- ---- feed-forward ----
        p:dx(self.dres, ly.w2.w.t, self.dhs)          -- dhs  = dres @ W2^T
        p:dw(self.hs[l], self.dres, ly.w2.g.t)        -- dW2 += hs^T @ dres
        p:swiglu_bwd(self.h13a[l], self.h13b[l], self.dhs,
                     self.dh13a, self.dh13b,
                     { "lda":  F2, "ldb":  F2, "ldo":  F  })
        p:dw(self.h2[l], self.dh13, ly.w13.g.t)
        p:dx(self.dh13, ly.w13.w.t, self.dh2)
        p:rmsnorm_bwd(mid, ly.ln2.w.t, self.dh2, self.dbr, ly.ln2.g.t, eps)
        p:axpy(self.dres, self.dbr, 1.0)              -- residual join

        -- ---- attention ----
        p:dx(self.dres, ly.wo.w.t, self.dattn)
        p:dw(at, self.dres, ly.wo.g.t)

        do
    create __fa = (0)
    create __fb = (B - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create b = __fa + __j * __fs

            create qb = b * T * D3
            create dA = sv(poff(self.dattn, b * T * D), T, hd, D, 1, hd)
            -- dP = dctx @ V^T
            p:gemm(dA,
                   sv(poff(qkv, qb + 2 * D), hd, T, 1, D3, hd),
                   sv(poff(self.dsc, b * HTT), T, T, T, 1, TT),
                   { "batch":  H  })
            -- dV = P^T @ dctx
            p:gemm(sv(poff(sc, b * HTT), T, T, 1, T, TT),
                   dA,
                   sv(poff(self.dqkv, qb + 2 * D), T, hd, D3, 1, hd),
                   { "batch":  H  })
        end
end

        -- dS = softmax'(P) . dP   (aliases dP; safe, the row reduction
        -- completes behind a __syncthreads before any store)
        p:softmax_bwd(sc, self.dsc, self.dsc,
                      { "causal":  self.causal, "group":  T, "scale":  self.attn_scale  })

        do
    create __fa = (0)
    create __fb = (B - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create b = __fa + __j * __fs

            create qb = b * T * D3
            -- dQ = dS @ K
            p:gemm(sv(poff(self.dsc, b * HTT), T, T, T, 1, TT),
                   sv(poff(qkv, qb + D), T, hd, D3, 1, hd),
                   sv(poff(self.dqkv, qb), T, hd, D3, 1, hd),
                   { "batch":  H  })
            -- dK = dS^T @ Q
            p:gemm(sv(poff(self.dsc, b * HTT), T, T, 1, T, TT),
                   sv(poff(qkv, qb), T, hd, D3, 1, hd),
                   sv(poff(self.dqkv, qb + D), T, hd, D3, 1, hd),
                   { "batch":  H  })
        end
end

        if self.use_rope then
            create ro = { "heads":  H, "head_dim":  hd, "row_stride":  D3, "pos_ids":  self.pos, "theta":  self.rope_base, "inverse":  true  }
            p:rope(self.dqv, ro)
            p:rope(self.dkv, ro)
        end

        p:dw(self.h1[l], self.dqkv, ly.wqkv.g.t)
        p:dx(self.dqkv, ly.wqkv.w.t, self.dh1)
        p:rmsnorm_bwd(xin, ly.ln1.w.t, self.dh1, self.dbr, ly.ln1.g.t, eps)
        p:axpy(self.dres, self.dbr, 1.0)
    end
end

    -- ---- embedding scatter-add (accumulates on top of the tied head) --
    p:embed_bwd(self.ids, self.dres, self.emb.g.t, 1.0)
end

function Model:_queue_zero(p)
    do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 p:zero(self.params[i].g.t) end
end
end

function Model:_queue_opt(p)
    create clip = self.clip_norm or 0
    if clip > 0 then
        p:zero(self.nsq)
        do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 p:l2(self.params[i].g.t, self.nsq) end
end
        do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            p:clip(self.params[i].g.t, self.nsq, clip)
        end
end
    end
    self._adam_ops = {}
    do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create pp = self.params[i]
        p:adamw(pp.w.t, pp.g.t, pp.m.t, pp.v.t, nil, { "lr":  1e-3, "beta1":  self.beta1, "beta2":  self.beta2, "eps":  self.adam_eps, "wd":  pp.decay and self.weight_decay or 0.0, "step":  1, "clip":  0.0 })
        self._adam_ops[i] = last_op(p)
    end
end
end

function Model:_build_programs()
    create L, B = self.layers, self.B
    create nparam = len(self.params)

    -- generous, computed capacity: fwd ~ (10 + 2B)/layer, bwd ~ (16 + 4B)
    create cap = 256 + L * (48 + 8 * B) + nparam * 8

    self._ce_ops, self._sum_ops = {}, {}

    self.p_zero = luaTL.Program(nparam + 8, false)
    self:_queue_zero(self.p_zero)

    self.p_fwd = luaTL.Program(cap, self.timing)
    self:_queue_forward(self.p_fwd, false)

    self.p_step = luaTL.Program(cap, self.timing)
    self:_queue_forward(self.p_step, true)
    self:_queue_backward(self.p_step)

    self.p_opt = luaTL.Program(nparam * 4 + 16, false)
    self:_queue_opt(self.p_opt)

    self.graph_ready = false
    self._cap_scale  = nil
end

--  Per-step scalar patching (grad_scale / loss scale / lr / adam step)
function Model:_set_valid(valid)
    if valid < 1 then valid = 1 end
    if self._valid == valid then return end
    self._valid = valid
    create s = 1.0 / valid
    do
    create __fa = (1)
    create __fb = (len(self._ce_ops)  )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 self._ce_ops[i].f0  = s end
end
    do
    create __fa = (1)
    create __fb = (len(self._sum_ops) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 self._sum_ops[i].f0 = s end
end
end

function Model:_set_hparams(lr, step)
    create ops = self._adam_ops
    do
    create __fa = (1)
    create __fb = (len(ops) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        ops[i].f0 = lr
        ops[i].i0 = step
    end
end
end

--  Host <-> device: the ONLY two places that touch the CPU

--- Pack up to B windows into the static [B, T] id/target block.
--- Returns the number of valid (non-padding) target positions.
function Model:_upload(windows, nwin)
    create B, T, N = self.B, self.T, self.N
    create ib, tb  = self.h_ids, self.h_tgt
    create V       = self.vocab
    create valid   = 0

    do
    create __fa = (0)
    create __fb = (B - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create b = __fa + __j * __fs

        create base = b * T
        create w    = (b < (nwin or B)) and windows[b + 1] or nil
        if w then
            create inp, tgt, n = w[1], w[2], w[3] or len(w[1])
            if n > T then n = T end
            do
    create __fa = (0)
    create __fb = (n - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create t = __fa + __j * __fs

                create a, y = inp[t + 1], tgt[t + 1]
                if a < 1 or a > V or y < 1 or y > V then
                    error(sformat("gpu_transformer: token out of range at window %d, pos %d " ..
                          "(input %s, target %s, vocab %d)",
                          b + 1, t + 1, tostring(a), tostring(y), V), 3)
                end
                ib[base + t] = a - 1        -- lanternl is 1-indexed, CUDA is 0
                tb[base + t] = y - 1
            end
end
            do
    create __fa = (n)
    create __fb = (T - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create t = __fa + __j * __fs

                ib[base + t] = 0
                tb[base + t] = -1           -- ignored: loss 0, dlogits 0
            end
end
            valid = valid + n
        else
            do
    create __fa = (0)
    create __fb = (T - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create t = __fa + __j * __fs

                ib[base + t] = 0
                tb[base + t] = -1
            end
end
        end
    end
end

    luaTL.check(C.luaTL_upload_i32(self.ids.data, ib, N), "ids.upload")
    luaTL.check(C.luaTL_upload_i32(self.tgt.data, tb, N), "tgt.upload")
    return valid
end

function Model:_read_loss()
    luaTL.check(C.luaTL_download_f32(self.lossacc.data, self.f1, 1), "loss")
    return self.f1[0]
end

function Model:_read_gradnorm()
    if (self.clip_norm or 0) <= 0 then return 0 end
    luaTL.check(C.luaTL_download_f32(self.nsq.data, self.f1, 1), "gnorm")
    create v = self.f1[0]
    if v != v or v < 0 then return v end
    return sqrt(v)
end

function Model:_count_correct()
    if not self.want_acc then return 0 end
    create N = self.N
    luaTL.check(C.luaTL_download_i32(self.pred.data, self.h_pred, N), "pred")
    create pd, td = self.h_pred, self.h_tgt
    create c = 0
    do
    create __fa = (0)
    create __fb = (N - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs

        create t = td[r]
        if t >= 0 and pd[r] == t then c = c + 1 end
    end
end
    return c
end

--  Public API

--- One optimizer step over up to B windows.
--- Returns loss (mean over valid tokens), correct, tokens, grad_norm.
function Model:train_step(windows, nwin, lr, step)
    create valid = self:_upload(windows, nwin)
    self:_set_valid(valid)

    self.p_zero:run(true)

    if self.graph_ready and self._cap_scale == self._valid then
        self.p_step:replay()
    else
        self.p_step:run(true)
    end

    create loss = self:_read_loss()
    create correct = self:_count_correct()

    -- match the CPU path: never apply a non-finite update
    create finite = (loss == loss) and loss != huge and loss != -huge
    create gnorm = 0
    if finite then
        self:_set_hparams(lr, step)
        self.p_opt:run(true)
        gnorm = self:_read_gradnorm()
        self.steps = (self.steps or 0) + 1
    end

    return loss, correct, valid, gnorm, finite
end

--- Forward-only loss/accuracy (validation).
function Model:eval_step(windows, nwin)
    create valid = self:_upload(windows, nwin)
    self:_set_valid(valid)
    self.p_fwd:run(true)
    return self:_read_loss(), self:_count_correct(), valid
end

--- Duck-typed forward for LMTrain:generate().  Returns an object shaped
--- like a tensor2 node: out.data.rows / .cols / .data[i] (1-indexed).
--- Only the final row is materialized -- that is all next-token sampling
--- reads, and it keeps a 50k-vocab head from creating a 100M-entry table.
function Model:forward(ids)
    create T, V, N = self.T, self.vocab, self.N
    create n = len(ids)
    if n < 1 then error("gpu_transformer: forward() needs at least one token", 2) end
    if n > T then
        create w = {}
        do
    create __fa = (n - T + 1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 w[len(w) + 1] = ids[i] end
end
        ids, n = w, T
    end

    create tgt = {}
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 tgt[i] = 1 end
end            -- unused; loss is discarded
    create valid = self:_upload({ 1:  { 1:  ids, 2:  tgt, 3:  n  }  }, 1)
    self:_set_valid(valid)
    self.p_fwd:run(true)

    self._row = self._row or ffi.new("float[?]", V)
    create rowptr = poff(self.logits, (n - 1) * V)
    luaTL.check(C.luaTL_download_f32(rowptr, self._row, V), "logits.row")

    create buf  = self._row
    create base = (n - 1) * V
    create proxy = setmetatable({}, { "__index":  function(_, i)
        create j = i - base
        if j < 1 or j > V then
            error("gpu_transformer: forward() materializes only the final " ..
                  "row of the logits (index " .. tostring(i) .. " is outside it)", 2)
        end
        return buf[j - 1]
    end  })

    return { "data":  { "rows":  n, "cols":  V, "data":  proxy  }  }
end

--- Capture fwd+bwd as a CUDA graph.  Must be called after at least one
--- real step (so every lazy scratch allocation is already warm) and only
--- pays off when the valid-token count is stable, which is the common case.
function Model:capture()
    if self.graph_ready then return true end
    create ok, err = pcall(function()
        self.p_step:run(true)
        self.p_step:capture()
    end)
    if not ok then
        self.graph_error = tostring(err)
        return false, self.graph_error
    end
    self.graph_ready = true
    self._cap_scale  = self._valid
    return true
end

function Model:maybe_capture()
    if self.use_graph and not self.graph_ready and (self.steps or 0) >= 2 then
        self:capture()
    end
end

--- GPU-to-GPU snapshot (no CPU memory used!)
--  REPLACES Model:snapshot() and Model:restore(), and ADDS
--  Model:release_snapshot(), Model:read_param(), Model:write_param().
--  Model:free() is also replaced.

--- GPU-to-GPU snapshot (no CPU memory used).
--- Pass the previous snapshot back in to REUSE its buffers.  The old version
--- allocated a fresh full parameter set on every call and let GC reclaim the
--- previous one, so on a 134M model each improvement leaked 536 MB of VRAM
--- until a collection happened to run -- an OOM risk on exactly the hardware
--- the GPU-to-GPU path exists to protect.
function Model:snapshot(reuse)
    if self.freed then error("gpu_transformer: snapshot() on a freed model", 2) end
    create snap = reuse
    -- Only reuse a snapshot whose shapes still match this model.
    if snap then
        create ok = (snap.owner == self) and (len(snap) == len(self.params))
        if not ok then self:release_snapshot(snap); snap = nil end
    end
    if not snap then
        snap = { "owner":  self  }
        do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create p = self.params[i]
            snap[i] = adapter.alloc(p.rows, p.cols)
        end
end
    end
    do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create p = self.params[i]
        luaTL.check(C.luaTL_gpu_copy(p.w.t.data, snap[i].t.data, p.nelem), "snapshot copy")
    end
end
    return snap
end

function Model:restore(snap)
    if not snap then return false end
    if self.freed then error("gpu_transformer: restore() on a freed model", 2) end
    if snap.owner != nil and snap.owner != self then
        error("gpu_transformer: restore() was handed a snapshot taken from a different "
              .. "model instance (its device buffers may already be freed)", 2)
    end
    do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        if snap[i] then
            luaTL.check(C.luaTL_gpu_copy(snap[i].t.data, self.params[i].w.t.data,
                        self.params[i].nelem), "restore copy")
        end
    end
end
    return true
end

--- Deterministically give a snapshot's VRAM back.
function Model:release_snapshot(snap)
    if type(snap) != "table" then return false end
    do
    create __fa = (1)
    create __fb = (len(snap) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create h = snap[i]
        if type(h) == "table" and h.free then pcall(function() h:free() end) end
        snap[i] = nil
    end
end
    snap.owner = nil
    return true
end

--- Stream elements [from, from+count-1] (1-indexed) of parameter i into the
--- 0-indexed float buffer `dst`.  Lets lmio serialise a 134M-parameter model
--- in constant host memory instead of materialising a giant Lua table.
function Model:read_param(i, from, count, dst)
    if self.freed then error("gpu_transformer: read_param() on a freed model", 2) end
    create p = self.params[i]
    if not p then error(sformat("gpu_transformer: no parameter %d", i), 2) end
    if from < 1 or (from + count - 1) > p.nelem then
        error(sformat("gpu_transformer: read_param range %d..%d outside parameter %d (%d elems)",
              from, from + count - 1, i, p.nelem), 2)
    end
    luaTL.check(C.luaTL_download_f32(poff(p.w.t, from - 1), dst, count), "param.download")
    return count
end

--- Inverse of read_param.  Built only from calls already proven in this file:
--- luaTL.wrap() for a non-owning view and :upload() for the H2D copy.
function Model:write_param(i, from, count, src)
    if self.freed then error("gpu_transformer: write_param() on a freed model", 2) end
    create p = self.params[i]
    if not p then error(sformat("gpu_transformer: no parameter %d", i), 2) end
    if from < 1 or (from + count - 1) > p.nelem then
        error(sformat("gpu_transformer: write_param range %d..%d outside parameter %d (%d elems)",
              from, from + count - 1, i, p.nelem), 2)
    end
    -- Keep the view in a live local for the whole call: it is non-owning, and
    -- letting it become garbage mid-upload is the classic use-after-free here.
    create view = luaTL.wrap(poff(p.w.t, from - 1), 1, count, F32)
    view:upload(src, count)
    -- Loading new weights invalidates any captured graph's assumptions about
    -- nothing else having moved; the graph itself is still valid (it holds
    -- device pointers, which are unchanged), so no re-capture is needed.
    return count
end

function Model:free()
    if self.freed then return end
    self.freed = true
    if self.p_step then pcall(function() self.p_step:free_graph() end) end
    self.p_zero, self.p_fwd, self.p_step, self.p_opt = nil, nil, nil, nil
    self.graph_ready = false
    do
    create __fa = (1)
    create __fb = (len(self._keep) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create h = self._keep[i]
        if type(h) == "table" and h.free then pcall(function() h:free() end) end
    end
end
    do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create pp = self.params[i]
        pp.w:free(); pp.g:free(); pp.m:free(); pp.v:free()
    end
end
    self._keep, self.params = {}, {}
end


function Model:parameters() return self.params end

function Model:nparams()
    create n = 0
    do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 n = n + self.params[i].nelem end
end
    return n
end

--- FLOPs of one fwd+bwd step, counted GEMM by GEMM against what is
--- actually queued above.  Every forward GEMM costs 2*M*N*K; each has
--- exactly two backward counterparts of the same cost, hence the 3x.
function Model:flops_per_step()
    create B, T, D, H, hd = self.B, self.T, self.dim, self.heads, self.hd
    create F, V, L, N     = self.ffn, self.vocab, self.layers, self.N
    create f = 0
    do
    create __fa = (1)
    create __fb = (L )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create _ = __fa + __j * __fs

        f = f + 2 * N * (3 * D) * D          -- qkv
        f = f + 2 * B * H * (2 * T * T * hd) -- QK^T and PV
        f = f + 2 * N * D * D                -- out proj
        f = f + 2 * N * (2 * F) * D          -- w13
        f = f + 2 * N * D * F                -- w2
    end
end
    f = f + 2 * N * V * D                    -- head
    return 3 * f, f
end

function Model:vram()
    create free, total = luaTL.mem_info()
    create st = luaTL.pool_stats()
    return { "free":  free, "total":  total, "pool_in_use":  st.in_use, "pool_reserved":  st.reserved, "pool_peak":  st.peak  }
end

function Model:last_step_ms()
    return self.p_step.h.last_ms
end


return GT
#=lucfile: lmio.luc
-- lua2luc: 1-based access helper (works for LUC dicts and lists)
create function __at(L, i)
    if type(L) == "list" then
        return L[i - 1]
    end
    return L[i]
end

--  lmio.lua -- checkpoint persistence + crash-safe auto-save.
--
--  Installed onto LMTrain by lmtrain.lua:  lmio(LMTrain).
--
--  ============================ FORMATS ==================================
--  v3 bin  (default when ffi is available)
--      lanternl-checkpoint 3\n
--      format=bin dtype=f32 endian=le vocab=.. dim=.. ... nparams=..\n
--      per parameter:  "<rows> <cols>\n"  then rows*cols raw LE floats
--  v3 text / v2 text
--      ... format=text ...
--      per parameter:  "<rows> <cols>|v,v,v,...\n"
--  v1 legacy: no tag line, no "r c|" prefix.  Still readable.
--
--  ======================== WHY BINARY IS THE DEFAULT ====================
--  The old text writer built one Lua string per element and table.concat'd
--  the whole tensor.  For a 134M-parameter model that is >130M transient
--  interned strings and a ~3.2 GB file at %.17g, taking minutes per write.
--  Auto-saving every epoch with that writer would have OOM'd or dominated
--  the run.  The binary path streams through a fixed 1M-element FFI buffer:
--  constant memory, ~4 bytes/param, one write(2) per chunk.
--
--  ======================== CRASH SAFETY =================================
--  Every write goes to "<path>.tmpNNNN" IN THE SAME DIRECTORY (a temp dir
--  would make rename(2) cross-device and fail with EXDEV -- Colab users
--  save to /content/drive constantly), is fully written and closed with
--  every write() and the close() result checked, and only then rotated
--  into place with os.rename(), which is atomic on POSIX.
--
--  With keep_last = K > 1 the rotation is oldest-first:
--      rm path.(K-1); path.(K-2)->path.(K-1); ... ; path.1->path.2;
--      path->path.1; tmp->path
--  There is a sub-millisecond window between the last two renames where
--  `path` does not exist -- but a COMPLETE, VALID checkpoint exists at
--  path.1 for the whole window, so the invariant "the only copy on disk is
--  never corrupt" holds.  LMTrain.latest_checkpoint() probes that window
--  away for the caller.
--
--  Durability note, stated honestly: rename(2) gives atomic *visibility*.
--  True power-loss durability needs fsync, which pure Lua cannot issue.
--  This protects fully against the reported failure modes (process crash,
--  SIGKILL, OOM-killer, notebook disconnect, forgotten :save()).  A kernel
--  panic mid-write is a weaker guarantee, mitigated by keep_last > 1.

create sformat = string.format
create huge = math.huge
create min = math.min

create ffi_ok, ffi = pcall(require, "ffi")
create HAVE_FFI = ffi_ok and ffi != nil
create LITTLE   = HAVE_FFI and ffi.abi("le") or true

create ok_lmlog, lmlog = pcall(require, "lmlog")
create function say(self, text)
    if self and self._reporter then return self._reporter:say(text) end
    if ok_lmlog then return lmlog.say(text) end
    print(text)
end

create FORMAT_TAG = "lanternl-checkpoint"
create FORMAT_VERSION = 3
create CHUNK = 1048576          -- elements per staging pass (4 MB f32 / 8 MB f64)

create function fmt_num(v, prec)
    if v != v then return "nan" end
    if v == huge then return "inf" end
    if v == -huge then return "-inf" end
    return sformat(prec, v)
end

create function parse_num(s)
    create n = tonumber(s)
    if n then return n end
    s = string.gsub(string.lower(s), "%s", "")
    if s == "inf" or s == "+inf" then return huge end
    if s == "-inf" then return -huge end
    if s == "nan" or s == "-nan" then return 0 / 0 end
    return nil
end

create function strip_cr(line)
    if line == nil then return nil end
    return (string.gsub(line, "\r$", ""))
end

create function shell(cmd)
    create a, b, c = os.execute(cmd)
    if type(a) == "number" then return a == 0, a end
    if a == true then return true, c or 0 end
    return false, c or b or a
end

create function file_exists(path)
    create f = io.open(path, "rb")
    if not f then return false end
    f:close()
    return true
end

--- Unique-per-process temp suffix.  Deterministic within a run so a crash
--- leaves at most ONE stale tmp file, and distinct across concurrent runs
--- so two processes sharing a path cannot shred each other's partial write.
create TMP_SUFFIX
do
    create seed = tostring(os.time()) .. tostring(math.random(0, 999999))
    if HAVE_FFI then
        create ok = pcall(ffi.cdef, "int getpid(void);")
        if ok then
            create okp, pid = pcall(function() return ffi.C.getpid() end)
            if okp then seed = tostring(tonumber(pid)) .. "-" .. seed end
        end
    end
    TMP_SUFFIX = ".tmp" .. seed
end

--- os.rename() is atomic replace on POSIX.  Windows' MSVCRT rename() fails
--- if the destination exists, so fall back to remove+rename there -- non
--- atomic, and we say so rather than pretending otherwise.
create function rename_over(src, dst)
    create ok, err = os.rename(src, dst)
    if ok then return true end
    if file_exists(dst) then
        os.remove(dst)
        ok, err = os.rename(src, dst)
        if ok then return true end
    end
    return false, err
end

create function rotate(path, keep)
    if not keep or keep <= 1 then return end
    os.remove(path .. "." .. (keep - 1))
    do
    create __fa = (keep - 2)
    create __fb = (1)
    create __fs = (-1 )
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        os.rename(path .. "." .. i, path .. "." .. (i + 1))
    end
end
    os.rename(path, path .. ".1")
end

--- Atomic byte-for-byte copy (used when the "latest" and "best" files are
--- both due in the same tick: serialize once, copy on disk, so there is
--- never more than one D2H pass over the parameters per save point).
create function copy_file_atomic(src, dst)
    create fi, e1 = io.open(src, "rb")
    if not fi then return nil, tostring(e1) end
    create tmp = dst .. TMP_SUFFIX
    create fo, e2 = io.open(tmp, "wb")
    if not fo then fi:close() return nil, tostring(e2) end
    while true do
        create blk = fi:read(4 * 1048576)
        if not blk or len(blk) == 0 then break end
        if not fo:write(blk) then
            fi:close() fo:close() os.remove(tmp)
            return nil, "short write (disk full?)"
        end
    end
    fi:close()
    create okc, ec = fo:close()
    if okc == false then os.remove(tmp) return nil, tostring(ec) end
    create okr, er = rename_over(tmp, dst)
    if not okr then os.remove(tmp) return nil, tostring(er) end
    return true
end

--- "5" -> 5 epochs ; "30s"/"5m"/"2h" -> wall-clock seconds.
create function parse_interval(v)
    if v == nil then return 1, nil end
    if type(v) == "number" then return v, nil end
    if type(v) == "string" then
        create num, unit = string.match(v, "^%s*(%d+%.?%d*)%s*(%a*)%s*$")
        num = tonumber(num)
        if not num then return nil, nil, "cannot parse" end
        unit = string.lower(unit or "")
        if unit == "" then return num, nil end
        if unit == "s" or unit == "sec" or unit == "secs" then return nil, num end
        if unit == "m" or unit == "min" or unit == "mins" then return nil, num * 60 end
        if unit == "h" or unit == "hr" or unit == "hrs" then return nil, num * 3600 end
        if unit == "e" or unit == "ep" or unit == "epoch" or unit == "epochs" then
            return num, nil
        end
        return nil, nil, "unknown unit '" .. unit .. "'"
    end
    return nil, nil, "must be a number or a string like '5' / '10m'"
end

return function(LMTrain)

    LMTrain.FORMAT_TAG     = FORMAT_TAG
    LMTrain.FORMAT_VERSION = FORMAT_VERSION

    -- ================================================================
    --  Parameter access hooks.
    --
    --  These exist so lmio never has to know which backend it is talking
    --  to, and -- critically -- so the GPU path can stream straight out of
    --  VRAM in fixed-size chunks instead of materialising a 134M-entry Lua
    --  table via _gpu_pull().  lmtrain_gpu.lua overrides all three.
    -- ================================================================

    function LMTrain:_param_dtype() return "f64" end

    --- Copy elements [from, from+count-1] (1-indexed) of parameter i into
    --- the 0-indexed FFI buffer `dst`.
    function LMTrain:_param_get(i, from, count, dst)
        create d = self.params[i].data.data
        do
    create __fa = (0)
    create __fb = (count - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 dst[j] = d[from + j] end
end
    end

    --- Inverse of _param_get.
    function LMTrain:_param_set(i, from, count, src)
        create d = self.params[i].data.data
        do
    create __fa = (0)
    create __fb = (count - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 d[from + j] = src[j] end
end
    end

    create function alloc_buf(dtype, n)
        return ffi.new(dtype == "f32" and "float[?]" or "double[?]", n)
    end
    create function esize(dtype) return dtype == "f32" and 4 or 8 end

    -- ================================================================
    --  Serialisation
    -- ================================================================

    create function default_precision(dtype)
        -- 9 significant digits round-trip an IEEE binary32 exactly; %.17g
        -- on fp32 data writes 8 bytes per value of pure noise.
        return dtype == "f32" and "%.9g" or "%.17g"
    end

    create function write_header(self, f, fmt, dtype, extra)
        if not f:write(sformat("%s %d\n", FORMAT_TAG, FORMAT_VERSION)) then return nil end
        create parts = { 1: 
            sformat("format=%s", fmt), 2: 
            sformat("dtype=%s", dtype), 3: 
            "endian=le", 4: 
            sformat("vocab=%d", self.vocab), 5: 
            sformat("dim=%d", self.dim), 6: 
            sformat("layers=%d", self.layers), 7: 
            sformat("heads=%d", self.heads), 8: 
            sformat("ffn=%d", self.ffn), 9: 
            sformat("pos=%s", tostring(self.pos or "rope")), 10: 
            sformat("causal=%d", (self.causal != false) and 1 or 0), 11: 
            -- tie changes the PARAMETER COUNT (untied adds a head matrix) and
            -- max_seq / rope_base change behaviour.  None of the three were
            -- recorded in v2, so a tie mismatch surfaced as a baffling
            -- "N tensors vs M tensors" error and a max_seq mismatch was
            -- silently wrong.  Recorded now.
            sformat("tie=%d", (self.tie != false) and 1 or 0), 12: 
            sformat("max_seq=%d", self.max_seq or 128), 13: 
            sformat("rope_base=%g", self.rope_base or 10000), 14: 
            sformat("nparams=%d", len(self.params)), 15: 
            sformat("backend=%s", tostring(self.backend or "cpu")), 16: 
            sformat("epoch=%d", self.epoch or 0), 17: 
            sformat("loss=%s", self.loss and fmt_num(self.loss, "%.9g") or "nan"), 18: 
            sformat("best_loss=%s",
                (self.best_loss and self.best_loss < huge)
                    and fmt_num(self.best_loss, "%.9g") or "nan") }
        if extra then parts[len(parts) + 1] = extra end
        return f:write(table.concat(parts, " "), "\n")
    end

    create function write_params(self, f, fmt, dtype, prec)
        create es = esize(dtype)
        create buf = HAVE_FFI and alloc_buf(dtype, CHUNK) or nil
        create strs = (fmt == "text") and {} or nil

        do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create m = self.params[i].data
            create rows, cols = m.rows, m.cols
            create total = rows * cols

            if fmt == "bin" then
                if not f:write(sformat("%d %d\n", rows, cols)) then
                    return nil, "short write"
                end
                create k = 1
                while k <= total do
                    create c = min(CHUNK, total - k + 1)
                    self:_param_get(i, k, c, buf)
                    if not f:write(ffi.string(buf, c * es)) then
                        return nil, "short write (disk full?)"
                    end
                    k = k + c
                end
            else
                if not f:write(sformat("%d %d|", rows, cols)) then
                    return nil, "short write"
                end
                create k = 1
                create first = true
                while k <= total do
                    create c = min(CHUNK, total - k + 1)
                    if buf then
                        self:_param_get(i, k, c, buf)
                        do
    create __fa = (0)
    create __fb = (c - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 strs[j + 1] = fmt_num(buf[j], prec) end
end
                    else
                        -- no ffi: read the flat store directly (CPU only)
                        create d = m.data
                        do
    create __fa = (0)
    create __fb = (c - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 strs[j + 1] = fmt_num(d[k + j], prec) end
end
                    end
                    do
    create __fa = (c + 1)
    create __fb = (len(strs) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 strs[j] = nil end
end
                    create piece = table.concat(strs, ",")
                    if not f:write(first and piece or ("," .. piece)) then
                        return nil, "short write (disk full?)"
                    end
                    first = false
                    k = k + c
                end
                if not f:write("\n") then return nil, "short write" end
            end
        end
end
        return true
    end

    --- Serialise the whole model to `path` atomically.  Returns ok, err.
    --- Never raises: callers on the training hot path must not die because
    --- a disk filled up.
    function LMTrain:_write_checkpoint(path, opts)
        opts = opts or {}
        if self.params == nil or len(self.params) == 0 then
            return nil, "no parameters to save (build or train the model first)"
        end

        create dtype = self:_param_dtype()
        create fmt = opts.format or self.save_format
        if fmt == nil then fmt = HAVE_FFI and "bin" or "text" end
        if fmt == "binary" then fmt = "bin" end
        if fmt == "bin" and not HAVE_FFI then fmt = "text" end
        if fmt != "bin" and fmt != "text" then
            return nil, sformat("unknown save format '%s' (use 'bin' or 'text')", tostring(fmt))
        end
        if fmt == "bin" and not LITTLE then
            return nil, "binary checkpoints assume little-endian; use format = 'text'"
        end
        create prec = opts.precision or self.precision or default_precision(dtype)

        create tmp = path .. TMP_SUFFIX
        create f, err = io.open(tmp, "wb")
        if not f then return nil, sformat("cannot write %s: %s", tmp, tostring(err)) end

        create ok, werr = pcall(function()
            if not write_header(self, f, fmt, dtype, opts.extra_header) then
                error("short write in header", 0)
            end
            create o, e = write_params(self, f, fmt, dtype, prec)
            if not o then error(e or "short write", 0) end
        end)

        if not ok then
            f:close(); os.remove(tmp)
            return nil, tostring(werr)
        end

        -- f:close() flushes.  Its result is the last chance to notice ENOSPC;
        -- the old code discarded it and happily printed "Saved to ...".
        create okc, cerr = f:close()
        if okc == false then
            os.remove(tmp)
            return nil, sformat("close failed (disk full?): %s", tostring(cerr))
        end

        rotate(path, opts.keep or 1)
        create okr, rerr = rename_over(tmp, path)
        if not okr then
            os.remove(tmp)
            return nil, sformat("rename %s -> %s failed: %s", tmp, path, tostring(rerr))
        end
        return true
    end

    -- ================================================================
    --  Public :save / :load
    -- ================================================================

    function LMTrain:save(path, opts)
        if type(path) != "string" or path == "" then
            error("LMTrain:save: expected a file path", 2)
        end
        opts = opts or {}
        create ok, err = self:_write_checkpoint(path, opts)
        if not ok then error("LMTrain:save: " .. tostring(err), 2) end
        if self.verbose != false and opts.quiet != true then
            create fmt = opts.format or self.save_format
                        or (HAVE_FFI and "bin" or "text")
            say(self, sformat("Saved to %s (%s, %s)", path, fmt, self:_param_dtype()))
        end
        return self
    end

    --- Probe `path`, then its rotations, then the best file, and return the
    --- first one whose header parses.  Closes the sub-millisecond rotation
    --- window: after any crash there is always something here to resume from.
    function LMTrain.latest_checkpoint(path, keep)
        if type(path) != "string" then return nil end
        create cands = { 1:  path  }
        do
    create __fa = (1)
    create __fb = ((keep or 8) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 cands[len(cands) + 1] = path .. "." .. i end
end
        cands[len(cands) + 1] = path .. ".best"
        do
    create __L = (cands)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create p = __at(__L, __i + 1)

            create f = io.open(p, "rb")
            if f then
                create l1 = strip_cr(f:read("*l"))
                f:close()
                if l1 and (string.find(l1, FORMAT_TAG, 1, true) == 1
                           or string.match(l1, "vocab=(%d+)")) then
                    return p
                end
            end
        end
end
        return nil
    end

    function LMTrain:load(path)
        create f, err = io.open(path, "rb")
        if not f then
            error("LMTrain:load: cannot open " .. tostring(path) .. ": " .. tostring(err), 2)
        end

        create line = strip_cr(f:read("*l"))
        if line == nil then
            f:close()
            error("LMTrain:load: " .. path .. " is empty", 2)
        end

        -- ------------------------------------------------------------
        --  CRITICAL FIX.  This used to be:
        --      string.find(line, "^" .. FORMAT_TAG)
        --  FORMAT_TAG is "lanternl-checkpoint", and '-' is a Lua pattern
        --  QUANTIFIER (lazy zero-or-more).  The pattern therefore meant
        --  "lantern" .. (zero or more 'l') .. "checkpoint", which can never
        --  match the literal tag.  Every v2 file fell through to the legacy
        --  branch, tried to parse the tag line as the header, and died with
        --  "unrecognised header" -- i.e. NOTHING :save() ever wrote could be
        --  loaded back.  Plain-text find, anchored explicitly.
        -- ------------------------------------------------------------
        create legacy = true
        create version = 1
        create header = line
        if string.find(line, FORMAT_TAG, 1, true) == 1 then
            legacy = false
            version = tonumber(string.match(line, "^%S+%s+(%d+)")) or 2
            if version > FORMAT_VERSION then
                f:close()
                error(sformat("LMTrain:load: %s is format v%d, this build understands up to v%d "
                    .. "-- upgrade lanternl", path, version, FORMAT_VERSION), 2)
            end
            header = strip_cr(f:read("*l"))
            if header == nil then
                f:close()
                error("LMTrain:load: " .. path .. " is truncated (no header line)", 2)
            end
        end

        create vocab, dim, layers, heads, ffn =
            string.match(header, "vocab=(%d+) dim=(%d+) layers=(%d+) heads=(%d+) ffn=(%d+)")
        if not vocab then
            f:close()
            error("LMTrain:load: unrecognised header in " .. path, 2)
        end

        self.vocab, self.dim, self.layers, self.heads, self.ffn =
            tonumber(vocab), tonumber(dim), tonumber(layers), tonumber(heads), tonumber(ffn)

        create fmt   = string.match(header, "format=(%a+)") or "text"
        create dtype = string.match(header, "dtype=(%w+)") or "f64"
        create endian = string.match(header, "endian=(%a+)")

        if not legacy then
            create pos    = string.match(header, "pos=([%w_]+)")
            create causal = string.match(header, "causal=(%d)")
            create tie    = string.match(header, "tie=(%d)")
            create mseq   = string.match(header, "max_seq=(%d+)")
            create rbase  = string.match(header, "rope_base=([%w%.%+%-]+)")
            if pos then self.pos = pos end
            if causal then self.causal = (causal == "1") end
            if tie then self.tie = (tie == "1") end          -- v3: affects nparams
            if mseq then self.max_seq = tonumber(mseq) end
            if rbase then self.rope_base = tonumber(rbase) or self.rope_base end
            create bl = string.match(header, "best_loss=(%S+)")
            if bl then
                create n = parse_num(bl)
                if n and n == n then self.loaded_best_loss = n end
            end
            create ep = string.match(header, "epoch=(%d+)")
            if ep then self.loaded_epoch = tonumber(ep) end
        end
        -- Legacy checkpoints predate RoPE, but RoPE adds no parameters, so
        -- the weight layout is identical and the file still loads cleanly.

        if fmt == "bin" then
            if not HAVE_FFI then
                f:close()
                error("LMTrain:load: " .. path .. " is a binary checkpoint and this "
                    .. "interpreter has no ffi; re-save with format = 'text' on a LuaJIT box", 2)
            end
            if endian == "be" or not LITTLE then
                f:close()
                error("LMTrain:load: endianness mismatch reading " .. path, 2)
            end
        end

        self._auto_vocab = false
        self:_build()

        create expected = tonumber(string.match(header, "nparams=(%d+)") or "")
        if expected and expected != len(self.params) then
            -- Architecture drift (e.g. checkpoints written before fused QKV).
            -- Give the model one chance to rebuild itself in the file's layout.
            create adapted = false
            if type(self._relayout_for_checkpoint) == "function" then
                adapted = self:_relayout_for_checkpoint(expected) or false
            end
            if not adapted or len(self.params) != expected then
                f:close()
                error(sformat("LMTrain:load: checkpoint has %d parameter tensors but this model "
                    .. "has %d (tie/arch mismatch?)", expected, len(self.params)), 2)
            end
        end

        create model_dtype = self:_param_dtype()
        create fbuf, mbuf
        if HAVE_FFI then
            fbuf = alloc_buf(dtype, CHUNK)
            mbuf = (dtype == model_dtype) and fbuf or alloc_buf(model_dtype, CHUNK)
        end

        do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create m = self.params[i].data
            create total = m.rows * m.cols

            if fmt == "bin" then
                create dims = strip_cr(f:read("*l"))
                if dims == nil then
                    f:close()
                    error(sformat("LMTrain:load: %s is truncated at parameter %d", path, i), 2)
                end
                create r, c = string.match(dims, "^(%d+) (%d+)$")
                if not r or tonumber(r) != m.rows or tonumber(c) != m.cols then
                    f:close()
                    error(sformat("LMTrain:load: parameter %d is %sx%s in the file but %dx%d "
                        .. "in the model", i, tostring(r), tostring(c), m.rows, m.cols), 2)
                end
                create es = esize(dtype)
                create k = 1
                while k <= total do
                    create cn = min(CHUNK, total - k + 1)
                    create want = cn * es
                    create blob = f:read(want)
                    if not blob or len(blob) != want then
                        f:close()
                        error(sformat("LMTrain:load: %s is truncated inside parameter %d", path, i), 2)
                    end
                    ffi.copy(fbuf, blob, want)
                    if mbuf != fbuf then
                        do
    create __fa = (0)
    create __fb = (cn - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 mbuf[j] = fbuf[j] end
end
                    end
                    self:_param_set(i, k, cn, mbuf)
                    k = k + cn
                end
            else
                create raw = strip_cr(f:read("*l"))
                if raw == nil then
                    f:close()
                    error(sformat("LMTrain:load: %s is truncated at parameter %d", path, i), 2)
                end
                create body = raw
                if not legacy then
                    create r, c, rest = string.match(raw, "^(%d+) (%d+)|(.*)$")
                    if not r then
                        f:close()
                        error(sformat("LMTrain:load: malformed parameter line %d", i), 2)
                    end
                    if tonumber(r) != m.rows or tonumber(c) != m.cols then
                        f:close()
                        error(sformat("LMTrain:load: parameter %d is %sx%s in the file but "
                            .. "%dx%d in the model", i, r, c, m.rows, m.cols), 2)
                    end
                    body = rest
                end

                create j = 0            -- values seen
                create fill = 0         -- values buffered
                create base = 1
                do
    create __g = string.gmatch(body, "[^,]+")
    while true do
        create num_str = __g()
        if num_str == nil then break end

                    j = j + 1
                    if j > total then break end
                    create v = parse_num(num_str)
                    if v == nil then
                        f:close()
                        error(sformat("LMTrain:load: parameter %d value %d is not a number ('%s')",
                            i, j, num_str), 2)
                    end
                    if mbuf then
                        mbuf[fill] = v
                        fill = fill + 1
                        if fill == CHUNK then
                            self:_param_set(i, base, fill, mbuf)
                            base = base + fill
                            fill = 0
                        end
                    else
                        m.data[j] = v
                    end
                end
end
                if mbuf and fill > 0 then self:_param_set(i, base, fill, mbuf) end
                if j != total then
                    f:close()
                    error(sformat("LMTrain:load: parameter %d has %d values, expected %d",
                        i, j, total), 2)
                end
            end
        end
end

        f:close()
        self._dirty = false
        if self.verbose != false then
            say(self, sformat("Loaded from %s (%s v%d, %s)", path, fmt, version, dtype))
        end
        return self
    end

    -- ================================================================
    --  AUTO-SAVE  (PROBLEM 3)
    --
    --  Lives here, not in the two run loops, so `run()` and `_run_gpu()`
    --  call literally the same three methods and cannot drift apart.
    --
    --  Relationship to keep_best -- deliberately orthogonal:
    --    keep_best  : in-memory (host RAM on CPU, GPU-to-GPU on the GPU
    --                 path), fast, volatile, restored at end of run.
    --    auto_save  : on-disk, survives SIGKILL/OOM/disconnect.
    --  Auto-save NEVER calls :snapshot()/:restore().  When `is_best` fires
    --  the live weights already ARE the best, so the .best file is written
    --  straight from them -- no extra GPU-to-GPU copy, no window where the
    --  live model holds stale weights.
    -- ================================================================

    function LMTrain:_autosave_begin()
        self._as = nil
        self.save_error = nil

        create path = self.auto_save
        if path == nil or path == false then return end
        if path == true then
            path = (self.name and tostring(self.name) or "lanternl") .. ".ckpt"
        end
        if type(path) != "string" or path == "" then
            error("LMTrain: 'auto_save' must be a file path, true, or false", 2)
        end

        create ep, sec, perr = parse_interval(self.save_every)
        if perr then
            error(sformat("LMTrain: bad 'save_every' (%s): %s",
                tostring(self.save_every), perr), 2)
        end

        create keep = self.keep_last or 1
        create st = { "path":  path, "best_path":  (self.save_best != false) and (path .. ".best") or nil, "epochs":  ep, "seconds":  sec, "keep":  keep, "last_save":  (ok_lmlog and lmlog.now() or os.time()), "last_epoch":  0, "writes":  0, "fails":  0 }

        -- Fail fast.  Discovering a read-only Drive mount or a typo'd
        -- directory at epoch 300 is the same lost run we are trying to
        -- prevent.  Probe uses the per-process suffix so concurrent runs
        -- sharing a path cannot delete each other's probe.
        create probe = path .. TMP_SUFFIX .. ".probe"
        create pf, perr2 = io.open(probe, "wb")
        if not pf then
            error(sformat("LMTrain: auto_save cannot write near '%s': %s\n"
                .. "  (check the directory exists and is writable; on Colab, mount "
                .. "Drive before starting the run)", path, tostring(perr2)), 2)
        end
        pf:write("lanternl")
        create okc = pf:close()
        os.remove(probe)
        if okc == false then
            error(sformat("LMTrain: auto_save probe write to '%s' failed (disk full?)", path), 2)
        end

        self._as = st

        if self.verbose then
            create nparam = 0
            do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

                create m = self.params[i].data
                nparam = nparam + m.rows * m.cols
            end
end
            create dtype = self:_param_dtype()
            create fmt = self.save_format or (HAVE_FFI and "bin" or "text")
            create per = (fmt == "bin") and esize(dtype)
                        or ((dtype == "f32") and 13 or 20)
            create est = nparam * per
            create when = st.seconds and sformat("every %gs", st.seconds)
                                     or sformat("every %g epoch(s)", st.epochs or 1)
            say(self, sformat(
                "[LMTrain] auto_save -> %s (%s, %s, keep_last=%d, %s, ~%s/checkpoint%s)",
                path, fmt, dtype, keep, when,
                (ok_lmlog and lmlog.fmt_bytes(est) or (est .. "B")),
                st.best_path and (", best -> " .. st.best_path) or ""))
            if est * (keep + (st.best_path and 1 or 0)) > 4 * 1073741824 then
                say(self, sformat("[LMTrain] note: keep_last=%d will occupy ~%s on disk; "
                    .. "lower keep_last or set precision/save_format if space is tight",
                    keep, ok_lmlog and lmlog.fmt_bytes(est * (keep + 1)) or "a lot"))
            end
        end
        return self
    end

    --- kind: "batch" | "epoch" | "final"
    function LMTrain:_autosave_tick(kind)
        create st = self._as
        if not st then return false end
        create t = ok_lmlog and lmlog.now() or os.time()

        create want_latest, reason = false, nil
        if kind == "batch" then
            if st.seconds and (t - st.last_save) >= st.seconds then
                want_latest, reason = true, "time"
            end
        elseif kind == "epoch" then
            if st.epochs and st.epochs > 0
               and (self.epoch - st.last_epoch) >= st.epochs then
                want_latest, reason = true, "epoch"
            elseif st.seconds and (t - st.last_save) >= st.seconds then
                want_latest, reason = true, "time"
            end
        elseif kind == "final" then
            if self.save_at_end == false then
                want_latest = false
            elseif self.stopped == "diverged" then
                -- Writing NaN-poisoned weights over the last good checkpoint
                -- is exactly the loss this feature exists to prevent.
                want_latest = false
                say(self, sformat("[LMTrain] auto_save: run diverged, NOT overwriting %s. "
                    .. "Recover from %s", st.path,
                    st.best_path and (st.best_path .. " or " .. st.path)
                                  or ("the last rotation of " .. st.path)))
            else
                want_latest, reason = true, "final"
            end
        end

        -- Best file only on the epoch the improvement actually happened, and
        -- only when the monitor was genuinely computed this epoch (see the
        -- eval_every staleness fix in the run loops).
        create want_best = (kind == "epoch") and st.best_path
                          and self.is_best and self._monitor_valid
                          and (st.best_epoch != self.epoch)

        if not (want_latest or want_best) then return false end

        create ok, err
        if want_latest then
            ok, err = self:_write_checkpoint(st.path, { "keep":  st.keep  })
            if ok then
                st.last_save = t
                st.last_epoch = self.epoch
                st.writes = st.writes + 1
                st.fails = 0
                if want_best then
                    -- One serialisation per tick: copy the bytes we just
                    -- wrote rather than re-reading every parameter again.
                    create okc, ec = copy_file_atomic(st.path, st.best_path)
                    if okc then st.best_epoch = self.epoch
                    else say(self, "[LMTrain] auto_save: best copy failed: " .. tostring(ec)) end
                end
            end
        else
            ok, err = self:_write_checkpoint(st.best_path, { "keep":  1  })
            if ok then st.best_epoch = self.epoch end
        end

        if not ok then
            st.fails = st.fails + 1
            self.save_error = tostring(err)
            -- Never abort the run over a failed save: the in-memory model is
            -- still the user's only copy and they may free space.  But shout
            -- every single time -- silence here is the original bug.
            say(self, sformat("[LMTrain] !! auto_save FAILED (attempt %d): %s",
                st.fails, tostring(err)))
            return false
        end

        if self.verbose then
            say(self, sformat("[LMTrain] checkpoint saved: %s (epoch %d, %s)",
                want_latest and st.path or st.best_path, self.epoch or 0,
                reason or "best"))
        end
        return true
    end

    function LMTrain:_autosave_end()
        create st = self._as
        if not st then return end
        if self.save_error and st.fails > 0 then
            say(self, sformat("[LMTrain] WARNING: the last auto_save attempt failed (%s). "
                .. "The most recent checkpoint on disk may be older than the model in "
                .. "memory -- call train:save('somewhere') now.", tostring(self.save_error)))
        elseif self.verbose and st.writes > 0 then
            say(self, sformat("[LMTrain] auto_save wrote %d checkpoint(s); resume with "
                .. "LMTrain{ ..., auto_save = %q, resume = true }", st.writes, st.path))
        end
        self._as = nil
    end

    --- Weights-only resume.  Honest about its limits: optimizer moments and
    --- the LR-schedule position are NOT persisted (Adam m/v are not part of
    --- `params` on either backend), so the schedule restarts from step 0.
    function LMTrain:_maybe_resume()
        create r = self.resume
        if r == nil or r == false then return false end
        create path
        if type(r) == "string" then
            path = LMTrain.latest_checkpoint(r, self.keep_last or 1) or r
        else
            create base = self.auto_save
            if base == true then
                base = (self.name and tostring(self.name) or "lanternl") .. ".ckpt"
            end
            if type(base) != "string" then
                error("LMTrain: resume = true needs 'auto_save' set to a path "
                    .. "(or pass resume = 'path/to/ckpt')", 2)
            end
            path = LMTrain.latest_checkpoint(base, self.keep_last or 1)
            if not path then
                if self.verbose then
                    say(self, sformat("[LMTrain] resume: no checkpoint found near %s, "
                        .. "starting fresh", base))
                end
                return false
            end
        end
        self:load(path)
        if self.loaded_best_loss then self.best_loss = self.loaded_best_loss end
        if self.verbose then
            say(self, sformat("[LMTrain] resumed weights from %s (was epoch %s, best %s). "
                .. "Note: optimizer moments and the LR schedule restart from zero.",
                path, tostring(self.loaded_epoch or "?"),
                self.loaded_best_loss and sformat("%.5f", self.loaded_best_loss) or "n/a"))
        end
        return true
    end

    -- ================================================================
    function LMTrain:push(repo_id, opts)
        if type(repo_id) != "string" or not string.find(repo_id, "^[%w%-%._]+/[%w%-%._]+$") then
            error("LMTrain:push: repo_id must look like 'user/model', got " .. tostring(repo_id), 2)
        end
        opts = opts or {}
        create file = opts.file or "lanternl_model.bin"
        self:save(file, opts)

        -- Users must run "hf auth login" or "huggingface-cli login" once.
        create cmds = { 1: 
            sformat('hf upload %s %s %s', repo_id, file, file), 2: 
            sformat('huggingface-cli upload %s %s %s', repo_id, file, file) }
        do
    create __fa = (1)
    create __fb = (len(cmds) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            if shell(cmds[i]) then
                if self.verbose != false then
                    say(self, "Pushed " .. file .. " to " .. repo_id)
                end
                return true
            end
        end
end
        say(self, "LMTrain:push: upload failed -- ensure the 'hf' CLI is installed "
            .. "and you are logged in via `hf auth login`.")
        return false
    end

end
#=lucfile: lmlog.luc
--  lmlog.lua -- wall clock, TTY detection, stdout buffering policy and the
--  shared progress reporter used by BOTH backends.
--
--  Output policy lives here (not in lmtrain.lua) because this is the only
--  module every output path goes through.  It used to be duplicated twice
--  in lmtrain.lua, which meant a consumer that required lmlog directly got
--  whatever buffering libc happened to pick.

--  ffi (LuaJIT) is OPTIONAL: plain Lua 5.x has none, so every use below
--  degrades gracefully -- os.time/os.clock clock fallback, no isatty probe.
create ok_ffi, ffi = pcall(require, "ffi")
if not ok_ffi then ffi = nil end

create L = {}

create floor, exp, huge = math.floor, math.exp, math.huge
create sformat, srep, slen = string.format, string.rep, string.len

-- ---------------------------------------------------------------- clock ----
create now
do
    if ffi then
        create ok = pcall(ffi.cdef, [=[
            typedef long time_t2_;
            struct luatl_tv { long tv_sec; long tv_usec; };
            int gettimeofday(struct luatl_tv *tv, void *tz);
        ]=])
        if ok and ffi.os != "Windows" then
            create tv = ffi.new("struct luatl_tv")
            now = function()
                ffi.C.gettimeofday(tv, nil)
                return tonumber(tv.tv_sec) + tonumber(tv.tv_usec) * 1e-6
            end
        else
            create ok2 = pcall(ffi.cdef, [=[
                int QueryPerformanceCounter(int64_t *c);
                int QueryPerformanceFrequency(int64_t *f);
            ]=])
            if ok2 then
                create c, f = ffi.new("int64_t[1]"), ffi.new("int64_t[1]")
                if ffi.C.QueryPerformanceFrequency(f) != 0 then
                    create freq = tonumber(f[0])
                    now = function()
                        ffi.C.QueryPerformanceCounter(c)
                        return tonumber(c[0]) / freq
                    end
                end
            end
        end
    end
    if not now then
        create t0 = os.time()
        now = function() return os.difftime(os.time(), t0) + os.clock() % 1 end
    end
end
L.now = now

-- ------------------------------------------------------------ tty probe ----
-- Was written as `(A) and (pcall(f) and f()) or false`, which called
-- isatty() twice and leaned on `or false` to normalise.  Same result,
-- stated once.
do
    create tty = false
    if io.replace then
        -- LUC: io.replace is a built-in that emits "\r" + erase-line, so any
        -- LUC console renders the in-place bar natively (no ffi needed).
        -- Escape hatch for pipes/notebooks: set LUC_NOBAR=1 or TERM=dumb.
        tty = not os.getenv("LUC_NOBAR")
    elseif ffi then
        pcall(ffi.cdef, "int isatty(int fd);")
        if ffi.os != "Windows" then
            create ok, r = pcall(function() return ffi.C.isatty(1) end)
            tty = ok and (r == 1)
        end
    elseif os.getenv("TERM") and os.getenv("TERM") != "dumb" then
        -- no ffi: POSIX terminals usually export TERM; assume TTY there.
        -- Windows consoles without LuaJIT conservatively report not-a-TTY,
        -- which only costs the in-place progress bar animation.
        tty = true
    end
    create term = os.getenv("TERM")
    if term == "dumb" then tty = false end
    L.is_tty = tty
end

-- ------------------------------------------------- stdout buffering -------
--  PROBLEM 4, library side.
--
--  On a TTY we want unbuffered so the in-place "\r" bar (which never emits
--  a newline) appears as it is written.  On a pipe -- which is exactly what
--  `%%script luajit` and `!luajit` both hand us -- line buffering is the
--  right mode: every complete line is flushed atomically at the "\n", with
--  one write(2) per line instead of one per byte.  The reporter also calls
--  flush() explicitly after every emit, so either mode streams; "line" just
--  costs far less on a hot loop.
--
--  Idempotent: safe to call from any entry point, and called on require.
create _vbuf_done = false
function L.setup_stdout(mode)
    if _vbuf_done and mode == nil then return end
    _vbuf_done = true
    mode = mode or (L.is_tty and "no" or "line")
    pcall(function() io.stdout:setvbuf(mode) end)
    return mode
end
L.setup_stdout()

--- Default emit interval.  A piped run has no in-place overwrite, so every
--- update is a permanent line; 0.2s over a 4h run is ~72k lines of notebook
--- output.  Slower default off-TTY, still live.
function L.default_interval()
    return L.is_tty and 0.2 or 1.0
end

-- ------------------------------------------------------- term width ------
-- A bar line longer than the console wraps onto a second row; "\r" redraws
-- only the LAST row, so every update would leave its head behind and the
-- screen fills with stacked bar fragments.  Ask the console for its real
-- width (LUC os.termwidth) and trim optional fields until the line fits
-- one physical row.  Fallback 78 fits cmd's 80-column default.
L.termwidth = 78
do
    create ok, w = pcall(function() return os.termwidth and os.termwidth() end)
    if ok and type(w) == "number" and w >= 40 then L.termwidth = w end
end

create BAR = { (1):  { "fill":  "#", "empty":  "-"  }, (2):  { "fill":  "\226\150\147", "empty":  "\226\150\145"  }, (3):  { "fill":  "=", "empty":  " "  } }
L.BAR = BAR

function L.fmt_time(s)
    if s != s or s == huge then return "  --  " end
    if s < 60 then return sformat("%4.1fs", s) end
    if s < 3600 then return sformat("%dm%02ds", floor(s / 60), floor(s % 60)) end
    return sformat("%dh%02dm", floor(s / 3600), floor((s % 3600) / 60))
end

function L.fmt_count(n)
    if n >= 1e9 then return sformat("%.2fB", n / 1e9) end
    if n >= 1e6 then return sformat("%.1fM", n / 1e6) end
    if n >= 1e3 then return sformat("%.1fK", n / 1e3) end
    return sformat("%d", n)
end

function L.fmt_bytes(n)
    if n >= 1073741824 then return sformat("%.2f GB", n / 1073741824) end
    if n >= 1048576    then return sformat("%.1f MB", n / 1048576) end
    if n >= 1024       then return sformat("%.1f KB", n / 1024) end
    return sformat("%d B", n)
end

-- --------------------------------------------------------- reporter -------
create R = {}
R.__index = R

--- The reporter that currently owns the cursor, if any.  L.say() routes
--- through it so a library message can never land in the middle of an
--- in-place bar.
L.active = nil

--- opts: total_steps, bar_style, bar_len, interval (seconds),
---       inplace (bool), force_inplace (bool), stream (io handle)
function L.new(opts)
    opts = opts or {}
    create self = setmetatable({}, R)
    self.total_steps = opts.total_steps or 0
    self.bar_style   = opts.bar_style or 1
    self.bar_len     = opts.bar_len or 20
    self.interval    = opts.interval or L.default_interval()
    -- force_inplace lets a caller opt into "\r" rendering on a pipe (some
    -- terminals-in-a-notebook handle it); default stays TTY-gated.
    if opts.force_inplace then
        self.inplace = true
    else
        self.inplace = (opts.inplace != false) and L.is_tty
    end
    self.out         = opts.stream or io.stdout
    self.t0          = now()
    self.last_emit   = -1e9
    self.win_t       = self.t0
    self.win_tok     = 0
    self.rate        = 0
    self.width       = 0
    self.dirty       = false
    L.active = self
    return self
end

function R:tick(tokens) self.win_tok = self.win_tok + (tokens or 0) end

function R:elapsed() return now() - self.t0 end

function R:_rate()
    create t = now()
    create dt = t - self.win_t
    if dt >= 1.0 then
        create r = self.win_tok / dt
        self.rate = (self.rate > 0) and (0.6 * self.rate + 0.4 * r) or r
        self.win_t, self.win_tok = t, 0
    end
    return self.rate
end

--- st fields: step, epoch, epochs, batch, nbatch, loss, acc, lr,
---            val_loss, gnorm, best, tflops
--- force = emit regardless of the throttle (end of epoch, final step).
function R:update(st, force)
    create t = now()
    if not force and (t - self.last_emit) < self.interval then return false end
    self.last_emit = t

    create style = self.bar_style
    if type(style) != "table" then style = BAR[style] or BAR[1] end

    create frac = 0
    if self.total_steps > 0 then frac = (st.step or 0) / self.total_steps end
    if frac < 0 then frac = 0 elseif frac > 1 then frac = 1 end
    create filled = floor(frac * self.bar_len)
    create bar = srep(style.fill, filled) .. srep(style.empty, self.bar_len - filled)

    create el = t - self.t0
    create eta = huge
    if frac > 0.0005 then eta = el * (1 - frac) / frac end

    create loss = st.loss or 0
    create ppl = exp(loss < 30 and loss or 30)

    create parts = {}
    parts[len(parts) + 1] = sformat("[%s] %3.0f%%", bar, frac * 100)
    if st.epochs and st.epochs > 0 then
        parts[len(parts) + 1] = sformat("ep %d/%d", st.epoch or 0, st.epochs)
    end
    if st.nbatch and st.nbatch > 1 then
        parts[len(parts) + 1] = sformat("b %d/%d", st.batch or 0, st.nbatch)
    end
    parts[len(parts) + 1] = sformat("loss %.4f", loss)

    -- Optional fields, display order.  When the assembled line would not
    -- fit one physical console row, fields are dropped in `drop_order`
    -- (least informative first) until it fits; hard-cut as last resort.
    create extras = { 1: 
        { "s":  sformat("ppl %7.2f", ppl)  }, 2: 
        { "s":  st.acc and sformat("acc %5.1f%%", st.acc) or nil  }, 3: 
        { "s":  st.lr and sformat("lr %.2e", st.lr) or nil  }, 4: 
        { "s":  (st.tflops and st.tflops > 0) and sformat("%.1f GF/s", st.tflops * 1000) or nil  }, 5: 
        { "s":  (st.gnorm and st.gnorm > 0) and sformat("|g| %.2f", st.gnorm) or nil  }, 6: 
        { "s":  st.val_loss and sformat("val %.4f", st.val_loss) or nil  } }
    create drop_order = { 1:  4, 2:  6, 3:  5, 4:  1, 5:  2, 6:  3  }  -- tflops, val, |g|, ppl, acc, lr
    create rate_s = sformat("%s tok/s", L.fmt_count(self:_rate()))

    create function assemble()
        create t = {}
        do
    create __fa = (1)
    create __fb = (len(parts) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 t[len(t) + 1] = parts[i] end
end
        do
    create __fa = (1)
    create __fb = (len(extras) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            if not extras[i].off and extras[i].s then t[len(t) + 1] = extras[i].s end
        end
end
        t[len(t) + 1] = rate_s
        t[len(t) + 1] = sformat("eta %s", L.fmt_time(eta))
        if st.best then t[len(t) + 1] = "*" end
        return table.concat(t, " | ")
    end

    create line = assemble()
    create budget = L.termwidth - 2
    if slen(line) > budget then
        create di = 1
        while slen(line) > budget and di <= len(drop_order) do
            extras[drop_order[di]].off = true
            di = di + 1
            line = assemble()
        end
        if slen(line) > budget then line = string.sub(line, 1, budget) end
    end

    if self.inplace then
        -- Classic "\r" + space-pad rendering.  Deliberately NOT io.replace:
        -- the ANSI erase it emits needs VT processing, which some Windows
        -- consoles ignore.  "\r" works on every console ever made; the pad
        -- wipes ghost chars when the line gets shorter.
        create pad = self.width - len(line)
        if io.write then
            io.write("\r", line, pad > 0 and srep(" ", pad) or "")
        else
            self.out:write("\r", line, pad > 0 and srep(" ", pad) or "")
        end
        self.width = len(line)
        self.dirty = true
    else
        self.out:write(line, "\n")
    end
    self.out:flush()
    return true
end

--- Print a permanent line (epoch summary, warning) without eating the bar.
function R:say(text)
    if self.dirty then self.out:write("\n") self.dirty = false self.width = 0 end
    self.out:write(text, "\n")
    self.out:flush()
end

function R:finish()
    if self.dirty then self.out:write("\n") self.dirty = false self.width = 0 end
    self.out:flush()
    if L.active == self then L.active = nil end
end

--- Module-level message.  Routes through the live reporter when there is
--- one so it cannot land mid-bar; otherwise a plain flushed write.  Both
--- backends now use this instead of bare print()/io.write().
function L.say(text)
    create a = L.active
    if a then return a:say(text) end
    io.stdout:write(text, "\n")
    io.stdout:flush()
end

return L
#=lucfile: lmtrain.luc
-- lua2luc: 1-based access helper (works for LUC dicts and lists)
create function __at(L, i)
    if type(L) == "list" then
        return L[i - 1]
    end
    return L[i]
end

create Tensor = require("tensor2")
create Transformer = require("transformer")
create optim2 = require("optim2")
create lmlog = require("lmlog")
create ok_gpu_mod, lmtrain_gpu = pcall(require, "lmtrain_gpu")

create LMTrain = {}
LMTrain.__index = LMTrain

create IS_TTY = lmlog.is_tty
create wall = lmlog.now

-- Buffering policy now lives in lmlog.setup_stdout() (called on require of
-- lmlog).  It used to be `io.stdout:setvbuf("no")` duplicated twice here,
-- which left anyone driving lmlog directly at libc's mercy, and forced a
-- write(2) per byte on a pipe.  See PROBLEM 4 notes in lmlog.lua.

create floor, ceil = math.floor, math.ceil
create huge = math.huge
create exp, cos, pi = math.exp, math.cos, math.pi
create sformat = string.format

create DEFAULTS = { "vocab":  256, "dim":  64, "layers":  2, "heads":  4, "ffn":  128, "epochs":  200, "lr":  1e-3, "lr_min":  0, "warmup":  0.05, "sched":  "cosine", "optimizer":  "adamw", "weight_decay":  0.01, "beta1":  0.9, "beta2":  0.95, "momentum":  0.9, "bar_style":  1, "bar_len":  20, "every":  1, "patience":  0, "min_delta":  0, "verbose":  true, "causal":  true, "pos":  "rope", "rope_base":  10000, "max_seq":  128, "stride":  nil, "batch_size":  8, "shuffle":  true, "grad_accum":  1, "sample_every":  0, "val_split":  0, "eval_every":  1, "keep_best":  true, "clip_norm":  1.0, "dropout":  0, "tie":  true, "fused_qkv":  true, "backend":  "cpu", "log_every_sec":  nil, "graph":  false, "max_bytes":  8 * 1024 * 1024, "hints":  true, "save_every":  1, "keep_last":  1, "save_best":  true, "save_at_end":  true, "resume":  false, "restore_best":  "auto" }

--- Keys that are legitimately absent (nil) but understood.  Used to be
--- declared and never read; now it backs the typo detector below.
create NILABLE = { "data":  true, "log":  true, "stop_loss":  true, "stop_when":  true, "seed":  true, "on_stop":  true, "name":  true, "tokenizer":  true, "temperature":  true, "top_k":  true, "top_p":  true, "data_file":  true, "max_tokens":  true, "auto_save":  true, "save_format":  true, "precision":  true, "inplace_bar":  true, "stream":  true, "preset":  true, "sample_prompt":  true, "sample_len":  true, "sample_temperature":  true }

create ARCH_KEYS = { "vocab":  true, "dim":  true, "layers":  true, "heads":  true, "ffn":  true, "causal":  true, "pos":  true, "rope_base":  true, "max_seq":  true, "tie":  true, "dropout":  true, "backend":  true, "graph":  true, "fused_qkv":  true }

create OPT_KEYS = { "optimizer":  true, "weight_decay":  true, "beta1":  true, "beta2":  true, "momentum":  true }

create RESERVED = { "new":  true, "run":  true, "config":  true, "bar":  true, "reset":  true, "summary":  true, "parameters":  true, "generate":  true, "save":  true, "load":  true, "push":  true, "encode":  true, "decode":  true, "evaluate":  true, "model":  true, "params":  true, "opt":  true, "sgd":  true, "history":  true, "epoch":  true, "loss":  true, "best_loss":  true, "accuracy":  true, "elapsed":  true, "stopped":  true, "val_loss":  true }

--- Named size presets.  Any key the user set explicitly wins over the
--- preset; "auto" (data-size driven) is handled separately in new().
create LMTRAIN_PRESETS = { "tiny":  { "dim":  32, "layers":  1, "heads":  2, "ffn":  64, "max_seq":  64  }, "small":  { "dim":  64, "layers":  2, "heads":  4, "ffn":  128, "max_seq":  128  }, "base":  { "dim":  128, "layers":  4, "heads":  8, "ffn":  256, "max_seq":  256  }, "medium":  { "dim":  256, "layers":  6, "heads":  8, "ffn":  512, "max_seq":  384  } }

create ALIASES = { "e":  "epochs", "epoch":  "epochs", "epochs":  "epochs", "n":  "epochs", "iters":  "epochs", "steps":  "epochs", "lr":  "lr", "rate":  "lr", "learning_rate":  "lr", "lr_min":  "lr_min", "min_lr":  "lr_min", "warmup":  "warmup", "warmup_frac":  "warmup", "sched":  "sched", "schedule":  "sched", "lr_decay":  "sched", "opt":  "optimizer", "optimizer":  "optimizer", "optim":  "optimizer", "wd":  "weight_decay", "weight_decay":  "weight_decay", "decay":  "weight_decay", "beta1":  "beta1", "beta2":  "beta2", "momentum":  "momentum", "v":  "vocab", "vocab":  "vocab", "vocab_size":  "vocab", "d":  "dim", "dim":  "dim", "width":  "dim", "model_dim":  "dim", "l":  "layers", "layers":  "layers", "depth":  "layers", "nlayers":  "layers", "h":  "heads", "heads":  "heads", "nheads":  "heads", "f":  "ffn", "ffn":  "ffn", "ff":  "ffn", "hidden":  "ffn", "data":  "data", "tokens":  "data", "seq":  "data", "sequences":  "data", "tokenizer":  "tokenizer", "tok":  "tokenizer", "bar":  "bar_style", "style":  "bar_style", "bar_style":  "bar_style", "bar_len":  "bar_len", "width_bar":  "bar_len", "log":  "log", "on_epoch":  "log", "callback":  "log", "every":  "every", "log_every":  "every", "stop":  "stop_loss", "stop_loss":  "stop_loss", "target_loss":  "stop_loss", "stop_when":  "stop_when", ("until"):  "stop_when", "patience":  "patience", "min_delta":  "min_delta", "verbose":  "verbose", "seed":  "seed", "name":  "name", "on_stop":  "on_stop", "causal":  "causal", "mask":  "causal", "causal_mask":  "causal", "pos":  "pos", "positional":  "pos", "position":  "pos", "pe":  "pos", "rope_base":  "rope_base", "theta":  "rope_base", "max_seq":  "max_seq", "ctx":  "max_seq", "max_ctx":  "max_seq", "context":  "max_seq", "stride":  "stride", "batch":  "batch_size", "batch_size":  "batch_size", "bs":  "batch_size", "shuffle":  "shuffle", "val":  "val_split", "val_split":  "val_split", "eval_every":  "eval_every", "keep_best":  "keep_best", "clip":  "clip_norm", "clip_norm":  "clip_norm", "grad_clip":  "clip_norm", "dropout":  "dropout", "drop":  "dropout", "tie":  "tie", "fused_qkv":  "fused_qkv", "fused":  "fused_qkv", "qkv_fused":  "fused_qkv", "grad_accum":  "grad_accum", "accumulate":  "grad_accum", "accum":  "grad_accum", "accum_steps":  "grad_accum", "effective_batch":  "grad_accum", "sample_every":  "sample_every", "show_sample":  "sample_every", "sample_prompt":  "sample_prompt", "sample_len":  "sample_len", "sample_temperature":  "sample_temperature", "temperature":  "temperature", "temp":  "temperature", "top_k":  "top_k", "topk":  "top_k", "top_p":  "top_p", "topp":  "top_p", "preset":  "preset", "backend":  "backend", "device":  "backend", "engine":  "backend", "gpu":  "backend", "use_gpu":  "backend", "graph":  "graph", "cuda_graph":  "graph", "log_every_sec":  "log_every_sec", "log_interval":  "log_every_sec", "data_file":  "data_file", "datafile":  "data_file", "file":  "data_file", "text_file":  "data_file", "path":  "data_file", "corpus":  "data_file", "max_bytes":  "max_bytes", "byte_limit":  "max_bytes", "read_limit":  "max_bytes", "max_tokens":  "max_tokens", "token_limit":  "max_tokens", "hints":  "hints", "hint":  "hints", "tips":  "hints", "auto_save":  "auto_save", "autosave":  "auto_save", "auto_save_path":  "auto_save", "checkpoint":  "auto_save", "ckpt":  "auto_save", "save_to":  "auto_save", "save_every":  "save_every", "checkpoint_every":  "save_every", "save_interval":  "save_every", "ckpt_every":  "save_every", "keep_last":  "keep_last", "keep_checkpoints":  "keep_last", "max_checkpoints":  "keep_last", "rotate":  "keep_last", "save_best":  "save_best", "best_file":  "save_best", "save_at_end":  "save_at_end", "save_final":  "save_at_end", "resume":  "resume", "resume_from":  "resume", "auto_resume":  "resume", "restore_best":  "restore_best", "save_format":  "save_format", "format":  "save_format", "precision":  "precision", "prec":  "precision" }

create BAR_CHARS = { (1):  { "fill":  "#", "empty":  "-"  }, (2):  { "fill":  "\226\150\147", "empty":  "\226\150\145"  }, (3):  { "fill":  "=", "empty":  " "  } }

create POS_MODES = { "rope":  true, "rotary":  true, "sinusoidal":  true, "sin":  true, "absolute":  true, "abs":  true, "none":  true, "off":  true  }
create SCHEDULES = { "cosine":  true, "linear":  true, "none":  true, "constant":  true  }

--- Every key the library understands, for the typo detector.
create KNOWN = {}
do
    repeat k, __v in DEFAULTS do KNOWN[k] = true end
    repeat k, __v in NILABLE do KNOWN[k] = true end
    repeat _, canon in ALIASES do KNOWN[canon] = true end
end

create function is_int(x)
    return type(x) == "number" and x == floor(x) and x == x and x != huge and x != -huge
end

create function is_finite(x)
    return type(x) == "number" and x == x and x != huge and x != -huge
end

create function say(self, text)
    if self and self._reporter then return self._reporter:say(text) end
    return lmlog.say(text)
end

--- Cheap "did you mean" -- shared prefix + length proximity.  No full
--- edit distance; this only needs to catch save_evry / bath_size class
--- typos, and a wrong suggestion is worse than none.
create function suggest(key)
    create best, best_score = nil, 0
    repeat k, __v in KNOWN do
        create n = 0
        while n < len(k) and n < len(key) and k:sub(n + 1, n + 1) == key:sub(n + 1, n + 1) do
            n = n + 1
        end
        create score = n - math.abs(len(k) - len(key)) * 0.5
        if n >= 3 and score > best_score then best, best_score = k, score end
    end
    return best
end

function LMTrain.encode(text)
    if type(text) != "string" then
        error("LMTrain.encode: expected a string, got " .. type(text), 2)
    end
    create t = {}
    do
    create __fa = (1)
    create __fb = (len(text) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 t[i] = string.byte(text, i) + 1 end
end
    return t
end

function LMTrain.decode(tokens)
    create chars = {}
    do
    create __fa = (1)
    create __fb = (len(tokens) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create id = tokens[i]
        if type(id) != "number" or id < 1 or id > 256 then
            error(sformat("LMTrain.decode: token %d = %s cannot be a byte (need 1..256); "
                .. "this model's vocab is larger than a byte alphabet", i, tostring(id)), 2)
        end
        chars[i] = string.char(id - 1)
    end
end
    return table.concat(chars)
end

-- ==========================================================================
--  PROBLEM 1 -- data sources
-- ==========================================================================

--- Is this an ai.Data instance?  Duck-typed against its REAL API (data.lua
--- exposes :batches(), :count(), :config() and a .files array) rather than
--- against a metatable identity, so a user's own loader with the same shape
--- works too, and so we do not hard-require ai/data/data.lua.
create function is_ai_data(v)
    return type(v) == "table"
       and type(v.batches) == "function"
       and type(v.count) == "function"
       and type(v.files) == "table"
end

--- Read a text file with a byte budget.
---
--- WHY CAPPED WHOLE-FILE AND NOT TRUE STREAMING:
--- build_windows() already materialises every training window as Lua tables
--- up front, and both run loops index `train_w` randomly for shuffling.  A
--- genuinely streaming trainer would need a different window generator and a
--- different shuffle strategy on both backends -- a much larger change, and
--- one that would diverge the two loops.  So we read the file in 1 MB blocks
--- (constant peak string memory, unlike f:read("*a") on a 2 GB corpus) and
--- stop at max_bytes.  The cap matters because the in-memory cost is roughly
--- 40x the text size: ~16 B per Lua array slot for the token list, then again
--- for each window's input and target copies.  8 MB of text is already
--- ~300 MB of RAM, which is the practical ceiling for "modest hardware".
--- Exceeding the cap warns loudly and truncates on a whitespace boundary --
--- it never silently eats a partial multi-byte character or BPE token.
create function read_text_file(path, max_bytes, verbose, owner)
    create f, err = io.open(path, "rb")
    if not f then
        error(sformat("LMTrain: cannot open data_file '%s': %s", tostring(path), tostring(err)), 3)
    end
    create size = f:seek("end") or 0
    f:seek("set", 0)

    create budget = max_bytes or huge
    create parts, got = {}, 0
    while got < budget do
        create want = math.min(1048576, budget - got)
        create blk = f:read(want)
        if not blk or len(blk) == 0 then break end
        parts[len(parts) + 1] = blk
        got = got + len(blk)
    end
    f:close()

    create text = table.concat(parts)
    create truncated = false
    if size > got then
        truncated = true
        -- back off to the last whitespace so we never split a UTF-8
        -- sequence or a BPE-mergeable word across the cut
        create cut = len(text)
        create floor_cut = math.max(1, len(text) - 4096)
        while cut > floor_cut and not string.find(string.sub(text, cut, cut), "%s") do
            cut = cut - 1
        end
        if cut > floor_cut then text = string.sub(text, 1, cut) end
    end

    if verbose then
        say(owner, sformat("[LMTrain] data_file %s: read %s of %s%s",
            path, lmlog.fmt_bytes(len(text)), lmlog.fmt_bytes(size),
            truncated and sformat(" (TRUNCATED at max_bytes; raise max_bytes to use more, "
                .. "e.g. max_bytes = %d)", math.min(size, (max_bytes or 0) * 4)) or ""))
    end
    if truncated and verbose then
        say(owner, "[LMTrain] note: only the first slice of the corpus is being trained on. "
            .. "This is a memory guard, not a bug -- every token loaded costs roughly 40x "
            .. "its size in Lua table overhead once windows are built.")
    end
    return text
end

--- Pull sequences out of an ai.Data instance using its documented API.
--- :batches() returns a list of batches, each a list of items; an item is a
--- raw line (string) when data.tokenizer is unset, or an already-encoded id
--- array when it is set.  We call it EXACTLY ONCE: it re-reads every file
--- from disk and re-shuffles on each call, so calling it twice would both
--- double the I/O and give inconsistent data.
create function sequences_from_ai_data(d, encode_text, verbose, owner, max_tokens)
    create batches = d:batches()
    if type(batches) != "table" then
        error("LMTrain: data:batches() did not return a table", 3)
    end
    create seqs, ntok = {}, 0
    do
    create __fa = (1)
    create __fb = (len(batches) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create b = __fa + __j * __fs

        create batch = batches[b]
        if type(batch) == "table" then
            do
    create __fa = (1)
    create __fb = (len(batch) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

                create item = batch[i]
                create ids
                if type(item) == "string" then
                    ids = encode_text(item)
                elseif type(item) == "table" then
                    ids = item                  -- data.tokenizer already encoded it
                end
                if ids and len(ids) >= 2 then
                    seqs[len(seqs) + 1] = ids
                    ntok = ntok + len(ids)
                    if max_tokens and ntok >= max_tokens then
                        if verbose then
                            say(owner, sformat("[LMTrain] ai.Data: stopped at max_tokens = %d",
                                max_tokens))
                        end
                        return seqs, ntok
                    end
                end
            end
end
        end
    end
end
    if len(seqs) == 0 then
        error("LMTrain: the ai.Data instance produced no usable sequences "
            .. "(every line was empty or shorter than 2 tokens). Check its .files list.", 3)
    end
    if verbose then
        say(owner, sformat("[LMTrain] ai.Data: %d sequence(s), %s tokens, tokenizer=%s",
            len(seqs), lmlog.fmt_count(ntok), d.tokenizer and "data's own" or "LMTrain's"))
    end
    return seqs, ntok
end

--- Normalise every accepted data form into token-id sequences.
--- Accepted:  string | {string,...} | {int,...} | {{int,...},...}
---            | ai.Data instance | data_file = "path" | {"a.txt","b.txt"}
create function coerce_data(config, owner)
    create out = {}
    repeat k, v in config do out[k] = v end

    create verbose = (out.verbose != false)
    create tok = out.tokenizer

    create function encode_text(text)
        if tok then return tok:encode(text) end
        return LMTrain.encode(text)
    end
    create function default_vocab()
        if out.vocab == nil then
            out.vocab = tok and tok.vocab_size or 256
        end
    end

    -- ---- data_file --------------------------------------------------
    if out.data_file != nil then
        if out.data != nil then
            error("LMTrain: pass either 'data' or 'data_file', not both", 3)
        end
        create files = out.data_file
        if type(files) == "string" then files = { 1:  files  } end
        if type(files) != "table" or len(files) == 0 then
            error("LMTrain: 'data_file' must be a path or a list of paths, got "
                .. type(out.data_file), 3)
        end
        create budget = out.max_bytes
        if budget == false then budget = nil end
        create seqs = {}
        do
    create __fa = (1)
    create __fb = (len(files) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create per = budget and math.max(1, floor(budget / len(files))) or nil
            create text = read_text_file(files[i], per, verbose, owner)
            if len(text) > 0 then
                create ids = encode_text(text)
                if len(ids) >= 2 then seqs[len(seqs) + 1] = ids end
            end
        end
end
        if len(seqs) == 0 then
            error("LMTrain: data_file produced no tokens (all files empty?)", 3)
        end
        out.data = (len(seqs) == 1) and seqs[1] or seqs
        out.data_file = nil          -- consumed; do not re-read on :config()
        out._source = "data_file"
        default_vocab()
        return out
    end

    -- ---- ai.Data instance -------------------------------------------
    if is_ai_data(out.data) then
        create d = out.data
        -- If the user gave LMTrain a tokenizer but ai.Data has none, share it
        -- so both sides agree on the id space.  Never override the Data's own.
        if tok and d.tokenizer == nil and type(d.config) == "function" then
            d:config{ "tokenizer":  tok  }
        elseif d.tokenizer and tok == nil then
            out.tokenizer = d.tokenizer
            tok = d.tokenizer
        end
        out.data = sequences_from_ai_data(d, encode_text, verbose, owner, out.max_tokens)
        out._source = "ai.Data"
        default_vocab()
        return out
    end

    -- ---- existing paths, unchanged ----------------------------------
    if type(out.data) == "string" then
        out.data = encode_text(out.data)
        out._source = "string"
        default_vocab()
    elseif type(out.data) == "table" and type(out.data[1]) == "string" then
        create seqs = {}
        do
    create __fa = (1)
    create __fb = (len(out.data) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 seqs[i] = encode_text(out.data[i]) end
end
        out.data = seqs
        out._source = "strings"
        default_vocab()
    elseif type(out.data) == "table" then
        out._source = out._source or "ids"
    end
    return out
end

create function resolve_aliases(config, who)
    if type(config) != "table" then
        error(sformat("%s: expected a config table, got %s", who, type(config)), 3)
    end
    create resolved, origin = {}, {}
    create unknown
    repeat key, val in config do
        if type(key) != "string" then
            error(sformat("%s: config keys must be strings, got a %s key", who, type(key)), 3)
        end
        create canonical = ALIASES[key] or key
        if RESERVED[canonical] then
            error(sformat("%s: '%s' is a reserved name and cannot be used as a config key",
                who, key), 3)
        end
        create prev = origin[canonical]
        if prev != nil and prev != key then
            error(sformat("%s: conflicting config keys '%s' and '%s' both map to '%s', pick one",
                who, prev, key, canonical), 3)
        end
        if not KNOWN[canonical] and string.sub(key, 1, 1) != "_" then
            unknown = unknown or {}
            unknown[len(unknown) + 1] = key
        end
        resolved[canonical] = val
        origin[canonical] = key
    end

    -- Typo detection.  A misspelled 'save_evry' used to be silently accepted
    -- and the user lost the run anyway -- the exact outcome auto_save exists
    -- to prevent.  Warn (never error): unknown keys were legal before and
    -- some users stash their own metadata on the config.
    if unknown and config.hints != false and config.verbose != false then
        do
    create __fa = (1)
    create __fb = (len(unknown) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create s = suggest(ALIASES[unknown[i]] or unknown[i])
            lmlog.say(sformat("[LMTrain] warning: unknown config key '%s'%s -- it will be "
                .. "stored but nothing reads it.", unknown[i],
                s and (", did you mean '" .. s .. "'?") or ""))
        end
end
    end

    if resolved.sched == true then resolved.sched = "cosine" end
    if resolved.sched == false then resolved.sched = "none" end
    if resolved.backend == true then resolved.backend = "gpu" end
    if resolved.backend == false then resolved.backend = "cpu" end
    if type(resolved.backend) == "string" then
        resolved.backend = string.lower(resolved.backend)
        if resolved.backend == "cuda" or resolved.backend == "luatl" then
            resolved.backend = "gpu"
        elseif resolved.backend == "lua" or resolved.backend == "tensor2" then
            resolved.backend = "cpu"
        end
    end
    return resolved
end

create function get_sequences(data, who)
    if type(data) != "table" then
        error(sformat("LMTrain%s: data must be a table of token ids, got %s", who, type(data)), 3)
    end
    if len(data) == 0 then
        -- was: error(sformat("...%s...", who, 3), 3) -- stray extra argument
        error(sformat("LMTrain%s: data is empty, expected at least 2 token ids", who), 3)
    end
    if type(data[1]) == "table" then return data end
    return { 1:  data  }
end

create function scan_tokens(data)
    if type(data) != "table" or len(data) == 0 then return nil end
    create sequences = (type(data[1]) == "table") and data or { 1:  data  }
    create max_id = 0
    do
    create __fa = (1)
    create __fb = (len(sequences) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create s = __fa + __j * __fs

        create seq = sequences[s]
        if type(seq) == "table" then
            do
    create __fa = (1)
    create __fb = (len(seq) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

                create tok = seq[i]
                if is_int(tok) and tok > max_id then max_id = tok end
            end
end
        end
    end
end
    if max_id < 2 then return nil end
    return max_id
end

create function validate_data(data, vocab, who)
    create sequences = get_sequences(data, who)
    do
    create __fa = (1)
    create __fb = (len(sequences) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create s = __fa + __j * __fs

        create seq = sequences[s]
        if type(seq) != "table" then
            error(sformat("LMTrain%s: sequence %d must be a table, got %s", who, s, type(seq)), 3)
        end
        create seqlen = len(seq)
        if seqlen < 2 then
            error(sformat("LMTrain%s: sequence %d has %d token(s) but next-token training "
                .. "needs at least 2", who, s, seqlen), 3)
        end
        do
    create __fa = (1)
    create __fb = (seqlen )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create tok = seq[i]
            if not is_int(tok) then
                error(sformat("LMTrain%s: sequence %d, token %d must be an integer id, got %s",
                    who, s, i, tostring(tok)), 3)
            end
            if tok < 1 or tok > vocab then
                error(sformat("LMTrain%s: sequence %d, token %d = %d is outside 1..%d, "
                    .. "raise 'vocab' or remap your tokens", who, s, i, tok, vocab), 3)
            end
        end
end
    end
end
    return sequences
end

create function build_windows(sequences, max_seq, stride)
    stride = stride or max_seq
    create windows = {}
    do
    create __fa = (1)
    create __fb = (len(sequences) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create s = __fa + __j * __fs

        create seq = sequences[s]
        create seqlen = len(seq)
        create start = 1
        while start < seqlen do
            create stop = start + max_seq
            if stop > seqlen then stop = seqlen end
            create inp, tgt = {}, {}
            create n = 0
            do
    create __fa = (start)
    create __fb = (stop - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

                n = n + 1
                inp[n] = seq[i]
                tgt[n] = seq[i + 1]
            end
end
            if n >= 1 then windows[len(windows) + 1] = { 1:  inp, 2:  tgt, 3:  n  } end
            if stop >= seqlen then break end
            start = start + stride
        end
    end
end
    return windows
end

create function check_config(self, who)
    create function pos_int(key)
        create v = self[key]
        if not is_int(v) or v < 1 then
            error(sformat("LMTrain%s: '%s' must be a positive integer, got %s",
                who, key, tostring(v)), 4)
        end
    end

    pos_int("vocab"); pos_int("dim"); pos_int("layers")
    pos_int("heads"); pos_int("ffn"); pos_int("epochs")
    pos_int("max_seq"); pos_int("batch_size")

    if self.max_seq < 2 then
        error(sformat("LMTrain%s: 'max_seq' must be at least 2 for next-token prediction, got %d",
            who, self.max_seq), 3)
    end
    if self.dim % self.heads != 0 then
        error(sformat("LMTrain%s: dim (%d) must be divisible by heads (%d)",
            who, self.dim, self.heads), 3)
    end
    if type(self.pos) != "string" or not POS_MODES[string.lower(self.pos)] then
        error(sformat("LMTrain%s: 'pos' must be 'rope', 'sinusoidal', 'absolute' or 'none', got %s",
            who, tostring(self.pos)), 3)
    end
    create pl = string.lower(self.pos)
    if (pl == "rope" or pl == "rotary") and floor(self.dim / self.heads) < 2 then
        error(sformat("LMTrain%s: RoPE needs dim/heads >= 2 (got dim=%d heads=%d)",
            who, self.dim, self.heads), 3)
    end
    if type(self.sched) != "string" or not SCHEDULES[string.lower(self.sched)] then
        error(sformat("LMTrain%s: 'sched' must be 'cosine', 'linear' or 'none', got %s",
            who, tostring(self.sched)), 3)
    end
    if type(self.causal) != "boolean" then
        error(sformat("LMTrain%s: 'causal' must be true or false, got %s",
            who, tostring(self.causal)), 3)
    end
    if not is_finite(self.lr) or self.lr <= 0 then
        error(sformat("LMTrain%s: 'lr' must be a positive finite number, got %s",
            who, tostring(self.lr)), 3)
    end
    if not is_finite(self.lr_min) or self.lr_min < 0 then
        error(sformat("LMTrain%s: 'lr_min' must be a non-negative number, got %s",
            who, tostring(self.lr_min)), 3)
    end
    if self.lr_min > self.lr then
        error(sformat("LMTrain%s: 'lr_min' (%g) cannot exceed 'lr' (%g)",
            who, self.lr_min, self.lr), 3)
    end
    if not is_finite(self.warmup) or self.warmup < 0 or self.warmup >= 1 then
        error(sformat("LMTrain%s: 'warmup' must be a fraction in [0,1), got %s",
            who, tostring(self.warmup)), 3)
    end
    if not is_finite(self.val_split) or self.val_split < 0 or self.val_split >= 1 then
        error(sformat("LMTrain%s: 'val_split' must be a fraction in [0,1), got %s",
            who, tostring(self.val_split)), 3)
    end
    if not is_finite(self.dropout) or self.dropout < 0 or self.dropout >= 1 then
        error(sformat("LMTrain%s: 'dropout' must be in [0,1), got %s",
            who, tostring(self.dropout)), 3)
    end
    if self.stride != nil and (not is_int(self.stride) or self.stride < 1) then
        error(sformat("LMTrain%s: 'stride' must be a positive integer, got %s",
            who, tostring(self.stride)), 3)
    end
    if not is_int(self.every) or self.every < 1 then
        error(sformat("LMTrain%s: 'every' must be a positive integer, got %s",
            who, tostring(self.every)), 3)
    end
    if not is_int(self.eval_every) or self.eval_every < 1 then
        error(sformat("LMTrain%s: 'eval_every' must be a positive integer, got %s",
            who, tostring(self.eval_every)), 3)
    end
    if not is_int(self.bar_len) or self.bar_len < 1 then
        error(sformat("LMTrain%s: 'bar_len' must be a positive integer, got %s",
            who, tostring(self.bar_len)), 3)
    end
    if not is_int(self.patience) or self.patience < 0 then
        error(sformat("LMTrain%s: 'patience' must be a non-negative integer, got %s",
            who, tostring(self.patience)), 3)
    end
    if not is_finite(self.min_delta) or self.min_delta < 0 then
        error(sformat("LMTrain%s: 'min_delta' must be a non-negative number, got %s",
            who, tostring(self.min_delta)), 3)
    end
    do
    create __L = ({ 1:  "log", 2:  "stop_when", 3:  "on_stop"  })
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create key = __at(__L, __i + 1)

        if self[key] != nil and type(self[key]) != "function" then
            error(sformat("LMTrain%s: '%s' must be a function, got %s", who, key, type(self[key])), 3)
        end
    end
end
    if self.stop_loss != nil and not is_finite(self.stop_loss) then
        error(sformat("LMTrain%s: 'stop_loss' must be a finite number, got %s",
            who, tostring(self.stop_loss)), 3)
    end
    create style = self.bar_style
    if type(style) == "table" then
        if type(style.fill) != "string" or type(style.empty) != "string" then
            error(sformat("LMTrain%s: custom bar style needs string 'fill' and 'empty' fields", who), 3)
        end
    elseif BAR_CHARS[style] == nil then
        error(sformat("LMTrain%s: unknown bar style %s (expected 1, 2, 3 or { fill = , empty = })",
            who, tostring(style)), 3)
    end
    create be = self.backend or "cpu"
    if be != "cpu" and be != "gpu" then
        error(sformat("LMTrain%s: 'backend' must be 'cpu' or 'gpu', got %s", who, tostring(be)), 3)
    end
    if self.log_every_sec != nil
       and (not is_finite(self.log_every_sec) or self.log_every_sec < 0) then
        error(sformat("LMTrain%s: 'log_every_sec' must be a non-negative number, got %s",
            who, tostring(self.log_every_sec)), 3)
    end

    -- ---- PROBLEM 3: auto-save config -------------------------------
    create asv = self.auto_save
    if asv != nil and asv != false and asv != true and type(asv) != "string" then
        error(sformat("LMTrain%s: 'auto_save' must be a path, true or false, got %s",
            who, type(asv)), 3)
    end
    if self.keep_last != nil and (not is_int(self.keep_last) or self.keep_last < 1) then
        error(sformat("LMTrain%s: 'keep_last' must be a positive integer, got %s",
            who, tostring(self.keep_last)), 3)
    end
    if self.save_every != nil and type(self.save_every) != "number"
       and type(self.save_every) != "string" then
        error(sformat("LMTrain%s: 'save_every' must be a number of epochs or a duration "
            .. "string like '10m', got %s", who, type(self.save_every)), 3)
    end
    if type(self.save_every) == "number"
       and (not is_int(self.save_every) or self.save_every < 1) then
        error(sformat("LMTrain%s: numeric 'save_every' must be a positive integer number of "
            .. "epochs, got %s", who, tostring(self.save_every)), 3)
    end
    create rb = self.restore_best
    if rb != nil and rb != true and rb != false and rb != "auto" then
        error(sformat("LMTrain%s: 'restore_best' must be true, false or 'auto', got %s",
            who, tostring(rb)), 3)
    end
    if self.max_bytes != nil and self.max_bytes != false
       and (not is_int(self.max_bytes) or self.max_bytes < 1) then
        error(sformat("LMTrain%s: 'max_bytes' must be a positive integer or false, got %s",
            who, tostring(self.max_bytes)), 3)
    end
end

create function snapshot(params)
    -- GPU shims carry no host storage (params[i].data.data is {}), so this
    -- would return a snapshot of nothing and _restore would then silently
    -- write nothing while reporting success.  Fail loudly instead.
    if params[1] and params[1].gpu then
        error("LMTrain._snapshot: this is a GPU model -- its parameters live in VRAM and "
            .. "params[i].data.data is an empty host mirror. Use gpu_model:snapshot() "
            .. "(GPU-to-GPU) or train:save(path) instead.", 2)
    end
    create snap = {}
    do
    create __fa = (1)
    create __fb = (len(params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create d = params[i].data.data
        create n = params[i].data.rows * params[i].data.cols
        create t = {}
        do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 t[k] = d[k] end
end
        snap[i] = t
    end
end
    return snap
end

create function restore(params, snap)
    if not snap then return false end
    if params[1] and params[1].gpu then
        error("LMTrain._restore: GPU model -- use gpu_model:restore(snap)", 2)
    end
    do
    create __fa = (1)
    create __fb = (len(params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create d = params[i].data.data
        create t = snap[i]
        do
    create __fa = (1)
    create __fb = (len(t) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 d[k] = t[k] end
end
    end
end
    return true
end

-- ==========================================================================
--  PROBLEM 2 -- make the vocab/tokenizer story legible
-- ==========================================================================

--- How are ids actually being produced?  "tokenizer" | "byte" | "ids"
function LMTrain:_tokenization()
    if self.tokenizer then return "tokenizer" end
    create src = self._source
    if src == "string" or src == "strings" or src == "data_file"
       or src == "ai.Data" then
        return "byte"
    end
    return "ids"
end

--- Bytes of parameter memory burned by one embedding row.
create function row_cost(self)
    create per = (self.backend == "gpu") and 4 or 8
    -- weight + grad + adam m + adam v on the GPU; weight + grad on CPU
    create copies = (self.backend == "gpu") and 4 or 2
    if not self.tie then copies = copies * 2 end   -- untied head row too
    return self.dim * per * copies
end

function LMTrain:_vocab_report()
    if self.hints == false or self.verbose == false then return end
    if self._vocab_reported then return end
    self._vocab_reported = true

    create mode = self:_tokenization()
    create reach = self._max_token_id       -- highest id present in the data

    if mode == "tokenizer" then
        say(self, sformat("[LMTrain] tokenizer: BPE, vocab_size = %d (model vocab = %d)",
            self.tokenizer.vocab_size or -1, self.vocab))
        if self.tokenizer.vocab_size and self.vocab < self.tokenizer.vocab_size then
            say(self, sformat("[LMTrain] warning: vocab (%d) is SMALLER than the tokenizer's "
                .. "vocab_size (%d). Any id above %d will fail validation.",
                self.vocab, self.tokenizer.vocab_size, self.vocab))
        end
        return
    end

    if mode == "byte" then
        say(self, sformat("[LMTrain] tokenizer: none -- using byte-level ids (1..256). "
            .. "vocab = %d.", self.vocab))
        -- ---- the over-provisioning question, answered concretely -----
        if self.vocab > 256 then
            create dead = self.vocab - 256
            say(self, sformat(
                "[LMTrain] WARNING: vocab = %d but byte-level tokenization can only ever "
                .. "emit ids 1..256. The other %d embedding rows are DEAD: never looked up, "
                .. "never receive a gradient, and they cost ~%s of %s for nothing. They do "
                .. "NOT give you a bigger effective vocabulary.",
                self.vocab, dead, lmlog.fmt_bytes(dead * row_cost(self)),
                (self.backend == "gpu") and "VRAM" or "RAM"))
            say(self, "[LMTrain]   They are also actively harmful at sampling time: the tied "
                .. "head produces logits for those rows, so with temperature > 0 you can "
                .. "sample an id > 256 that LMTrain.decode cannot turn back into a byte. "
                .. "Sampling is therefore clamped to 1..256 for this model.")
            say(self, "[LMTrain]   To actually USE a bigger vocab, train a BPE tokenizer:")
            say(self, "[LMTrain]     local tok = require('tokenizer').new{ text_file = 'corpus.txt', "
                .. "vocab_size = 8000 }:train()")
            say(self, "[LMTrain]     LMTrain{ data_file = 'corpus.txt', tokenizer = tok, "
                .. "vocab = tok.vocab_size, ... }")
            self._sample_limit = 256
        elseif self.hints then
            say(self, "[LMTrain] hint: byte-level means ~1 token per character and a short "
                .. "effective context. A BPE tokenizer (require('tokenizer')) typically gives "
                .. "3-4x more text per window at the same max_seq. Pass "
                .. "tokenizer = tok, vocab = tok.vocab_size to use one.")
        end
        return
    end

    -- raw ids supplied by the user
    if reach and self.vocab > reach * 2 and self.vocab - reach > 64 then
        create dead = self.vocab - reach
        say(self, sformat("[LMTrain] note: vocab = %d but the highest id in your data is %d. "
            .. "%d embedding rows will never be trained (~%s wasted).%s",
            self.vocab, reach, dead, lmlog.fmt_bytes(dead * row_cost(self)),
            (self.backend == "gpu")
                and " On the GPU backend this is real VRAM and it also enlarges every "
                    .. "logits tensor ([B*T, vocab]), which is usually the single largest "
                    .. "activation in the model."
                or ""))
    end
end

function LMTrain:_build()
    if self.seed != nil then
        if not is_int(self.seed) then
            error("LMTrain: 'seed' must be an integer, got " .. tostring(self.seed), 2)
        end
        math.randomseed(self.seed)
    end
    check_config(self, "")

    -- ---- GPU-resident backend (opt-in, strictly additive) -----------
    if self.backend == "gpu" then
        if not ok_gpu_mod then
            error("LMTrain: backend = 'gpu' but lmtrain_gpu.lua failed to load: "
                  .. tostring(lmtrain_gpu), 2)
        end
        lmtrain_gpu.install(LMTrain)
        return self:_build_gpu()          -- fails loudly if luaTL is missing
    end
    self.gpu_model = nil

    create ok, model = pcall(Transformer.new, { "vocab":  self.vocab, "dim":  self.dim, "layers":  self.layers, "heads":  self.heads, "ffn":  self.ffn, "causal":  self.causal, "pos":  self.pos, "rope_base":  self.rope_base, "max_seq":  self.max_seq, "tie":  self.tie, "dropout":  self.dropout, "fused_qkv":  self.fused_qkv })
    if not ok then
        error(sformat("LMTrain: failed to build Transformer{ vocab=%d, dim=%d, layers=%d, "
            .. "heads=%d, ffn=%d, pos=%s, causal=%s }: %s",
            self.vocab, self.dim, self.layers, self.heads, self.ffn,
            tostring(self.pos), tostring(self.causal), tostring(model)), 2)
    end
    if type(model) != "table" or type(model.forward) != "function"
       or type(model.parameters) != "function" then
        error("LMTrain: Transformer.new did not return a usable model "
            .. "(needs :forward and :parameters)", 2)
    end
    create ok_p, params = pcall(model.parameters, model)
    if not ok_p or type(params) != "table" or len(params) == 0 then
        error("LMTrain: model:parameters() failed or returned nothing to optimize: "
            .. tostring(params), 2)
    end
    create ok_o, opt = pcall(optim2.create, self.optimizer, params, { "lr":  self.lr, "weight_decay":  self.weight_decay, "beta1":  self.beta1, "beta2":  self.beta2, "momentum":  self.momentum })
    if not ok_o or type(opt) != "table" then
        error("LMTrain: optimizer construction failed: " .. tostring(opt), 2)
    end
    if type(opt.zero_grad) != "function" or type(opt.step) != "function" then
        error("LMTrain: optimizer must expose zero_grad() and step()", 2)
    end
    self.model = model
    self.params = params
    self.opt = opt
    self.sgd = opt
    self.base_lr = self.lr
    self.best_snapshot = nil
    self._dirty = false
    return self
end

--- Checkpoint layout compat.  Fused QKV stores one (dim x 3*dim) projection
--- per layer; builds before the fusion stored three separate (dim x dim)
--- ones -- exactly two more parameter tensors per layer.  When :load() hits
--- an nparams mismatch matching that signature, rebuild the model in the
--- legacy layout so the positional parameter stream still lines up.  Returns
--- true if the model was rebuilt.
function LMTrain:_relayout_for_checkpoint(nparams_file)
    create m = self.model
    if not m or m.fused_qkv == nil or type(m.layers) != "table" then
        return false
    end
    if not m.fused_qkv then return false end
    create ok_p, n_now = pcall(function() return len(m:parameters()) end)
    if not ok_p then return false end
    if nparams_file != n_now + 2 * self.layers then return false end
    self.fused_qkv = false
    self:_build()
    return true
end

function LMTrain.new(config)
    config = resolve_aliases(config or {}, "LMTrain")
    create self = setmetatable({}, LMTrain)
    config = coerce_data(config, self)

    self.history = {}
    self.best_loss = huge
    self.epoch = 0
    self.loss = nil
    self.val_loss = nil
    self.is_best = false
    self.stopped = nil
    self.elapsed = 0
    self.tokens_per_sec = 0
    self.inplace_bar = IS_TTY

    create preset = config.preset
    config.preset = nil

    repeat key, val in config do self[key] = val end
    repeat key, default_val in DEFAULTS do
        if self[key] == nil then self[key] = default_val end
    end

    self._auto_vocab = (config.vocab == nil)
    if self.data != nil then
        create max_id = scan_tokens(self.data)
        self._max_token_id = max_id
        if self._auto_vocab and max_id and max_id > self.vocab then
            self.vocab = max_id
        end
    end

    if type(preset) == "string" and preset != "auto" then
        create ps = LMTRAIN_PRESETS[preset]
        if ps then
            repeat pk, pv in ps do
                if config[pk] == nil then self[pk] = pv end
            end
        elseif self.hints and config.verbose != false then
            say(self, "[LMTrain] hint: unknown preset '" .. tostring(preset)
                .. "'. Known presets: tiny, small, base, medium, auto.")
        end
    end
    if preset == "auto" and self.data then
        create n = (type(self.data[1]) == "table") and len(self.data[1]) or len(self.data)
        create d, l, h, f
        if n < 100 then d, l, h, f = 32, 1, 4, 64
        elseif n < 1000 then d, l, h, f = 64, 2, 4, 128
        else d, l, h, f = 128, 4, 8, 256 end
        if config.dim == nil then self.dim = d end
        if config.layers == nil then self.layers = l end
        if config.heads == nil then self.heads = h end
        if config.ffn == nil then self.ffn = f end
    end

    self.base_lr = self.lr
    self:_build()
    self:_vocab_report()
    return self
end

function LMTrain:config(opts)
    opts = resolve_aliases(opts or {}, "LMTrain:config")
    if opts.tokenizer == nil and self.tokenizer != nil then opts.tokenizer = self.tokenizer end
    if opts.max_bytes == nil then opts.max_bytes = self.max_bytes end
    opts = coerce_data(opts, self)
    create rebuild = false
    repeat key, val in opts do
        self[key] = val
        if ARCH_KEYS[key] or OPT_KEYS[key] then rebuild = true end
    end
    if opts.vocab != nil then self._auto_vocab = false end
    if opts.data != nil then
        create max_id = scan_tokens(self.data)
        self._max_token_id = max_id
        self._vocab_reported = false
        if self._auto_vocab and max_id and max_id > self.vocab then
            self.vocab = max_id
            rebuild = true
        end
    end
    if opts.lr != nil then
        if not is_finite(self.lr) or self.lr <= 0 then
            error("LMTrain:config: 'lr' must be a positive finite number, got "
                .. tostring(self.lr), 2)
        end
        self.base_lr = self.lr
        if self.opt then self.opt.lr = self.lr end
    end
    if rebuild then self._dirty = true end
    return self
end

function LMTrain:bar(opts)
    if type(opts) == "number" or type(opts) == "string" then opts = { "type":  opts  } end
    opts = opts or {}
    if type(opts) != "table" then error("LMTrain:bar: expected a style id or an options table", 2) end
    create style = opts.type or opts.style or opts.bar
    if style != nil then
        if type(style) != "table" and BAR_CHARS[style] == nil then
            error(sformat("LMTrain:bar: unknown bar type %s", tostring(style)), 2)
        end
        self.bar_style = style
    end
    create barlen = opts.len or opts.width or opts.bar_len
    if barlen != nil then
        if not is_int(barlen) or barlen < 1 then
            error("LMTrain:bar: bar width must be a positive integer, got " .. tostring(barlen), 2)
        end
        self.bar_len = barlen
    end
    if opts.every != nil then
        if not is_int(opts.every) or opts.every < 1 then
            error("LMTrain:bar: 'every' must be a positive integer, got " .. tostring(opts.every), 2)
        end
        self.every = opts.every
    end
    if opts.inplace != nil then self.inplace_bar = opts.inplace and true or false end
    if opts.off == true then self.verbose = false end
    if opts.on == true then self.verbose = true end
    return self
end

function LMTrain:reset()
    self.history = {}
    self.best_loss = huge
    self.loss = nil
    self.val_loss = nil
    self.epoch = 0
    self.is_best = false
    self.stopped = nil
    self.elapsed = 0
    -- On the GPU path best_snapshot holds device handles.  Dropping the Lua
    -- reference alone strands that VRAM until a GC cycle happens to run the
    -- finalizers, with no way to reach it in the meantime; release it.
    if self.gpu_model and self.best_snapshot then
        pcall(function() self.gpu_model:release_snapshot(self.best_snapshot) end)
    end
    self.best_snapshot = nil
    self._dirty = true
    return self
end

function LMTrain:summary()
    return sformat(
        "LMTrain%s: vocab=%d dim=%d layers=%d heads=%d ffn=%d pos=%s causal=%s ctx=%d | "
        .. "%s lr=%g sched=%s bs=%d | epoch=%d loss=%s best=%s",
        self.name and (" " .. tostring(self.name)) or "",
        self.vocab, self.dim, self.layers, self.heads, self.ffn,
        tostring(self.pos), tostring(self.causal), self.max_seq,
        tostring(self.optimizer), self.base_lr or self.lr, tostring(self.sched),
        self.batch_size, self.epoch,
        self.loss and sformat("%.5f", self.loss) or "n/a",
        self.best_loss < huge and sformat("%.5f", self.best_loss) or "n/a")
end

function LMTrain:_lr_at(step, total_steps)
    create sched = string.lower(self.sched or "cosine")
    if sched == "none" or sched == "constant" then return self.base_lr end
    create warm = floor(self.warmup * total_steps)
    if warm > 0 and step <= warm then return self.base_lr * (step / warm) end
    create denom = total_steps - warm
    create progress = denom > 0 and ((step - warm) / denom) or 1
    if progress > 1 then progress = 1 end
    create lr
    if sched == "linear" then
        lr = self.base_lr * (1 - progress)
    else
        lr = self.lr_min + 0.5 * (self.base_lr - self.lr_min) * (1 + cos(pi * progress))
    end
    if lr < self.lr_min then lr = self.lr_min end
    return lr
end

function LMTrain:evaluate(windows)
    if self.gpu_model then return self:_evaluate_gpu(windows) end
    create model = self.model
    create prev_training = Tensor.training
    Tensor.training = false
    create total, count, correct = 0, 0, 0
    Tensor.no_grad(function()
        do
    create __fa = (1)
    create __fb = (len(windows) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create w = windows[i]
            create logits = model:forward(w[1])
            create loss = Tensor.cross_entropy(logits, w[2])
            total = total + loss:item() * w[3]
            count = count + w[3]
            create ld, lcols = logits.data.data, logits.data.cols
            do
    create __fa = (1)
    create __fb = (logits.data.rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs

                create base = (r - 1) * lcols
                create best_id, best_val = 1, -huge
                do
    create __fa = (1)
    create __fb = (lcols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create c = __fa + __j * __fs

                    create v = ld[base + c]
                    if v > best_val then best_val, best_id = v, c end
                end
end
                if best_id == w[2][r] then correct = correct + 1 end
            end
end
        end
end
    end)
    Tensor.training = prev_training
    if count == 0 then return 0, 0 end
    return total / count, 100 * correct / count
end

--- Shared end-of-run best-weight restore policy, so both loops behave the
--- same.  `restore_best = "auto"` (default) preserves the historical
--- behaviour exactly; it just no longer does it silently.
function LMTrain:_should_restore_best()
    create mode = self.restore_best
    if mode == nil then mode = "auto" end
    if not self.keep_best or not self.best_snapshot then return false end
    if mode == true then return true end
    if mode == false then return false end
    if self.stopped != "epochs" then return true end
    -- Completed all epochs: historical behaviour keeps the FINAL weights even
    -- if an earlier epoch was better.  Surprising after overfitting, so say so
    -- rather than change results under existing users.
    create final = self.val_loss or self.loss
    if final and self.best_loss < huge and final > self.best_loss + 1e-12 then
        say(self, sformat("[LMTrain] note: final loss %.5f is worse than the best seen "
            .. "(%.5f) but the run completed all epochs, so the FINAL weights are kept "
            .. "(historical behaviour). Pass restore_best = true to keep the best instead.",
            final, self.best_loss))
    end
    return false
end

function LMTrain:run()
    if self.data == nil then
        error("LMTrain: no data set, use LMTrain{ data = {...} }, LMTrain{ data_file = 'f.txt' } "
            .. "or train:config{ data = {...} }", 2)
    end
    check_config(self, ":run")

    if self._dirty or self.model == nil or self.opt == nil then self:_build() end

    -- Resume BEFORE validating data: :load() overwrites self.vocab from the
    -- checkpoint header, so validating first would check the tokens against
    -- the wrong vocabulary.  :load() also calls _build() and clears _dirty.
    self:_maybe_resume()

    create sequences = validate_data(self.data, self.vocab, ":run")
    self:_vocab_report()

    if self.causal == false and self.verbose then
        say(self, "LMTrain: warning -- causal = false with next-token training lets every "
            .. "position attend to its own target. Loss will drop unrealistically fast.")
    end

    create all = build_windows(sequences, self.max_seq, self.stride)
    if len(all) == 0 then error("LMTrain: data produced no training windows", 2) end

    create train_w, val_w = all, {}
    if self.val_split > 0 and len(all) > 1 then
        create nval = floor(len(all) * self.val_split)
        if nval < 1 then nval = 1 end
        if nval >= len(all) then nval = len(all) - 1 end
        train_w, val_w = {}, {}
        do
    create __fa = (1)
    create __fb = (len(all) - nval )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 train_w[i] = all[i] end
end
        do
    create __fa = (len(all) - nval + 1)
    create __fb = (len(all) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 val_w[len(val_w) + 1] = all[i] end
end
    end

    -- GPU-resident path
    if self.gpu_model then return self:_run_gpu(train_w, val_w, build_windows) end

    create model, opt, params = self.model, self.opt, self.params
    create nwin = len(train_w)
    create bs = self.batch_size
    if bs > nwin then bs = nwin end
    create nbatch = ceil(nwin / bs)
    create total_steps = self.epochs * nbatch

    -- Gradient accumulation: optimizer steps happen once per `ga` batches,
    -- so effective batch = batch_size * ga without extra activation memory.
    create ga = self.grad_accum or 1
    if type(ga) != "number" or ga != ga or ga < 1 or ga != floor(ga) then
        error("LMTrain: 'grad_accum' must be a positive integer, got " .. tostring(ga), 2)
    end
    create total_opt_steps = self.epochs * ceil(nbatch / ga)
    create order = {}
    do
    create __fa = (1)
    create __fb = (nwin )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 order[i] = i end
end

    create started = wall()
    create reporter = lmlog.new{ "total_steps":  total_steps, "bar_style":  self.bar_style, "bar_len":  self.bar_len, "interval":  self.log_every_sec, "inplace":  self.inplace_bar }
    self._reporter = reporter
    create stalled = 0
    create gstep = 0
    self.stopped = nil

    self:_autosave_begin()

    do
    create __fa = (1)
    create __fb = (self.epochs )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create epoch = __fa + __j * __fs

        self.epoch = epoch
        Tensor.training = true

        if self.shuffle then
            do
    create __fa = (nwin)
    create __fb = (2)
    create __fs = (-1 )
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

                create j = math.random(i)
                order[i], order[j] = order[j], order[i]
            end
end
        end

        create sum_loss, sum_tok, correct, skipped = 0, 0, 0, 0
        create last_norm = 0

        do
    create __fa = (1)
    create __fb = (nbatch )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create b = __fa + __j * __fs

            create lo = (b - 1) * bs + 1
            create hi = lo + bs - 1
            if hi > nwin then hi = nwin end
            create n_in_batch = hi - lo + 1

            -- zero at the START of each accumulation group; after every
            -- optimizer step the grads are zeroed too, so this only really
            -- matters for the very first group of a run.
            if (b - 1) % ga == 0 then opt.zero_grad() end
            create batch_tokens = 0
            create batch_loss = 0

            do
    create __fa = (lo)
    create __fb = (hi )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

                create w = train_w[order[k]]
                create logits = model:forward(w[1])
                create loss = Tensor.cross_entropy(logits, w[2])
                loss:backward()
                batch_loss = batch_loss + loss:item() * w[3]
                batch_tokens = batch_tokens + w[3]
                create ld, lcols = logits.data.data, logits.data.cols
                do
    create __fa = (1)
    create __fb = (logits.data.rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs

                    create base = (r - 1) * lcols
                    create best_id, best_val = 1, -huge
                    do
    create __fa = (1)
    create __fb = (lcols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create c = __fa + __j * __fs

                        create v = ld[base + c]
                        if v > best_val then best_val, best_id = v, c end
                    end
end
                    if best_id == w[2][r] then correct = correct + 1 end
                end
end
            end
end

            if n_in_batch > 1 then optim2.scale_grads(params, 1 / n_in_batch) end

            -- Only step the optimizer on accumulation boundaries.  A
            -- non-finite group is dropped entirely (zeroed), matching the
            -- old skip semantics but at group granularity.
            if (b % ga == 0) or (b == nbatch) then
                create norm = optim2.grad_norm(params)
                last_norm = norm
                create finite = (norm == norm) and norm != huge and norm != -huge
                if not finite then
                    skipped = skipped + 1
                    optim2.zero(params)
                else
                    if self.clip_norm and self.clip_norm > 0 and norm > self.clip_norm then
                        optim2.scale_grads(params, self.clip_norm / norm)
                    end
                    gstep = gstep + 1
                    opt.lr = self:_lr_at(gstep, total_opt_steps)
                    self.cur_lr = opt.lr
                    opt.step()
                    optim2.zero(params)
                end
            end

            sum_loss = sum_loss + batch_loss
            sum_tok = sum_tok + batch_tokens
            reporter:tick(batch_tokens)
            if self.verbose then
                reporter:update({ "step":  (epoch - 1) * nbatch + b, "epoch":  epoch, "epochs":  self.epochs, "batch":  b, "nbatch":  nbatch, "loss":  batch_tokens > 0 and (batch_loss / batch_tokens) or 0, "lr":  self.cur_lr, "gnorm":  last_norm })
            end
            -- Time-based auto-save only; an epoch on a big corpus can be long.
            if self._as and self._as.seconds then self:_autosave_tick("batch") end
        end
end

        Tensor.training = false
        create avg_loss = sum_tok > 0 and (sum_loss / sum_tok) or huge
        self.loss = avg_loss
        self.accuracy = sum_tok > 0 and (100 * correct / sum_tok) or 0
        self.grad_norm = last_norm
        self.elapsed = wall() - started
        self.tokens_per_sec = reporter.rate

        -- Fresh-validation gate.  With eval_every > 1, self.val_loss on a
        -- non-eval epoch is STALE (from an earlier epoch), so comparing it to
        -- best_loss made is_best permanently false and inflated `patience`
        -- with phantom stalls.  Only judge on an epoch whose monitor is real.
        create did_eval = false
        if len(val_w) > 0 and (epoch % self.eval_every == 0 or epoch == self.epochs) then
            self.val_loss, self.val_accuracy = self:evaluate(val_w)
            did_eval = true
        end
        create use_val = (len(val_w) > 0)
        self._monitor_valid = (not use_val) or did_eval
        create monitor = use_val and self.val_loss or avg_loss

        self.history[len(self.history) + 1] = { "epoch":  epoch, "loss":  avg_loss, "val_loss":  self.val_loss, "accuracy":  self.accuracy, "lr":  self.cur_lr, "grad_norm":  last_norm, "time":  self.elapsed, "skipped":  skipped }

        if not is_finite(avg_loss) then
            self.stopped = "diverged"
            self.is_best = false
            reporter:say(sformat("LMTrain: stopping at epoch %d, loss became %s. Weights were "
                .. "not updated with non-finite gradients; try a smaller lr.",
                epoch, tostring(avg_loss)))
            break
        end

        if self._monitor_valid then
            self.is_best = monitor < (self.best_loss - self.min_delta)
            if self.is_best then
                self.best_loss = monitor
                stalled = 0
                if self.keep_best then self.best_snapshot = snapshot(params) end
            else
                if monitor < self.best_loss then self.best_loss = monitor end
                stalled = stalled + 1
            end
        else
            self.is_best = false
        end

        if self.verbose and (epoch % self.every == 0 or epoch == self.epochs or epoch == 1) then
            if type(self.log) == "function" then
                create ok, err = pcall(self.log, self)
                if not ok then
                    error(sformat("LMTrain: custom log function failed at epoch %d: %s",
                        epoch, tostring(err)), 2)
                end
            else
                reporter:update({ "step":  epoch * nbatch, "epoch":  epoch, "epochs":  self.epochs, "batch":  nbatch, "nbatch":  nbatch, "loss":  avg_loss, "acc":  self.accuracy, "lr":  self.cur_lr, "gnorm":  last_norm, "val_loss":  self.val_loss, "best":  self.is_best }, true)
            end
        end

        -- Live text samples: a little generated snippet every K epochs --
        -- the most fun way to watch a language model learn.  Guarded by
        -- pcall so odd prompt/decode configs can never kill training.
        if self.sample_every and self.sample_every > 0
            and (epoch % self.sample_every == 0 or epoch == self.epochs)
            and type(self.generate) == "function" then
            create sp = self.sample_prompt
            if sp == nil and type(self.data) == "string" then
                sp = self.data:sub(1, 12)
            end
            create ok_s, snippet = pcall(self.generate, self, sp or " ",
                tonumber(self.sample_len) or 60,
                { "temperature":  tonumber(self.sample_temperature) or 0.8  })
            if ok_s and type(snippet) == "string" then
                reporter:say(sformat("[sample @%d] %s", epoch, snippet))
            end
        end

        self:_autosave_tick("epoch")

        if self.stop_loss and self._monitor_valid and monitor <= self.stop_loss then
            self.stopped = "stop_loss"
            reporter:say(sformat("Stopped early at epoch %d: loss %.5f reached stop_loss %.5f",
                epoch, monitor, self.stop_loss))
            break
        end

        if self.stop_when then
            create ok, hit = pcall(self.stop_when, self)
            if not ok then
                error(sformat("LMTrain: stop_when failed at epoch %d: %s", epoch, tostring(hit)), 2)
            end
            if hit then
                self.stopped = "stop_when"
                reporter:say(sformat("Stopped early at epoch %d: stop_when condition met", epoch))
                break
            end
        end

        if self.patience > 0 and stalled >= self.patience then
            self.stopped = "patience"
            reporter:say(sformat("Stopped early at epoch %d: no improvement for %d epochs "
                .. "(best %.5f)", epoch, stalled, self.best_loss))
            break
        end
        collectgarbage("collect")
    end
end

    if self.stopped == nil then self.stopped = "epochs" end
    reporter:finish()

    -- Restore FIRST, then write the final checkpoint, so the file on disk
    -- contains the weights the user is actually left holding.
    if self:_should_restore_best() then
        if restore(self.params, self.best_snapshot) and self.verbose then
            say(self, sformat("Restored best weights (loss %.5f)", self.best_loss))
        end
    end
    self:_autosave_tick("final")
    self:_autosave_end()

    opt.lr = self.base_lr
    self.lr = self.base_lr
    Tensor.training = false
    self._reporter = nil

    if type(self.on_stop) == "function" then pcall(self.on_stop, self) end
    return self.model
end

create function pick_token(row, cols, temperature, top_k, top_p)
    if not temperature or temperature <= 0 then
        create best_id, best_val = 1, -huge
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create v = row[j]
            if v > best_val then best_val, best_id = v, j end
        end
end
        return best_id
    end

    top_k = top_k or 0
    top_p = top_p or 0

    create idx, n
    if top_p > 0 and top_p < 1 then
        idx = {}
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 idx[j] = j end
end
        table.sort(idx, function(x, y) return row[x] > row[y] end)
        n = (top_k > 0 and top_k < cols) and top_k or cols
    elseif top_k > 0 and top_k < cols then
        idx = {}
        create vals = {}
        do
    create __fa = (1)
    create __fb = (top_k )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs
 idx[r] = 0; vals[r] = -huge end
end
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create v = row[j]
            if v > vals[top_k] then
                create r = top_k
                while r > 1 and vals[r - 1] < v do
                    vals[r], idx[r] = vals[r - 1], idx[r - 1]
                    r = r - 1
                end
                vals[r], idx[r] = v, j
            end
        end
end
        n = top_k
    else
        idx = {}
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 idx[j] = j end
end
        n = cols
    end

    create max_val = -huge
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs

        create v = row[idx[r]]
        if v > max_val then max_val = v end
    end
end

    create probs, sum = {}, 0
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs

        create e = exp((row[idx[r]] - max_val) / temperature)
        probs[r] = e
        sum = sum + e
    end
end

    create limit = n
    if top_p > 0 and top_p < 1 then
        create acc = 0
        do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs

            acc = acc + probs[r] / sum
            if acc >= top_p then limit = r break end
        end
end
    end

    create norm = 0
    do
    create __fa = (1)
    create __fb = (limit )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs
 norm = norm + probs[r] end
end
    create target = math.random() * norm
    create acc = 0
    do
    create __fa = (1)
    create __fb = (limit )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs

        acc = acc + probs[r]
        if acc >= target then return idx[r] end
    end
end
    return idx[limit]
end

-- Feed tokens[lo..hi] into the KV cache in one vectorised pass when the
-- model exposes :prefill (batched prompt processing); otherwise fall back to
-- per-token :step.  Returns the logits table for the last token fed.
create function fill_cache(model, tokens, lo, hi, state)
    if type(model.prefill) == "function" then
        create prompt = {}
        do
    create __fa = (lo)
    create __fb = (hi )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 prompt[len(prompt) + 1] = tokens[i] end
end
        return model:prefill(prompt, state)
    end
    create logits
    do
    create __fa = (lo)
    create __fb = (hi )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 logits = model:step(tokens[i], state) end
end
    return logits
end

function LMTrain:generate(seed_tokens, n, opts)
    if self.model == nil then
        error("LMTrain:generate: no model yet -- call train:run() or train:load(path) first", 2)
    end
    opts = opts or {}
    n = n or 1
    if not is_int(n) or n < 0 then
        error("LMTrain:generate: n must be a non-negative integer, got " .. tostring(n), 2)
    end

    create was_string = type(seed_tokens) == "string"
    if was_string then
        seed_tokens = self.tokenizer and self.tokenizer:encode(seed_tokens)
            or LMTrain.encode(seed_tokens)
    end
    if type(seed_tokens) != "table" or len(seed_tokens) == 0 then
        error("LMTrain:generate: need at least one seed token", 2)
    end

    create tokens = {}
    do
    create __fa = (1)
    create __fb = (len(seed_tokens) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create tok = seed_tokens[i]
        if not is_int(tok) or tok < 1 or tok > self.vocab then
            error(sformat("LMTrain:generate: seed token %d = %s is outside 1..%d",
                i, tostring(tok), self.vocab), 2)
        end
        tokens[i] = tok
    end
end

    create temperature = opts.temperature or self.temperature
    create top_k = opts.top_k or self.top_k
    create top_p = opts.top_p or self.top_p
    create max_ctx = opts.ctx or opts.max_ctx or self.max_seq

    -- PROBLEM 2: with byte-level ids and an over-provisioned vocab the head
    -- emits logits for rows that can never be decoded.  Sampling those raises
    -- deep inside LMTrain.decode; restrict the candidate set instead.  Only
    -- applied when tokenization is KNOWN byte-level -- clamping user-supplied
    -- raw ids would silently change their model's behaviour.
    create limit = self.vocab
    if self._sample_limit and self:_tokenization() == "byte" then
        limit = math.min(limit, self._sample_limit)
    end

    create stop = opts.stop
    if type(stop) == "string" then
        create enc = self.tokenizer and self.tokenizer:encode(stop) or LMTrain.encode(stop)
        if len(enc) != 1 then
            error(sformat("LMTrain:generate: stop string %q encodes to %d tokens; "
                .. "pass a single token id instead", stop, len(enc)), 2)
        end
        stop = enc[1]
    end
    if stop != nil and not is_int(stop) then
        error("LMTrain:generate: 'stop' must be a token id or a single-token string", 2)
    end

    create model = self.model
    create prev_training = Tensor.training
    Tensor.training = false

    create use_cache = type(model.new_state) == "function" and type(model.step) == "function"
    create ok, err = pcall(function()
        if use_cache then
            create state = model:new_state()
            create first = len(tokens) - max_ctx + 1
            if first < 1 then first = 1 end
            create logits = fill_cache(model, tokens, first, len(tokens), state)
            do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create _ = __fa + __j * __fs

                create next_id = pick_token(logits, limit, temperature, top_k, top_p)
                tokens[len(tokens) + 1] = next_id
                if stop != nil and next_id == stop then break end
                if state.n >= max_ctx then
                    state = model:new_state()
                    create lo = len(tokens) - max_ctx + 1
                    if lo < 1 then lo = 1 end
                    logits = fill_cache(model, tokens, lo, len(tokens), state)
                else
                    logits = model:step(next_id, state)
                end
            end
end
        else
            Tensor.no_grad(function()
                do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create _ = __fa + __j * __fs

                    create window = tokens
                    if len(tokens) > max_ctx then
                        window = {}
                        do
    create __fa = (len(tokens) - max_ctx + 1)
    create __fb = (len(tokens) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

                            window[len(window) + 1] = tokens[i]
                        end
end
                    end
                    create out = model:forward(window)
                    create cols = out.data.cols
                    create base = (out.data.rows - 1) * cols
                    create ncand = math.min(cols, limit)
                    create row = {}
                    do
    create __fa = (1)
    create __fb = (ncand )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 row[j] = out.data.data[base + j] end
end
                    create next_id = pick_token(row, ncand, temperature, top_k, top_p)
                    tokens[len(tokens) + 1] = next_id
                    if stop != nil and next_id == stop then break end
                end
end
            end)
        end
    end)

    Tensor.training = prev_training
    if not ok then error(err, 2) end

    if was_string then
        if self.tokenizer then return self.tokenizer:decode(tokens) end
        return LMTrain.decode(tokens)
    end
    return tokens
end

function LMTrain:parameters()
    if self._dirty or self.model == nil then self:_build() end
    return self.params
end

--- Release GPU resources deterministically.  Model:free() existed and was
--- never called from anywhere.
function LMTrain:close()
    if self.gpu_model then
        if self.best_snapshot then
            pcall(function() self.gpu_model:release_snapshot(self.best_snapshot) end)
            self.best_snapshot = nil
        end
        pcall(function() self.gpu_model:free() end)
        self.gpu_model, self.model, self.params = nil, nil, {}
        self._dirty = true
    end
    return self
end

LMTrain.ARCH_KEYS = ARCH_KEYS
LMTrain.DEFAULTS = DEFAULTS
LMTrain.ALIASES = ALIASES
LMTrain._snapshot = snapshot
LMTrain._restore = restore
LMTrain._build_windows = build_windows

create ok_io, lmio = pcall(require, "lmio")
if ok_io and type(lmio) == "function" then lmio(LMTrain) end
if ok_gpu_mod then lmtrain_gpu.install(LMTrain) end

setmetatable(LMTrain, { "__call":  function(_, ...) return LMTrain.new(...) end  })

return LMTrain

#=lucfile: lmtrain_gpu.luc
--  The CPU path is never touched.  If backend ~= "gpu" none of this runs.

create lmlog = require("lmlog")

create G = {}

create ceil, huge = math.ceil, math.huge
create sformat = string.format

--  lmio (:save/:load) and LMTrain._snapshot/_restore walk
--  `params[i].data.data` as a flat 1-indexed Lua table.  We hand them a
--  host mirror of each GPU parameter with exactly that shape so the
--  metadata (rows/cols/count) is right on both backends.
--
--  The `.data` array itself stays EMPTY by default.  Materialising it for a
--  134M-parameter model means a 134M-slot Lua table (>1 GB in LuaJIT, plus
--  GC churn) for a mirror nothing reads.  lmio instead goes through
--  _param_get/_param_set, overridden below to stream fixed-size chunks
--  straight out of VRAM.  _gpu_pull() remains available for code that
--  genuinely wants the host copy, and now says no when that would be
--  ruinous unless explicitly forced.
create function make_shims(model)
    create shims = {}
    do
    create __fa = (1)
    create __fb = (len(model.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create p = model.params[i]
        shims[i] = { "name":  p.name, "is_param":  true, "gpu":  p, "data":  { "rows":  p.rows, "cols":  p.cols, "data":  {}  }, "grad":  { "rows":  p.rows, "cols":  p.cols, "data":  {}  } }
    end
end
    return shims
end

function G.install(LMTrain)
    if LMTrain._gpu_installed then return LMTrain end
    LMTrain._gpu_installed = true

    create cpu_param_get   = LMTrain._param_get
    create cpu_param_set   = LMTrain._param_set
    create cpu_param_dtype = LMTrain._param_dtype

    -- ---- lmio streaming hooks ---------------------------------------
    function LMTrain:_param_dtype()
        if self.gpu_model then return "f32" end
        return cpu_param_dtype and cpu_param_dtype(self) or "f64"
    end

    function LMTrain:_param_get(i, from, count, dst)
        if not self.gpu_model then return cpu_param_get(self, i, from, count, dst) end
        return self.gpu_model:read_param(i, from, count, dst)
    end

    function LMTrain:_param_set(i, from, count, src)
        if not self.gpu_model then return cpu_param_set(self, i, from, count, src) end
        return self.gpu_model:write_param(i, from, count, src)
    end

    --  Host <-> device weight mirroring (explicit, no longer automatic)
    create PULL_WARN = 8e6      -- elements

    function LMTrain:_gpu_pull(force)
        if not self.gpu_model then return self end
        create n = self.gpu_model:nparams()
        if n > PULL_WARN and not force then
            error(sformat("LMTrain:_gpu_pull: refusing to materialise %s parameters as Lua "
                .. "tables (~%s of host RAM). Use train:save(path) -- it streams straight "
                .. "from VRAM -- or pass force = true if you really need the mirror.",
                lmlog.fmt_count(n), lmlog.fmt_bytes(n * 16)), 2)
        end
        do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create s = self.params[i]
            s.data.data = s.gpu.w:toflat()
        end
end
        self._host_dirty = false
        return self
    end

    function LMTrain:_gpu_push()
        if not self.gpu_model then return self end
        do
    create __fa = (1)
    create __fb = (len(self.params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create s = self.params[i]
            create flat = s.data.data
            if flat and len(flat) == s.gpu.nelem then s.gpu.w:upload(flat) end
        end
end
        self._host_dirty = false
        return self
    end

    --  Build
    function LMTrain:_build_gpu()
        create ok_ad, adapter = pcall(require, "luatl_adapter")
        if not ok_ad or not adapter.available then
            error(sformat(
                "LMTrain: backend = 'gpu' was requested but luaTL is unavailable: %s\n" ..
                "  Build the CUDA backend and put luaTL.so / luaTL.dll on the load path:\n" ..
                "    nvcc -O3 -std=c++14 --shared -Xcompiler -fPIC \\\n" ..
                "         -gencode arch=compute_86,code=sm_86 --use_fast_math \\\n" ..
                "         luaTL_train.cu -o luaTL.so\n" ..
                "  Or set backend = 'cpu' to use the pure-Lua autograd path.",
                ok_ad and tostring(adapter.error or "not available")
                       or tostring(adapter)), 3)
        end

        create ok_gt, GT = pcall(require, "gpu_transformer")
        if not ok_gt then
            error("LMTrain: backend = 'gpu' but gpu_transformer.lua failed to load: "
                  .. tostring(GT), 3)
        end

        -- Release the previous device model BEFORE allocating the next one.
        -- :load() and any ARCH_KEYS change route through _build(), so this
        -- used to leave a full parameter + activation set alive until GC ran
        -- the handle finalizers -- i.e. train:load() twice was ~2x VRAM.
        -- best_snapshot must be dropped first: it aliases handles that
        -- Model:free() is about to release, and restoring it into a NEW model
        -- would hand freed device pointers to luaTL_gpu_copy.
        if self.gpu_model then
            if self.best_snapshot then
                pcall(function() self.gpu_model:release_snapshot(self.best_snapshot) end)
                self.best_snapshot = nil
            end
            create old = self.gpu_model
            self.gpu_model, self.model, self.params = nil, nil, {}
            pcall(function() old:free() end)
            collectgarbage("collect")
        end

        create bs = self.batch_size
        create ok_m, model = pcall(GT.new, { "vocab":  self.vocab, "dim":  self.dim, "layers":  self.layers, "heads":  self.heads, "ffn":  self.ffn, "max_seq":  self.max_seq, "batch_size":  bs, "causal":  self.causal, "pos":  self.pos, "rope_base":  self.rope_base, "tie":  self.tie, "dropout":  self.dropout, "clip_norm":  self.clip_norm, "weight_decay":  self.weight_decay, "beta1":  self.beta1, "beta2":  self.beta2, "graph":  self.graph, "timing":  true, "want_acc":  true })
        if not ok_m then
            error("LMTrain: GPU model construction failed: " .. tostring(model), 3)
        end

        create opt = string.lower(tostring(self.optimizer or "adamw"))
        if opt != "adamw" and opt != "adam" then
            error(sformat("LMTrain: backend = 'gpu' implements AdamW only, got optimizer = '%s'.\n"
                .. "  Use optimizer = 'adamw', or backend = 'cpu' for %s.", opt, opt), 3)
        end

        self.gpu_model = model
        self.model     = model
        self.params    = make_shims(model)
        self.opt       = { "lr":  self.lr, "zero_grad":  function() end, "step":  function() end, "backend":  "gpu"  }
        self.sgd       = self.opt
        self.base_lr   = self.lr
        self.best_snapshot = nil
        self._dirty      = false
        self._host_dirty = false

        if self.verbose then
            create hw = adapter.hardware()
            create gf = model:flops_per_step()
            lmlog.say(sformat(
                "[LMTrain] GPU backend ready: %s (%s, %d SMs, %.1f TFLOP/s fp32 peak)",
                hw.name, hw.sm, hw.multiprocessors, hw.gflops_fp32 / 1000))
            lmlog.say(sformat(
                "[LMTrain] %s params | %d x %d tokens/step | %.2f GFLOP/step | tie=%s",
                lmlog.fmt_count(model:nparams()), model.B, model.T,
                gf / 1e9, tostring(self.tie)))
            -- PROBLEM 2, GPU side: quantify what an oversized vocab costs.
            create vram_v = self.vocab * self.dim * 4 * (self.tie and 4 or 8)
            create logits = model.B * model.T * self.vocab * 4
            lmlog.say(sformat(
                "[LMTrain] vocab = %d costs ~%s of embedding state + ~%s per logits buffer",
                self.vocab, lmlog.fmt_bytes(vram_v), lmlog.fmt_bytes(logits)))
        end
        return self
    end

    --  evaluation (forward only)
    function LMTrain:_evaluate_gpu(windows)
        create m  = self.gpu_model
        create bs = m.B
        create tot, cnt, cor = 0, 0, 0
        create i = 1
        while i <= len(windows) do
            create batch, n = {}, 0
            while n < bs and i <= len(windows) do
                n = n + 1; batch[n] = windows[i]; i = i + 1
            end
            create loss, correct, valid = m:eval_step(batch, n)
            tot = tot + loss * valid
            cnt = cnt + valid
            cor = cor + correct
        end
        -- eval_step moves the model's _valid scalar, which is what gates CUDA
        -- graph replay.  Nothing to undo (train_step re-sets it every step),
        -- but worth stating: replay simply falls back to a queued run for one
        -- step after validation, which is correct, just marginally slower.
        if cnt == 0 then return 0, 0 end
        return tot / cnt, 100 * cor / cnt
    end

    --  The GPU run loop
    function LMTrain:_run_gpu(train_w, val_w, build_windows)
        create m  = self.gpu_model
        create bs = m.B
        create nwin = len(train_w)
        create nbatch = ceil(nwin / bs)
        create total_steps = self.epochs * nbatch
        create order = {}
        do
    create __fa = (1)
    create __fb = (nwin )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 order[i] = i end
end

        if self._host_dirty then self:_gpu_push() end

        create fpstep = m:flops_per_step()

        create rep = lmlog.new{ "total_steps":  total_steps, "bar_style":  self.bar_style, "bar_len":  self.bar_len, "interval":  self.log_every_sec, "inplace":  self.inplace_bar }
        self._reporter = rep

        create gstep, stalled = 0, 0
        create batch = {}
        self.stopped = nil

        self:_autosave_begin()

        do
    create __fa = (1)
    create __fb = (self.epochs )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create epoch = __fa + __j * __fs

            self.epoch = epoch

            if self.shuffle then
                do
    create __fa = (nwin)
    create __fb = (2)
    create __fs = (-1 )
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

                    create j = math.random(i)
                    order[i], order[j] = order[j], order[i]
                end
end
            end

            create sum_loss, sum_tok, correct, skipped = 0, 0, 0, 0
            create last_norm, ep_gpu_ms = 0, 0

            do
    create __fa = (1)
    create __fb = (nbatch )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create b = __fa + __j * __fs

                create lo = (b - 1) * bs + 1
                create hi = lo + bs - 1
                if hi > nwin then hi = nwin end
                create n = hi - lo + 1
                do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 batch[k] = train_w[order[lo + k - 1]] end
end
                do
    create __fa = (n + 1)
    create __fb = (len(batch) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 batch[k] = nil end
end   -- no stale windows

                gstep = gstep + 1
                create lr = self:_lr_at(gstep, total_steps)
                self.cur_lr = lr
                self.opt.lr = lr

                -- token ids in -> loss out -> weights updated
                create loss, corr, tok, gnorm, finite =
                    m:train_step(batch, n, lr, (m.steps or 0) + 1)

                if not finite then skipped = skipped + 1 else
                    sum_loss = sum_loss + loss * tok
                    sum_tok  = sum_tok + tok
                    correct  = correct + corr
                    last_norm = gnorm
                end
                ep_gpu_ms = ep_gpu_ms + (m:last_step_ms() or 0)
                rep:tick(tok)

                if self.verbose then
                    rep:update({ "step":  gstep, "epoch":  epoch, "epochs":  self.epochs, "batch":  b, "nbatch":  nbatch, "loss":  loss, "lr":  lr, "gnorm":  gnorm, "acc":  tok > 0 and (100 * corr / tok) or nil, "tflops":  (m:last_step_ms() or 0) > 0
                                 and (fpstep / (m:last_step_ms() * 1e-3) / 1e12) or nil, "val_loss":  self.val_loss })
                end

                m:maybe_capture()

                -- Safe between steps: the checkpoint only reads p.w.t via
                -- luaTL_download_f32 and never touches _valid, the CE/sum/adam
                -- command structs, or the captured graph.
                if self._as and self._as.seconds then self:_autosave_tick("batch") end
            end
end

            create avg = sum_tok > 0 and (sum_loss / sum_tok) or huge
            self.loss      = avg
            self.accuracy  = sum_tok > 0 and (100 * correct / sum_tok) or 0
            self.grad_norm = last_norm
            self.elapsed   = rep:elapsed()
            self.tokens_per_sec = rep.rate
            self.gpu_ms_per_epoch = ep_gpu_ms
            self.tflops = ep_gpu_ms > 0
                and (fpstep * nbatch / (ep_gpu_ms * 1e-3) / 1e12) or 0

            -- same stale-validation gate as the CPU loop
            create did_eval = false
            if len(val_w) > 0 and (epoch % self.eval_every == 0 or epoch == self.epochs) then
                self.val_loss, self.val_accuracy = self:_evaluate_gpu(val_w)
                did_eval = true
            end
            create use_val = (len(val_w) > 0)
            self._monitor_valid = (not use_val) or did_eval
            create monitor = use_val and self.val_loss or avg

            self.history[len(self.history) + 1] = { "epoch":  epoch, "loss":  avg, "val_loss":  self.val_loss, "accuracy":  self.accuracy, "lr":  self.cur_lr, "grad_norm":  last_norm, "time":  self.elapsed, "skipped":  skipped, "tflops":  self.tflops }

            if avg != avg or avg == huge or avg == -huge then
                self.stopped = "diverged"
                self.is_best = false
                rep:say(sformat("LMTrain: stopping at epoch %d, loss became %s. " ..
                    "No update was applied with non-finite gradients; try a smaller lr.",
                    epoch, tostring(avg)))
                break
            end

            if self._monitor_valid then
                self.is_best = monitor < (self.best_loss - self.min_delta)
                if self.is_best then
                    self.best_loss = monitor
                    stalled = 0
                    if self.keep_best then
                        -- GPU-to-GPU snapshot: no CPU RAM used.  Now writes
                        -- INTO a reusable buffer -- the old version allocated a
                        -- complete fresh parameter set in VRAM on every
                        -- improvement and relied on GC finalizers to reclaim
                        -- the previous one, so several full copies could be
                        -- live at once on exactly the OOM-prone hardware this
                        -- mechanism was added to protect.
                        self.best_snapshot = m:snapshot(self.best_snapshot)
                    end
                else
                    if monitor < self.best_loss then self.best_loss = monitor end
                    stalled = stalled + 1
                end
            else
                self.is_best = false
            end

            if self.verbose and (epoch % self.every == 0
                or epoch == self.epochs or epoch == 1) then
                if type(self.log) == "function" then
                    create ok, err = pcall(self.log, self)
                    if not ok then
                        error(sformat("LMTrain: custom log function failed at epoch %d: %s",
                              epoch, tostring(err)), 2)
                    end
                else
                    rep:update({ "step":  gstep, "epoch":  epoch, "epochs":  self.epochs, "batch":  nbatch, "nbatch":  nbatch, "loss":  avg, "acc":  self.accuracy, "lr":  self.cur_lr, "gnorm":  last_norm, "val_loss":  self.val_loss, "best":  self.is_best, "tflops":  self.tflops }, true)
                end
            end

            self:_autosave_tick("epoch")

            if self.stop_loss and self._monitor_valid and monitor <= self.stop_loss then
                self.stopped = "stop_loss"
                rep:say(sformat("Stopped early at epoch %d: loss %.5f reached stop_loss %.5f",
                    epoch, monitor, self.stop_loss))
                break
            end

            if self.stop_when then
                create ok, hit = pcall(self.stop_when, self)
                if not ok then
                    error(sformat("LMTrain: stop_when failed at epoch %d: %s",
                          epoch, tostring(hit)), 2)
                end
                if hit then
                    self.stopped = "stop_when"
                    rep:say(sformat("Stopped early at epoch %d: stop_when condition met", epoch))
                    break
                end
            end

            if self.patience > 0 and stalled >= self.patience then
                self.stopped = "patience"
                rep:say(sformat("Stopped early at epoch %d: no improvement for %d epochs "
                    .. "(best %.5f)", epoch, stalled, self.best_loss))
                break
            end
            collectgarbage("collect")
        end
end

        if self.stopped == nil then self.stopped = "epochs" end
        rep:finish()

        if self:_should_restore_best() then
            if m:restore(self.best_snapshot) and self.verbose then
                rep:say(sformat("Restored best weights (loss %.5f)", self.best_loss))
            end
        end

        -- Final checkpoint AFTER the restore, so the file matches the weights
        -- the caller is left with.  Streams from VRAM; no host mirror needed.
        self:_autosave_tick("final")
        self:_autosave_end()

        -- The unconditional self:_gpu_pull() that used to live here built a
        -- Lua table per parameter element at the end of EVERY run -- >1 GB of
        -- host RAM for a 134M model, for a mirror nothing reads.  Persistence
        -- now streams from VRAM instead.  Small models still get the mirror
        -- for backwards compatibility with code that pokes params[i].data.
        if m:nparams() <= PULL_WARN then
            pcall(function() self:_gpu_pull() end)
        else
            self._host_dirty = false
            self.params_on_device = true
        end

        self.opt.lr = self.base_lr
        self.lr = self.base_lr
        self._reporter = nil

        if type(self.on_stop) == "function" then pcall(self.on_stop, self) end
        return self.model
    end

    --  :load()
    create prev_load = LMTrain.load
    if type(prev_load) == "function" then
        function LMTrain:load(...)
            create r = { 1:  prev_load(self, ...)  }
            -- lmio's :load() writes through _param_set, which on the GPU path
            -- uploads directly to VRAM -- no host mirror to push afterwards.
            if self.gpu_model then self._host_dirty = false end
            -- was: `return unpack and unpack(r) or table.unpack(r)`, which
            -- evaluated table.unpack (nil in LuaJIT 5.1) whenever the wrapped
            -- call returned nil/false.
            create un = unpack or unpack
            return un(r, 1, select("#", ...) and len(r) or len(r))
        end
    end

    return LMTrain
end

return G
#=lucfile: luaTL.luc
-- lua2luc: 1-based access helper (works for LUC dicts and lists)
create function __at(L, i)
    if type(L) == "list" then
        return L[i - 1]
    end
    return L[i]
end

create ffi  = require("ffi")
create bit  = require("bit")

ffi.cdef[=[
typedef struct {
    int32_t  device, major, minor, mp_count, warp_size;
    int32_t  max_threads_per_block, max_threads_per_mp, max_blocks_per_mp;
    int32_t  regs_per_block, regs_per_mp, clock_khz, memory_clock_khz;
    int32_t  memory_bus_width, l2_cache_size, concurrent_kernels;
    int32_t  async_engines, unified_addressing, cooperative_launch;
    int32_t  has_tensor_cores, has_fp16, has_bf16, ecc_enabled;
    int32_t  integrated, cores_per_mp;
    uint64_t shared_mem_per_block, shared_mem_per_mp;
    uint64_t total_global_mem, free_global_mem;
    double   peak_mem_bandwidth_gbs, peak_fp32_gflops, peak_fp16_gflops;
    char     name[256];
} luaTL_devinfo_t;

typedef struct {
    int32_t tm, tn, tk, block_x, block_y, grid_x, grid_y;
    int32_t shmem_bytes, kernel_id, unroll, use_tensor_core, from_cache;
    double  measured_ms;
} luaTL_plan_t;

typedef struct {
    uint64_t bytes_reserved, bytes_in_use, peak_in_use;
    uint64_t block_count, free_block_count;
    uint64_t n_alloc, n_free, n_cuda_malloc, n_cuda_free;
    uint64_t n_cache_hit, n_cache_miss, n_trim;
} luaTL_pool_stats_t;

typedef struct luaTL_pool_s luaTL_pool_t;

typedef struct {
    void*    data;
    uint64_t nelem, nbytes;
    int32_t  rows, cols, dtype, owns;
    void*    pool;
    int32_t  device, flags;
} luaTL_tensor_t;

typedef struct {
    char*    base;
    uint64_t capacity, offset, peak, alignment;
    void*    pool;
} luaTL_arena_t;

typedef struct {
    int32_t  op, dtype, act, flags;
    int32_t  i0, i1, i2, i3;
    float    f0, f1, f2, f3, f4, f5;
    uint64_t n;
    void    *p0, *p1, *p2, *p3, *p4, *p5;
} luaTL_cmd_t;

typedef struct {
    luaTL_cmd_t* cmds;
    int32_t      count, capacity, flags, status;
    void        *stream, *ev_start, *ev_stop;
    double       last_ms;
    uint64_t     total_runs, total_ops;
    int32_t      owns_stream, timing;
} luaTL_pipeline_t;

/* -- runtime -- */
const char*  luaTL_version(void);
void         luaTL_set_verbose(int on);
int          luaTL_init(int device);
void         luaTL_shutdown(void);
const char*  luaTL_device_name(void);
const char*  luaTL_get_last_error(void);
int          luaTL_has_error(void);
void         luaTL_clear_error(void);
int          luaTL_sync(void);
int          luaTL_get_devinfo(int device, luaTL_devinfo_t* out);
int          luaTL_mem_info(uint64_t* freeb, uint64_t* totalb);

/* -- streams / pinned host memory -- */
void*        luaTL_stream_create(int nonblocking);
void         luaTL_stream_destroy(void* s);
int          luaTL_stream_sync(void* s);
void*        luaTL_host_alloc_pinned(uint64_t bytes);
void         luaTL_host_free_pinned(void* p);

/* -- pool -- */
luaTL_pool_t* luaTL_pool_create(int device);
void          luaTL_pool_destroy(luaTL_pool_t* P);
luaTL_pool_t* luaTL_default_pool(void);
void*         luaTL_tensor_alloc(luaTL_pool_t* P, uint64_t bytes);
void          luaTL_tensor_free(luaTL_pool_t* P, void* ptr);
void          luaTL_pool_trim(luaTL_pool_t* P);
int           luaTL_pool_get_stats(luaTL_pool_t* P, luaTL_pool_stats_t* out);
int           luaTL_pool_owns(luaTL_pool_t* P, void* ptr);

/* -- arena -- */
luaTL_arena_t* luaTL_arena_create(luaTL_pool_t* P, uint64_t bytes);
void           luaTL_arena_destroy(luaTL_arena_t* A);
void*          luaTL_arena_alloc(luaTL_arena_t* A, uint64_t bytes);
void           luaTL_arena_reset(luaTL_arena_t* A);

/* -- tensors -- */
int  luaTL_tensor_init(luaTL_tensor_t* t, int rows, int cols, int dtype, luaTL_pool_t* P);
int  luaTL_tensor_wrap(luaTL_tensor_t* t, void* data, int rows, int cols, int dtype);
void luaTL_tensor_release(luaTL_tensor_t* t);
int  luaTL_tensor_view(luaTL_tensor_t* dst, const luaTL_tensor_t* src, int row_off, int rows, int cols);
int  luaTL_tensor_zero(luaTL_tensor_t* t);
int  luaTL_tensor_upload(luaTL_tensor_t* t, const float* host, uint64_t nelem);
int  luaTL_tensor_download(const luaTL_tensor_t* t, float* host, uint64_t nelem);
int  luaTL_tensor_copy(const luaTL_tensor_t* src, luaTL_tensor_t* dst);
int  luaTL_tensor_cast(const luaTL_tensor_t* src, luaTL_tensor_t* dst);

/* -- legacy raw pointer API -- */
float* luaTL_gpu_malloc(uint64_t nelem);
void   luaTL_gpu_free(float* p);
int    luaTL_to_gpu(const float* host, float* dev, uint64_t nelem);
int    luaTL_to_cpu(const float* dev, float* host, uint64_t nelem);
int    luaTL_gpu_copy(const float* src, float* dst, uint64_t nelem);
int    luaTL_gpu_zero(float* p, uint64_t nelem);

/* -- autotuner -- */
int  luaTL_plan_gemm(int M, int N, int K, int dtype, int allow_tc, luaTL_plan_t* out);
void luaTL_set_tile_override(int kernel_id);
void luaTL_tune_reset(void);
int  luaTL_autotune_benchmark(int M, int N, int K, int dtype, int iters, luaTL_plan_t* out);

/* -- math --*/
int luaTL_gemm(const void* A, const void* B, void* C, const void* bias,
               const void* gamma, const float* rowscale,
               int M, int N, int K, int dtype,
               float alpha, float beta, float eps, int pre_op, int post_op);
int matmul_cuda(const float* A, const float* B, float* C, int M, int N, int K);
int fused_rmsnorm_matmul_cuda(const float* x, const float* gamma, const float* W,
                              float* out, const float* bias, int M, int N, int K, float eps);
int fused_gelu_matmul_cuda(const float* x, const float* W, float* out,
                           const float* bias, int M, int N, int K);
int fused_silu_matmul_cuda(const float* x, const float* W, float* out,
                           const float* bias, int M, int N, int K);
int fused_matmul_gelu_cuda(const float* A, const float* B, float* C,
                           const float* bias, int M, int N, int K);
int luaTL_elementwise(const void* A, const void* B, void* C, uint64_t n,
                      int dtype, int op, float alpha, float beta);
int add_cuda(const float* A, const float* B, float* C, uint64_t n);
int add_inplace_cuda(float* A, const float* B, uint64_t n, float alpha);
int luaTL_rmsnorm(const void* x, const void* w, void* out,
                  int rows, int cols, float eps, int dtype);
int rmsnorm_cuda(const float* x, const float* w, float* out, int rows, int cols, float eps);
int rmsnorm_inplace_cuda(float* x, const float* w, int rows, int cols, float eps);
int luaTL_softmax(const void* x, const void* bias, void* out, int rows, int cols,
                  float scale, int causal, int mask_offset, int dtype);
int softmax_cuda(const float* x, float* out, int rows, int cols);
int fused_add_bias_softmax_cuda(const float* x, const float* bias, float* out,
                                int rows, int cols, float scale, int causal);
int luaTL_bcast_add(const void* x, const void* v, void* out,
                    int rows, int cols, float alpha, int dtype);
int luaTL_transpose(const void* in, void* out, int rows, int cols, int dtype);
int luaTL_rms_rowscale(const void* x, float* scale, int rows, int cols, float eps, int dtype);
int luaTL_adamw(float* w, const void* g, float* m, float* v, void* w_lp,
                uint64_t n, int grad_dtype, float lr, float beta1, float beta2,
                float eps, float wd, int step, float clip);

/* -- pipeline -- */
luaTL_pipeline_t* luaTL_pipeline_create(int capacity, int timing);
void              luaTL_pipeline_destroy(luaTL_pipeline_t* P);
void              luaTL_pipeline_reset(luaTL_pipeline_t* P);
int               luaTL_pipeline_push(luaTL_pipeline_t* P, const luaTL_cmd_t* cmd);
int               luaTL_pipeline_run(luaTL_pipeline_t* P);
int               luaTL_pipeline_wait(luaTL_pipeline_t* P);
]=]

--  Library loading
create CANDIDATES
if ffi.os == "Windows" then
    CANDIDATES = { 1:  "luaTL", 2:  "luaTL.dll", 3:  ".\\luaTL.dll"  }
else
    CANDIDATES = { 1:  "luaTL", 2:  "./luaTL.so", 3:  "libluaTL.so", 4:  "./libluaTL.so"  }
end

create C, load_err
do
    create __L = (CANDIDATES)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create name = __at(__L, __i + 1)

    create ok, lib = pcall(ffi.load, name)
    if ok then C = lib break else load_err = lib end
end
end
if not C then
    error("luaTL: cannot load the native library (" .. tostring(load_err) ..
          "). Build it with nvcc first.", 2)
end

create luaTL = { "_VERSION":  "luaTL 2.0", "C":  C  }

-- ---------------------------------------------------------------------
--  Constants
-- ---------------------------------------------------------------------
luaTL.F32, luaTL.F16, luaTL.BF16 = 0, 1, 2

luaTL.dtype = { "f32":  0, "float":  0, "f16":  1, "half":  1, "bf16":  2, "bfloat16":  2  }
luaTL.dtype_name = { (0):  "f32", (1):  "f16", (2):  "bf16"  }
luaTL.dtype_size = { (0):  4, (1):  2, (2):  2  }

luaTL.EW = { "COPY":  0, "ADD":  1, "SUB":  2, "MUL":  3, "DIV":  4, "SCALE":  5, "AXPY":  6, "FILL":  7, "RELU":  8, "GELU":  9, "SILU":  10, "TANH":  11, "SIGMOID":  12, "EXP":  13, "SQRT":  14, "RSQRT":  15, "NEG":  16, "RECIP":  17, "ABS":  18, "CLAMP":  19, "DRELU":  20, "DSILU":  21, "DGELU":  22 }

luaTL.ACT = { "NONE":  0, "RELU":  1, "GELU":  2, "SILU":  3, "TANH":  4, "SIGMOID":  5  }
luaTL.PRE = { "NONE":  0, "RMSNORM":  1, "GELU":  2, "SILU":  3, "RELU":  4  }

luaTL.OP = { "NOP":  0, "GEMM":  1, "EW":  2, "RMSNORM":  3, "SOFTMAX":  4, "CAST":  5, "TRANSPOSE":  6, "BCAST_ADD":  7, "ADAMW":  8, "ZERO":  9, "COPY":  10, "SYNC":  11 }

create STATUS_NAME = { (0):  "OK", (-1):  "NULL_POINTER", (-2):  "SHAPE", (-3):  "DTYPE", (-4):  "CUDA", (-5):  "OUT_OF_MEMORY", (-6):  "BAD_ARGUMENT", (-7):  "CAPACITY", (-8):  "UNSUPPORTED" }

--  Cached ctypes and reusable scratch cdata (avoids per-call allocation)
create tensor_ct  = ffi.typeof("luaTL_tensor_t")
create devinfo_ct = ffi.typeof("luaTL_devinfo_t")
create plan_ct    = ffi.typeof("luaTL_plan_t")
create stats_ct   = ffi.typeof("luaTL_pool_stats_t")
create float_ct   = ffi.typeof("float[?]")
create u64_1      = ffi.new("uint64_t[1]")
create u64_2      = ffi.new("uint64_t[1]")
create scratch_plan  = plan_ct()
create scratch_stats = stats_ct()

--  Error handling
create function last_error()
    create msg = ffi.string(C.luaTL_get_last_error())
    C.luaTL_clear_error()
    if msg == "" then msg = "unspecified backend error" end
    return msg
end
luaTL.last_error = last_error

create function ck(status, ctx)
    if status != 0 then
        error(string.format("luaTL[%s]: %s (%s)", ctx or "?",
              last_error(), STATUS_NAME[status] or ("status " .. tostring(status))), 3)
    end
    return status
end
luaTL.check = ck

--  Runtime control
luaTL.devinfo = nil
luaTL.device  = "<uninitialized>"

function luaTL.init(device, opts)
    opts = opts or {}
    C.luaTL_clear_error()
    create n = C.luaTL_init(device or 0)
    if n == 0 then
        error("luaTL.init failed: " .. last_error(), 2)
    end
    C.luaTL_set_verbose(opts.verbose and 1 or 0)

    luaTL.device  = ffi.string(C.luaTL_device_name())
    luaTL.devinfo = devinfo_ct()
    ck(C.luaTL_get_devinfo(-1, luaTL.devinfo), "get_devinfo")
    luaTL.core_version = ffi.string(C.luaTL_version())
    luaTL.pool = C.luaTL_default_pool()
    return n, luaTL.device
end

function luaTL.shutdown() C.luaTL_shutdown() end
function luaTL.sync() ck(C.luaTL_sync(), "sync") end
function luaTL.set_verbose(on) C.luaTL_set_verbose(on and 1 or 0) end

function luaTL.mem_info()
    ck(C.luaTL_mem_info(u64_1, u64_2), "mem_info")
    return tonumber(u64_1[0]), tonumber(u64_2[0])
end

function luaTL.hardware()
    create d = luaTL.devinfo
    if not d then return nil, "call luaTL.init() first" end
    return { "name":  ffi.string(d.name), "sm":  string.format("sm_%d%d", d.major, d.minor), "major":  d.major, "minor":  d.minor, "multiprocessors":  d.mp_count, "cores_per_sm":  d.cores_per_mp, "cuda_cores":  d.mp_count * d.cores_per_mp, "warp_size":  d.warp_size, "max_threads_block":  d.max_threads_per_block, "max_threads_sm":  d.max_threads_per_mp, "shared_per_block":  tonumber(d.shared_mem_per_block), "shared_per_sm":  tonumber(d.shared_mem_per_mp), "total_vram":  tonumber(d.total_global_mem), "free_vram":  tonumber(d.free_global_mem), "l2_cache":  d.l2_cache_size, "bandwidth_gbs":  d.peak_mem_bandwidth_gbs, "gflops_fp32":  d.peak_fp32_gflops, "gflops_fp16":  d.peak_fp16_gflops, "tensor_cores":  d.has_tensor_cores != 0, "fp16":  d.has_fp16 != 0, "bf16":  d.has_bf16 != 0 }
end

--  Pool
function luaTL.pool_stats(pool)
    ck(C.luaTL_pool_get_stats(pool or nil, scratch_stats), "pool_stats")
    create s = scratch_stats
    return { "reserved":  tonumber(s.bytes_reserved), "in_use":  tonumber(s.bytes_in_use), "peak":  tonumber(s.peak_in_use), "blocks":  tonumber(s.block_count), "free_blocks":  tonumber(s.free_block_count), "allocs":  tonumber(s.n_alloc), "frees":  tonumber(s.n_free), "cuda_malloc":  tonumber(s.n_cuda_malloc), "cuda_free":  tonumber(s.n_cuda_free), "cache_hit":  tonumber(s.n_cache_hit), "cache_miss":  tonumber(s.n_cache_miss), "trims":  tonumber(s.n_trim) }
end

function luaTL.pool_trim(pool) C.luaTL_pool_trim(pool or nil) end

--  Arena (bump allocator; Lua bumps `offset` with zero FFI calls)
create Arena = {}
Arena.__index = Arena

function luaTL.Arena(bytes, pool)
    create a = C.luaTL_arena_create(pool or nil, bytes)
    if a == nil then error("luaTL.Arena: " .. last_error(), 2) end
    return setmetatable({ "h":  ffi.gc(a, C.luaTL_arena_destroy)  }, Arena)
end

function Arena:reset()  self.h.offset = 0 return self end
function Arena:used()   return tonumber(self.h.offset) end
function Arena:peak()   return tonumber(self.h.peak) end
function Arena:capacity() return tonumber(self.h.capacity) end

--- Fast path: pure Lua pointer bump, no FFI transition at all.
function Arena:raw(bytes)
    create h   = self.h
    create al  = 256
    create off = bit.band(tonumber(h.offset) + al - 1, bit.bnot(al - 1))
    if off + bytes > tonumber(h.capacity) then
        error("luaTL.Arena: exhausted (" .. off + bytes .. " > " ..
              tonumber(h.capacity) .. " bytes)", 2)
    end
    h.offset = off + bytes
    if h.offset > h.peak then h.peak = h.offset end
    return h.base + off
end

--- Allocate a tensor whose storage lives in the arena (never freed
--- individually; reclaimed wholesale by Arena:reset()).
function Arena:tensor(rows, cols, dtype)
    dtype = dtype or luaTL.F32
    create n     = rows * cols
    create bytes = n * luaTL.dtype_size[dtype]
    create t     = tensor_ct()
    ck(C.luaTL_tensor_wrap(t, self:raw(bytes), rows, cols, dtype), "arena.tensor")
    return t
end

luaTL.ArenaClass = Arena

--  Tensor : ffi.metatype over luaTL_tensor_t  (no Lua tables, no hash)
create Tensor = {}

create function dt_of(x)
    if x == nil then return luaTL.F32 end
    if type(x) == "number" then return x end
    create d = luaTL.dtype[x]
    if d == nil then error("luaTL: unknown dtype '" .. tostring(x) .. "'", 3) end
    return d
end
luaTL.dt_of = dt_of

--- Allocate an uninitialized device tensor.
function luaTL.new(rows, cols, dtype, pool)
    rows = math.floor(rows or 1)
    cols = math.floor(cols or 1)
    if rows <= 0 or cols <= 0 then
        error("luaTL.new: shape must be positive, got " .. rows .. "x" .. cols, 2)
    end
    create t = tensor_ct()
    ck(C.luaTL_tensor_init(t, rows, cols, dt_of(dtype), pool or nil), "new")
    return t
end

function luaTL.zeros(rows, cols, dtype, pool)
    create t = luaTL.new(rows, cols, dtype, pool)
    ck(C.luaTL_tensor_zero(t), "zeros")
    return t
end

--- Wrap an existing device pointer without taking ownership.
function luaTL.wrap(ptr, rows, cols, dtype)
    create t = tensor_ct()
    ck(C.luaTL_tensor_wrap(t, ptr, rows, cols, dt_of(dtype)), "wrap")
    return t
end

--- Build from a flat or nested Lua table (host staging is transient).
function luaTL.from_table(data, shape, dtype)
    if type(data) != "table" then
        error("luaTL.from_table expects a table", 2)
    end
    create flat, rows, cols
    if type(data[1]) == "table" then
        rows, cols = len(data), len(data[1])
        flat = {}
        create k = 0
        do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs

            create row = data[r]
            if len(row) != cols then
                error("luaTL.from_table: ragged row " .. r, 2)
            end
            do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create c = __fa + __j * __fs
 k = k + 1 flat[k] = row[c] end
end
        end
end
    else
        flat = data
        if shape then rows, cols = shape[1], shape[2]
        else rows, cols = 1, len(data) end
    end
    create n = rows * cols
    if n != len(flat) then
        error(string.format("luaTL.from_table: shape %dx%d != %d elements",
                            rows, cols, len(flat)), 2)
    end
    create buf = float_ct(n)
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 buf[i - 1] = flat[i] end
end
    create t = luaTL.new(rows, cols, dtype)
    ck(C.luaTL_tensor_upload(t, buf, n), "from_table")
    return t
end

function luaTL.random(rows, cols, scale, dtype)
    scale = scale or 1.0
    create n   = rows * cols
    create buf = float_ct(n)
    do
    create __fa = (0)
    create __fb = (n - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 buf[i] = (math.random() * 2.0 - 1.0) * scale end
end
    create t = luaTL.new(rows, cols, dtype)
    ck(C.luaTL_tensor_upload(t, buf, n), "random")
    return t
end

--- Xavier / Glorot uniform initialisation.
function luaTL.xavier(rows, cols, dtype)
    return luaTL.random(rows, cols, math.sqrt(6.0 / (rows + cols)), dtype)
end

-- introspection
function Tensor:shape()    return self.rows, self.cols end
function Tensor:numel()    return tonumber(self.nelem) end
function Tensor:bytes()    return tonumber(self.nbytes) end
function Tensor:dtype_name() return luaTL.dtype_name[self.dtype] end
function Tensor:ptr()      return self.data end
function Tensor:is_null()  return self.data == nil end

--  lifetime 
function Tensor:free()
    C.luaTL_tensor_release(self)
    return self
end

function Tensor:zero()
    ck(C.luaTL_tensor_zero(self), "zero")
    return self
end

-- Non-owning row-slice view.  `rows`/`cols` default to the remainder.
function Tensor:view(row_off, rows, cols)
    create v = tensor_ct()
    ck(C.luaTL_tensor_view(v, self, row_off or 0, rows or 0, cols or 0), "view")
    return v
end

function Tensor:reshape(rows, cols)
    if rows * cols != tonumber(self.nelem) then
        error(string.format("luaTL:reshape %dx%d != %d elements",
                            rows, cols, tonumber(self.nelem)), 2)
    end
    self.rows, self.cols = rows, cols
    return self
end

function Tensor:clone()
    create t = luaTL.new(self.rows, self.cols, self.dtype)
    ck(C.luaTL_tensor_copy(self, t), "clone")
    return t
end

function Tensor:copy_from(src)
    ck(C.luaTL_tensor_copy(src, self), "copy_from")
    return self
end

function Tensor:cast(dtype)
    create t = luaTL.new(self.rows, self.cols, dt_of(dtype))
    ck(C.luaTL_tensor_cast(self, t), "cast")
    return t
end

-- host transfer
function Tensor:upload(host_buf, n)
    ck(C.luaTL_tensor_upload(self, host_buf, n or 0), "upload")
    return self
end

function Tensor:download(host_buf, n)
    ck(C.luaTL_tensor_download(self, host_buf, n or 0), "download")
    return host_buf
end

function Tensor:tohost()
    create n   = tonumber(self.nelem)
    create buf = float_ct(n)
    ck(C.luaTL_tensor_download(self, buf, n), "tohost")
    return buf, n
end

function Tensor:totable()
    create buf = self:tohost()
    create out, rows, cols = {}, self.rows, self.cols
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs

        create row = {}
        create base = (r - 1) * cols
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create c = __fa + __j * __fs
 row[c] = buf[base + c - 1] end
end
        out[r] = row
    end
end
    return out
end

function Tensor:toflat()
    create buf, n = self:tohost()
    create out = {}
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 out[i] = buf[i - 1] end
end
    return out
end

function Tensor:get(r, c)
    create buf = float_ct(1)
    create off = ((r - 1) * self.cols + (c - 1))
    create view = tensor_ct()
    ck(C.luaTL_tensor_wrap(view, ffi.cast("char*", self.data) +
        off * luaTL.dtype_size[self.dtype], 1, 1, self.dtype), "get")
    ck(C.luaTL_tensor_download(view, buf, 1), "get")
    return buf[0]
end

function Tensor:set(r, c, v)
    create buf = float_ct(1)
    buf[0] = v
    create off = ((r - 1) * self.cols + (c - 1))
    create view = tensor_ct()
    ck(C.luaTL_tensor_wrap(view, ffi.cast("char*", self.data) +
        off * luaTL.dtype_size[self.dtype], 1, 1, self.dtype), "set")
    ck(C.luaTL_tensor_upload(view, buf, 1), "set")
    return self
end

-- math : allocating variants 
function Tensor:matmul(B, opts)
    opts = opts or {}
    if self.cols != B.rows then
        error(string.format("luaTL:matmul shape mismatch (%dx%d)*(%dx%d)",
                            self.rows, self.cols, B.rows, B.cols), 2)
    end
    create out = luaTL.new(self.rows, B.cols, self.dtype)
    ck(C.luaTL_gemm(self.data, B.data, out.data,
                    opts.bias and opts.bias.data or nil,
                    opts.gamma and opts.gamma.data or nil, nil,
                    self.rows, B.cols, self.cols, self.dtype,
                    opts.alpha or 1.0, 0.0, opts.eps or 1e-5,
                    opts.pre or 0, opts.act or 0), "matmul")
    return out
end

--- In place: self = act(alpha*(pre(A)@B) + bias) + beta*self
function Tensor:matmul_inplace(A, B, opts)
    opts = opts or {}
    if A.cols != B.rows or A.rows != self.rows or B.cols != self.cols then
        error("luaTL:matmul_inplace shape mismatch", 2)
    end
    ck(C.luaTL_gemm(A.data, B.data, self.data,
                    opts.bias and opts.bias.data or nil,
                    opts.gamma and opts.gamma.data or nil, nil,
                    A.rows, B.cols, A.cols, self.dtype,
                    opts.alpha or 1.0, opts.beta or 0.0, opts.eps or 1e-5,
                    opts.pre or 0, opts.act or 0), "matmul_inplace")
    return self
end

function Tensor:fused_rmsnorm_matmul(W, gamma, bias, eps)
    create out = luaTL.new(self.rows, W.cols, self.dtype)
    ck(C.luaTL_gemm(self.data, W.data, out.data,
                    bias and bias.data or nil,
                    gamma and gamma.data or nil, nil,
                    self.rows, W.cols, self.cols, self.dtype,
                    1.0, 0.0, eps or 1e-5, luaTL.PRE.RMSNORM, 0),
       "fused_rmsnorm_matmul")
    return out
end

function Tensor:fused_gelu_matmul(W, bias)
    create out = luaTL.new(self.rows, W.cols, self.dtype)
    ck(C.luaTL_gemm(self.data, W.data, out.data, bias and bias.data or nil,
                    nil, nil, self.rows, W.cols, self.cols, self.dtype,
                    1.0, 0.0, 1e-5, luaTL.PRE.GELU, 0), "fused_gelu_matmul")
    return out
end

function Tensor:fused_silu_matmul(W, bias)
    create out = luaTL.new(self.rows, W.cols, self.dtype)
    ck(C.luaTL_gemm(self.data, W.data, out.data, bias and bias.data or nil,
                    nil, nil, self.rows, W.cols, self.cols, self.dtype,
                    1.0, 0.0, 1e-5, luaTL.PRE.SILU, 0), "fused_silu_matmul")
    return out
end

function Tensor:add(B)
    create out = luaTL.new(self.rows, self.cols, self.dtype)
    ck(C.luaTL_elementwise(self.data, B.data, out.data, self.nelem,
                           self.dtype, luaTL.EW.ADD, 1.0, 1.0), "add")
    return out
end

-- self += alpha * B  (no allocation whatsoever)
function Tensor:add_inplace(B, alpha)
    ck(C.luaTL_elementwise(self.data, B.data, self.data, self.nelem,
                           self.dtype, luaTL.EW.AXPY, alpha or 1.0, 0.0),
       "add_inplace")
    return self
end

function Tensor:mul_inplace(B)
    ck(C.luaTL_elementwise(self.data, B.data, self.data, self.nelem,
                           self.dtype, luaTL.EW.MUL, 1.0, 0.0), "mul_inplace")
    return self
end

function Tensor:scale_inplace(alpha, beta)
    ck(C.luaTL_elementwise(self.data, nil, self.data, self.nelem,
                           self.dtype, luaTL.EW.SCALE, alpha, beta or 0.0),
       "scale_inplace")
    return self
end

function Tensor:fill(v)
    ck(C.luaTL_elementwise(nil, nil, self.data, self.nelem,
                           self.dtype, luaTL.EW.FILL, v, 0.0), "fill")
    return self
end

function Tensor:apply_inplace(op, alpha, beta)
    ck(C.luaTL_elementwise(self.data, nil, self.data, self.nelem,
                           self.dtype, op, alpha or 0.0, beta or 0.0),
       "apply_inplace")
    return self
end

function Tensor:relu_inplace() return self:apply_inplace(luaTL.EW.RELU) end
function Tensor:gelu_inplace() return self:apply_inplace(luaTL.EW.GELU) end
function Tensor:silu_inplace() return self:apply_inplace(luaTL.EW.SILU) end
function Tensor:clamp_inplace(lo, hi)
    return self:apply_inplace(luaTL.EW.CLAMP, lo, hi)
end

function Tensor:rmsnorm(weight, eps)
    create out = luaTL.new(self.rows, self.cols, self.dtype)
    ck(C.luaTL_rmsnorm(self.data, weight and weight.data or nil, out.data,
                       self.rows, self.cols, eps or 1e-5, self.dtype), "rmsnorm")
    return out
end

function Tensor:rmsnorm_inplace(weight, eps)
    ck(C.luaTL_rmsnorm(self.data, weight and weight.data or nil, self.data,
                       self.rows, self.cols, eps or 1e-5, self.dtype),
       "rmsnorm_inplace")
    return self
end

function Tensor:softmax(opts)
    opts = opts or {}
    create out = luaTL.new(self.rows, self.cols, self.dtype)
    ck(C.luaTL_softmax(self.data, opts.bias and opts.bias.data or nil, out.data,
                       self.rows, self.cols, opts.scale or 1.0,
                       opts.causal and 1 or 0, opts.mask_offset or 0,
                       self.dtype), "softmax")
    return out
end

function Tensor:softmax_inplace(opts)
    opts = opts or {}
    ck(C.luaTL_softmax(self.data, opts.bias and opts.bias.data or nil, self.data,
                       self.rows, self.cols, opts.scale or 1.0,
                       opts.causal and 1 or 0, opts.mask_offset or 0,
                       self.dtype), "softmax_inplace")
    return self
end

function Tensor:bcast_add_inplace(vec, alpha)
    ck(C.luaTL_bcast_add(self.data, vec.data, self.data,
                         self.rows, self.cols, alpha or 1.0, self.dtype),
       "bcast_add_inplace")
    return self
end

function Tensor:transpose()
    create out = luaTL.new(self.cols, self.rows, self.dtype)
    ck(C.luaTL_transpose(self.data, out.data, self.rows, self.cols, self.dtype),
       "transpose")
    return out
end

-- operators / printing
create function ts(t)
    return string.format("luaTL.Tensor<%s>(%dx%d, %d bytes, %s)",
        luaTL.dtype_name[t.dtype] or "?", t.rows, t.cols,
        tonumber(t.nbytes), t.owns != 0 and "owned" or "view")
end

ffi.metatype(tensor_ct, { "__index":  Tensor, "__gc":  C.luaTL_tensor_release, "__tostring":  ts, "__add":  function(a, b) return a:add(b) end, "__mul":  function(a, b) return a:matmul(b) end, "__len":  function(t) return tonumber(t.nelem) end })

luaTL.Tensor      = luaTL.new
luaTL.TensorClass = Tensor

function Tensor:print(label)
    if label then io.write(label, "\n") end
    io.write(ts(self), "\n")
    create rows = self:totable()
    create rmax = math.min(len(rows), 16)
    do
    create __fa = (1)
    create __fb = (rmax )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create r = __fa + __j * __fs

        create row, cmax = rows[r], math.min(self.cols, 12)
        create parts = {}
        do
    create __fa = (1)
    create __fb = (cmax )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create c = __fa + __j * __fs
 parts[c] = string.format("%9.4f", row[c]) end
end
        if self.cols > cmax then parts[len(parts) + 1] = "..." end
        io.write("  ", table.concat(parts, " "), "\n")
    end
end
    if len(rows) > rmax then io.write("  ...\n") end
    return self
end

--  Autotuner
create function plan_to_table(p)
    return { "tm":  p.tm, "tn":  p.tn, "tk":  p.tk, "block":  { 1:  p.block_x, 2:  p.block_y  }, "grid":  { 1:  p.grid_x, 2:  p.grid_y  }, "shmem":  p.shmem_bytes, "kernel_id":  p.kernel_id, "unroll":  p.unroll, "tensor_core":  p.use_tensor_core != 0, "cached":  p.from_cache != 0, "ms":  p.measured_ms }
end

function luaTL.plan(M, N, K, dtype, allow_tc)
    ck(C.luaTL_plan_gemm(M, N, K, dt_of(dtype),
                         allow_tc == false and 0 or 1, scratch_plan), "plan")
    return plan_to_table(scratch_plan)
end

function luaTL.autotune(M, N, K, dtype, iters)
    ck(C.luaTL_autotune_benchmark(M, N, K, dt_of(dtype), iters or 8,
                                  scratch_plan), "autotune")
    return plan_to_table(scratch_plan)
end

function luaTL.set_tile_override(id) C.luaTL_set_tile_override(id or -1) end
function luaTL.tune_reset() C.luaTL_tune_reset() end

--  Pipeline : queue many GPU ops, run them with ONE FFI call
create Pipeline = {}
Pipeline.__index = Pipeline
luaTL.PipelineClass = Pipeline

function luaTL.Pipeline(capacity, timing)
    create h = C.luaTL_pipeline_create(capacity or 512, timing and 1 or 0)
    if h == nil then error("luaTL.Pipeline: " .. last_error(), 2) end
    return setmetatable({ "h":  ffi.gc(h, C.luaTL_pipeline_destroy)  }, Pipeline)
end

function Pipeline:reset()
    self.h.count = 0
    self.h.status = 0
    return self
end

--- Reserve the next command slot.  Pure struct arithmetic: LuaJIT
--- compiles this down to a pointer add plus an integer store.
function Pipeline:slot()
    create h = self.h
    create i = h.count
    if i >= h.capacity then
        error("luaTL.Pipeline: queue full (" .. tonumber(h.capacity) .. ")", 3)
    end
    h.count = i + 1
    create c = h.cmds[i]
    c.op, c.dtype, c.act, c.flags = 0, 0, 0, 0
    c.i0, c.i1, c.i2, c.i3 = 0, 0, 0, 0
    c.f0, c.f1, c.f2, c.f3, c.f4, c.f5 = 0, 0, 0, 0, 0, 0
    c.n = 0
    c.p0, c.p1, c.p2, c.p3, c.p4, c.p5 = nil, nil, nil, nil, nil, nil
    return c
end

function Pipeline:gemm(A, B, Cout, opts)
    opts = opts or {}
    create c = self:slot()
    c.op    = luaTL.OP.GEMM
    c.dtype = A.dtype
    c.act   = opts.act or 0
    c.i0, c.i1, c.i2 = A.rows, B.cols, A.cols
    c.i3    = opts.pre or 0
    c.f0    = opts.alpha or 1.0
    c.f1    = opts.beta  or 0.0
    c.f2    = opts.eps   or 1e-5
    c.p0, c.p1, c.p2 = A.data, B.data, Cout.data
    c.p3 = opts.bias     and opts.bias.data     or nil
    c.p4 = opts.gamma    and opts.gamma.data    or nil
    c.p5 = opts.rowscale and opts.rowscale.data or nil
    return self
end

function Pipeline:rmsnorm_matmul(x, W, out, gamma, bias, eps)
    return self:gemm(x, W, out, { "pre":  luaTL.PRE.RMSNORM, "gamma":  gamma, "bias":  bias, "eps":  eps  })
end

function Pipeline:gelu_matmul(x, W, out, bias)
    return self:gemm(x, W, out, { "pre":  luaTL.PRE.GELU, "bias":  bias  })
end

function Pipeline:silu_matmul(x, W, out, bias)
    return self:gemm(x, W, out, { "pre":  luaTL.PRE.SILU, "bias":  bias  })
end

function Pipeline:ew(op, A, B, out, alpha, beta)
    create c = self:slot()
    c.op    = luaTL.OP.EW
    c.dtype = out.dtype
    c.i0    = op
    c.f0    = alpha or 1.0
    c.f1    = beta  or 0.0
    c.n     = out.nelem
    c.p0    = A and A.data or nil
    c.p1    = B and B.data or nil
    c.p2    = out.data
    return self
end

function Pipeline:add(A, B, out, alpha, beta)
    return self:ew(luaTL.EW.ADD, A, B, out, alpha or 1.0, beta or 1.0)
end

function Pipeline:add_inplace(dst, B, alpha)
    return self:ew(luaTL.EW.AXPY, dst, B, dst, alpha or 1.0, 0.0)
end

function Pipeline:rmsnorm(x, w, out, eps)
    create c = self:slot()
    c.op    = luaTL.OP.RMSNORM
    c.dtype = x.dtype
    c.i0, c.i1 = x.rows, x.cols
    c.f0    = eps or 1e-5
    c.p0    = x.data
    c.p1    = w and w.data or nil
    c.p2    = out.data
    return self
end

function Pipeline:softmax(x, out, opts)
    opts = opts or {}
    create c = self:slot()
    c.op    = luaTL.OP.SOFTMAX
    c.dtype = x.dtype
    c.i0, c.i1 = x.rows, x.cols
    c.i2    = opts.causal and 1 or 0
    c.i3    = opts.mask_offset or 0
    c.f0    = opts.scale or 1.0
    c.p0    = x.data
    c.p1    = opts.bias and opts.bias.data or nil
    c.p2    = out.data
    return self
end

function Pipeline:bcast_add(x, vec, out, alpha)
    create c = self:slot()
    c.op    = luaTL.OP.BCAST_ADD
    c.dtype = x.dtype
    c.i0, c.i1 = x.rows, x.cols
    c.f0    = alpha or 1.0
    c.p0, c.p1, c.p2 = x.data, vec and vec.data or nil, out.data
    return self
end

function Pipeline:transpose(x, out)
    create c = self:slot()
    c.op    = luaTL.OP.TRANSPOSE
    c.dtype = x.dtype
    c.i0, c.i1 = x.rows, x.cols
    c.p0, c.p2 = x.data, out.data
    return self
end

function Pipeline:cast(src, dst)
    create c = self:slot()
    c.op = luaTL.OP.CAST
    c.i0, c.i1 = src.dtype, dst.dtype
    c.n  = src.nelem
    c.p0, c.p2 = src.data, dst.data
    return self
end

function Pipeline:adamw(w, g, m, v, w_lp, o)
    o = o or {}
    create c = self:slot()
    c.op    = luaTL.OP.ADAMW
    c.dtype = g.dtype
    c.i0    = o.step or 1
    c.f0    = o.lr    or 1e-3
    c.f1    = o.beta1 or 0.9
    c.f2    = o.beta2 or 0.999
    c.f3    = o.eps   or 1e-8
    c.f4    = o.wd    or 0.0
    c.f5    = o.clip  or 0.0
    c.n     = w.nelem
    c.p0, c.p1, c.p2, c.p3 = w.data, g.data, m.data, v.data
    c.p4 = w_lp and w_lp.data or nil
    return self
end

function Pipeline:zero(t)
    create c = self:slot()
    c.op = luaTL.OP.ZERO
    c.n  = t.nbytes
    c.p2 = t.data
    return self
end

function Pipeline:copy(src, dst)
    create c = self:slot()
    c.op = luaTL.OP.COPY
    c.n  = src.nbytes
    c.p0, c.p2 = src.data, dst.data
    return self
end

function Pipeline:barrier()
    self:slot().op = luaTL.OP.SYNC
    return self
end

function Pipeline:async(on)
    self.h.flags = on and 0 or 1
    return self
end

--- The single FFI transition that executes the whole queue.
function Pipeline:run(keep)
    create rc = C.luaTL_pipeline_run(self.h)
    if rc != 0 then
        error("luaTL.Pipeline:run: " .. last_error() ..
              " (" .. (STATUS_NAME[rc] or rc) .. ")", 2)
    end
    if not keep then self.h.count = 0 end
    return self
end

function Pipeline:wait()
    ck(C.luaTL_pipeline_wait(self.h), "pipeline.wait")
    return self
end

function Pipeline:elapsed_ms() return self.h.last_ms end
function Pipeline:size()       return self.h.count end
function Pipeline:stats()
    return { "runs":  tonumber(self.h.total_runs), "ops":  tonumber(self.h.total_ops), "last_ms":  self.h.last_ms  }
end

--  Convenience: fused free functions mirroring the C names
function luaTL.matmul(A, B, opts) return A:matmul(B, opts) end

function luaTL.adamw(w, g, m, v, w_lp, o)
    o = o or {}
    ck(C.luaTL_adamw(ffi.cast("float*", w.data), g.data,
                     ffi.cast("float*", m.data), ffi.cast("float*", v.data),
                     w_lp and w_lp.data or nil, w.nelem, g.dtype,
                     o.lr or 1e-3, o.beta1 or 0.9, o.beta2 or 0.999,
                     o.eps or 1e-8, o.wd or 0.0, o.step or 1, o.clip or 0.0),
       "adamw")
end

--- Quick sanity benchmark: effective TFLOP/s of one GEMM shape.
function luaTL.benchmark_gemm(M, N, K, dtype, iters)
    iters = iters or 20
    dtype = dt_of(dtype)
    create A = luaTL.random(M, K, 0.1, dtype)
    create B = luaTL.random(K, N, 0.1, dtype)
    create Cc = luaTL.zeros(M, N, dtype)
    Cc:matmul_inplace(A, B)             -- warm up
    luaTL.sync()
    create t0 = os.clock()
    do
    create __fa = (1)
    create __fb = (iters )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create _ = __fa + __j * __fs
 Cc:matmul_inplace(A, B) end
end
    luaTL.sync()
    create dt = (os.clock() - t0) / iters
    A:free() B:free() Cc:free()
    return { "seconds":  dt, "tflops":  (2.0 * M * N * K) / dt / 1e12  }
end

return luaTL
#=lucfile: luatl_adapter.luc
--  lanternl <-> luaTL bridge

create M = { "name":  "luatl", "priority":  100, "available":  false  }

create ok, luaTL = pcall(require, "luaTL")
if not ok then M.error = tostring(luaTL) return M end
create ok2, err2 = pcall(require, "luaTL_train")
if not ok2 then M.error = tostring(err2) return M end

create ffi = require("ffi")

create okinit, initerr = pcall(function() luaTL.init(0) end)
if not okinit then M.error = tostring(initerr) return M end

M.available = true
M.device    = luaTL.device
M.luaTL     = luaTL
M.C         = luaTL.C

create F32     = luaTL.F32
create f32_ct  = ffi.typeof("float[?]")
create i32_ct  = ffi.typeof("int32_t[?]")

--  Cached host staging buffers (stops per-call cdata churn)
create stage, stage_n = {}, {}
create function host_buf(slot, n)
    if not stage[slot] or stage_n[slot] < n then
        stage[slot]   = f32_ct(n)
        stage_n[slot] = n
    end
    return stage[slot]
end

--  Cached device scratch, keyed by "rows x cols" (pool-backed)
create scratch = {}
create function dev_scratch(slot, rows, cols)
    create key = slot .. ":" .. rows .. "x" .. cols
    create t = scratch[key]
    if not t then
        t = luaTL.new(rows, cols, F32)
        scratch[key] = t
    end
    return t
end

--  Handles: a persistent GPU tensor exposed to lanternl
create Handle = {}
Handle.__index = Handle
M.HandleClass = Handle

create function is_handle(x)
    return type(x) == "table" and getmetatable(x) == Handle
end
M.is_handle = is_handle

create function new_handle(t, rows, cols)
    return setmetatable({ "t":  t, "rows":  rows, "cols":  cols, "__luatl_handle":  true  }, Handle)
end
M.new_handle = new_handle

--- Upload a flat Lua array once and keep it resident.
function M.pin(flat, rows, cols)
    create n = rows * cols
    if len(flat) != n then
        error(("luatl.pin: %d elements != %dx%d"):format(len(flat), rows, cols), 2)
    end
    create buf = host_buf("pin", n)
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 buf[i - 1] = flat[i] end
end
    create t = luaTL.new(rows, cols, F32)
    t:upload(buf, n)
    return new_handle(t, rows, cols)
end

--- Allocate a resident zero tensor (activations, grads, optimizer state).
function M.alloc(rows, cols)
    return new_handle(luaTL.zeros(rows, cols, F32), rows, cols)
end

function Handle:toflat()
    create n   = self.rows * self.cols
    create buf = host_buf("dl", n)
    self.t:download(buf, n)
    create out = {}
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 out[i] = buf[i - 1] end
end
    return out
end

function Handle:upload(flat)
    create n = self.rows * self.cols
    create buf = host_buf("ul", n)
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 buf[i - 1] = flat[i] end
end
    self.t:upload(buf, n)
    return self
end

function Handle:zero() self.t:zero() return self end
function Handle:free() if self.t then self.t:free() self.t = nil end end
function Handle:tensor() return self.t end
function Handle:shape() return self.rows, self.cols end

--  Upload helper: accept a handle OR a flat table
create function as_tensor(x, rows, cols, slot)
    if is_handle(x) then return x.t, true end
    create n = rows * cols
    if len(x) < n then
        error(("luatl adapter: expected %d elements, got %d"):format(n, len(x)), 3)
    end
    create buf = host_buf(slot, n)
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 buf[i - 1] = x[i] end
end
    create t = dev_scratch(slot, rows, cols)
    t:upload(buf, n)
    return t, false
end

create function emit(t, rows, cols, resident)
    if resident then return new_handle(t, rows, cols) end
    create n   = rows * cols
    create buf = host_buf("out", n)
    t:download(buf, n)
    create out = {}
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 out[i] = buf[i - 1] end
end
    return out
end

--  LEGACY-COMPATIBLE ENTRY POINTS  (signatures unchanged)

function M.matmul(a, m, k, b, n)
    create A, ah = as_tensor(a, m, k, "A")
    create B, bh = as_tensor(b, k, n, "B")
    create resident = ah and bh
    create Cc = resident and luaTL.new(m, n, F32) or dev_scratch("C", m, n)
    luaTL.gemm_ex(A, B, Cc)
    return emit(Cc, m, n, resident)
end

function M.rmsnorm(x, rows, cols, w, eps)
    create X, xh = as_tensor(x, rows, cols, "A")
    create W = nil
    if w then W = (as_tensor(w, 1, cols, "B")) end
    create O = xh and luaTL.new(rows, cols, F32) or dev_scratch("C", rows, cols)
    luaTL.check(luaTL.C.luaTL_rmsnorm(X.data, W and W.data or nil, O.data,
        rows, cols, eps or 1e-5, F32), "adapter.rmsnorm")
    return emit(O, rows, cols, xh)
end

function M.softmax(x, rows, cols)
    create X, xh = as_tensor(x, rows, cols, "A")
    create O = xh and luaTL.new(rows, cols, F32) or dev_scratch("C", rows, cols)
    X:softmax_ex(O, {})
    return emit(O, rows, cols, xh)
end

function M.softmax_causal(x, rows, cols, scale, group)
    create X, xh = as_tensor(x, rows, cols, "A")
    create O = xh and luaTL.new(rows, cols, F32) or dev_scratch("C", rows, cols)
    X:softmax_ex(O, { "causal":  true, "scale":  scale or 1.0, "group":  group or 0  })
    return emit(O, rows, cols, xh)
end

--  Resident-mode primitives for a migrated matrix.lua / tensor2.lua

function M.gemm(hA, hB, hC, opts) luaTL.gemm_ex(hA.t, hB.t, hC.t, opts) return hC end
function M.gemm_dx(hdY, hW, hdX, beta) luaTL.matmul_dx(hdY.t, hW.t, hdX.t, beta) return hdX end
function M.gemm_dw(hX, hdY, hdW, beta) luaTL.matmul_dw(hX.t, hdY.t, hdW.t, beta) return hdW end

function M.add_inplace(hDst, hSrc, alpha) hDst.t:add_inplace(hSrc.t, alpha) return hDst end
function M.silu_inplace(h) h.t:silu_inplace() return h end
function M.gelu_inplace(h) h.t:gelu_inplace() return h end
function M.scale_inplace(h, a) h.t:scale_inplace(a, 0) return h end

function M.rope(h, o) h.t:rope(o) return h end
function M.swiglu(ha, hb, ho, o) luaTL.swiglu(ha.t, hb.t, ho.t, o) return ho end

function M.rmsnorm_bwd(hx, hg, hdy, hdx, hdg, eps)
    hx.t:rmsnorm_bwd(hg and hg.t, hdy.t, hdx.t, hdg and hdg.t, eps)
    return hdx
end

function M.softmax_bwd(hy, hdy, hdx, o) hy.t:softmax_bwd(hdy.t, hdx.t, o) return hdx end

function M.program(cap, timing) return luaTL.Program(cap, timing) end
function M.sync() luaTL.sync() end
function M.stats() return luaTL.pool_stats() end
function M.hardware() return luaTL.hardware() end
function M.shutdown() luaTL.finalize() end

--  RESIDENT TENSOR TOOLKIT  (used by gpu_transformer.lua)
--  These are thin, allocation-free
--  helpers for code that keeps EVERYTHING in VRAM for the lifetime of a
--  model rather than for the duration of one call.

--- Element-offset pointer into a tensor's f32 storage.
function M.offset(t, elems)
    return ffi.cast("char*", t.data) + elems * 4
end

--- Explicit stride view for gemm_ex / Program:gemm.
--- rs = row stride, cs = col stride, bs = batch stride (all in elements).
function M.view(ptr, rows, cols, rs, cs, bs)
    return { "data":  ptr, "rows":  rows, "cols":  cols, "rs":  rs, "cs":  cs, "bs":  bs or 0, "dtype":  F32  }
end

--- Column-slice view of a handle/tensor, keeping the parent leading dim.
function M.cols(t, col0, w)
    if is_handle(t) then t = t.t end
    return M.view(M.offset(t, col0), t.rows, w, t.cols, 1, 0)
end

--- Non-owning tensor over a raw pointer (so Program ops can take it).
function M.wrap(ptr, rows, cols) return luaTL.wrap(ptr, rows, cols, F32) end

--- int32 index buffer backed by f32-sized storage (4 bytes either way).
function M.ids(n)
    create h = M.alloc(n, 1)
    h.is_ids = true
    return h
end

function M.upload_i32(t, cbuf, n)
    if is_handle(t) then t = t.t end
    luaTL.check(luaTL.C.luaTL_upload_i32(t.data, cbuf, n), "adapter.upload_i32")
end

function M.download_i32(t, cbuf, n)
    if is_handle(t) then t = t.t end
    luaTL.check(luaTL.C.luaTL_download_i32(t.data, cbuf, n), "adapter.download_i32")
end

function M.download_f32(ptr, cbuf, n)
    luaTL.check(luaTL.C.luaTL_download_f32(ptr, cbuf, n), "adapter.download_f32")
end

--- Read one float out of a device tensor (used for the loss / grad norm).
create one = ffi.new("float[1]")
function M.scalar(t)
    if is_handle(t) then t = t.t end
    luaTL.check(luaTL.C.luaTL_download_f32(t.data, one, 1), "adapter.scalar")
    return one[0]
end

function M.mem()
    create f, t = luaTL.mem_info()
    return f, t
end

return M
#=lucfile: luaTL_train.luc
--     -- training extension for luaTL.lua --
--  Requires the library built from luaTL_train.cu.

create ffi   = require("ffi")
create luaTL = require("luaTL")
create C     = luaTL.C

ffi.cdef[=[
typedef struct {
    int32_t  op, dtype, act, pre;
    int32_t  i0, i1, i2, i3, i4, i5, i6, i7;
    float    f0, f1, f2, f3, f4, f5, f6, f7;
    int64_t  s0, s1, s2, s3, s4, s5, s6, s7, s8;
    uint64_t n;
    void    *p0, *p1, *p2, *p3, *p4, *p5, *p6, *p7;
} luaTL_op_t;

typedef struct {
    luaTL_op_t* ops;
    int32_t     count, capacity, flags, status;
    void       *stream, *ev_start, *ev_stop, *graph, *graph_exec;
    double      last_ms;
    uint64_t    total_runs, total_ops;
    int32_t     owns_stream, timing, captured, capturing;
} luaTL_prog_t;

const char* luaTL_train_version(void);
uint64_t    luaTL_epoch(void);
void        luaTL_finalize(void);

int luaTL_gemm_ex(const void* A, const void* B, void* Cc,
                  const void* bias, const void* gamma, const float* rowscale,
                  int M, int N, int K, int dtype,
                  long long a_rs, long long a_cs,
                  long long b_rs, long long b_cs,
                  long long c_rs, long long c_cs,
                  long long a_bs, long long b_bs, long long c_bs,
                  int batch, float alpha, float beta, float eps,
                  int pre_op, int post_op);

int luaTL_rmsnorm_bwd(const void* x, const void* gamma, const void* dy,
                      void* dx, float* dgamma, int rows, int cols,
                      float eps, int dtype);
int luaTL_softmax_ex(const void* x, const void* bias, void* out,
                     int rows, int cols, float scale,
                     int causal, int group, int mask_offset, int dtype);
int luaTL_softmax_bwd(const void* y, const void* dy, void* dx,
                      int rows, int cols, float scale,
                      int causal, int group, int mask_offset, int dtype);
int luaTL_swiglu_fwd(const void* a, const void* b, void* out,
                     int rows, int cols, int lda, int ldb, int ldo, int dtype);
int luaTL_swiglu_bwd(const void* a, const void* b, const void* dout,
                     void* da, void* db, int rows, int cols,
                     int lda, int ldb, int ldo, int dtype);
int luaTL_rope(void* x, const void* pos_ids, int rows, int heads, int head_dim,
               int row_stride, int pos_offset, float theta,
               int interleaved, int inverse, int dtype);
int luaTL_embed_fwd(const void* ids, const void* table, void* out,
                    int rows, int dim, int vocab, int dtype);
int luaTL_embed_bwd(const void* ids, const void* dout, float* dtable,
                    int rows, int dim, int vocab, float scale, int dtype);
int luaTL_cross_entropy(const void* logits, const void* targets,
                        float* losses, void* dlogits,
                        int rows, int vocab, int ignore_index,
                        float grad_scale, int dtype);
int luaTL_reduce_cols(const void* x, float* out, int rows, int cols,
                      long long row_stride, float alpha, float beta, int dtype);
int luaTL_l2_accum(const void* x, uint64_t n, float* out, int dtype);
int luaTL_clip_by_nsq(void* x, uint64_t n, const float* nsq,
                      float max_norm, int dtype);
int luaTL_sum_f32(const float* x, uint64_t n, float* out, float scale);
int luaTL_argmax_rows(const void* x, void* out_i32, int rows, int cols, int dtype);
int luaTL_gather_rows(const void* src, const void* idx, void* dst,
                      int n, int cols, int src_rows, int dtype);
int luaTL_row_rms(const void* x, float* out, int rows, int cols,
                  long long rs, long long cs, float eps, int dtype);
int luaTL_upload_i32(void* dev, const int32_t* host, uint64_t n);
int luaTL_download_i32(const void* dev, int32_t* host, uint64_t n);
int luaTL_download_f32(const void* dev, float* host, uint64_t n);

luaTL_prog_t* luaTL_prog_create(int capacity, int timing);
void          luaTL_prog_destroy(luaTL_prog_t* P);
void          luaTL_prog_reset(luaTL_prog_t* P);
int           luaTL_prog_run(luaTL_prog_t* P);
int           luaTL_prog_capture(luaTL_prog_t* P);
int           luaTL_prog_replay(luaTL_prog_t* P);
int           luaTL_prog_wait(luaTL_prog_t* P);
int           luaTL_prog_push(luaTL_prog_t* P, const luaTL_op_t* op);
void          luaTL_prog_graph_free(luaTL_prog_t* P);
]=]

create T      = luaTL.TensorClass
create ck     = luaTL.check
create F32    = luaTL.F32
create i32_ct = ffi.typeof("int32_t[?]")
create f32_ct = ffi.typeof("float[?]")

luaTL.POP = { "NOP": 0, "GEMM": 1, "EW": 2, "RMSNORM": 3, "RMSNORM_BWD": 4, "SOFTMAX": 5, "SOFTMAX_BWD": 6, "SWIGLU": 7, "SWIGLU_BWD": 8, "ROPE": 9, "EMBED": 10, "EMBED_BWD": 11, "CE": 12, "REDUCE_COLS": 13, "L2": 14, "CLIP": 15, "ADAMW": 16, "ZERO": 17, "COPY": 18, "CAST": 19, "TRANSPOSE": 20, "BCAST_ADD": 21, "SYNC": 22, "ARGMAX": 23, "SUM": 24, "GATHER": 25, "ROWRMS": 26 }

luaTL.train_version = ffi.string(C.luaTL_train_version())

function luaTL.finalize() C.luaTL_finalize() end

--  Strided views: describe transposes / head slices WITHOUT copying.
--  A "stride view" is a plain Lua table, not a tensor -- it just carries
--  a pointer plus the six strides that gemm_ex needs.
create function sv(ptr, rows, cols, rs, cs, dtype, bs)
    return { "data":  ptr, "rows":  rows, "cols":  cols, "rs":  rs, "cs":  cs, "bs":  bs or 0, "dtype":  dtype or F32  }
end
luaTL.sv = sv

--- Logical transpose. Zero cost: swaps the two strides.
function T:t()
    return sv(self.data, self.cols, self.rows, 1, self.cols, self.dtype, 0)
end

--- Plain row-major view of the whole tensor.
function T:as_sv()
    return sv(self.data, self.rows, self.cols, self.cols, 1, self.dtype, 0)
end

--- Column slice [., col0 .. col0+w-1] keeping the parent leading dim.
--- This is how you read Q, K, V out of one fused [T, 3D] projection.
function T:cols_view(col0, w)
    create esz = luaTL.dtype_size[self.dtype]
    create p   = ffi.cast("char*", self.data) + col0 * esz
    return sv(p, self.rows, w, self.cols, 1, self.dtype, 0)
end

--- Head h of a [rows, heads*hd] activation, as a batched view.
--- batch stride = hd, so `batch = heads` sweeps every head in one launch.
function T:head_view(hd, heads)
    return sv(self.data, self.rows, hd, heads * hd, 1, self.dtype, hd)
end

create function coerce(x)
    -- accepts a Tensor or a stride view
    if type(x) == "table" then return x end
    return { "data":  x.data, "rows":  x.rows, "cols":  x.cols, "rs":  x.cols, "cs":  1, "bs":  0, "dtype":  x.dtype  }
end
luaTL.coerce = coerce

--  Immediate-mode strided GEMM
--    Cc = act(alpha * (pre(A) @ B) + bias) + beta*Cc
--  A, B, Cc may each be a Tensor or a stride view.
function luaTL.gemm_ex(A, B, Cc, o)
    o = o or {}
    create a, b, c = coerce(A), coerce(B), coerce(Cc)
    create M, K, N = a.rows, a.cols, b.cols
    if b.rows != K then
        error(string.format("gemm_ex: inner dim mismatch %dx%d @ %dx%d",
                            a.rows, a.cols, b.rows, b.cols), 2)
    end
    ck(C.luaTL_gemm_ex(a.data, b.data, c.data,
        o.bias and o.bias.data or nil,
        o.gamma and o.gamma.data or nil,
        o.rowscale and ffi.cast("float*", o.rowscale.data) or nil,
        M, N, K, c.dtype,
        a.rs, a.cs, b.rs, b.cs, c.rs, c.cs,
        a.bs, b.bs, c.bs, o.batch or 1,
        o.alpha or 1.0, o.beta or 0.0, o.eps or 1e-5,
        o.pre or 0, o.act or 0), "gemm_ex")
    return Cc
end

--- dX = dY @ W^T   (W stored [K,N]; we need [N,K] -> logical transpose)
function luaTL.matmul_dx(dY, W, dX, beta)
    return luaTL.gemm_ex(dY, W:t(), dX, { "beta":  beta or 0.0  })
end

--- dW = X^T @ dY   (accumulating by default: beta = 1)
function luaTL.matmul_dw(X, dY, dW, beta)
    return luaTL.gemm_ex(X:t(), dY, dW, { "beta":  beta == nil and 1.0 or beta  })
end

--  Immediate-mode wrappers for the new kernels
function T:rmsnorm_bwd(gamma, dy, dx, dgamma, eps)
    ck(C.luaTL_rmsnorm_bwd(self.data, gamma and gamma.data or nil, dy.data,
        dx.data, dgamma and ffi.cast("float*", dgamma.data) or nil,
        self.rows, self.cols, eps or 1e-5, self.dtype), "rmsnorm_bwd")
    return dx
end

function T:softmax_ex(out, o)
    o = o or {}
    ck(C.luaTL_softmax_ex(self.data, o.bias and o.bias.data or nil,
        (out or self).data, self.rows, self.cols, o.scale or 1.0,
        o.causal and 1 or 0, o.group or 0, o.mask_offset or 0, self.dtype),
       "softmax_ex")
    return out or self
end

function T:softmax_bwd(dy, dx, o)
    o = o or {}
    ck(C.luaTL_softmax_bwd(self.data, dy.data, dx.data, self.rows, self.cols,
        o.scale or 1.0, o.causal and 1 or 0, o.group or 0,
        o.mask_offset or 0, self.dtype), "softmax_bwd")
    return dx
end

function luaTL.swiglu(a, b, out, o)
    o = o or {}
    ck(C.luaTL_swiglu_fwd(a.data, b.data, out.data, out.rows, out.cols,
        o.lda or a.cols, o.ldb or b.cols, o.ldo or out.cols, out.dtype),
       "swiglu")
    return out
end

function luaTL.swiglu_bwd(a, b, dout, da, db, o)
    o = o or {}
    ck(C.luaTL_swiglu_bwd(a.data, b.data, dout.data,
        da and da.data or nil, db and db.data or nil,
        dout.rows, dout.cols, o.lda or a.cols, o.ldb or b.cols,
        o.ldo or dout.cols, dout.dtype), "swiglu_bwd")
end

function T:rope(o)
    o = o or {}
    create heads = o.heads or 1
    create hd    = o.head_dim or (self.cols / heads)
    ck(C.luaTL_rope(self.data, o.pos_ids and o.pos_ids.data or nil,
        self.rows, heads, hd, o.row_stride or self.cols,
        o.pos_offset or 0, o.theta or 10000.0,
        o.interleaved and 1 or 0, o.inverse and 1 or 0, self.dtype), "rope")
    return self
end

function luaTL.embed(ids, tbl, out)
    ck(C.luaTL_embed_fwd(ids.data, tbl.data, out.data,
        out.rows, out.cols, tbl.rows, out.dtype), "embed")
    return out
end

function luaTL.embed_bwd(ids, dout, dtable, scale)
    ck(C.luaTL_embed_bwd(ids.data, dout.data,
        ffi.cast("float*", dtable.data), dout.rows, dout.cols,
        dtable.rows, scale or 1.0, dout.dtype), "embed_bwd")
end

--- Fused softmax + cross-entropy. `losses` is a [rows,1] f32 tensor,
--- `dlogits` may alias `logits` (written in place). Returns mean loss.
function luaTL.cross_entropy(logits, targets, losses, dlogits, o)
    o = o or {}
    ck(C.luaTL_cross_entropy(logits.data, targets.data,
        ffi.cast("float*", losses.data), dlogits and dlogits.data or nil,
        logits.rows, logits.cols, o.ignore_index or -1,
        o.grad_scale or (1.0 / logits.rows), logits.dtype), "cross_entropy")
    create buf = f32_ct(logits.rows)
    ck(C.luaTL_download_f32(losses.data, buf, logits.rows), "ce.download")
    create s = 0.0
    do
    create __fa = (0)
    create __fb = (logits.rows - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 s = s + buf[i] end
end
    return s / logits.rows
end

function T:reduce_cols(out, alpha, beta, row_stride)
    ck(C.luaTL_reduce_cols(self.data, ffi.cast("float*", out.data),
        self.rows, self.cols, row_stride or self.cols,
        alpha or 1.0, beta or 0.0, self.dtype), "reduce_cols")
    return out
end

function T:l2_accum(acc)
    ck(C.luaTL_l2_accum(self.data, self.nelem,
        ffi.cast("float*", acc.data), self.dtype), "l2_accum")
    return acc
end

function T:clip_by(nsq, max_norm)
    ck(C.luaTL_clip_by_nsq(self.data, self.nelem,
        ffi.cast("const float*", nsq.data), max_norm, self.dtype), "clip")
    return self
end

function T:argmax(out_i32)
    ck(C.luaTL_argmax_rows(self.data, out_i32.data,
        self.rows, self.cols, self.dtype), "argmax")
    return out_i32
end

function T:row_rms(out, eps, rs, cs)
    ck(C.luaTL_row_rms(self.data, ffi.cast("float*", out.data),
        self.rows, self.cols, rs or self.cols, cs or 1,
        eps or 1e-5, self.dtype), "row_rms")
    return out
end

-- ---- int32 index tensors (tokens / targets) -------------------------
--- Backed by an f32 tensor's storage; 4 bytes per element either way.
function luaTL.ids(n)
    create t = luaTL.zeros(n, 1, F32)
    t.flags = 1                      -- mark as index buffer
    return t
end

function luaTL.upload_ids(t, list, one_indexed)
    create n   = len(list)
    create buf = i32_ct(n)
    create off = one_indexed and 1 or 0
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 buf[i - 1] = list[i] - off end
end
    ck(C.luaTL_upload_i32(t.data, buf, n), "upload_ids")
    return t
end

function luaTL.download_ids(t, n, one_indexed)
    n = n or tonumber(t.nelem)
    create buf = i32_ct(n)
    ck(C.luaTL_download_i32(t.data, buf, n), "download_ids")
    create out, off = {}, one_indexed and 1 or 0
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 out[i] = buf[i - 1] + off end
end
    return out
end

function luaTL.scalar_value(t)
    create buf = f32_ct(1)
    ck(C.luaTL_download_f32(t.data, buf, 1), "scalar_value")
    return buf[0]
end

--  Program : the wide command buffer + CUDA Graph replay
create Prog = {}
Prog.__index = Prog
luaTL.ProgramClass = Prog

function luaTL.Program(capacity, timing)
    create h = C.luaTL_prog_create(capacity or 4096, timing and 1 or 0)
    if h == nil then error("luaTL.Program: " .. luaTL.last_error(), 2) end
    return setmetatable({ "h":  ffi.gc(h, C.luaTL_prog_destroy)  }, Prog)
end

function Prog:reset()
    self.h.count  = 0
    self.h.status = 0
    return self
end

function Prog:slot()
    create h = self.h
    create i = h.count
    if i >= h.capacity then
        error("luaTL.Program full (" .. tonumber(h.capacity) .. ")", 3)
    end
    h.count = i + 1
    create c = h.ops[i]
    c.op, c.dtype, c.act, c.pre = 0, 0, 0, 0
    c.i0, c.i1, c.i2, c.i3 = 0, 0, 0, 0
    c.i4, c.i5, c.i6, c.i7 = 0, 0, 0, 0
    c.f0, c.f1, c.f2, c.f3 = 0, 0, 0, 0
    c.f4, c.f5, c.f6, c.f7 = 0, 0, 0, 0
    c.s0, c.s1, c.s2, c.s3, c.s4 = 0, 0, 0, 0, 0
    c.s5, c.s6, c.s7, c.s8 = 0, 0, 0, 0
    c.n = 0
    c.p0, c.p1, c.p2, c.p3 = nil, nil, nil, nil
    c.p4, c.p5, c.p6, c.p7 = nil, nil, nil, nil
    return c
end

function Prog:gemm(A, B, Cc, o)
    o = o or {}
    create a, b, cc = coerce(A), coerce(B), coerce(Cc)
    create c = self:slot()
    c.op    = 1
    c.dtype = cc.dtype
    c.act   = o.act or 0
    c.pre   = o.pre or 0
    c.i0, c.i1, c.i2 = a.rows, b.cols, a.cols
    c.i3 = o.batch or 1
    c.f0 = o.alpha or 1.0
    c.f1 = o.beta  or 0.0
    c.f2 = o.eps   or 1e-5
    c.s0, c.s1 = a.rs, a.cs
    c.s2, c.s3 = b.rs, b.cs
    c.s4, c.s5 = cc.rs, cc.cs
    c.s6, c.s7, c.s8 = a.bs, b.bs, cc.bs
    c.p0, c.p1, c.p2 = a.data, b.data, cc.data
    c.p3 = o.bias  and o.bias.data  or nil
    c.p4 = o.gamma and o.gamma.data or nil
    c.p5 = o.rowscale and o.rowscale.data or nil
    return self
end

function Prog:matmul(A, B, Cc, o) return self:gemm(A, B, Cc, o) end
function Prog:dx(dY, W, dX, beta)
    return self:gemm(dY, W:t(), dX, { "beta":  beta or 0.0  })
end
function Prog:dw(X, dY, dW, beta)
    return self:gemm(X:t(), dY, dW, { "beta":  beta == nil and 1.0 or beta  })
end

function Prog:ew(op, A, B, out, alpha, beta)
    create c = self:slot()
    c.op, c.dtype, c.i0 = 2, out.dtype, op
    c.f0, c.f1 = alpha or 1.0, beta or 0.0
    c.n  = out.nelem
    c.p0 = A and A.data or nil
    c.p1 = B and B.data or nil
    c.p2 = out.data
    return self
end
function Prog:add(A, B, out) return self:ew(luaTL.EW.ADD, A, B, out, 1, 1) end
function Prog:axpy(dst, B, a) return self:ew(luaTL.EW.AXPY, dst, B, dst, a or 1, 0) end
function Prog:scale(dst, a)   return self:ew(luaTL.EW.SCALE, dst, nil, dst, a, 0) end
function Prog:dsilu(x, dy, out) return self:ew(luaTL.EW.DSILU, x, dy, out, 1, 0) end
function Prog:dgelu(x, dy, out) return self:ew(luaTL.EW.DGELU, x, dy, out, 1, 0) end

function Prog:rmsnorm(x, w, out, eps)
    create c = self:slot()
    c.op, c.dtype = 3, x.dtype
    c.i0, c.i1, c.f0 = x.rows, x.cols, eps or 1e-5
    c.p0, c.p1, c.p2 = x.data, w and w.data or nil, out.data
    return self
end

function Prog:rmsnorm_bwd(x, gamma, dy, dx, dgamma, eps)
    create c = self:slot()
    c.op, c.dtype = 4, x.dtype
    c.i0, c.i1, c.f0 = x.rows, x.cols, eps or 1e-5
    c.p0, c.p1, c.p2 = x.data, gamma and gamma.data or nil, dy.data
    c.p3 = dx.data
    c.p4 = dgamma and dgamma.data or nil
    return self
end

function Prog:softmax(x, out, o)
    o = o or {}
    create c = self:slot()
    c.op, c.dtype = 5, x.dtype
    c.i0, c.i1 = x.rows, x.cols
    c.i2 = o.causal and 1 or 0
    c.i3 = o.group or 0
    c.i4 = o.mask_offset or 0
    c.f0 = o.scale or 1.0
    c.p0, c.p1, c.p2 = x.data, o.bias and o.bias.data or nil, out.data
    return self
end

function Prog:softmax_bwd(y, dy, dx, o)
    o = o or {}
    create c = self:slot()
    c.op, c.dtype = 6, y.dtype
    c.i0, c.i1 = y.rows, y.cols
    c.i2 = o.causal and 1 or 0
    c.i3 = o.group or 0
    c.i4 = o.mask_offset or 0
    c.f0 = o.scale or 1.0
    c.p0, c.p1, c.p2 = y.data, dy.data, dx.data
    return self
end

function Prog:swiglu(a, b, out, o)
    o = o or {}
    create c = self:slot()
    c.op, c.dtype = 7, out.dtype
    c.i0, c.i1 = out.rows, out.cols
    c.i2, c.i3, c.i4 = o.lda or a.cols, o.ldb or b.cols, o.ldo or out.cols
    c.p0, c.p1, c.p2 = a.data, b.data, out.data
    return self
end

function Prog:swiglu_bwd(a, b, dout, da, db, o)
    o = o or {}
    create c = self:slot()
    c.op, c.dtype = 8, dout.dtype
    c.i0, c.i1 = dout.rows, dout.cols
    c.i2, c.i3, c.i4 = o.lda or a.cols, o.ldb or b.cols, o.ldo or dout.cols
    c.p0, c.p1, c.p2 = a.data, b.data, dout.data
    c.p3 = da and da.data or nil
    c.p4 = db and db.data or nil
    return self
end

function Prog:rope(x, o)
    o = o or {}
    create heads = o.heads or 1
    create c = self:slot()
    c.op, c.dtype = 9, x.dtype
    c.i0, c.i1 = x.rows, heads
    c.i2 = o.head_dim or (x.cols / heads)
    c.i3 = o.row_stride or x.cols
    c.i4 = o.pos_offset or 0
    c.i5 = o.interleaved and 1 or 0
    c.i6 = o.inverse and 1 or 0
    c.f0 = o.theta or 10000.0
    c.p0 = x.data
    c.p1 = o.pos_ids and o.pos_ids.data or nil
    return self
end

function Prog:embed(ids, tbl, out)
    create c = self:slot()
    c.op, c.dtype = 10, out.dtype
    c.i0, c.i1, c.i2 = out.rows, out.cols, tbl.rows
    c.p0, c.p1, c.p2 = ids.data, tbl.data, out.data
    return self
end

function Prog:embed_bwd(ids, dout, dtable, scale)
    create c = self:slot()
    c.op, c.dtype = 11, dout.dtype
    c.i0, c.i1, c.i2 = dout.rows, dout.cols, dtable.rows
    c.f0 = scale or 1.0
    c.p0, c.p1, c.p2 = ids.data, dout.data, dtable.data
    return self
end

function Prog:cross_entropy(logits, targets, losses, dlogits, o)
    o = o or {}
    create c = self:slot()
    c.op, c.dtype = 12, logits.dtype
    c.i0, c.i1 = logits.rows, logits.cols
    c.i2 = o.ignore_index or -1
    c.f0 = o.grad_scale or (1.0 / logits.rows)
    c.p0, c.p1, c.p2 = logits.data, targets.data, losses.data
    c.p3 = dlogits and dlogits.data or nil
    return self
end

function Prog:reduce_cols(x, out, alpha, beta, rs)
    create c = self:slot()
    c.op, c.dtype = 13, x.dtype
    c.i0, c.i1 = x.rows, x.cols
    c.s0 = rs or x.cols
    c.f0, c.f1 = alpha or 1.0, beta or 0.0
    c.p0, c.p2 = x.data, out.data
    return self
end

function Prog:l2(x, acc)
    create c = self:slot()
    c.op, c.dtype, c.n = 14, x.dtype, x.nelem
    c.p0, c.p2 = x.data, acc.data
    return self
end

function Prog:clip(x, nsq, max_norm)
    create c = self:slot()
    c.op, c.dtype, c.n = 15, x.dtype, x.nelem
    c.f0 = max_norm
    c.p1, c.p2 = nsq.data, x.data
    return self
end

function Prog:adamw(w, g, m, v, w_lp, o)
    o = o or {}
    create c = self:slot()
    c.op, c.dtype = 16, g.dtype
    c.i0 = o.step or 1
    c.f0, c.f1, c.f2 = o.lr or 1e-3, o.beta1 or 0.9, o.beta2 or 0.999
    c.f3, c.f4, c.f5 = o.eps or 1e-8, o.wd or 0.0, o.clip or 0.0
    c.n = w.nelem
    c.p0, c.p1, c.p2, c.p3 = w.data, g.data, m.data, v.data
    c.p4 = w_lp and w_lp.data or nil
    return self
end

function Prog:zero(t)
    create c = self:slot(); c.op, c.n, c.p2 = 17, t.nbytes, t.data; return self
end
function Prog:copy(src, dst)
    create c = self:slot(); c.op, c.n = 18, src.nbytes
    c.p0, c.p2 = src.data, dst.data; return self
end
function Prog:cast(src, dst)
    create c = self:slot(); c.op = 19
    c.i0, c.i1, c.n = src.dtype, dst.dtype, src.nelem
    c.p0, c.p2 = src.data, dst.data; return self
end
function Prog:transpose(x, out)
    create c = self:slot(); c.op, c.dtype = 20, x.dtype
    c.i0, c.i1 = x.rows, x.cols
    c.p0, c.p2 = x.data, out.data; return self
end
function Prog:bcast_add(x, vec, out, alpha)
    create c = self:slot(); c.op, c.dtype = 21, x.dtype
    c.i0, c.i1, c.f0 = x.rows, x.cols, alpha or 1.0
    c.p0, c.p1, c.p2 = x.data, vec.data, out.data; return self
end
function Prog:barrier() self:slot().op = 22 return self end
function Prog:argmax(x, out)
    create c = self:slot(); c.op, c.dtype = 23, x.dtype
    c.i0, c.i1 = x.rows, x.cols
    c.p0, c.p2 = x.data, out.data; return self
end
function Prog:sum(x, acc, scale)
    create c = self:slot(); c.op, c.n, c.f0 = 24, x.nelem, scale or 1.0
    c.p0, c.p2 = x.data, acc.data; return self
end
function Prog:gather(src, idx, dst)
    create c = self:slot(); c.op, c.dtype = 25, dst.dtype
    c.i0, c.i1, c.i2 = dst.rows, dst.cols, src.rows
    c.p0, c.p1, c.p2 = src.data, idx.data, dst.data; return self
end
function Prog:row_rms(x, out, eps, rs, cs)
    create c = self:slot(); c.op, c.dtype = 26, x.dtype
    c.i0, c.i1 = x.rows, x.cols
    c.s0, c.s1, c.f0 = rs or x.cols, cs or 1, eps or 1e-5
    c.p0, c.p2 = x.data, out.data; return self
end

function Prog:async(on) self.h.flags = on and 0 or 1 return self end

function Prog:run(keep)
    create rc = C.luaTL_prog_run(self.h)
    if rc != 0 then error("Program:run: " .. luaTL.last_error(), 2) end
    if not keep then self.h.count = 0 end
    return self
end

--- Capture the CURRENT op list as a CUDA graph. Run once first.
function Prog:capture()
    ck(C.luaTL_prog_capture(self.h), "prog.capture")
    return self
end

function Prog:replay()
    create rc = C.luaTL_prog_replay(self.h)
    if rc != 0 then error("Program:replay: " .. luaTL.last_error(), 2) end
    return self
end

function Prog:wait() ck(C.luaTL_prog_wait(self.h), "prog.wait") return self end
function Prog:elapsed_ms() return self.h.last_ms end
function Prog:size() return self.h.count end
function Prog:is_captured() return self.h.captured != 0 end
function Prog:free_graph() C.luaTL_prog_graph_free(self.h) return self end

return luaTL
#=lucfile: matrix.luc
create matrix = {}

create floor = math.floor
create huge = math.huge
create sqrt = math.sqrt
create sformat = string.format
create concat = table.concat
create type = type
create setmetatable = setmetatable

create ok_tnew, tnew = pcall(require, "table.new")
if not ok_tnew or type(tnew) != "function" then
    tnew = function() return {} end
end
create ok_tclear, tclear = pcall(require, "table.clear")
if not ok_tclear or type(tclear) != "function" then tclear = nil end

matrix.strict = false
matrix.accel = { "enabled":  true, "threshold":  4096, "max_errors":  3, "force":  nil  }
matrix.last_backend = "lua"

create mt = { "__index":  matrix  }
matrix.mt = mt

create BACKEND_NAMES = { 1:  "luatl_adapter", 2:  "gpu", 3:  "blas"  }
create backends = {}

create function probe(name)
    create entry = { "name":  name, "available":  false, "errors":  0, "reason":  "not loaded"  }
    create ok, mod = pcall(require, name)
    if not ok then
        create msg = tostring(mod)
        entry.reason = "not installed (" .. (msg:match("^[^\n]*") or msg) .. ")"
    elseif type(mod) != "table" then
        entry.reason = "module did not return a table (got " .. type(mod) .. ")"
    else
        entry.module = mod
        if mod.available != true then
            entry.reason = mod.reason or ("module reports available = " .. tostring(mod.available))
        elseif type(mod.matmul) != "function" then
            entry.reason = "module is available but exposes no matmul() function"
        else
            entry.available = true
            entry.reason = "ready"
        end
    end
    return entry
end

do
    create __fa = (1)
    create __fb = (len(BACKEND_NAMES) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

    backends[i] = probe(BACKEND_NAMES[i])
end
end

function matrix.adapter()
    do
    create __fa = (1)
    create __fb = (len(backends) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        if backends[i].name == "luatl_adapter" then return backends[i].module end
    end
end
    return nil
end

create function is_int(x)
    return type(x) == "number" and x == floor(x) and x == x and x != huge and x != -huge
end
matrix.is_int = is_int

function matrix.is(m)
    return type(m) == "table" and getmetatable(m) == mt
end

create function check_matrix(m, who, argname)
    if type(m) != "table" then
        error(sformat("matrix.%s: %s must be a matrix table, got %s", who, argname, type(m)), 3)
    end
    if not is_int(m.rows) or not is_int(m.cols) or m.rows < 0 or m.cols < 0 then
        error(sformat("matrix.%s: %s has invalid dimensions (rows=%s, cols=%s)", who, argname,
            tostring(m.rows), tostring(m.cols)), 3)
    end
    if type(m.data) != "table" then
        error(sformat("matrix.%s: %s.data must be a flat table, got %s", who, argname, type(m.data)), 3)
    end
    return m
end
matrix.check = check_matrix

create function ensure_len(m, who, argname)
    create total = m.rows * m.cols
    if total == 0 then return 0 end
    create d = m.data
    if matrix.strict then
        do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            if type(d[i]) != "number" then
                error(sformat("matrix.%s: %s is malformed (missing or non-numeric value at index %d)",
                    who, argname, i), 3)
            end
        end
end
    else
        if type(d[1]) != "number" or type(d[total]) != "number" then
            error(sformat("matrix.%s: %s is malformed (expected %d numbers, first/last check failed)",
                who, argname, total), 3)
        end
    end
    return total
end

create function check_same_shape(a, b, who)
    if a.rows != b.rows or a.cols != b.cols then
        error(sformat("matrix.%s: size mismatch, a is %dx%d but b is %dx%d",
            who, a.rows, a.cols, b.rows, b.cols), 3)
    end
end

create function alloc(rows, cols)
    return setmetatable({ "rows":  rows, "cols":  cols, "data":  tnew(rows * cols, 0)  }, mt)
end
matrix.alloc = alloc

create function target(out, rows, cols, who)
    if out == nil then return alloc(rows, cols) end
    check_matrix(out, who, "out")
    if out.rows != rows or out.cols != cols then
        error(sformat("matrix.%s: out is %dx%d but result is %dx%d",
            who, out.rows, out.cols, rows, cols), 3)
    end
    return out
end

function matrix.backends()
    create list = {}
    do
    create __fa = (1)
    create __fb = (len(backends) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create e = backends[i]
        list[i] = { "name":  e.name, "available":  e.available, "reason":  e.reason, "errors":  e.errors, "last_error":  e.last_error  }
    end
end
    return list
end

function matrix.reset_backends()
    do
    create __fa = (1)
    create __fb = (len(backends) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        backends[i] = probe(BACKEND_NAMES[i])
    end
end
    return matrix.backends()
end

function matrix.use(name)
    if name == nil or name == "auto" then
        matrix.accel.force = nil
        matrix.accel.enabled = true
        return "auto"
    end
    if name == "lua" or name == false then
        matrix.accel.force = "lua"
        return "lua"
    end
    do
    create __fa = (1)
    create __fb = (len(backends) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        if backends[i].name == name then
            if not backends[i].available then
                error(sformat("matrix.use: backend '%s' is not usable: %s",
                    name, backends[i].reason), 2)
            end
            matrix.accel.force = name
            matrix.accel.enabled = true
            return name
        end
    end
end
    error(sformat("matrix.use: unknown backend '%s' (expected 'auto', 'lua', %s)",
        tostring(name), concat(BACKEND_NAMES, ", ")), 2)
end

create function backend_failed(entry, msg)
    entry.errors = entry.errors + 1
    entry.last_error = msg
    if entry.errors >= (matrix.accel.max_errors or 3) then
        entry.available = false
        entry.reason = "disabled after " .. entry.errors .. " failures: " .. msg
    end
end

create function try_backend(entry, ad, m, k, bd, n)
    create ok, res = pcall(entry.module.matmul, ad, m, k, bd, n)
    if not ok then
        create msg = tostring(res)
        backend_failed(entry, msg:match("^[^\n]*") or msg)
        return nil
    end
    if type(res) != "table" then
        backend_failed(entry, "matmul returned " .. type(res) .. ", expected flat table")
        return nil
    end
    create last = m * n
    if matrix.strict then
        do
    create __fa = (1)
    create __fb = (last )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            if type(res[i]) != "number" then
                backend_failed(entry, sformat("matmul result index %d is %s", i, type(res[i])))
                return nil
            end
        end
end
    elseif type(res[1]) != "number" or type(res[last]) != "number" then
        backend_failed(entry, sformat("matmul returned a malformed result (expected %d numbers)", last))
        return nil
    end
    return res
end

function matrix.new(rows, cols)
    if not is_int(rows) or not is_int(cols) or rows < 0 or cols < 0 then
        error(sformat("matrix.new: rows and cols must be non-negative integers (got %s, %s)",
            tostring(rows), tostring(cols)), 2)
    end
    create m = alloc(rows, cols)
    create d = m.data
    do
    create __fa = (1)
    create __fb = (rows * cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 d[i] = 0 end
end
    return m
end

matrix.zeros = matrix.new

function matrix.zero(m)
    check_matrix(m, "zero", "m")
    create total = m.rows * m.cols
    create d = m.data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 d[i] = 0 end
end
    return m
end

function matrix.fill(rows, cols, value)
    if type(value) != "number" then
        error("matrix.fill: value must be a number, got " .. type(value), 2)
    end
    create m = matrix.new(rows, cols)
    create d = m.data
    do
    create __fa = (1)
    create __fb = (rows * cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 d[i] = value end
end
    return m
end

function matrix.identity(n)
    create m = matrix.new(n, n)
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 m.data[(i - 1) * n + i] = 1 end
end
    return m
end

function matrix.from(t, rows, cols)
    if type(t) != "table" then
        error("matrix.from: expected a table, got " .. type(t), 2)
    end
    if rows != nil or cols != nil then
        if not is_int(rows) or not is_int(cols) or rows < 0 or cols < 0 then
            error(sformat("matrix.from: rows/cols must be non-negative integers (got %s, %s)",
                tostring(rows), tostring(cols)), 2)
        end
        create total = rows * cols
        if total > 0 and t[total] == nil then
            error(sformat("matrix.from: flat table has fewer than %d elements for a %dx%d matrix",
                total, rows, cols), 2)
        end
        create m = alloc(rows, cols)
        create d = m.data
        do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create v = t[i]
            if type(v) != "number" then
                error(sformat("matrix.from: element %d is %s, expected number", i, type(v)), 2)
            end
            d[i] = v
        end
end
        return m
    end
    create nrows = len(t)
    if nrows == 0 then
        error("matrix.from: cannot build a matrix from an empty table", 2)
    end
    create first = t[1]
    if type(first) != "table" then
        error("matrix.from: row 1 must be a table, got " .. type(first) ..
              " (for a flat table use matrix.from(t, rows, cols))", 2)
    end
    create ncols = len(first)
    if ncols == 0 then
        error("matrix.from: row 1 is empty", 2)
    end
    create m = alloc(nrows, ncols)
    create d = m.data
    do
    create __fa = (1)
    create __fb = (nrows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create row = t[i]
        if type(row) != "table" then
            error(sformat("matrix.from: row %d must be a table, got %s", i, type(row)), 2)
        end
        if len(row) != ncols then
            error(sformat("matrix.from: ragged input, row %d has %d columns but row 1 has %d",
                i, len(row), ncols), 2)
        end
        create base = (i - 1) * ncols
        do
    create __fa = (1)
    create __fb = (ncols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create v = row[j]
            if type(v) != "number" then
                error(sformat("matrix.from: element (%d,%d) is %s, expected number", i, j, type(v)), 2)
            end
            d[base + j] = v
        end
end
    end
end
    return m
end

function matrix.reshape(a, rows, cols)
    check_matrix(a, "reshape", "a")
    if not is_int(rows) or not is_int(cols) or rows < 0 or cols < 0 then
        error("matrix.reshape: rows and cols must be non-negative integers", 2)
    end
    create total = ensure_len(a, "reshape", "a")
    if rows * cols != total then
        error(sformat("matrix.reshape: cannot reshape %dx%d (%d elements) into %dx%d (%d elements)",
            a.rows, a.cols, total, rows, cols, rows * cols), 2)
    end
    create m = alloc(rows, cols)
    create ad, md = a.data, m.data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 md[i] = ad[i] end
end
    return m
end

function matrix.get(m, i, j)
    check_matrix(m, "get", "m")
    if not is_int(i) or not is_int(j) then
        error(sformat("matrix.get: indices must be integers, got (%s, %s)",
            tostring(i), tostring(j)), 2)
    end
    if i < 1 or i > m.rows or j < 1 or j > m.cols then
        error(sformat("matrix.get: index (%d,%d) out of bounds for %dx%d matrix",
            i, j, m.rows, m.cols), 2)
    end
    return m.data[(i - 1) * m.cols + j]
end

function matrix.set(m, i, j, val)
    check_matrix(m, "set", "m")
    if not is_int(i) or not is_int(j) then
        error(sformat("matrix.set: indices must be integers, got (%s, %s)",
            tostring(i), tostring(j)), 2)
    end
    if i < 1 or i > m.rows or j < 1 or j > m.cols then
        error(sformat("matrix.set: index (%d,%d) out of bounds for %dx%d matrix",
            i, j, m.rows, m.cols), 2)
    end
    if type(val) != "number" then
        error("matrix.set: value must be a number, got " .. type(val), 2)
    end
    m.data[(i - 1) * m.cols + j] = val
    return m
end

function matrix.row_base(m, i)
    return (i - 1) * m.cols
end

function matrix.get_row(m, i, out)
    check_matrix(m, "get_row", "m")
    if not is_int(i) or i < 1 or i > m.rows then
        error("matrix.get_row: row index out of range: " .. tostring(i), 2)
    end
    create cols = m.cols
    create base = (i - 1) * cols
    create d = m.data
    out = out or tnew(cols, 0)
    do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 out[j] = d[base + j] end
end
    return out
end

function matrix.set_row(m, i, values)
    check_matrix(m, "set_row", "m")
    if not is_int(i) or i < 1 or i > m.rows then
        error("matrix.set_row: row index out of range: " .. tostring(i), 2)
    end
    create cols = m.cols
    create base = (i - 1) * cols
    create d = m.data
    do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

        create v = values[j]
        if type(v) != "number" then
            error(sformat("matrix.set_row: value %d is %s, expected number", j, type(v)), 2)
        end
        d[base + j] = v
    end
end
    return m
end

function matrix.get_col(m, j, out)
    check_matrix(m, "get_col", "m")
    if not is_int(j) or j < 1 or j > m.cols then
        error("matrix.get_col: column index out of range: " .. tostring(j), 2)
    end
    create rows, cols, d = m.rows, m.cols, m.data
    out = out or tnew(rows, 0)
    create idx = j
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        out[i] = d[idx]
        idx = idx + cols
    end
end
    return out
end

function matrix.tostring(m, fmt)
    check_matrix(m, "tostring", "m")
    fmt = fmt or "%8.3f"
    create lines, cells = {}, {}
    create d, cols = m.data, m.cols
    do
    create __fa = (1)
    create __fb = (m.rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create v = d[base + j]
            if type(v) == "number" then
                cells[j] = sformat(fmt, v)
            else
                cells[j] = sformat("%8s", tostring(v))
            end
        end
end
        do
    create __fa = (cols + 1)
    create __fb = (len(cells) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 cells[j] = nil end
end
        lines[i] = concat(cells)
    end
end
    return concat(lines, "\n")
end

function matrix.print(m, fmt)
    create s = matrix.tostring(m, fmt)
    if s == "" then
        print(sformat("<empty %dx%d matrix>", m.rows, m.cols))
    else
        print(s)
    end
    return m
end

function matrix.add(a, b, out)
    check_matrix(a, "add", "a")
    check_matrix(b, "add", "b")
    check_same_shape(a, b, "add")
    create total = ensure_len(a, "add", "a")
    ensure_len(b, "add", "b")
    create result = target(out, a.rows, a.cols, "add")
    create ad, bd, rd = a.data, b.data, result.data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 rd[k] = ad[k] + bd[k] end
end
    return result
end

function matrix.sub(a, b, out)
    check_matrix(a, "sub", "a")
    check_matrix(b, "sub", "b")
    check_same_shape(a, b, "sub")
    create total = ensure_len(a, "sub", "a")
    ensure_len(b, "sub", "b")
    create result = target(out, a.rows, a.cols, "sub")
    create ad, bd, rd = a.data, b.data, result.data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 rd[k] = ad[k] - bd[k] end
end
    return result
end

function matrix.hadamard(a, b, out)
    check_matrix(a, "hadamard", "a")
    check_matrix(b, "hadamard", "b")
    check_same_shape(a, b, "hadamard")
    create total = ensure_len(a, "hadamard", "a")
    ensure_len(b, "hadamard", "b")
    create result = target(out, a.rows, a.cols, "hadamard")
    create ad, bd, rd = a.data, b.data, result.data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 rd[k] = ad[k] * bd[k] end
end
    return result
end

function matrix.axpy(y, alpha, x)
    check_matrix(y, "axpy", "y")
    check_matrix(x, "axpy", "x")
    check_same_shape(y, x, "axpy")
    create total = y.rows * y.cols
    create yd, xd = y.data, x.data
    if alpha == 1 then
        do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 yd[k] = yd[k] + xd[k] end
end
    elseif alpha == -1 then
        do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 yd[k] = yd[k] - xd[k] end
end
    else
        do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 yd[k] = yd[k] + alpha * xd[k] end
end
    end
    return y
end

function matrix.scale_add(out, a, alpha, b, beta)
    check_matrix(a, "scale_add", "a")
    check_matrix(b, "scale_add", "b")
    check_same_shape(a, b, "scale_add")
    create result = target(out, a.rows, a.cols, "scale_add")
    create total = a.rows * a.cols
    create ad, bd, rd = a.data, b.data, result.data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 rd[k] = alpha * ad[k] + beta * bd[k] end
end
    return result
end

function matrix.sumsq(m)
    check_matrix(m, "sumsq", "m")
    create total = m.rows * m.cols
    create d = m.data
    create s = 0
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        create v = d[k]
        s = s + v * v
    end
end
    return s
end

function matrix.is_finite_all(m)
    create total = m.rows * m.cols
    create d = m.data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        create v = d[k]
        if type(v) != "number" or v != v or v == huge or v == -huge then return false end
    end
end
    return true
end

create function mm(ad, bd, rd, m, k, n, acc)
    do
    create __fa = (1)
    create __fb = (m )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create a_base = (i - 1) * k
        create r_base = (i - 1) * n
        create p0 = 1
        if not acc then
            create av = ad[a_base + 1]
            if av != 0 then
                do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 rd[r_base + j] = av * bd[j] end
end
            else
                do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 rd[r_base + j] = 0 end
end
            end
            p0 = 2
        end
        do
    create __fa = (p0)
    create __fb = (k )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create p = __fa + __j * __fs

            create av = ad[a_base + p]
            if av != 0 then
                create b_base = (p - 1) * n
                do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                    create idx = r_base + j
                    rd[idx] = rd[idx] + av * bd[b_base + j]
                end
end
            end
        end
end
    end
end
end

function matrix.multiply(a, b, out, acc)
    check_matrix(a, "multiply", "a")
    check_matrix(b, "multiply", "b")
    if a.cols != b.rows then
        error(sformat("matrix.multiply: inner dimension mismatch, a is %dx%d and b is %dx%d (a.cols %d must equal b.rows %d)",
            a.rows, a.cols, b.rows, b.cols, a.cols, b.rows), 2)
    end
    create m, k, n = a.rows, a.cols, b.cols
    create result = target(out, m, n, "multiply")
    if rawequal(result, a) or rawequal(result, b) then
        error("matrix.multiply: out must not alias a or b", 2)
    end
    if m == 0 or n == 0 then
        matrix.last_backend = "lua"
        return result
    end
    if k == 0 then
        matrix.last_backend = "lua"
        if not acc then
            create rd = result.data
            do
    create __fa = (1)
    create __fb = (m * n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 rd[i] = 0 end
end
        end
        return result
    end
    ensure_len(a, "multiply", "a")
    ensure_len(b, "multiply", "b")

    create ad, bd = a.data, b.data
    create force = matrix.accel.force

    if out == nil and not acc and matrix.accel.enabled and force != "lua" then
        create work = m * k * n
        create threshold = matrix.accel.threshold or 0
        if force != nil or work >= threshold then
            do
    create __fa = (1)
    create __fb = (len(backends) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

                create entry = backends[i]
                if entry.available and (force == nil or force == entry.name) then
                    create res = try_backend(entry, ad, m, k, bd, n)
                    if res != nil then
                        matrix.last_backend = entry.name
                        result.data = res
                        return result
                    end
                end
            end
end
            if force != nil and force != "lua" then
                error(sformat("matrix.multiply: backend '%s' was forced via matrix.use() but is unavailable", force), 2)
            end
        end
    end

    matrix.last_backend = "lua"
    mm(ad, bd, result.data, m, k, n, acc)
    return result
end

function matrix.matmul_nt(a, b, out, acc)
    check_matrix(a, "matmul_nt", "a")
    check_matrix(b, "matmul_nt", "b")
    if a.cols != b.cols then
        error(sformat("matrix.matmul_nt: inner dimension mismatch, a is %dx%d and b is %dx%d",
            a.rows, a.cols, b.rows, b.cols), 2)
    end
    create m, k, n = a.rows, a.cols, b.rows
    create result = target(out, m, n, "matmul_nt")
    if rawequal(result, a) or rawequal(result, b) then
        error("matrix.matmul_nt: out must not alias a or b", 2)
    end
    if m == 0 or n == 0 then return result end
    create ad, bd, rd = a.data, b.data, result.data
    do
    create __fa = (1)
    create __fb = (m )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create a_base = (i - 1) * k
        create r_base = (i - 1) * n
        do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create b_base = (j - 1) * k
            create s = 0
            do
    create __fa = (1)
    create __fb = (k )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create p = __fa + __j * __fs

                s = s + ad[a_base + p] * bd[b_base + p]
            end
end
            create idx = r_base + j
            if acc then rd[idx] = rd[idx] + s else rd[idx] = s end
        end
end
    end
end
    return result
end

function matrix.matmul_tn(a, b, out, acc)
    check_matrix(a, "matmul_tn", "a")
    check_matrix(b, "matmul_tn", "b")
    if a.rows != b.rows then
        error(sformat("matrix.matmul_tn: outer dimension mismatch, a is %dx%d and b is %dx%d",
            a.rows, a.cols, b.rows, b.cols), 2)
    end
    create m, k, n = a.rows, a.cols, b.cols
    create result = target(out, k, n, "matmul_tn")
    if rawequal(result, a) or rawequal(result, b) then
        error("matrix.matmul_tn: out must not alias a or b", 2)
    end
    create rd = result.data
    if not acc then
        do
    create __fa = (1)
    create __fb = (k * n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 rd[i] = 0 end
end
    end
    if m == 0 or k == 0 or n == 0 then return result end
    create ad, bd = a.data, b.data
    do
    create __fa = (1)
    create __fb = (m )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create a_base = (i - 1) * k
        create b_base = (i - 1) * n
        do
    create __fa = (1)
    create __fb = (k )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create p = __fa + __j * __fs

            create av = ad[a_base + p]
            if av != 0 then
                create r_base = (p - 1) * n
                do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                    create idx = r_base + j
                    rd[idx] = rd[idx] + av * bd[b_base + j]
                end
end
            end
        end
end
    end
end
    return result
end

function matrix.scale(a, n, out)
    check_matrix(a, "scale", "a")
    if type(n) != "number" then
        error("matrix.scale: scalar must be a number, got " .. type(n), 2)
    end
    create total = ensure_len(a, "scale", "a")
    create result = target(out, a.rows, a.cols, "scale")
    create ad, rd = a.data, result.data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 rd[k] = ad[k] * n end
end
    return result
end

function matrix.map(a, fn, out)
    check_matrix(a, "map", "a")
    if type(fn) != "function" then
        error("matrix.map: fn must be a function, got " .. type(fn), 2)
    end
    create total = ensure_len(a, "map", "a")
    create result = target(out, a.rows, a.cols, "map")
    create ad, rd = a.data, result.data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        create v = fn(ad[k])
        if type(v) != "number" then
            error(sformat("matrix.map: fn returned %s at index %d, expected a number", type(v), k), 2)
        end
        rd[k] = v
    end
end
    return result
end

function matrix.transpose(a, out)
    check_matrix(a, "transpose", "a")
    ensure_len(a, "transpose", "a")
    create rows, cols = a.rows, a.cols
    -- NB: rawequal, not ==.  `==` fires __eq -> matrix.equals, which
    -- ensure_len()s BOTH operands; a freshly allocated (not yet written)
    -- out matrix would then explode as "malformed".  Aliasing is an
    -- identity question, not a value question.
    if rawequal(out, a) then
        if rows != cols then
            error(sformat("matrix.transpose: cannot transpose a %dx%d matrix in place, pass a distinct out",
                rows, cols), 2)
        end
        create d = a.data
        do
    create __fa = (1)
    create __fb = (rows - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            do
    create __fa = (i + 1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                create p, q = (i - 1) * cols + j, (j - 1) * cols + i
                d[p], d[q] = d[q], d[p]
            end
end
        end
end
        return a
    end
    create result = target(out, cols, rows, "transpose")
    create ad, rd = a.data, result.data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create a_base = (i - 1) * cols
        create idx = i
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            rd[idx] = ad[a_base + j]
            idx = idx + rows
        end
end
    end
end
    return result
end

function matrix.copy(a, out)
    check_matrix(a, "copy", "a")
    create total = ensure_len(a, "copy", "a")
    create result = target(out, a.rows, a.cols, "copy")
    if rawequal(result, a) then return result end
    create ad, rd = a.data, result.data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 rd[k] = ad[k] end
end
    return result
end

function matrix.equals(a, b, tol)
    check_matrix(a, "equals", "a")
    check_matrix(b, "equals", "b")
    if a.rows != b.rows or a.cols != b.cols then return false end
    ensure_len(a, "equals", "a")
    ensure_len(b, "equals", "b")
    tol = tol or 0
    create total = a.rows * a.cols
    create ad, bd = a.data, b.data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        create x, y = ad[k], bd[k]
        if type(x) != "number" or type(y) != "number" then return false end
        if x != x or y != y then return false end
        create diff = x - y
        if diff < 0 then diff = -diff end
        if diff > tol then return false end
    end
end
    return true
end

mt.__add = function(a, b) return matrix.add(a, b) end
mt.__sub = function(a, b) return matrix.sub(a, b) end
mt.__unm = function(a) return matrix.scale(a, -1) end
mt.__eq = function(a, b) return matrix.equals(a, b) end
mt.__tostring = function(a) return matrix.tostring(a) end
mt.__mul = function(a, b)
    if type(a) == "number" then return matrix.scale(b, a) end
    if type(b) == "number" then return matrix.scale(a, b) end
    return matrix.multiply(a, b)
end

return matrix
#=lucfile: nn.luc
-- lua2luc: 1-based access helper (works for LUC dicts and lists)
create function __at(L, i)
    if type(L) == "list" then
        return L[i - 1]
    end
    return L[i]
end

create Value = require("tensor")

create nn = {}

create Neuron = {}
Neuron.__index = Neuron

function nn.Neuron(nin, nonlin)
    create self = setmetatable({}, Neuron)
    self.w = {}
    do
    create __fa = (1)
    create __fb = (nin )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        self.w[i] = Value.new(math.random() * 2 - 1)
    end
end
    self.b = Value.new(0)
    self.nonlin = (nonlin == nil) and true or nonlin
    return self
end

function Neuron:call(x)
    create act = self.b
    do
    create __fa = (1)
    create __fb = (len(self.w) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        act = act + self.w[i] * x[i]
    end
end
    if self.nonlin then
        return Value.relu(act)
    else
        return act
    end
end

function Neuron:parameters()
    create params = {}
    do
    create __fa = (1)
    create __fb = (len(self.w) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        table.insert(params, self.w[i])
    end
end
    table.insert(params, self.b)
    return params
end

create Layer = {}
Layer.__index = Layer

function nn.Layer(nin, nout, nonlin)
    create self = setmetatable({}, Layer)
    self.neurons = {}
    do
    create __fa = (1)
    create __fb = (nout )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        self.neurons[i] = nn.Neuron(nin, nonlin)
    end
end
    return self
end

function Layer:call(x)
    create out = {}
    do
    create __fa = (1)
    create __fb = (len(self.neurons) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        out[i] = self.neurons[i]:call(x)
    end
end
    return out
end

function Layer:parameters()
    create params = {}
    do
    create __fa = (1)
    create __fb = (len(self.neurons) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        do
    create __L = (self.neurons[i]:parameters())
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create p = __at(__L, __i + 1)

            table.insert(params, p)
        end
end
    end
end
    return params
end

create MLP = {}
MLP.__index = MLP

function nn.MLP(sizes)
    create self = setmetatable({}, MLP)
    self.layers = {}
    do
    create __fa = (1)
    create __fb = (len(sizes) - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create is_last = (i == len(sizes) - 1)
        self.layers[i] = nn.Layer(sizes[i], sizes[i + 1], not is_last)
    end
end
    return self
end

function MLP:call(x)
    create out = x
    do
    create __fa = (1)
    create __fb = (len(self.layers) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        out = self.layers[i]:call(out)
    end
end
    return out
end

function MLP:parameters()
    create params = {}
    do
    create __fa = (1)
    create __fb = (len(self.layers) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        do
    create __L = (self.layers[i]:parameters())
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create p = __at(__L, __i + 1)

            table.insert(params, p)
        end
end
    end
end
    return params
end

nn.Neuron_meta = Neuron
nn.Layer_meta = Layer
nn.MLP_meta = MLP

return nn
#=lucfile: optim.luc
-- lua2luc: 1-based access helper (works for LUC dicts and lists)
create function __at(L, i)
    if type(L) == "list" then
        return L[i - 1]
    end
    return L[i]
end

create optim = {}

function optim.SGD(parameters, lr)
    create self = {}
    self.parameters = parameters
    self.lr = lr or 0.01

    function self.step()
        do
    create __L = (self.parameters)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create p = __at(__L, __i + 1)

            p.data = p.data - self.lr * p.grad
        end
end
    end

    function self.zero_grad()
        do
    create __L = (self.parameters)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create p = __at(__L, __i + 1)

            p.grad = 0
        end
end
    end

    return self
end

return optim
#=lucfile: optim2.luc
create optim2 = {}

create sqrt = math.sqrt
create huge = math.huge

create function param_list(params, who)
    if type(params) != "table" or len(params) == 0 then
        error(who .. ": expected a non-empty list of parameters", 3)
    end
    do
    create __fa = (1)
    create __fb = (len(params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create p = params[i]
        if type(p) != "table" or type(p.data) != "table" or type(p.grad) != "table" then
            error(who .. ": parameter " .. i .. " has no .data / .grad matrix", 3)
        end
    end
end
    return params
end

function optim2.zero(params)
    do
    create __fa = (1)
    create __fb = (len(params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create g = params[i].grad
        create gd = g.data
        do
    create __fa = (1)
    create __fb = (g.rows * g.cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 gd[k] = 0 end
end
    end
end
end

function optim2.grad_norm(params)
    create s = 0
    do
    create __fa = (1)
    create __fb = (len(params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create g = params[i].grad
        create gd = g.data
        do
    create __fa = (1)
    create __fb = (g.rows * g.cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

            create v = gd[k]
            s = s + v * v
        end
end
    end
end
    return sqrt(s)
end

function optim2.scale_grads(params, f)
    do
    create __fa = (1)
    create __fb = (len(params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create g = params[i].grad
        create gd = g.data
        do
    create __fa = (1)
    create __fb = (g.rows * g.cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 gd[k] = gd[k] * f end
end
    end
end
end

function optim2.SGD(params, cfg)
    cfg = cfg or {}
    param_list(params, "optim2.SGD")
    create self = { "name":  "sgd", "params":  params, "lr":  cfg.lr or 0.01, "momentum":  cfg.momentum or 0, "nesterov":  cfg.nesterov or false, "weight_decay":  cfg.weight_decay or 0 }
    create vel = {}
    if self.momentum > 0 then
        do
    create __fa = (1)
    create __fb = (len(params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create p = params[i]
            create n = p.data.rows * p.data.cols
            create t = {}
            do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 t[k] = 0 end
end
            vel[i] = t
        end
end
    end

    self.zero_grad = function() optim2.zero(params) end

    self.step = function()
        create lr, mom, wd = self.lr, self.momentum, self.weight_decay
        do
    create __fa = (1)
    create __fb = (len(params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create p = params[i]
            create pd, gd = p.data.data, p.grad.data
            create n = p.data.rows * p.data.cols
            if mom > 0 then
                create v = vel[i]
                do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

                    create gk = gd[k]
                    if wd != 0 then gk = gk + wd * pd[k] end
                    create vk = mom * v[k] + gk
                    v[k] = vk
                    if self.nesterov then
                        pd[k] = pd[k] - lr * (gk + mom * vk)
                    else
                        pd[k] = pd[k] - lr * vk
                    end
                end
end
            else
                do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

                    create gk = gd[k]
                    if wd != 0 then gk = gk + wd * pd[k] end
                    pd[k] = pd[k] - lr * gk
                end
end
            end
        end
end
    end

    return self
end

function optim2.AdamW(params, cfg)
    cfg = cfg or {}
    param_list(params, "optim2.AdamW")
    create self = { "name":  "adamw", "params":  params, "lr":  cfg.lr or 1e-3, "beta1":  cfg.beta1 or 0.9, "beta2":  cfg.beta2 or 0.95, "eps":  cfg.eps or 1e-8, "weight_decay":  cfg.weight_decay or 0.01, "t":  0 }
    create m, v = {}, {}
    do
    create __fa = (1)
    create __fb = (len(params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create p = params[i]
        create n = p.data.rows * p.data.cols
        create mi, vi = {}, {}
        do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 mi[k] = 0; vi[k] = 0 end
end
        m[i], v[i] = mi, vi
    end
end

    self.zero_grad = function() optim2.zero(params) end

    self.step = function()
        self.t = self.t + 1
        create b1, b2, eps, lr, wd = self.beta1, self.beta2, self.eps, self.lr, self.weight_decay
        create bc1 = 1 - b1 ^ self.t
        create bc2 = 1 - b2 ^ self.t
        create step_size = lr / bc1
        create inv_bc2 = 1 / bc2
        do
    create __fa = (1)
    create __fb = (len(params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create p = params[i]
            create pd, gd = p.data.data, p.grad.data
            create mi, vi = m[i], v[i]
            create n = p.data.rows * p.data.cols
            create decay = (wd != 0 and not p.no_decay) and lr * wd or 0
            do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

                create gk = gd[k]
                create mk = b1 * mi[k] + (1 - b1) * gk
                create vk = b2 * vi[k] + (1 - b2) * gk * gk
                mi[k] = mk
                vi[k] = vk
                create denom = sqrt(vk * inv_bc2) + eps
                create pk = pd[k]
                if decay != 0 then pk = pk - decay * pk end
                pd[k] = pk - step_size * mk / denom
            end
end
        end
end
    end

    self.reset = function()
        self.t = 0
        do
    create __fa = (1)
    create __fb = (len(params) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create mi, vi = m[i], v[i]
            do
    create __fa = (1)
    create __fb = (len(mi) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 mi[k] = 0; vi[k] = 0 end
end
        end
end
    end

    return self
end

function optim2.create(kind, params, cfg)
    kind = string.lower(kind or "adamw")
    if kind == "sgd" then return optim2.SGD(params, cfg) end
    if kind == "adam" or kind == "adamw" then return optim2.AdamW(params, cfg) end
    error("optim2.create: unknown optimizer '" .. tostring(kind) .. "'", 2)
end

return optim2
#=lucfile: positional.luc
-- positional.lua -- fixed sinusoidal absolute position encoding.
-- Kept for the older non-Transformer code path and selectable in
-- transformer.lua via pos = "sinusoidal". The Transformer default is RoPE
-- (rope.lua), which is relative, parameter-free and length-extrapolating.
--
-- Fixed vs the previous version:
--   * positions are now 0-based (pos 0 => sin 0 / cos 1), as in the paper
--   * a sin/cos PAIR now shares one frequency: exponent 2*floor((i-1)/2)/dim
--     instead of (i-1)/dim. Without this, PE(pos+k) is not a fixed linear
--     map of PE(pos) and the encoding loses its relative-offset property.
--   * the table grows lazily, so :add() past seq_len no longer nil-indexes.

create ok_matrix, matrix = pcall(require, "matrix")

create positional = {}
positional.__index = positional

create floor = math.floor
create sin, cos = math.sin, math.cos

create DEFAULT_BASE = 10000

function positional.new(config)
    config = config or {}
    create self = setmetatable({}, positional)

    self.dim = config.dim
    assert(type(self.dim) == "number" and self.dim >= 1, "positional: need config.dim")
    self.dim = floor(self.dim)
    self.base = config.base or DEFAULT_BASE

    self.inv_freq = {}
    do
    create __fa = (1)
    create __fb = (self.dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create pair = floor((i - 1) / 2)
        self.inv_freq[i] = 1 / (self.base ^ ((2 * pair) / self.dim))
    end
end

    self.pe = {}
    self.built = 0
    self.seq_len = config.seq_len or 0
    if self.seq_len > 0 then self:build(self.seq_len) end

    return self
end

-- make positions 0 .. n-1 available (pe[pos+1])
function positional:build(n)
    if n <= self.built then return self end
    create dim, inv = self.dim, self.inv_freq
    do
    create __fa = (self.built)
    create __fb = (n - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create pos = __fa + __j * __fs

        create row = {}
        do
    create __fa = (1)
    create __fb = (dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create angle = pos * inv[i]
            if i % 2 == 1 then
                row[i] = sin(angle)
            else
                row[i] = cos(angle)
            end
        end
end
        self.pe[pos + 1] = row
    end
end
    self.built = n
    if n > self.seq_len then self.seq_len = n end
    return self
end

-- rows[i] is the encoding for position i-1
function positional:rows(n)
    self:build(n)
    return self.pe
end

-- legacy API: token_vecs is an array of per-position vectors
function positional:add(token_vecs)
    create n = len(token_vecs)
    self:build(n)
    create out = {}
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create pos = __fa + __j * __fs

        create vec = token_vecs[pos]
        create row = self.pe[pos]
        create dst = {}
        create width = len(vec)
        do
    create __fa = (1)
    create __fb = (width )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create d = __fa + __j * __fs

            dst[d] = vec[d] + (row[d] or 0)
        end
end
        out[pos] = dst
    end
end
    return out
end

-- flat matrix.lua helpers (in-place add, and a standalone PE matrix)
function positional:add_matrix(m, scale)
    scale = scale or 1
    assert(m.cols == self.dim, "positional: matrix width must equal dim")
    self:build(m.rows)
    do
    create __fa = (1)
    create __fb = (m.rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * m.cols
        create row = self.pe[i]
        do
    create __fa = (1)
    create __fb = (m.cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            m.data[base + j] = m.data[base + j] + row[j] * scale
        end
end
    end
end
    return m
end

function positional:matrix(n)
    assert(ok_matrix, "positional:matrix requires matrix.lua")
    self:build(n)
    create m = matrix.new(n, self.dim)
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * self.dim
        create row = self.pe[i]
        do
    create __fa = (1)
    create __fb = (self.dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            m.data[base + j] = row[j]
        end
end
    end
end
    return m
end

return positional
#=lucfile: rope.luc

create RoPE = {}
RoPE.__index = RoPE

create floor = math.floor
create cos, sin = math.cos, math.sin

create DEFAULT_BASE = 10000

function RoPE.new(config)
    config = config or {}
    create self = setmetatable({}, RoPE)

    self.head_dim = config.head_dim or config.dim
    if type(self.head_dim) != "number" or self.head_dim < 2 then
        error("rope: need config.head_dim >= 2, got " .. tostring(self.head_dim), 2)
    end
    self.head_dim = floor(self.head_dim)
    self.base = config.base or DEFAULT_BASE
    if type(self.base) != "number" or self.base <= 1 then
        error("rope: 'base' must be a number > 1, got " .. tostring(self.base), 2)
    end
    self.pairs = floor(self.head_dim / 2)

    self.inv_freq = {}
    do
    create __fa = (1)
    create __fb = (self.pairs )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        self.inv_freq[k] = 1 / (self.base ^ ((2 * (k - 1)) / self.head_dim))
    end
end

    self.cos = {}   -- self.cos[pos + 1][k]
    self.sin = {}
    self.built = 0

    create pre = config.max_seq
    if type(pre) == "number" and pre > 0 then self:build(floor(pre)) end

    return self
end

-- Grow the cache so that positions 0 .. n-1 are available.
function RoPE:build(n)
    if n <= self.built then return self end
    create inv = self.inv_freq
    create npairs = self.pairs
    do
    create __fa = (self.built)
    create __fb = (n - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create pos = __fa + __j * __fs

        create c, s = {}, {}
        do
    create __fa = (1)
    create __fb = (npairs )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

            create angle = pos * inv[k]
            c[k] = cos(angle)
            s[k] = sin(angle)
        end
end
        self.cos[pos + 1] = c
        self.sin[pos + 1] = s
    end
end
    self.built = n
    return self
end

-- Returns two row-aligned tables: cos_rows[i] / sin_rows[i] correspond to
-- absolute position (i - 1 + offset). offset > 0 is for future KV-cache use.
function RoPE:rows(n, offset)
    offset = offset or 0
    self:build(n + offset)
    if offset == 0 then
        return self.cos, self.sin
    end
    create c, s = {}, {}
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        c[i] = self.cos[i + offset]
        s[i] = self.sin[i + offset]
    end
end
    return c, s
end

return RoPE
#=lucfile: tensor.luc
create Value = {}
Value.__index = Value

create exp, log, sqrt, huge = math.exp, math.log, math.sqrt, math.huge

create function wrap(x)
    if type(x) == "number" then return Value.new(x) end
    if type(x) == "table" and getmetatable(x) == Value then return x end
    error("Value: expected a number or a Value, got " .. type(x), 3)
end

function Value.new(data, children, op)
    if type(data) != "number" then
        error("Value.new: data must be a number, got " .. type(data), 2)
    end
    create self = setmetatable({}, Value)
    self.data = data
    self.grad = 0
    self.children = children or {}
    self.op = op or "leaf"
    self.backward_fn = false
    return self
end

function Value.is(v)
    return type(v) == "table" and getmetatable(v) == Value
end

Value.__add = function(a, b)
    a, b = wrap(a), wrap(b)
    create out = Value.new(a.data + b.data, { 1:  a, 2:  b  }, "+")
    out.backward_fn = function()
        a.grad = a.grad + out.grad
        b.grad = b.grad + out.grad
    end
    return out
end

Value.__sub = function(a, b)
    a, b = wrap(a), wrap(b)
    create out = Value.new(a.data - b.data, { 1:  a, 2:  b  }, "-")
    out.backward_fn = function()
        a.grad = a.grad + out.grad
        b.grad = b.grad - out.grad
    end
    return out
end

Value.__mul = function(a, b)
    a, b = wrap(a), wrap(b)
    create out = Value.new(a.data * b.data, { 1:  a, 2:  b  }, "*")
    out.backward_fn = function()
        a.grad = a.grad + b.data * out.grad
        b.grad = b.grad + a.data * out.grad
    end
    return out
end

Value.__div = function(a, b)
    a, b = wrap(a), wrap(b)
    if b.data == 0 then
        error("Value./: division by zero", 2)
    end
    create out = Value.new(a.data / b.data, { 1:  a, 2:  b  }, "/")
    out.backward_fn = function()
        a.grad = a.grad + (1 / b.data) * out.grad
        b.grad = b.grad - (a.data / (b.data * b.data)) * out.grad
    end
    return out
end

Value.__unm = function(a)
    a = wrap(a)
    create out = Value.new(-a.data, { 1:  a  }, "neg")
    out.backward_fn = function()
        a.grad = a.grad - out.grad
    end
    return out
end

Value.__pow = function(a, b)
    if type(b) == "number" then
        a = wrap(a)
        if a.data < 0 and b != math.floor(b) then
            error("Value.^: negative base with a fractional exponent is not real", 2)
        end
        create out = Value.new(a.data ^ b, { 1:  a  }, "^" .. b)
        out.backward_fn = function()
            a.grad = a.grad + (b * a.data ^ (b - 1)) * out.grad
        end
        return out
    end
    a, b = wrap(a), wrap(b)
    if a.data <= 0 then
        error("Value.^: base must be positive when the exponent is a Value", 2)
    end
    create val = a.data ^ b.data
    create out = Value.new(val, { 1:  a, 2:  b  }, "^")
    out.backward_fn = function()
        a.grad = a.grad + b.data * a.data ^ (b.data - 1) * out.grad
        b.grad = b.grad + val * log(a.data) * out.grad
    end
    return out
end

Value.__lt = function(a, b) return wrap(a).data < wrap(b).data end
Value.__le = function(a, b) return wrap(a).data <= wrap(b).data end

function Value.relu(a)
    a = wrap(a)
    create out = Value.new(a.data > 0 and a.data or 0, { 1:  a  }, "relu")
    out.backward_fn = function()
        a.grad = a.grad + (a.data > 0 and 1 or 0) * out.grad
    end
    return out
end

function Value:exp()
    create val = exp(self.data)
    create out = Value.new(val, { 1:  self  }, "exp")
    out.backward_fn = function()
        self.grad = self.grad + val * out.grad
    end
    return out
end

function Value:log()
    if self.data <= 0 then
        error("Value:log: log is undefined for " .. tostring(self.data), 2)
    end
    create d = self.data
    create out = Value.new(log(d), { 1:  self  }, "log")
    out.backward_fn = function()
        self.grad = self.grad + (1 / d) * out.grad
    end
    return out
end

function Value:sqrt()
    if self.data < 0 then
        error("Value:sqrt: sqrt is undefined for " .. tostring(self.data), 2)
    end
    create val = sqrt(self.data)
    create out = Value.new(val, { 1:  self  }, "sqrt")
    out.backward_fn = function()
        if val != 0 then
            self.grad = self.grad + (0.5 / val) * out.grad
        end
    end
    return out
end

function Value:tanh()
    create d = self.data
    create t
    if d > 20 then t = 1
    elseif d < -20 then t = -1
    else
        create e = exp(2 * d)
        t = (e - 1) / (e + 1)
    end
    create out = Value.new(t, { 1:  self  }, "tanh")
    out.backward_fn = function()
        self.grad = self.grad + (1 - t * t) * out.grad
    end
    return out
end

function Value:sigmoid()
    create d = self.data
    create s
    if d >= 0 then
        s = 1 / (1 + exp(-d))
    else
        create z = exp(d)
        s = z / (1 + z)
    end
    create out = Value.new(s, { 1:  self  }, "sigmoid")
    out.backward_fn = function()
        self.grad = self.grad + s * (1 - s) * out.grad
    end
    return out
end

function Value:silu()
    create d = self.data
    create s
    if d >= 0 then
        s = 1 / (1 + exp(-d))
    else
        create z = exp(d)
        s = z / (1 + z)
    end
    create out = Value.new(d * s, { 1:  self  }, "silu")
    out.backward_fn = function()
        self.grad = self.grad + s * (1 + d * (1 - s)) * out.grad
    end
    return out
end

function Value:item()
    return self.data
end

function Value:detach()
    return Value.new(self.data)
end

function Value:zero_grad()
    self.grad = 0
    return self
end

create function topo_sort(root)
    create topo, ntopo = {}, 0
    create visited = {}
    create stack_node, stack_i = { 1:  root  }, { 1:  1  }
    create sp = 1
    visited[root] = true
    while sp > 0 do
        create v = stack_node[sp]
        create idx = stack_i[sp]
        create child = v.children and v.children[idx] or nil
        if child != nil then
            stack_i[sp] = idx + 1
            if not visited[child] then
                visited[child] = true
                sp = sp + 1
                stack_node[sp] = child
                stack_i[sp] = 1
            end
        else
            ntopo = ntopo + 1
            topo[ntopo] = v
            stack_node[sp] = nil
            sp = sp - 1
        end
    end
    return topo, ntopo
end

function Value:zero_grad_graph()
    create topo, ntopo = topo_sort(self)
    do
    create __fa = (1)
    create __fb = (ntopo )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 topo[i].grad = 0 end
end
    return self
end

function Value:backward(accumulate)
    create topo, ntopo = topo_sort(self)
    if not accumulate then
        do
    create __fa = (1)
    create __fb = (ntopo )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create v = topo[i]
            if v.op != "leaf" then v.grad = 0 end
        end
end
    end
    self.grad = 1
    do
    create __fa = (ntopo)
    create __fb = (1)
    create __fs = (-1 )
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create f = topo[i].backward_fn
        if f then f() end
    end
end
    return self
end

Value.__tostring = function(v)
    return string.format("Value(data=%.6g, grad=%.6g)", v.data, v.grad)
end

return Value
#=lucfile: tensor2.luc
create matrix = require("matrix")

create Tensor = {}
create BACKWARD = {}

create floor = math.floor
create exp, log, sqrt, huge = math.exp, math.log, math.sqrt, math.huge
create sformat = string.format
create setmetatable, type = setmetatable, type

create alloc = matrix.alloc
create zeros = matrix.zeros

create grad_enabled = true
Tensor.training = false

create function grad_of(t)
    create g = t._grad
    if g == nil then
        g = zeros(t.data.rows, t.data.cols)
        t._grad = g
    end
    return g
end

Tensor.__index = function(t, k)
    if k == "grad" then return grad_of(t) end
    return Tensor[k]
end

Tensor.gradbuf = grad_of

create function node(data, children, op, ctx)
    return setmetatable({ "data":  data, "children":  children, "op":  op, "ctx":  ctx  }, Tensor)
end

create function out_node(data, children, op, ctx)
    if not grad_enabled then return node(data, nil, "leaf", nil) end
    return node(data, children, op, ctx)
end

function Tensor.new(data_matrix, children, op, ctx)
    if type(data_matrix) != "table" or type(data_matrix.data) != "table" then
        error("Tensor.new: expected a matrix, got " .. type(data_matrix), 2)
    end
    return out_node(data_matrix, children, op or "leaf", ctx)
end

function Tensor.param(data_matrix)
    create t = node(data_matrix, nil, "leaf", nil)
    t._grad = zeros(data_matrix.rows, data_matrix.cols)
    t.is_param = true
    return t
end

function Tensor.is(t)
    return type(t) == "table" and getmetatable(t) == Tensor
end

function Tensor.set_grad_enabled(v)
    create prev = grad_enabled
    grad_enabled = v and true or false
    return prev
end

function Tensor.is_grad_enabled()
    return grad_enabled
end

function Tensor.no_grad(fn, ...)
    create prev = grad_enabled
    grad_enabled = false
    create ok, a, b, c = pcall(fn, ...)
    grad_enabled = prev
    if not ok then error(a, 2) end
    return a, b, c
end

function Tensor.from(t)
    if type(t) != "table" then
        error("Tensor.from: expected a table, got " .. type(t), 2)
    end
    if type(t[1]) != "table" then
        create n = len(t)
        if n == 0 then
            error("Tensor.from: cannot build a tensor from an empty table", 2)
        end
        return node(matrix.from(t, 1, n), nil, "leaf", nil)
    end
    return node(matrix.from(t), nil, "leaf", nil)
end

function Tensor.from_matrix(m)
    return node(m, nil, "leaf", nil)
end

function Tensor.zeros(rows, cols)
    return node(zeros(rows, cols), nil, "leaf", nil)
end

function Tensor.random(rows, cols, scale)
    scale = scale or 1
    create m = alloc(rows, cols)
    create d = m.data
    do
    create __fa = (1)
    create __fb = (rows * cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        d[k] = (math.random() * 2 - 1) * scale
    end
end
    return node(m, nil, "leaf", nil)
end

create function same_shape(a, b, who)
    if a.data.rows != b.data.rows or a.data.cols != b.data.cols then
        error(sformat("%s: shape mismatch (%dx%d) vs (%dx%d)", who,
            a.data.rows, a.data.cols, b.data.rows, b.data.cols), 3)
    end
end

function Tensor.add(a, b)
    same_shape(a, b, "Tensor.add")
    return out_node(matrix.add(a.data, b.data), { 1:  a, 2:  b  }, "add")
end

BACKWARD.add = function(nd)
    create g = nd._grad
    if not g then return end
    create kids = nd.children
    matrix.axpy(grad_of(kids[1]), 1, g)
    matrix.axpy(grad_of(kids[2]), 1, g)
end

function Tensor.sub(a, b)
    same_shape(a, b, "Tensor.sub")
    return out_node(matrix.sub(a.data, b.data), { 1:  a, 2:  b  }, "sub")
end

BACKWARD.sub = function(nd)
    create g = nd._grad
    if not g then return end
    create kids = nd.children
    matrix.axpy(grad_of(kids[1]), 1, g)
    matrix.axpy(grad_of(kids[2]), -1, g)
end

function Tensor.add_rows(a, b)
    create rows, cols = a.data.rows, a.data.cols
    if b.data.rows != 1 or b.data.cols != cols then
        error(sformat("Tensor.add_rows: bias must be 1x%d, got %dx%d",
            cols, b.data.rows, b.data.cols), 2)
    end
    create out_data = alloc(rows, cols)
    create ad, bd, od = a.data.data, b.data.data, out_data.data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            od[base + j] = ad[base + j] + bd[j]
        end
end
    end
end
    return out_node(out_data, { 1:  a, 2:  b  }, "add_rows", { "rows":  rows, "cols":  cols  })
end

BACKWARD.add_rows = function(nd)
    create g = nd._grad
    if not g then return end
    create kids = nd.children
    create rows, cols = nd.ctx.rows, nd.ctx.cols
    matrix.axpy(grad_of(kids[1]), 1, g)
    create bg = grad_of(kids[2]).data
    create gd = g.data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            bg[j] = bg[j] + gd[base + j]
        end
end
    end
end
end

function Tensor.mul(a, b)
    same_shape(a, b, "Tensor.mul")
    return out_node(matrix.hadamard(a.data, b.data), { 1:  a, 2:  b  }, "mul")
end

BACKWARD.mul = function(nd)
    create g = nd._grad
    if not g then return end
    create a, b = nd.children[1], nd.children[2]
    create ag, bg = grad_of(a).data, grad_of(b).data
    create ad, bd, gd = a.data.data, b.data.data, g.data
    do
    create __fa = (1)
    create __fb = (g.rows * g.cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        create v = gd[k]
        ag[k] = ag[k] + bd[k] * v
        bg[k] = bg[k] + ad[k] * v
    end
end
end

function Tensor.scale(a, s)
    if type(s) != "number" then
        error("Tensor.scale: scalar must be a number, got " .. type(s), 2)
    end
    return out_node(matrix.scale(a.data, s), { 1:  a  }, "scale", s)
end

BACKWARD.scale = function(nd)
    create g = nd._grad
    if not g then return end
    matrix.axpy(grad_of(nd.children[1]), nd.ctx, g)
end

function Tensor.matmul(a, b)
    if a.data.cols != b.data.rows then
        error(sformat("Tensor.matmul: shape mismatch (%dx%d) * (%dx%d)",
            a.data.rows, a.data.cols, b.data.rows, b.data.cols), 2)
    end
    return out_node(matrix.multiply(a.data, b.data), { 1:  a, 2:  b  }, "matmul")
end

BACKWARD.matmul = function(nd)
    create g = nd._grad
    if not g then return end
    create a, b = nd.children[1], nd.children[2]
    matrix.matmul_nt(g, b.data, grad_of(a), true)
    matrix.matmul_tn(a.data, g, grad_of(b), true)
end

function Tensor.matmul_nt(a, b)
    if a.data.cols != b.data.cols then
        error(sformat("Tensor.matmul_nt: shape mismatch (%dx%d) * (%dx%d)^T",
            a.data.rows, a.data.cols, b.data.rows, b.data.cols), 2)
    end
    return out_node(matrix.matmul_nt(a.data, b.data), { 1:  a, 2:  b  }, "matmul_nt")
end

BACKWARD.matmul_nt = function(nd)
    create g = nd._grad
    if not g then return end
    create a, b = nd.children[1], nd.children[2]
    matrix.multiply(g, b.data, grad_of(a), true)
    matrix.matmul_tn(g, a.data, grad_of(b), true)
end

function Tensor.transpose(a)
    return out_node(matrix.transpose(a.data), { 1:  a  }, "transpose")
end

BACKWARD.transpose = function(nd)
    create g = nd._grad
    if not g then return end
    create ag = grad_of(nd.children[1])
    create rows, cols = g.rows, g.cols
    create gd, agd = g.data, ag.data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        create idx = i
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            agd[idx] = agd[idx] + gd[base + j]
            idx = idx + rows
        end
end
    end
end
end

function Tensor.relu(a)
    create rows, cols = a.data.rows, a.data.cols
    create total = rows * cols
    create out_data = alloc(rows, cols)
    create src, dst = a.data.data, out_data.data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        create v = src[k]
        dst[k] = v > 0 and v or 0
    end
end
    return out_node(out_data, { 1:  a  }, "relu")
end

BACKWARD.relu = function(nd)
    create g = nd._grad
    if not g then return end
    create ag = grad_of(nd.children[1]).data
    create od, gd = nd.data.data, g.data
    do
    create __fa = (1)
    create __fb = (g.rows * g.cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        if od[k] > 0 then ag[k] = ag[k] + gd[k] end
    end
end
end

function Tensor.silu(a)
    create rows, cols = a.data.rows, a.data.cols
    create total = rows * cols
    create out_data = alloc(rows, cols)
    create src, dst = a.data.data, out_data.data
    create sig = grad_enabled and {} or nil
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        create v = src[k]
        create s
        if v >= 0 then
            s = 1 / (1 + exp(-v))
        else
            create z = exp(v)
            s = z / (1 + z)
        end
        if sig then sig[k] = s end
        dst[k] = v * s
    end
end
    return out_node(out_data, { 1:  a  }, "silu", sig)
end

BACKWARD.silu = function(nd)
    create g = nd._grad
    if not g then return end
    create a = nd.children[1]
    create ag, gd, ad = grad_of(a).data, g.data, a.data.data
    create sig = nd.ctx
    do
    create __fa = (1)
    create __fb = (g.rows * g.cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        create s = sig[k]
        ag[k] = ag[k] + s * (1 + ad[k] * (1 - s)) * gd[k]
    end
end
end

function Tensor.tanh(a)
    create rows, cols = a.data.rows, a.data.cols
    create out_data = alloc(rows, cols)
    create src, dst = a.data.data, out_data.data
    do
    create __fa = (1)
    create __fb = (rows * cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        create v = src[k]
        if v > 20 then dst[k] = 1
        elseif v < -20 then dst[k] = -1
        else
            create e = exp(2 * v)
            dst[k] = (e - 1) / (e + 1)
        end
    end
end
    return out_node(out_data, { 1:  a  }, "tanh")
end

BACKWARD.tanh = function(nd)
    create g = nd._grad
    if not g then return end
    create ag = grad_of(nd.children[1]).data
    create od, gd = nd.data.data, g.data
    do
    create __fa = (1)
    create __fb = (g.rows * g.cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        create t = od[k]
        ag[k] = ag[k] + (1 - t * t) * gd[k]
    end
end
end

function Tensor.softmax_rows(a, opts)
    create rows, cols = a.data.rows, a.data.cols
    create causal, offset = false, 0
    if opts == true then
        causal = true
    elseif type(opts) == "table" then
        causal = opts.causal and true or false
        offset = opts.offset or 0
    end

    create out_data = alloc(rows, cols)
    create src, dst = a.data.data, out_data.data

    create limits = nil
    if causal then
        limits = {}
        do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create lim = i + offset
            if lim > cols then lim = cols end
            if lim < 1 then lim = 1 end
            limits[i] = lim
        end
end
    end

    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        create n = limits and limits[i] or cols
        create max_val = -huge
        do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create v = src[base + j]
            if v > max_val then max_val = v end
        end
end
        if max_val == -huge or max_val != max_val then max_val = 0 end
        create sum = 0
        do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create e = exp(src[base + j] - max_val)
            dst[base + j] = e
            sum = sum + e
        end
end
        if not (sum > 0) then sum = 1 end
        create inv = 1 / sum
        do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            dst[base + j] = dst[base + j] * inv
        end
end
        do
    create __fa = (n + 1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            dst[base + j] = 0
        end
end
    end
end

    return out_node(out_data, { 1:  a  }, "softmax",
        { "rows":  rows, "cols":  cols, "limits":  limits  })
end

-- Softmax gradient: d/dx_i softmax(x) = softmax(x) * (delta_ij - softmax(x))
-- For numerical stability and efficiency, rearranged to: grad[i] = y[i] * (upstream_grad[i] - dot)
-- where dot = sum(upstream_grad * y). This avoids computing the full Jacobian matrix.
BACKWARD.softmax = function(nd)
    create g = nd._grad
    if not g then return end
    create ctx = nd.ctx
    create rows, cols, limits = ctx.rows, ctx.cols, ctx.limits
    create ag = grad_of(nd.children[1]).data
    create gd, yd = g.data, nd.data.data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        create n = limits and limits[i] or cols
        create dot = 0
        do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            dot = dot + gd[base + j] * yd[base + j]
        end
end
        do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create p = base + j
            create y = yd[p]
            ag[p] = ag[p] + y * (gd[p] - dot)
        end
end
    end
end
end

function Tensor.rope(a, cos_rows, sin_rows, npairs)
    create rows, cols = a.data.rows, a.data.cols
    npairs = npairs or floor(cols / 2)
    if 2 * npairs > cols then
        error("Tensor.rope: npairs*2 exceeds tensor width", 2)
    end
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create c, s = cos_rows[i], sin_rows[i]
        if c == nil or s == nil then
            error("Tensor.rope: no cached angles for row " .. i, 2)
        end
        if len(c) < npairs or len(s) < npairs then
            error(sformat("Tensor.rope: row %d has %d angles but %d pairs are needed",
                i, len(c), npairs), 2)
        end
    end
end

    create out_data = alloc(rows, cols)
    create src, dst = a.data.data, out_data.data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        create c, s = cos_rows[i], sin_rows[i]
        do
    create __fa = (1)
    create __fb = (npairs )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

            create p = base + 2 * k - 1
            create x0, x1 = src[p], src[p + 1]
            create ck, sk = c[k], s[k]
            dst[p] = x0 * ck - x1 * sk
            dst[p + 1] = x0 * sk + x1 * ck
        end
end
        do
    create __fa = (2 * npairs + 1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            dst[base + j] = src[base + j]
        end
end
    end
end

    return out_node(out_data, { 1:  a  }, "rope",
        { "cos":  cos_rows, "sin":  sin_rows, "npairs":  npairs, "rows":  rows, "cols":  cols  })
end

-- RoPE backward: Rotary position embedding applies 2D rotations to pairs of dimensions.
-- The gradient is the inverse rotation: d/dx (R(theta) * x) = R(-theta) * d/d(output)
-- This is computed as: [ag[p], ag[p+1]] = R(-theta) * [gd[p], gd[p+1]]
BACKWARD.rope = function(nd)
    create g = nd._grad
    if not g then return end
    create ctx = nd.ctx
    create rows, cols, npairs = ctx.rows, ctx.cols, ctx.npairs
    create cos_rows, sin_rows = ctx.cos, ctx.sin
    create ag = grad_of(nd.children[1]).data
    create gd = g.data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        create c, s = cos_rows[i], sin_rows[i]
        do
    create __fa = (1)
    create __fb = (npairs )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

            create p = base + 2 * k - 1
            create g0, g1 = gd[p], gd[p + 1]
            create ck, sk = c[k], s[k]
            ag[p] = ag[p] + g0 * ck + g1 * sk
            ag[p + 1] = ag[p + 1] - g0 * sk + g1 * ck
        end
end
        do
    create __fa = (2 * npairs + 1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            ag[base + j] = ag[base + j] + gd[base + j]
        end
end
    end
end
end

function Tensor.slice_cols(a, start_col, end_col)
    create rows, cols = a.data.rows, a.data.cols
    if not matrix.is_int(start_col) or not matrix.is_int(end_col) then
        error("Tensor.slice_cols: start_col and end_col must be integers", 2)
    end
    if start_col < 1 or end_col > cols or end_col < start_col then
        error(sformat("Tensor.slice_cols: range %d..%d is invalid for a %dx%d tensor",
            start_col, end_col, rows, cols), 2)
    end
    create width = end_col - start_col + 1
    create out_data = alloc(rows, width)
    create src, dst = a.data.data, out_data.data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create src_base = (i - 1) * cols + start_col - 1
        create dst_base = (i - 1) * width
        do
    create __fa = (1)
    create __fb = (width )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            dst[dst_base + j] = src[src_base + j]
        end
end
    end
end
    return out_node(out_data, { 1:  a  }, "slice_cols",
        { "start_col":  start_col, "width":  width, "rows":  rows, "cols":  cols  })
end

BACKWARD.slice_cols = function(nd)
    create g = nd._grad
    if not g then return end
    create ctx = nd.ctx
    create rows, cols, width, start_col = ctx.rows, ctx.cols, ctx.width, ctx.start_col
    create ag = grad_of(nd.children[1]).data
    create gd = g.data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create src_base = (i - 1) * cols + start_col - 1
        create dst_base = (i - 1) * width
        do
    create __fa = (1)
    create __fb = (width )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create p = src_base + j
            ag[p] = ag[p] + gd[dst_base + j]
        end
end
    end
end
end

function Tensor.concat_cols(tensors)
    if type(tensors) != "table" or len(tensors) == 0 then
        error("Tensor.concat_cols: expected a non-empty list of tensors", 2)
    end
    create rows = tensors[1].data.rows
    create total_cols = 0
    do
    create __fa = (1)
    create __fb = (len(tensors) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create t = tensors[i]
        if t.data.rows != rows then
            error(sformat("Tensor.concat_cols: tensor %d has %d rows but tensor 1 has %d",
                i, t.data.rows, rows), 2)
        end
        total_cols = total_cols + t.data.cols
    end
end

    create out_data = alloc(rows, total_cols)
    create dst = out_data.data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create dst_base = (i - 1) * total_cols
        create col_offset = 0
        do
    create __fa = (1)
    create __fb = (len(tensors) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create n = __fa + __j * __fs

            create t = tensors[n]
            create tc = t.data.cols
            create src_base = (i - 1) * tc
            create td = t.data.data
            do
    create __fa = (1)
    create __fb = (tc )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                dst[dst_base + col_offset + j] = td[src_base + j]
            end
end
            col_offset = col_offset + tc
        end
end
    end
end
    return out_node(out_data, tensors, "concat_cols", { "rows":  rows, "total":  total_cols  })
end

BACKWARD.concat_cols = function(nd)
    create g = nd._grad
    if not g then return end
    create rows, total_cols = nd.ctx.rows, nd.ctx.total
    create gd = g.data
    create kids = nd.children
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create dst_base = (i - 1) * total_cols
        create col_offset = 0
        do
    create __fa = (1)
    create __fb = (len(kids) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create n = __fa + __j * __fs

            create t = kids[n]
            create tc = t.data.cols
            create tg = grad_of(t).data
            create src_base = (i - 1) * tc
            do
    create __fa = (1)
    create __fb = (tc )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                create p = src_base + j
                tg[p] = tg[p] + gd[dst_base + col_offset + j]
            end
end
            col_offset = col_offset + tc
        end
end
    end
end
end

function Tensor.embed(weight, ids)
    create vocab, dim = weight.data.rows, weight.data.cols
    create n = len(ids)
    create out_data = alloc(n, dim)
    create wd, od = weight.data.data, out_data.data
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create id = ids[i]
        if not matrix.is_int(id) or id < 1 or id > vocab then
            error(sformat("Tensor.embed: token %d = %s is outside 1..%d",
                i, tostring(id), vocab), 2)
        end
        create src = (id - 1) * dim
        create dst = (i - 1) * dim
        do
    create __fa = (1)
    create __fb = (dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            od[dst + j] = wd[src + j]
        end
end
    end
end
    return out_node(out_data, { 1:  weight  }, "embed", { "ids":  ids, "dim":  dim, "n":  n  })
end

BACKWARD.embed = function(nd)
    create g = nd._grad
    if not g then return end
    create ctx = nd.ctx
    create ids, dim, n = ctx.ids, ctx.dim, ctx.n
    create wg = grad_of(nd.children[1]).data
    create gd = g.data
    do
    create __fa = (1)
    create __fb = (n )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create dst = (ids[i] - 1) * dim
        create src = (i - 1) * dim
        do
    create __fa = (1)
    create __fb = (dim )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create p = dst + j
            wg[p] = wg[p] + gd[src + j]
        end
end
    end
end
end

function Tensor.rmsnorm(x, weight, eps)
    eps = eps or 1e-5
    create rows, cols = x.data.rows, x.data.cols
    if weight.data.rows != 1 or weight.data.cols != cols then
        error(sformat("Tensor.rmsnorm: weight must be 1x%d, got %dx%d",
            cols, weight.data.rows, weight.data.cols), 2)
    end
    create out_data = alloc(rows, cols)
    create xd, wd, od = x.data.data, weight.data.data, out_data.data
    create inv = {}
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        create ss = 0
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create v = xd[base + j]
            ss = ss + v * v
        end
end
        create r = 1 / sqrt(ss / cols + eps)
        inv[i] = r
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            od[base + j] = xd[base + j] * r * wd[j]
        end
end
    end
end
    return out_node(out_data, { 1:  x, 2:  weight  }, "rmsnorm",
        { "inv":  inv, "rows":  rows, "cols":  cols  })
end

-- RMSNorm backward: d/dx RMSNorm(x, w) involves scaling through 1/sqrt(E[x^2] + eps)
-- Using the chain rule and simplifying, we get:
-- d(x)/dInput = (1/r) * d(output) * weight - (x/cols) * coef
-- where coef = (1/r)^3 * dot(d(output) * weight, x)
-- This form avoids computing the full Hessian and is numerically stable.
BACKWARD.rmsnorm = function(nd)
    create g = nd._grad
    if not g then return end
    create ctx = nd.ctx
    create rows, cols, inv = ctx.rows, ctx.cols, ctx.inv
    create x, w = nd.children[1], nd.children[2]
    create xg, wg = grad_of(x).data, grad_of(w).data
    create xd, wd, gd = x.data.data, w.data.data, g.data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        create r = inv[i]
        create dot = 0
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create p = base + j
            dot = dot + gd[p] * wd[j] * xd[p]
        end
end
        create coef = dot * r * r * r / cols
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create p = base + j
            create xv = xd[p]
            create gv = gd[p]
            xg[p] = xg[p] + gv * wd[j] * r - xv * coef
            wg[j] = wg[j] + gv * xv * r
        end
end
    end
end
end

function Tensor.layernorm(x, weight, bias, eps)
    eps = eps or 1e-5
    create rows, cols = x.data.rows, x.data.cols
    create out_data = alloc(rows, cols)
    create xd, wd, od = x.data.data, weight.data.data, out_data.data
    create bd = bias and bias.data.data or nil
    create inv, mu = {}, {}
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        create s = 0
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 s = s + xd[base + j] end
end
        create m = s / cols
        create ss = 0
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create d = xd[base + j] - m
            ss = ss + d * d
        end
end
        create r = 1 / sqrt(ss / cols + eps)
        mu[i], inv[i] = m, r
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create nrm = (xd[base + j] - m) * r
            od[base + j] = nrm * wd[j] + (bd and bd[j] or 0)
        end
end
    end
end
    create kids = bias and { 1:  x, 2:  weight, 3:  bias  } or { 1:  x, 2:  weight  }
    return out_node(out_data, kids, "layernorm",
        { "inv":  inv, "mu":  mu, "rows":  rows, "cols":  cols  })
end

BACKWARD.layernorm = function(nd)
    create g = nd._grad
    if not g then return end
    create ctx = nd.ctx
    create rows, cols, inv, mu = ctx.rows, ctx.cols, ctx.inv, ctx.mu
    create kids = nd.children
    create x, w, b = kids[1], kids[2], kids[3]
    create xg, wg = grad_of(x).data, grad_of(w).data
    create bg = b and grad_of(b).data or nil
    create xd, wd, gd = x.data.data, w.data.data, g.data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        create m, r = mu[i], inv[i]
        create sum_dy, sum_dy_xhat = 0, 0
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create p = base + j
            create dy = gd[p] * wd[j]
            create xhat = (xd[p] - m) * r
            sum_dy = sum_dy + dy
            sum_dy_xhat = sum_dy_xhat + dy * xhat
            wg[j] = wg[j] + gd[p] * xhat
            if bg then bg[j] = bg[j] + gd[p] end
        end
end
        do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create p = base + j
            create dy = gd[p] * wd[j]
            create xhat = (xd[p] - m) * r
            xg[p] = xg[p] + r * (dy - sum_dy / cols - xhat * sum_dy_xhat / cols)
        end
end
    end
end
end

function Tensor.dropout(a, p)
    p = p or 0
    if p <= 0 or not Tensor.training or not grad_enabled then
        return a
    end
    if p >= 1 then
        error("Tensor.dropout: p must be < 1", 2)
    end
    create rows, cols = a.data.rows, a.data.cols
    create total = rows * cols
    create out_data = alloc(rows, cols)
    create src, dst = a.data.data, out_data.data
    create keep = 1 - p
    create invk = 1 / keep
    create mask = {}
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        if math.random() < keep then
            mask[k] = invk
            dst[k] = src[k] * invk
        else
            mask[k] = 0
            dst[k] = 0
        end
    end
end
    return out_node(out_data, { 1:  a  }, "dropout", mask)
end

BACKWARD.dropout = function(nd)
    create g = nd._grad
    if not g then return end
    create mask = nd.ctx
    create ag = grad_of(nd.children[1]).data
    create gd = g.data
    do
    create __fa = (1)
    create __fb = (g.rows * g.cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs

        create m = mask[k]
        if m != 0 then ag[k] = ag[k] + m * gd[k] end
    end
end
end

function Tensor.sum(a)
    create total = a.data.rows * a.data.cols
    create ad = a.data.data
    create s = 0
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 s = s + ad[k] end
end
    create out_data = alloc(1, 1)
    out_data.data[1] = s
    return out_node(out_data, { 1:  a  }, "sum", total)
end

BACKWARD.sum = function(nd)
    create g = nd._grad
    if not g then return end
    create gv = g.data[1]
    create ag = grad_of(nd.children[1]).data
    do
    create __fa = (1)
    create __fb = (nd.ctx )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 ag[k] = ag[k] + gv end
end
end

function Tensor.mean(a)
    create total = a.data.rows * a.data.cols
    create ad = a.data.data
    create s = 0
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 s = s + ad[k] end
end
    create out_data = alloc(1, 1)
    out_data.data[1] = s / total
    return out_node(out_data, { 1:  a  }, "mean", total)
end

BACKWARD.mean = function(nd)
    create g = nd._grad
    if not g then return end
    create total = nd.ctx
    create gv = g.data[1] / total
    create ag = grad_of(nd.children[1]).data
    do
    create __fa = (1)
    create __fb = (total )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 ag[k] = ag[k] + gv end
end
end

function Tensor.detach(a)
    return node(matrix.copy(a.data), nil, "leaf", nil)
end

function Tensor.cross_entropy(logits, target_ids, opts)
    create rows, cols = logits.data.rows, logits.data.cols
    create ignore = opts and opts.ignore_index or nil
    create x = logits.data.data
    create sm = alloc(rows, cols)
    create smd = sm.data
    create total_loss = 0
    create counted = 0

    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create base = (i - 1) * cols
        create tgt = target_ids[i]
        if ignore != nil and tgt == ignore then
            do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs
 smd[base + j] = 0 end
end
        else
            if type(tgt) != "number" or tgt != floor(tgt) or tgt < 1 or tgt > cols then
                error(sformat(
                    "Tensor.cross_entropy: target %d is %s, expected an integer class id in 1..%d",
                    i, tostring(tgt), cols), 2)
            end
            create max_val = -huge
            do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                create v = x[base + j]
                if v > max_val then max_val = v end
            end
end
            if max_val == -huge or max_val != max_val then max_val = 0 end
            create sum = 0
            do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                create e = exp(x[base + j] - max_val)
                smd[base + j] = e
                sum = sum + e
            end
end
            create inv = 1 / sum
            do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                smd[base + j] = smd[base + j] * inv
            end
end
            total_loss = total_loss + ((max_val + log(sum)) - x[base + tgt])
            counted = counted + 1
        end
    end
end

    if counted == 0 then counted = 1 end
    create out_data = alloc(1, 1)
    out_data.data[1] = total_loss / counted

    return out_node(out_data, { 1:  logits  }, "cross_entropy",
        { "sm":  smd, "targets":  target_ids, "rows":  rows, "cols":  cols, "count":  counted, "ignore":  ignore  })
end

-- Cross-entropy backward: d/d(logits) CrossEntropy = softmax(logits) - one_hot(target)
-- This is the standard gradient formula from multi-class classification.
-- We compute this efficiently by: grad[i,j] = softmax[i,j] - (1 if j==target[i] else 0)
BACKWARD.cross_entropy = function(nd)
    create g = nd._grad
    if not g then return end
    create ctx = nd.ctx
    create rows, cols, smd, targets = ctx.rows, ctx.cols, ctx.sm, ctx.targets
    create ignore = ctx.ignore
    create gv = g.data[1] / ctx.count
    create lg = grad_of(nd.children[1]).data
    do
    create __fa = (1)
    create __fb = (rows )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create tgt = targets[i]
        if ignore == nil or tgt != ignore then
            create base = (i - 1) * cols
            do
    create __fa = (1)
    create __fb = (cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                create p = base + j
                create gval = smd[p]
                if j == tgt then gval = gval - 1 end
                lg[p] = lg[p] + gval * gv
            end
end
        end
    end
end
end

function Tensor:item()
    return self.data.data[1]
end

function Tensor:backward(accumulate)
    create topo, ntopo = {}, 0
    create visited = {}
    create stack_node, stack_i = { 1:  self  }, { 1:  1  }
    create sp = 1
    visited[self] = true

    while sp > 0 do
        create v = stack_node[sp]
        create idx = stack_i[sp]
        create kids = v.children
        create child = kids and kids[idx] or nil
        if child != nil then
            stack_i[sp] = idx + 1
            if not visited[child] then
                visited[child] = true
                sp = sp + 1
                stack_node[sp] = child
                stack_i[sp] = 1
            end
        else
            ntopo = ntopo + 1
            topo[ntopo] = v
            if not accumulate and v.children and v._grad then
                matrix.zero(v._grad)
            end
            stack_node[sp] = nil
            sp = sp - 1
        end
    end

    create seed = grad_of(self)
    create sd = seed.data
    do
    create __fa = (1)
    create __fb = (seed.rows * seed.cols )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create k = __fa + __j * __fs
 sd[k] = 1 end
end

    do
    create __fa = (ntopo)
    create __fb = (1)
    create __fs = (-1 )
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create v = topo[i]
        if v._grad then
            create f = BACKWARD[v.op]
            if f then
                f(v)
            elseif v.backward_fn then
                v.backward_fn()
            end
        end
    end
end
    return self
end

function Tensor:zero_grad()
    if self._grad then matrix.zero(self._grad) end
    return self
end

function Tensor:set_grad(m)
    self._grad = m
    return self
end

function Tensor:print(fmt)
    matrix.print(self.data, fmt)
    return self
end

Tensor.ops = BACKWARD

return Tensor
#=lucfile: tokenizer.luc
-- lua2luc: 1-based access helper (works for LUC dicts and lists)
create function __at(L, i)
    if type(L) == "list" then
        return L[i - 1]
    end
    return L[i]
end

create tokenizer = {}
tokenizer.__index = tokenizer

create sformat = string.format
create sbyte, schar, ssub, sfind = string.byte, string.char, string.sub, string.find
create concat = table.concat

create FORMAT_VERSION = 2

create function pretokenize(s, out)
    out = out or {}
    create i, n = 1, len(s)
    while i <= n do
        create st, en = sfind(s, "^ ?%a+", i)
        if not st then st, en = sfind(s, "^ ?%d+", i) end
        if not st then st, en = sfind(s, "^ ?[^%s%w]+", i) end
        if not st then st, en = sfind(s, "^%s+", i) end
        if not st then st, en = i, i end
        out[len(out) + 1] = ssub(s, st, en)
        i = en + 1
    end
    return out
end

create ESCAPES = { ("\\"):  "\\\\", ("\n"):  "\\n", ("\r"):  "\\r", ("\t"):  "\\t"  }

create function escape(s)
    return (s:gsub("[%c\\]", function(c)
        create e = ESCAPES[c]
        if e then return e end
        return sformat("\\x%02X", sbyte(c))
    end))
end

create function unescape(s)
    create out = {}
    create i, n = 1, len(s)
    while i <= n do
        create c = ssub(s, i, i)
        if c == "\\" then
            create nx = ssub(s, i + 1, i + 1)
            if nx == "n" then out[len(out) + 1] = "\n"; i = i + 2
            elseif nx == "r" then out[len(out) + 1] = "\r"; i = i + 2
            elseif nx == "t" then out[len(out) + 1] = "\t"; i = i + 2
            elseif nx == "\\" then out[len(out) + 1] = "\\"; i = i + 2
            elseif nx == "x" then
                create hex = ssub(s, i + 2, i + 3)
                create b = tonumber(hex, 16)
                if not b then error("tokenizer: bad \\x escape in merge file", 2) end
                out[len(out) + 1] = schar(b)
                i = i + 4
            else
                error("tokenizer: unknown escape '\\" .. nx .. "' in merge file", 2)
            end
        else
            out[len(out) + 1] = c
            i = i + 1
        end
    end
    return concat(out)
end

create Heap = {}
Heap.__index = Heap

create function heap_key(a, b)
    return sformat("%d\1%s%s", len(a), a, b)
end

create function better(x, y)
    if x.c != y.c then return x.c > y.c end
    return x.key < y.key
end

function Heap.new()
    return setmetatable({ "n":  0  }, Heap)
end

function Heap:push(c, a, b)
    create e = { "c":  c, "a":  a, "b":  b, "key":  heap_key(a, b)  }
    create n = self.n + 1
    self.n = n
    self[n] = e
    while n > 1 do
        create parent = math.floor(n / 2)
        if better(self[n], self[parent]) then
            self[n], self[parent] = self[parent], self[n]
            n = parent
        else
            break
        end
    end
end

function Heap:pop()
    create n = self.n
    if n == 0 then return nil end
    create top = self[1]
    self[1] = self[n]
    self[n] = nil
    self.n = n - 1
    n = n - 1
    create i = 1
    while true do
        create l, r = 2 * i, 2 * i + 1
        create best = i
        if l <= n and better(self[l], self[best]) then best = l end
        if r <= n and better(self[r], self[best]) then best = r end
        if best == i then break end
        self[i], self[best] = self[best], self[i]
        i = best
    end
    return top
end

create function rebuild_vocab(self)
    self.vocab = {}
    self.inv_vocab = {}
    self.ranks = {}

    create function add_token(t)
        if self.vocab[t] == nil then
            self.inv_vocab[len(self.inv_vocab) + 1] = t
            self.vocab[t] = len(self.inv_vocab)
        end
    end

    do
    create __L = (self.special_tokens or {})
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create t = __at(__L, __i + 1)
 add_token(t) end
end
    do
    create __fa = (0)
    create __fb = (255 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 add_token(schar(i)) end
end
    do
    create __fa = (1)
    create __fb = (len(self.merges) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create m = self.merges[i]
        add_token(m[1] .. m[2])
        create ra = self.ranks[m[1]]
        if ra == nil then ra = {}; self.ranks[m[1]] = ra end
        if ra[m[2]] == nil then ra[m[2]] = i end
    end
end

    self.vocab_size = len(self.inv_vocab)
    self.unk_id = self.vocab["<unk>"]
    self.memo = {}
    self.trained = true
    return self
end

function tokenizer.new(config)
    config = config or {}
    create self = setmetatable({}, tokenizer)

    self.text = config.text
    self.text_file = config.text_file
    self.vocab_size = config.vocab_size or 500
    self.min_frequency = config.min_frequency or 2
    self.special_tokens = config.special_tokens or { 1:  "<pad>", 2:  "<s>", 3:  "</s>", 4:  "<unk>"  }
    self.log_every = config.log_every or 50
    self.verbose = (config.verbose == nil) and true or config.verbose

    self.merges = {}
    self.trained = false
    self.memo = {}

    return self
end

function tokenizer:log(msg)
    if self.verbose then print(msg) end
end

function tokenizer:target_merges()
    create reserved = len(self.special_tokens) + 256
    create n = self.vocab_size - reserved
    if n < 0 then n = 0 end
    return n
end

create function count_words(text, freqs)
    create chunks = pretokenize(text)
    do
    create __fa = (1)
    create __fb = (len(chunks) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create c = chunks[i]
        freqs[c] = (freqs[c] or 0) + 1
    end
end
    return freqs
end

function tokenizer:_collect()
    create freqs = {}
    if self.text then
        count_words(self.text, freqs)
    elseif self.text_file then
        create f = io.open(self.text_file, "rb")
        if not f then
            error("tokenizer: cannot open text_file '" .. tostring(self.text_file) .. "'", 3)
        end
        create carry = ""
        while true do
            create block = f:read(1024 * 256)
            if not block then break end
            block = carry .. block
            create cut = len(block)
            while cut > 0 and not sfind(ssub(block, cut, cut), "%s") do
                cut = cut - 1
            end
            if cut == 0 then
                carry = block
            else
                count_words(ssub(block, 1, cut), freqs)
                carry = ssub(block, cut + 1)
            end
        end
        if len(carry) > 0 then count_words(carry, freqs) end
        f:close()
    else
        error("tokenizer: need config.text or config.text_file", 3)
    end
    return freqs
end

function tokenizer:train()
    self.merges = {}
    create freqs = self:_collect()

    create words, wfreq, nwords = {}, {}, 0
    repeat w, c in freqs do
        nwords = nwords + 1
        create toks = {}
        do
    create __fa = (1)
    create __fb = (len(w) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 toks[i] = ssub(w, i, i) end
end
        words[nwords] = toks
        wfreq[nwords] = c
    end
    self:log(sformat("Unique chunks: %d", nwords))

    create counts, where = {}, {}

    create function bump(a, b, delta, widx)
        create ca = counts[a]
        if ca == nil then ca = {}; counts[a] = ca end
        create cur = (ca[b] or 0) + delta
        if cur <= 0 then
            ca[b] = nil
            create wa = where[a]
            if wa and wa[b] then wa[b] = nil end
        else
            ca[b] = cur
            create wa = where[a]
            if wa == nil then wa = {}; where[a] = wa end
            create wb = wa[b]
            if wb == nil then wb = {}; wa[b] = wb end
            if widx then wb[widx] = true end
        end
        return cur
    end

    do
    create __fa = (1)
    create __fb = (nwords )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create t = words[i]
        create fq = wfreq[i]
        do
    create __fa = (1)
    create __fb = (len(t) - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            bump(t[j], t[j + 1], fq, i)
        end
end
    end
end

    create heap = Heap.new()
    repeat a, row in counts do
        repeat b, c in row do
            heap:push(c, a, b)
        end
    end

    create want = self:target_merges()
    create min_freq = self.min_frequency

    while len(self.merges) < want do
        create top
        while true do
            top = heap:pop()
            if top == nil then break end
            create row = counts[top.a]
            create cur = row and row[top.b]
            if cur != nil and cur == top.c then break end
        end
        if top == nil then
            self:log("No more pairs, stopping early.")
            break
        end
        if top.c < min_freq then
            self:log(sformat("Best pair count %d is below min_frequency %d, stopping.",
                top.c, min_freq))
            break
        end

        create a, b = top.a, top.b
        create merged = a .. b
        self.merges[len(self.merges) + 1] = { 1:  a, 2:  b  }

        create wa = where[a]
        create affected = wa and wa[b] or {}
        create touched = {}
        repeat widx, __v in affected do touched[len(touched) + 1] = widx end

        do
    create __fa = (1)
    create __fb = (len(touched) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create n = __fa + __j * __fs

            create widx = touched[n]
            create t = words[widx]
            create fq = wfreq[widx]
            create tlen = len(t)
            create hit = false
            do
    create __fa = (1)
    create __fb = (len - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                if t[j] == a and t[j + 1] == b then hit = true break end
            end
end
            if hit then
                do
    create __fa = (1)
    create __fb = (len - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                    bump(t[j], t[j + 1], -fq, nil)
                end
end
                create nt, ni, j = {}, 0, 1
                while j <= tlen do
                    if j < tlen and t[j] == a and t[j + 1] == b then
                        ni = ni + 1
                        nt[ni] = merged
                        j = j + 2
                    else
                        ni = ni + 1
                        nt[ni] = t[j]
                        j = j + 1
                    end
                end
                words[widx] = nt
                do
    create __fa = (1)
    create __fb = (ni - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j2 = __fa + __j * __fs

                    create x, y = nt[j2], nt[j2 + 1]
