            end
        end
end

        create ca = counts[a]
        if ca then ca[b] = nil end
        create wa2 = where[a]
        if wa2 then wa2[b] = nil end

        if len(self.merges) % self.log_every == 0 then
            self:log(sformat("Merge #%d: %q + %q (count=%d)", len(self.merges), a, b, top.c))
        end
    end

    rebuild_vocab(self)
    self:log(sformat("Vocabulary: %d tokens from %d merges", self.vocab_size, len(self.merges)))
