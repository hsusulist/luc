-- demos/discordbot.luc -- Discord ping bot template (import discord)
-- 1. create a bot at https://discord.com/developers/applications
-- 2. turn on MESSAGE CONTENT INTENT (Bot page) to read text
-- 3. invite it with applications.commands scope, put the token below
-- run: luc demos/discordbot.luc

import discord("bot")

create token = bot.token("TOKEN_HERE")

bot:run(token) do
    while true do
        create cmd = bot.prefix("!")
        if cmd == "ping" then
            bot.msg:send("pong!")
        end
    end
end
