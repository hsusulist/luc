-- demos/net_libaries/http.luc -- one-line HTTPS GET (import net)
-- run: luc "demos/net_libaries/http.luc"

import net("n")

create page, code = n.get("https://example.com")
if page == nil then
    -- no internet, bad certificate, TLS problem...: n.get returns nil and the reason
    print("request failed: " .. tostring(code))
else
    print(code)
    print(len(page))
end
