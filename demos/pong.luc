import window
-- settings
create WW, WH      = 900, 560
create WIN_SCORE   = 7
create PW, PH      = 14, 96
create MARGIN      = 26
create P_SPEED     = 430
create AI_SPEED    = 320
create AI_BACK     = 150
create BALL_R      = 8
create SERVE_T     = 0.9
create SPEED0      = 300
create SPEED_UP    = 1.045
create SPEED_MAX   = 2000

create BG     = "#0f1226"
create NET_C  = "#2b3257"
create P_COL  = "cyan"
create A_COL  = "orange"
create BALL_C = "white"
create TXT_C  = "white"
create DIM_C  = {"r": 8, "g": 10, "b": 24, "a": 175}

create px, py   = MARGIN, (WH-PH)/2
create ax, ay   = WW-MARGIN-PW, (WH-PH)/2
create bx, by   = WW/2, WH/2
create bvx, bvy = 0, 0
create speed    = SPEED0
create pscore, ascore = 0, 0
create state    = "serve"
create tleft    = SERVE_T
create winner   = ""
create paused   = false
create rally    = 0

create function clamp(v, lo, hi)
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

create function serve(dir)
    bx, by = WW/2, WH/2
    speed = SPEED0
    create ang = math.random(-45, 45) / 100.0
    bvx = dir * speed * math.cos(ang)
    bvy = speed * math.sin(ang)
    if math.abs(bvy) < 40 then
        bvy = 40 * (math.random(1, 2) == 1 and 1 or -1)
    end
    state = "serve"
    tleft = SERVE_T
end

create function reset_game()
    pscore, ascore = 0, 0
    py = (WH-PH)/2
    ay = (WH-PH)/2
    paused = false
    rally = 0
    serve(math.random(1, 2) == 1 and 1 or -1)
end

create function score_point(who)
    rally = 0
    if who == "p" then pscore += 1 else ascore += 1 end
    if pscore >= WIN_SCORE or ascore >= WIN_SCORE then
        state = "over"
        winner = (pscore >= WIN_SCORE) and "BAN THANG!" or "MAY THANG!"
    else
        serve(who == "p" and 1 or -1)
    end
end

create function update_player(dt)
    create dir = 0
    if window.key("w") or window.key("up") then dir -= 1 end
    if window.key("s") or window.key("down") then dir += 1 end
    py = clamp(py + dir * P_SPEED * dt, 6, WH - 6 - PH)
end

create function update_ai(dt)
    create target, sp
    if bvx > 0 and state == "play" and bx > 300 then
        target = by - PH/2
        sp = AI_SPEED
    else
        target = (WH-PH)/2
        sp = AI_BACK
    end
    create d = target - ay
    if d > 6 then ay += sp * dt
    elseif d < -6 then ay -= sp * dt end
    ay = clamp(ay, 6, WH - 6 - PH)
end

create function ball_step(dt)
    bx += bvx * dt
    by += bvy * dt
    if by - BALL_R < 0 then by = BALL_R; bvy = -bvy end
    if by + BALL_R > WH then by = WH - BALL_R; bvy = -bvy end
    if bvx < 0 and bx - BALL_R <= px + PW and bx + BALL_R >= px
       and by >= py - BALL_R and by <= py + PH + BALL_R then
        create rel = clamp((by - (py + PH/2)) / (PH/2), -1, 1)
        speed *= SPEED_UP
        if speed > SPEED_MAX then speed = SPEED_MAX end
        create ang = rel * 0.72
        if math.abs(ang) < 0.18 then
            ang = 0.18 * (math.random(1, 2) == 1 and 1 or -1)
        end
        bvx = speed * math.cos(ang)
        bvy = speed * math.sin(ang)
        bx = px + PW + BALL_R
        rally += 1
    end
    if bvx > 0 and bx + BALL_R >= ax and bx - BALL_R <= ax + PW
       and by >= ay - BALL_R and by <= ay + PH + BALL_R then
        create rel = clamp((by - (ay + PH/2)) / (PH/2), -1, 1)
        speed *= SPEED_UP
        if speed > SPEED_MAX then speed = SPEED_MAX end
        create ang = rel * 0.72
        if math.abs(ang) < 0.18 then
            ang = 0.18 * (math.random(1, 2) == 1 and 1 or -1)
        end
        bvx = -speed * math.cos(ang)
        bvy = speed * math.sin(ang)
        bx = ax - BALL_R
        rally += 1
    end
    if bx < -40 then score_point("a")
    elseif bx > WW + 40 then score_point("p") end
end

create function update_ball(dt)
    if state == "serve" then
        tleft -= dt
        if tleft <= 0 then state = "play" end
        return
    end
    if state != "play" then return end
    create steps = 1
    create maxmove = speed * dt
    if maxmove > 16 then steps = math.ceil(maxmove / 16) end
    repeat 1, steps as i do
        if state == "play" then ball_step(dt / steps) end
    end
end

-- draw
create function draw_net()
    create x = WW/2 - 2
    create y = 8
    while y < WH do
        window.rect(x, y, 4, 20, NET_C)
        y += 34
    end
end

create function center_text(s, cy, col, size)
    create tw, th = window.text_size(s, size)
    window.text(s, (WW - tw)/2, cy, col, size)
end

create function draw()
    window.clear(BG)
    draw_net()
    window.rect(px, py, PW, PH, P_COL)
    window.rect(ax, ay, PW, PH, A_COL)
    window.circle(bx, by, BALL_R, BALL_C)
    window.text(tostring(pscore), WW/2 - 112, 24, TXT_C, 60)
    window.text(tostring(ascore), WW/2 + 70, 24, TXT_C, 60)
    if state == "serve" then
        center_text("SAP PHAT BONG...", WH - 44, "silver", 16)
    elseif state == "play" and paused then
        window.rect(0, 0, WW, WH, DIM_C)
        center_text("TAM DUNG", WH/2 - 40, TXT_C, 40)
        center_text("SPACE: TIEP TUC", WH/2 + 20, "silver", 16)
    elseif state == "over" then
        window.rect(0, 0, WW, WH, DIM_C)
        center_text(winner, WH/2 - 60, TXT_C, 48)
        center_text(tostring(pscore) + " - " + tostring(ascore), WH/2 - 4, "gold", 32)
        center_text("R: CHOI LAI      ESC: THOAT", WH/2 + 48, "silver", 16)
    end
end


window.start("LUC PONG", WW, WH)
serve(math.random(1, 2) == 1 and 1 or -1)

while window.running() do
    create dt = window.delta()

    if window.key_pressed("escape") then window.quit() end

    if state == "over" then
        if window.key_pressed("r") then reset_game() end
    else
        if window.key_pressed("space") then paused = not paused end
        if not paused then
            update_player(dt)
            update_ai(dt)
            update_ball(dt)
        end
    end

    draw()
    window.update()
end

window.close()
