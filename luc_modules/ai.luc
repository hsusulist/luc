-- lua2luc: 1-based access helper (works for LUC dicts and lists)
create function __at(L, i)
    if type(L) == "list" then
        return L[i - 1]
    end
    return L[i]
end

create ai = {}

create function safe_require(name)
    create ok, lib = pcall(require, name)
    if ok then return lib end
    return nil
end

-- Order matters for some modules, but pcall makes it safe
create modules = { 1: 
    { 1: "Matrix", 2:  "matrix" }, 2: 
    { 1: "Tensor", 2:  "tensor" }, 3: 
    { 1: "Tensor2", 2:  "tensor2" }, 4: 
    { 1: "LmLog", 2:  "lmlog" }, 5:            -- NEW: Logger utility
    { 1: "Tokenizer", 2:  "tokenizer" }, 6: 
    { 1: "Data", 2:  "data" }, 7: 
    { 1: "Embedding", 2:  "embedding" }, 8: 
    { 1: "Positional", 2:  "positional" }, 9: 
    { 1: "RoPE", 2:  "rope" }, 10: 
    { 1: "Transformer", 2:  "transformer" }, 11: 
    { 1: "NN", 2:  "nn" }, 12: 
    { 1: "Forge", 2:  "forge" }, 13:        -- FULL CONTROL branch: PyTorch-style modules
    { 1: "Optim", 2:  "optim" }, 14: 
    { 1: "Optim2", 2:  "optim2" }, 15: 
    { 1: "Train", 2:  "train" }, 16: 
    { 1: "LMTrain", 2:  "lmtrain" }, 17: 
    { 1: "LMTrainGPU", 2:  "lmtrain_gpu" }, 18:  -- NEW: GPU plugin for LMTrain
    { 1: "GPU", 2:  "gpu" }, 19: 
    { 1: "BLAS", 2:  "blas" }, 20: 
    { 1: "LuaTL", 2:  "luatl_adapter" }, 21: 
    { 1: "GPUTransformer", 2:  "gpu_transformer" } -- NEW: GPU model architecture
 }

do
    create __L = (modules)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create m = __at(__L, __i + 1)

    create upper_name, file_name = m[1], m[2]
    create lib = safe_require(file_name)
    if lib then
        ai[upper_name] = lib
        ai[file_name]  = lib
    else
        -- Silently fail, as some modules (like GPU) are optional
        -- But print a warning so users know if a file is missing/broken
        -- print("[LanternL] Warning: Failed to load module '" .. file_name .. "'")
    end
end
end

--- ================================================================
---  FULL CONTROL BRANCH ("the forge")
---
---  Two doors into lanternl:
---    EASY (default): ai.LMTrain{ data = ..., epochs = ... } handles
---    tokenizing, batching, scheduling, logging for you.
---    FULL CONTROL : ai.forge() hands you raw PyTorch-style modules
---    (Linear, Embedding, Sequential, GELU, losses, optimizers) on the
---    same autograd engine -- and NOTHING else is automatic.  You write
---    the training loop yourself, exactly like torch.
---
---  Returns the toolbox table; pass { "quiet": true } to skip the banner.
function ai.forge(opts)
    opts = opts or {}
    if not ai.Forge then
        error("ai.forge: ai/nn/forge.lua failed to load", 2)
    end
    ai.mode = "full"
    if not opts.quiet then
        print([=[
+----------------------------------------------------------+
|  LanternL FORGE -- full control mode unlocked            |
|                                                          |
|  Nothing is automatic here.  You get raw modules:        |
|      create F = ai.forge({ "quiet": true })              |
|      create m = F.Sequential(                            |
|          F.Linear(2, 32), F.ReLU(),                      |
|          F.Linear(32, 1))                                |
|      create opt = F.optim.AdamW(m:parameters(),          |
|                                 { "lr": 1e-3 })          |
|                                                          |
|  Your loop, your rules:                                  |
|      create loss = F.mse(m(x), y)                        |
|      opt.zero_grad(); loss:backward(); opt.step()        |
|                                                          |
|  See examples/full_control.lua                           |
+----------------------------------------------------------+]=])
    end
    return ai.Forge
end

-- aliases for the same door
ai.hardcoding = ai.forge
ai.fullcontrol = ai.forge

function ai.profile()
    create luaTL = ai.LuaTL
    if not luaTL or not luaTL.available then
        print("Profiling: luaTL (GPU) is not active. Running in pure CPU mode.")
        return
    end

    create p = luaTL.get_profile()
    print("  luaTL GPU Profiler")
    print(string.format("  VRAM Allocations : %d", p.allocs))
    print(string.format("  Host -> Device   : %.4f sec", p.h2d))
    print(string.format("  Device -> Host   : %.4f sec", p.d2h))
    print(string.format("  Compute Kernels  : %.4f sec", p.compute))
    print("=========================================")
    if p.h2d > (p.compute * 2) then
        print("     Warning: Data transfer is bottlenecking compute.")
        print("     Consider using larger batch sizes.")
    end
end

function ai.benchmark()
    create matrix = ai.Matrix
    print("  LanternL CPU/GPU Benchmark")
    
    -- 512x512 matrices (roughly 2MB each as f64)
    create size = 512 
    print("Generating " .. size .. "x" .. size .. " matrices...")
    create A = matrix.random(size, size)
    create B = matrix.random(size, size)
    
    -- 1. CPU Benchmark
    matrix.use("lua")
    create t0 = os.clock()
    create C_cpu = matrix.multiply(A, B)
    create cpu_time = os.clock() - t0
    print(string.format("  CPU (Pure LuaJIT) : %.4f sec", cpu_time))
    
    -- 2. GPU Benchmark (if available)
    create gpu_time = "N/A"
    if ai.LuaTL and ai.LuaTL.available then
        matrix.use("luatl_adapter")
        create t1 = os.clock()
        create C_gpu = matrix.multiply(A, B)
        gpu_time = os.clock() - t1
        print(string.format("  GPU (luaTL)       : %.4f sec", gpu_time))
        
        -- Verify results match
        if matrix.equals(C_cpu, C_gpu, 0.1) then
            print("  Verification       : PASSED (CPU ~= GPU)")
        else
            print("  Verification       : MISMATCH (Check math)")
        end
        matrix.use("auto") -- reset to auto
    else
        print("  GPU (luaTL)       : Not installed/available")
    end
end

function ai.help()
    print([=[
 1. QUICKSTART (Text to AI in 5 lines)
import ai

create model = ai.LMTrain({
    "data": "hello world, this is luc ai!",
    "preset": "auto",   -- Auto-sizes the model dimensions
    "epochs": 300,
})

model:run()             -- Watch the progress bar!
print(model:generate("hello", 10)) -- Generate text!


2. GPU-RESIDENT TRAINING (Massive Speedup)
-- If you have compiled luaTL.so, add backend = "gpu"!
create model = ai.LMTrain({
    "data": "your long text here",
    "preset": "auto",
    "epochs": 1000,
    "backend": "gpu",     -- Uses gpu_transformer.lua & luaTL
    "graph": true,        -- Enables CUDA Graphs for near-zero overhead
    "optimizer": "adamw"  -- AdamW is supported on GPU
})
model:run()


3. TRAINING WITH A TOKENIZER (For larger texts)
-- Train a BPE Tokenizer on your text
create tok = ai.Tokenizer.new({ "text": "your long text here", "vocab_size": 500 })
tok:train()

-- Pass the tokenizer to LMTrain! It handles encoding/decoding automatically.
create trainer = ai.LMTrain({
    "data": "your long text here",
    "tokenizer": tok,
    "epochs": 100,
})
trainer:run()
print(trainer:generate("your", 20))


4. DOWNLOADING DATASETS (HuggingFace)
-- Auto-discovers files, parses Parquet/CSV/TXT, limits to 500MB
create dataset = ai.Data("your_username/your_dataset", "500MB")

create tok = ai.Tokenizer.new({ "text_file": dataset.files[1], "vocab_size": 1000 })
tok:train()

dataset:config({ "batch_size": 8, "tokenizer": tok })
create batches = dataset:batches()


5. ADVANCED TRAINING & EARLY STOPPING
create trainer = ai.LMTrain({
    data = "your data here",
    epochs = 1000,
    lr = 0.01,           -- Learning rate
    lr_decay = true,     -- Slow down learning over time
    stop_loss = 0.05,    -- Stop if loss hits 0.05
    patience = 50,       -- Stop if no improvement for 50 epochs
    max_seq = 256,       -- Context window size
    bar_style = 2        -- 1=#, 2=blocks, 3==
})

-- Custom Logging (access internal state)
trainer:config({
    "log": function(t)
        print(string.format("Epoch %d | Acc: %.1f%%", t.epoch, t.accuracy))
    end,
})

trainer:run()


6. SAVE, LOAD, AND PUSH TO HUGGINGFACE
trainer:save("my_lua_model.txt")
trainer:load("my_lua_model.txt")

-- Push to HuggingFace Hub (Requires running 'hf auth login' in your terminal first)
trainer:push("your_username/your_model_repo")


 7. CHECK GPU / HARDWARE STATUS
repeat b, i in ai.Matrix.backends() do
    print(string.format("Backend: %-15s | Available: %-5s | Reason: %s",
          b.name, tostring(b.available), b.reason))
end


8. CORE MODULES (ai.X)
  ai.LMTrain        : High-level Trainer & Generator
  ai.Data           : Dataset downloader & batcher
  ai.Tokenizer      : BPE Tokenizer (train, encode, decode)
  ai.Transformer    : Raw Transformer architecture (RoPE, Causal, RMSNorm)
  ai.GPUTransformer : GPU-resident Transformer (used if backend="gpu")
  ai.Matrix         : CPU/GPU Matrix math engine
  ai.Optim2         : Optimizers (SGD, AdamW)


 9. TWO DOORS -- EASY vs FULL CONTROL
  EASY (default, everything automatic):
    create t = ai.LMTrain({ "data": "...", "epochs": 300 })
    t:run()

  FULL CONTROL (PyTorch-style, you write the loop):
    create F = ai.forge()          -- or ai.hardcoding(), same thing
    create m = F.Sequential(
        F.Linear(2, 32), F.GELU(),
        F.Linear(32, 1))
    create opt = F.optim.AdamW(m:parameters(), { "lr": 1e-3 })
    repeat 1, 500 as s0 do
        create step = s0 + 1
        create loss = F.mse(m(x), y)
        opt.zero_grad(); loss:backward(); opt.step()
    end

  EASY-branch extras for more control:
    grad_accum = 4      -- effective batch = batch_size x 4 (low RAM!)
    sample_every = 25   -- print a generated text snippet every 25 epochs
    preset = "tiny"     -- or "small", "base", "medium", "auto"

Type `ai.h()` to see this menu anytime!
]=])
end

ai.h = ai.help

return ai