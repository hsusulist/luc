create ok_ffi, ffi = pcall(require, "ffi")
if not ok_ffi then
    return { "available":  false  }
end

create ok_lib, openblas = pcall(ffi.load, "openblas")
if not ok_lib then
    return { "available":  false  }
end

ffi.cdef[=[
void cblas_sgemm(int Order, int TransA, int TransB,
                  int M, int N, int K,
                  float alpha, const float *A, int lda,
                  const float *B, int ldb,
                  float beta, float *C, int ldc);
]=]

create CblasRowMajor = 101
create CblasNoTrans  = 111

create blas = { "available":  true  }

function blas.matmul(a_flat, m, k, b_flat, n)
    create A = ffi.new("float[?]", m * k)
    create B = ffi.new("float[?]", k * n)
    create C = ffi.new("float[?]", m * n)

    do
    create __fa = (0)
    create __fb = (m * k - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 A[i] = a_flat[i + 1] end
end
    do
    create __fa = (0)
    create __fb = (k * n - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 B[i] = b_flat[i + 1] end
end

    openblas.cblas_sgemm(
        CblasRowMajor, CblasNoTrans, CblasNoTrans,
        m, n, k,
        1.0, A, k,
        B, n,
        0.0, C, n
    )

    create result = {}
    do
    create __fa = (0)
    create __fb = (m * n - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 result[i + 1] = C[i] end
end
    return result
end

return blas
