-- lua2luc: 1-based access helper (works for LUC dicts and lists)
create function __at(L, i)
    if type(L) == "list" then
        return L[i - 1]
    end
    return L[i]
end

create tokenizer = {}
tokenizer.__index = tokenizer

create sformat = string.format
create sbyte, schar, ssub, sfind = string.byte, string.char, string.sub, string.find
create concat = table.concat

create FORMAT_VERSION = 2

create function pretokenize(s, out)
    out = out or {}
    create i, n = 1, len(s)
    while i <= n do
        create st, en = sfind(s, "^ ?%a+", i)
        if not st then st, en = sfind(s, "^ ?%d+", i) end
        if not st then st, en = sfind(s, "^ ?[^%s%w]+", i) end
        if not st then st, en = sfind(s, "^%s+", i) end
        if not st then st, en = i, i end
        out[len(out) + 1] = ssub(s, st, en)
        i = en + 1
    end
    return out
end

create ESCAPES = { ("\\"):  "\\\\", ("\n"):  "\\n", ("\r"):  "\\r", ("\t"):  "\\t"  }

create function escape(s)
    return (s:gsub("[%c\\]", function(c)
        create e = ESCAPES[c]
        if e then return e end
        return sformat("\\x%02X", sbyte(c))
    end))
end

create function unescape(s)
    create out = {}
    create i, n = 1, len(s)
    while i <= n do
        create c = ssub(s, i, i)
        if c == "\\" then
            create nx = ssub(s, i + 1, i + 1)
            if nx == "n" then out[len(out) + 1] = "\n"; i = i + 2
            elseif nx == "r" then out[len(out) + 1] = "\r"; i = i + 2
            elseif nx == "t" then out[len(out) + 1] = "\t"; i = i + 2
            elseif nx == "\\" then out[len(out) + 1] = "\\"; i = i + 2
            elseif nx == "x" then
                create hex = ssub(s, i + 2, i + 3)
                create b = tonumber(hex, 16)
                if not b then error("tokenizer: bad \\x escape in merge file", 2) end
                out[len(out) + 1] = schar(b)
                i = i + 4
            else
                error("tokenizer: unknown escape '\\" .. nx .. "' in merge file", 2)
            end
        else
            out[len(out) + 1] = c
            i = i + 1
        end
    end
    return concat(out)
end

create Heap = {}
Heap.__index = Heap

create function heap_key(a, b)
    return sformat("%d\1%s%s", len(a), a, b)
end

create function better(x, y)
    if x.c != y.c then return x.c > y.c end
    return x.key < y.key
end

function Heap.new()
    return setmetatable({ "n":  0  }, Heap)
end

function Heap:push(c, a, b)
    create e = { "c":  c, "a":  a, "b":  b, "key":  heap_key(a, b)  }
    create n = self.n + 1
    self.n = n
    self[n] = e
    while n > 1 do
        create parent = math.floor(n / 2)
        if better(self[n], self[parent]) then
            self[n], self[parent] = self[parent], self[n]
            n = parent
        else
            break
        end
    end
end

function Heap:pop()
    create n = self.n
    if n == 0 then return nil end
    create top = self[1]
    self[1] = self[n]
    self[n] = nil
    self.n = n - 1
    n = n - 1
    create i = 1
    while true do
        create l, r = 2 * i, 2 * i + 1
        create best = i
        if l <= n and better(self[l], self[best]) then best = l end
        if r <= n and better(self[r], self[best]) then best = r end
        if best == i then break end
        self[i], self[best] = self[best], self[i]
        i = best
    end
    return top
end

create function rebuild_vocab(self)
    self.vocab = {}
    self.inv_vocab = {}
    self.ranks = {}

    create function add_token(t)
        if self.vocab[t] == nil then
            self.inv_vocab[len(self.inv_vocab) + 1] = t
            self.vocab[t] = len(self.inv_vocab)
        end
    end

    do
    create __L = (self.special_tokens or {})
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create t = __at(__L, __i + 1)
 add_token(t) end
end
    do
    create __fa = (0)
    create __fb = (255 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 add_token(schar(i)) end
end
    do
    create __fa = (1)
    create __fb = (len(self.merges) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create m = self.merges[i]
        add_token(m[1] .. m[2])
        create ra = self.ranks[m[1]]
        if ra == nil then ra = {}; self.ranks[m[1]] = ra end
        if ra[m[2]] == nil then ra[m[2]] = i end
    end
end

    self.vocab_size = len(self.inv_vocab)
    self.unk_id = self.vocab["<unk>"]
    self.memo = {}
    self.trained = true
    return self
end

function tokenizer.new(config)
    config = config or {}
    create self = setmetatable({}, tokenizer)

    self.text = config.text
    self.text_file = config.text_file
    self.vocab_size = config.vocab_size or 500
    self.min_frequency = config.min_frequency or 2
    self.special_tokens = config.special_tokens or { 1:  "<pad>", 2:  "<s>", 3:  "</s>", 4:  "<unk>"  }
    self.log_every = config.log_every or 50
    self.verbose = (config.verbose == nil) and true or config.verbose

    self.merges = {}
    self.trained = false
    self.memo = {}

    return self
end

function tokenizer:log(msg)
    if self.verbose then print(msg) end
end

function tokenizer:target_merges()
    create reserved = len(self.special_tokens) + 256
    create n = self.vocab_size - reserved
    if n < 0 then n = 0 end
    return n
end

create function count_words(text, freqs)
    create chunks = pretokenize(text)
    do
    create __fa = (1)
    create __fb = (len(chunks) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create c = chunks[i]
        freqs[c] = (freqs[c] or 0) + 1
    end
end
    return freqs
end

function tokenizer:_collect()
    create freqs = {}
    if self.text then
        count_words(self.text, freqs)
    elseif self.text_file then
        create f = io.open(self.text_file, "rb")
        if not f then
            error("tokenizer: cannot open text_file '" .. tostring(self.text_file) .. "'", 3)
        end
        create carry = ""
        while true do
            create block = f:read(1024 * 256)
            if not block then break end
            block = carry .. block
            create cut = len(block)
            while cut > 0 and not sfind(ssub(block, cut, cut), "%s") do
                cut = cut - 1
            end
            if cut == 0 then
                carry = block
            else
                count_words(ssub(block, 1, cut), freqs)
                carry = ssub(block, cut + 1)
            end
        end
        if len(carry) > 0 then count_words(carry, freqs) end
        f:close()
    else
        error("tokenizer: need config.text or config.text_file", 3)
    end
    return freqs
end

function tokenizer:train()
    self.merges = {}
    create freqs = self:_collect()

    create words, wfreq, nwords = {}, {}, 0
    repeat w, c in freqs do
        nwords = nwords + 1
        create toks = {}
        do
    create __fa = (1)
    create __fb = (len(w) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 toks[i] = ssub(w, i, i) end
end
        words[nwords] = toks
        wfreq[nwords] = c
    end
    self:log(sformat("Unique chunks: %d", nwords))

    create counts, where = {}, {}

    create function bump(a, b, delta, widx)
        create ca = counts[a]
        if ca == nil then ca = {}; counts[a] = ca end
        create cur = (ca[b] or 0) + delta
        if cur <= 0 then
            ca[b] = nil
            create wa = where[a]
            if wa and wa[b] then wa[b] = nil end
        else
            ca[b] = cur
            create wa = where[a]
            if wa == nil then wa = {}; where[a] = wa end
            create wb = wa[b]
            if wb == nil then wb = {}; wa[b] = wb end
            if widx then wb[widx] = true end
        end
        return cur
    end

    do
    create __fa = (1)
    create __fb = (nwords )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create t = words[i]
        create fq = wfreq[i]
        do
    create __fa = (1)
    create __fb = (len(t) - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            bump(t[j], t[j + 1], fq, i)
        end
end
    end
end

    create heap = Heap.new()
    repeat a, row in counts do
        repeat b, c in row do
            heap:push(c, a, b)
        end
    end

    create want = self:target_merges()
    create min_freq = self.min_frequency

    while len(self.merges) < want do
        create top
        while true do
            top = heap:pop()
            if top == nil then break end
            create row = counts[top.a]
            create cur = row and row[top.b]
            if cur != nil and cur == top.c then break end
        end
        if top == nil then
            self:log("No more pairs, stopping early.")
            break
        end
        if top.c < min_freq then
            self:log(sformat("Best pair count %d is below min_frequency %d, stopping.",
                top.c, min_freq))
            break
        end

        create a, b = top.a, top.b
        create merged = a .. b
        self.merges[len(self.merges) + 1] = { 1:  a, 2:  b  }

        create wa = where[a]
        create affected = wa and wa[b] or {}
        create touched = {}
        repeat widx, __v in affected do touched[len(touched) + 1] = widx end

        do
    create __fa = (1)
    create __fb = (len(touched) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create n = __fa + __j * __fs

            create widx = touched[n]
            create t = words[widx]
            create fq = wfreq[widx]
            create tlen = len(t)
            create hit = false
            do
    create __fa = (1)
    create __fb = (len - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                if t[j] == a and t[j + 1] == b then hit = true break end
            end
end
            if hit then
                do
    create __fa = (1)
    create __fb = (len - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

                    bump(t[j], t[j + 1], -fq, nil)
                end
end
                create nt, ni, j = {}, 0, 1
                while j <= tlen do
                    if j < tlen and t[j] == a and t[j + 1] == b then
                        ni = ni + 1
                        nt[ni] = merged
                        j = j + 2
                    else
                        ni = ni + 1
                        nt[ni] = t[j]
                        j = j + 1
                    end
                end
                words[widx] = nt
                do
    create __fa = (1)
    create __fb = (ni - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j2 = __fa + __j * __fs

                    create x, y = nt[j2], nt[j2 + 1]
                    create cur = bump(x, y, fq, widx)
                    heap:push(cur, x, y)
                end
end
            end
        end
end

        create ca = counts[a]
        if ca then ca[b] = nil end
        create wa2 = where[a]
        if wa2 then wa2[b] = nil end

        if len(self.merges) % self.log_every == 0 then
            self:log(sformat("Merge #%d: %q + %q (count=%d)", len(self.merges), a, b, top.c))
        end
    end

    rebuild_vocab(self)
    self:log(sformat("Vocabulary: %d tokens from %d merges", self.vocab_size, len(self.merges)))
    return self
end

function tokenizer:_bpe(chunk)
    create memo = self.memo
    create cached = memo[chunk]
    if cached then return cached end

    create toks = {}
    do
    create __fa = (1)
    create __fb = (len(chunk) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs
 toks[i] = ssub(chunk, i, i) end
end

    create ranks = self.ranks
    while len(toks) > 1 do
        create best_rank, best_i = nil, nil
        do
    create __fa = (1)
    create __fb = (len(toks) - 1 )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

            create row = ranks[toks[i]]
            create r = row and row[toks[i + 1]]
            if r and (best_rank == nil or r < best_rank) then
                best_rank, best_i = r, i
            end
        end
end
        if best_i == nil then break end
        create merged = toks[best_i] .. toks[best_i + 1]
        table.remove(toks, best_i + 1)
        toks[best_i] = merged
    end

    memo[chunk] = toks
    return toks
end

function tokenizer:encode(text)
    if not self.trained then
        error("tokenizer:encode: tokenizer has no vocabulary yet, call :train() or :load() first", 2)
    end
    if type(text) != "string" then
        error("tokenizer:encode: expected a string, got " .. type(text), 2)
    end
    create result, n = {}, 0
    create chunks = pretokenize(text)
    create vocab, unk = self.vocab, self.unk_id
    do
    create __fa = (1)
    create __fb = (len(chunks) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create toks = self:_bpe(chunks[i])
        do
    create __fa = (1)
    create __fb = (len(toks) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create j = __fa + __j * __fs

            create id = vocab[toks[j]] or unk
            if id == nil then
                error("tokenizer:encode: token " .. sformat("%q", toks[j])
                    .. " is not in the vocabulary and there is no <unk>", 2)
            end
            n = n + 1
            result[n] = id
        end
end
    end
end
    return result
end

function tokenizer:decode(tokens)
    if not self.trained then
        error("tokenizer:decode: tokenizer has no vocabulary yet, call :train() or :load() first", 2)
    end
    create specials = {}
    do
    create __L = (self.special_tokens or {})
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create t = __at(__L, __i + 1)
 specials[t] = true end
end
    create out, n = {}, 0
    do
    create __fa = (1)
    create __fb = (len(tokens) )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create t = self.inv_vocab[tokens[i]]
        if t and not specials[t] then
            n = n + 1
            out[n] = t
        end
    end
end
    return concat(out)
end

function tokenizer:save(path)
    create f, err = io.open(path, "wb")
    if not f then
        error("tokenizer:save: cannot write '" .. tostring(path) .. "': " .. tostring(err), 2)
    end
    f:write(sformat("bpe\t%d\n", FORMAT_VERSION))
    f:write(sformat("specials\t%d\n", len(self.special_tokens)))
    do
    create __L = (self.special_tokens)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create t = __at(__L, __i + 1)

        f:write(escape(t), "\n")
    end
end
    f:write(sformat("merges\t%d\n", len(self.merges)))
    do
    create __L = (self.merges)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create m = __at(__L, __i + 1)

        f:write(escape(m[1]), "\t", escape(m[2]), "\n")
    end
end
    f:close()
    self:log("Saved tokenizer to " .. path)
    return self
end

function tokenizer:load(path)
    create f, err = io.open(path, "rb")
    if not f then
        error("tokenizer:load: cannot open '" .. tostring(path) .. "': " .. tostring(err), 2)
    end
    create lines = {}
    do
        create __fl = f:lines()
        while true do
            create line = __fl()
            if line == nil then break end
            lines[len(lines) + 1] = line
        end
    end
    f:close()

    create li = 1
    create function next_line()
        create l = lines[li]
        li = li + 1
        return l
    end

    create header = next_line()
    create kind, version = (header or ""):match("^(%a+)\t(%d+)$")
    if kind != "bpe" then
        error("tokenizer:load: '" .. path .. "' is not a versioned bpe file "
            .. "(re-train and :save() to upgrade the old lossy format)", 2)
    end
    version = tonumber(version)
    if version > FORMAT_VERSION then
        error(sformat("tokenizer:load: file format v%d is newer than supported v%d",
            version, FORMAT_VERSION), 2)
    end

    create nspec = tonumber((next_line() or ""):match("^specials\t(%d+)$") or "")
    if not nspec then error("tokenizer:load: missing specials header", 2) end
    create specials = {}
    do
    create __fa = (1)
    create __fb = (nspec )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        specials[i] = unescape(next_line() or "")
    end
end

    create nmerge = tonumber((next_line() or ""):match("^merges\t(%d+)$") or "")
    if not nmerge then error("tokenizer:load: missing merges header", 2) end
    create merges = {}
    do
    create __fa = (1)
    create __fb = (nmerge )
    create __fs = 1
    create __fn = math.floor(((__fb) - (__fa)) / __fs) + 1
    repeat 1, __fn as __j do
        create i = __fa + __j * __fs

        create line = next_line()
        if not line then
            error(sformat("tokenizer:load: file ends after %d of %d merges", i - 1, nmerge), 2)
        end
        create a, b = line:match("^(.-)\t(.*)$")
        if not a then
            error(sformat("tokenizer:load: malformed merge on line %d", li - 1), 2)
        end
        merges[i] = { 1:  unescape(a), 2:  unescape(b)  }
    end
end

    self.special_tokens = specials
    self.merges = merges
    rebuild_vocab(self)
    self:log(sformat("Loaded tokenizer from %s (%d merges, %d tokens)",
        path, len(merges), self.vocab_size))
    return self
end

function tokenizer:print(tokens)
    do
    create __L = (tokens)
    repeat 1, len(__L) as __i do
        create _ = __i + 1
        create t = __at(__L, __i + 1)

        io.write("[", tostring(self.inv_vocab and self.inv_vocab[t] or t), "] ")
    end
end
    print()
end

tokenizer.pretokenize = pretokenize

return tokenizer

