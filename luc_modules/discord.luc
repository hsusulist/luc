-- luc_modules/discord.luc -- Discord bot (import discord).
-- Needs a bot token: https://discord.com/developers/applications
-- Turn on MESSAGE CONTENT INTENT (to read text) and SERVER MEMBERS INTENT
-- (for full member lists + join events) on the Bot page.
--
--   import discord("bot")
--   create token = bot.token("TOKEN")
--   bot:run(token)
--   while bot.run do
--       create cmd = bot.prefix("!")
--       if cmd == "ping" then bot.msg:send("pong!") end
--   end
--
-- Groups: bot.msg (send/dm/last/lastby/sender), bot.user (join/getid),
-- bot.slash (new/slash), bot.debug (name/username/id/servers - grab early),
-- bot.embed (create/add_field/set_footer/set_author/set_thumbnail/set_image/send),
-- bot.buttons (new/disable/enable/click), bot.select (new/choose).
-- bot:run(token) only starts the bot: no loop, no config, no do-block
-- (throws on failure, so code after it only runs when online).
-- bot.on reads state, bot:stop() pauses (events queue up),
-- bot:on() resumes (queued events flush out).
-- The lib is silent by default; set LUC_WSDEBUG=1 for traffic logs.
-- NOTE: bot.prefix / bot.user.join / cmd.slash BLOCK until their event
-- arrives (each in its own task). Unmatched events stay queued.
import net("dn")
create json = require("json")

create API = "https://discord.com/api/v10"
create GW = "wss://gateway.discord.gg/?v=10&encoding=json"
if gw_test_url != nil then GW = gw_test_url end

create B = {
    "token": nil, "ws": nil, "seq": nil, "session": nil, "app": nil,
    "hb": 30, "hback": true, "gen": 0, "hello": false,
    "msgq": [], "joinq": [], "intq": [],
    "recent": [],
    "btns": [],
    "guilds": {}, "channels": {}, "members": {},
    "pending": [], "cur": nil,
    "paused": false, "running": false, "on": true,
}

create bot = {}

-- live info table: grab it before run, fields fill in at READY
-- (same table is mutated, never replaced, so early refs stay live)
bot.debug = {}

-- drop a leading self (dot and colon forms both work everywhere)
create function unself(a, b, c)
    if a == bot or a == bot.msg or a == bot.user or a == bot.slash then
        return b, c, nil
    end
    return a, b, c
end

create function auth()
    return "Authorization: Bot " .. B.token .. "\r\nUser-Agent: DiscordBot (luc, 0.2-beta1)"
end

-- REST with one 429 retry. Returns body, code.
create function rest(method, path, body)
    create url = API .. path
    create payload = nil
    if body != nil then payload = json.encode(body) end
    create r = nil
    create code = 0
    if method == "GET" then
        r, code = dn.get(url, auth())
    else
        r, code = dn.post(url, payload, "application/json", auth())
    end
    if code == 429 and r != nil then
        create t = json.decode(r)
        create wait = 1
        if t.retry_after != nil then wait = t.retry_after end
        task.wait(wait)
        if method == "GET" then
            r, code = dn.get(url, auth())
        else
            r, code = dn.post(url, payload, "application/json", auth())
        end
    end
    return r, code
end

create function gw_send(t)
    create s = json.encode(t)
    if os.getenv("LUC_WSDEBUG") != nil then print("discord> " .. s) end
    B.ws:send(s)
end

create function cache_guild(g)
    if g == nil or g.id == nil then return end
    B.guilds[g.id] = g
    if g.channels != nil then
        repeat ch, i in g.channels do
            B.channels[ch.id] = { "name": ch.name, "guild": g.id }
        end
    end
    if g.members != nil then
        repeat m, i in g.members do
            if m.user != nil and m.user.id != nil then
                B.members[m.user.id] = { "name": m.user.username }
            end
        end
    end
end

create function flush_pending()
    if B.app == nil then return end
    create keep = []
    repeat p, i in B.pending do
        create path = "/applications/" .. B.app .. "/commands"
        if p.scope == "guild" and p.guild != nil then
            path = "/applications/" .. B.app .. "/guilds/" .. p.guild .. "/commands"
        end
        create r, code = rest("POST", path, p.b)
        if code == 429 then keep:append(p) end
    end
    B.pending = keep
end

-- interaction answer with a full data object (content/embeds/components).
-- interaction_reply(text) is the text-only shortcut.
create function interaction_send(data)
    create cur = B.cur
    if cur == nil or cur.kind != "int" then return nil, "no interaction" end
    create r, code = rest("POST",
        "/interactions/" .. cur.iid .. "/" .. cur.itoken .. "/callback",
        { "type": 4, "data": data })
    if r == nil then return nil, code end
    if code == 204 or code == 200 then return true end
    return nil, r
end

create function interaction_reply(text)
    return interaction_send({ "content": text })
end

create function channel_id(name)
    repeat id, c in B.channels do
        if c.name == name then return id end
    end
    return nil
end

-- channel arg can be id, "name" or "#name"; ids pass through
create function resolve_channel(a)
    if a == nil then return nil end
    if type(a) != "string" then return a end
    if string.sub(a, 1, 1) == "#" then return channel_id(string.sub(a, 2)) end
    return channel_id(a) or a
end

-- newest-first history page for one channel (REST, non-blocking)
create function fetch_history(cid, limit)
    if limit == nil then limit = 20 end
    create r, code = rest("GET", "/channels/" .. cid .. "/messages?limit=" .. tostring(limit), nil)
    if r == nil then return nil, code end
    if code != 200 then return nil, r end
    return json.decode(r)
end

-- recount servers into bot.debug.servers (call after any guild change)
create function debug_servers()
    create n = 0
    repeat id, g in B.guilds do
        if g != nil then n = n + 1 end
    end
    bot.debug.servers = n
end

-- heartbeat with explicit null seq: the gateway requires "d":null
-- (not a missing key) before the first dispatch arrives
create function send_beat()
    create s = "{\"op\":1,\"d\":null}"
    if B.seq != nil then s = json.encode({ "op": 1, "d": B.seq }) end
    if os.getenv("LUC_WSDEBUG") != nil then print("discord> " .. s) end
    B.ws:send(s)
end

create function heartbeat()
    create g = B.gen
    while not B.hello do
        task.wait(0.1)
        if not B.running or B.gen != g then return end
    end
    send_beat()
    while B.running and B.gen == g do
        task.wait(B.hb)
        if B.running and B.gen == g then
            if not B.hback then
                pcall(function() B.ws:close() end)
                B.ws = nil
                return
            end
            B.hback = false
            send_beat()
        end
    end
end

create function handle_packet(m)
    -- one bad packet must never kill the pump: skip it and show it
    create ok, t = pcall(function() return json.decode(m) end)
    if not ok then
        if os.getenv("LUC_WSDEBUG") != nil then
            print("discord: bad packet skipped (" .. tostring(t) .. "): " .. string.sub(m, 1, 160))
        end
        return
    end
    if t == nil or t.op == nil then return end
    if t.op == 10 then
        B.hb = t.d.heartbeat_interval / 1000
        B.hello = true
        if B.session != nil and B.seq != nil then
            gw_send({ "op": 6, "d": { "token": B.token, "session_id": B.session, "seq": B.seq } })
        else
            gw_send({ "op": 2, "d": { "token": B.token, "intents": 33283,
                "properties": { "os": "windows", "browser": "luc", "device": "luc" } } })
        end
        return
    end
    if t.op == 11 then
        B.hback = true
        return
    end
    if t.op == 7 or t.op == 9 then
        if t.op == 9 then B.session = nil end
        B.ws:close()
        return
    end
    if t.op != 0 then return end
    if t.s != nil then B.seq = t.s end
    create ev = t.t
    create d = t.d
    if d == nil then return end
    if ev == "READY" then
        B.session = d.session_id
        if d.application != nil then B.app = d.application.id end
        if d.guilds != nil then
            repeat g, i in d.guilds do
                B.guilds[g.id] = g
            end
        end
        if d.user != nil then
            bot.debug.username = d.user.username
            bot.debug.id = d.user.id
            if d.user.global_name != nil then bot.debug.name = d.user.global_name
            else bot.debug.name = d.user.username end
        end
        debug_servers()
        flush_pending()
        return
    end
    if ev == "GUILD_CREATE" then
        cache_guild(d)
        debug_servers()
        return
    end
    if ev == "GUILD_DELETE" then
        if d != nil and d.id != nil then B.guilds[d.id] = nil end
        debug_servers()
        return
    end
    if ev == "MESSAGE_CREATE" then
        if d.author == nil then return end
        B.members[d.author.id] = { "name": d.author.username }
        B.msgq:append({ "kind": "msg", "id": d.id, "content": d.content,
            "channel": d.channel_id, "guild": d.guild_id,
            "author": d.author.username, "uid": d.author.id })
        -- live cache for all-channel lookups (non-destructive, capped)
        B.recent:append({ "content": d.content, "channel": d.channel_id,
            "author": d.author.username, "uid": d.author.id })
        if B.recent:len() > 200 then
            create nq = []
            create k = 1
            while k < B.recent:len() do
                nq:append(B.recent[k])
                k = k + 1
            end
            B.recent = nq
        end
        return
    end
    if ev == "INTERACTION_CREATE" then
        if d.data == nil then return end
        create uid = nil
        create aname = nil
        if d.member != nil and d.member.user != nil then
            uid = d.member.user.id
            aname = d.member.user.username
        elseif d.user != nil then
            uid = d.user.id
            aname = d.user.username
        end
        if d.application_id != nil then B.app = d.application_id end
        if d.type == 3 and d.data.component_type != nil then
            -- button (2) or select (3): queued for buttons:click / select:choose
            B.intq:append({ "kind": "comp", "ctype": d.data.component_type,
                "cid": d.data.custom_id, "values": d.data.values,
                "id": d.id, "token": d.token, "channel": d.channel_id,
                "uid": uid, "author": aname, "app": d.application_id })
            return
        end
        B.intq:append({ "kind": "int", "id": d.id, "token": d.token,
            "name": d.data.name, "channel": d.channel_id, "uid": uid, "app": d.application_id })
        return
    end
    if ev == "GUILD_MEMBER_ADD" then
        if d.user != nil then
            B.members[d.user.id] = { "name": d.user.username }
            B.joinq:append({ "kind": "join", "uid": d.user.id,
                "name": d.user.username, "guild": d.guild_id })
        end
        return
    end
end

create function reconnect()
    B.gen = B.gen + 1
    if B.ws != nil then pcall(function() B.ws:close() end) end
    B.ws = nil
    B.hello = false
    B.hback = true
    create delay = 3
    while B.running do
        create ws, e = dn.ws_connect(GW)
        if ws != nil then
            B.ws = ws
            B.gen = B.gen + 1
            task.spawn(function()
                heartbeat()
            end)
            return true
        end
        task.wait(delay)
        if delay < 60 then delay = delay * 2 end
    end
    return false
end

create function do_recv()
    if B.ws == nil then return nil, "no socket" end
    return B.ws:recv(65535)
end

create function pump()
    while B.running do
        if B.ws == nil then
            if not reconnect() then return end
        end
        -- recv can throw (socket closed under us): never let it kill pump
        create ok, m, e = pcall(do_recv)
        if not ok then m, e = nil, tostring(m) end
        if m != nil then handle_packet(m)
        else
            -- gateway dropped the connection: drop it here,
            -- reconnect() (backoff) runs on the next pass; queued events kept
            if os.getenv("LUC_WSDEBUG") != nil then
                print("discord: connection lost (" .. tostring(e) .. "), reconnecting...")
            end
            if B.ws != nil then pcall(function() B.ws:close() end) end
            B.ws = nil
            B.hello = false
        end
    end
end

-- pop first queued event (nil when empty/paused; never blocks)
create function qtake(q)
    if B.paused then return nil end
    if q:len() == 0 then return nil end
    create ev = q[0]
    create nq = []
    create k = 1
    while k < q:len() do
        nq:append(q[k])
        k = k + 1
    end
    if q == B.msgq then B.msgq = nq end
    if q == B.joinq then B.joinq = nq end
    if q == B.intq then B.intq = nq end
    return ev
end

create function wait_ev(q)
    while true do
        create ev = qtake(q)
        if ev != nil then return ev end
        task.wait(0.01)
    end
end

create function connect_gw()
    create ws, e = dn.ws_connect(GW)
    if ws == nil then return false, e end
    B.ws = ws
    B.hback = true
    B.hello = false
    task.spawn(function()
        pump()
    end)
    task.spawn(function()
        heartbeat()
    end)
    return true
end

-- ---- public surface (dot and colon forms both work) ----
bot.token = function(a, b)
    create t = a
    if t == bot then t = b end
    if t != nil and type(t) == "table" then t = t.token end
    -- tokens are often pasted with stray spaces/newlines: trim them,
    -- a single stray byte fails both REST (401) and gateway (no READY)
    if t != nil and type(t) == "string" then t = string.trim(t) end
    B.token = t
    return { "token": t }
end

bot.run = function(a, b)
    if a == bot then a, b = b, nil end
    if b != nil then
        return nil, "bot:run takes only a token - it starts the bot, no do-block"
    end
    create tok = a
    if tok != nil and type(tok) == "table" then tok = tok.token end
    if tok == nil then tok = B.token end
    B.token = tok
    if B.token == nil then return nil, "no token (bot.token first)" end
    B.running = true
    B.paused = false
    create ok, why = connect_gw()
    if not ok then
        B.running = false
        error("cannot reach gateway (" .. tostring(why) .. ")")
    end
    create t0 = os.clock()
    while B.session == nil do
        if os.clock() - t0 > 20 then
            B.running = false
            error("no READY from gateway (bad token?)")
        end
        task.wait(0.1)
    end
    flush_pending()
    return true
end

-- prefix watcher: blocks until a message starts with p, returns the word
-- after it. Each call waits for the NEXT one; others stay queued.
bot.prefix = function(a, b)
    if a == bot then a = b end
    create p = a
    while true do
        create ev = wait_ev(B.msgq)
        create c = ev.content
        if c != nil and string.startswith(c, p) then
            create rest = string.sub(c, string.len(p) + 1)
            B.cur = { "kind": "channel", "channel": ev.channel,
                      "guild": ev.guild, "author": ev.author }
            create sp = string.find(rest, " ")
            if sp != nil then return string.sub(rest, 1, sp - 1) end
            return rest
        end
        B.msgq:append(ev)
        task.wait(0.01)
    end
end

bot.user = {}
bot.user.join = function(a)
    while true do
        create ev = wait_ev(B.joinq)
        B.cur = { "kind": "channel", "channel": nil,
                  "guild": ev.guild, "author": ev.name }
        return ev.uid
    end
end
bot.user.getid = function(a, b)
    if a == bot.user then a = b end
    create name = a
    repeat id, info in B.members do
        if info.name == name then return id end
    end
    return nil
end
bot.user.name = function(a, b)
    if a == bot.user then a = b end
    create m = B.members[a]
    if m == nil then return nil end
    return m.name
end

bot.msg = {}
bot.msg.send = function(a, b, c)
    if a == bot.msg then a, b, c = b, c, nil end
    create channel = nil
    create text = nil
    if b == nil then
        text = a
        if B.cur != nil and B.cur.kind == "int" then
            return interaction_reply(text)
        end
        if B.cur != nil then channel = B.cur.channel end
    else
        channel = a
        text = b
    end
    if channel == nil then return nil, "no channel in context" end
    if type(channel) == "string" then
        create cid = channel
        if string.sub(channel, 1, 1) == "#" then
            cid = channel_id(string.sub(channel, 2))
        else
            -- plain name ("general") first, raw id as fallback
            cid = channel_id(channel) or channel
        end
        if cid == nil then return nil, "unknown channel" end
        channel = cid
    end
    create r, code = rest("POST", "/channels/" .. channel .. "/messages", { "content": text })
    if r == nil then return nil, code end
    if code == 200 or code == 201 then
        create t = json.decode(r)
        return true, t.id
    end
    return nil, r
end
bot.msg.dm = function(a, b, c)
    if a == bot.msg then a, b, c = b, c, nil end
    create who = a
    create text = b
    create uid = who
    if type(who) == "string" and bot.user.getid(who) != nil then
        uid = bot.user.getid(who)
    end
    create r, code = rest("POST", "/users/@me/channels", { "recipient_id": uid })
    if r == nil then return nil, code end
    if code != 200 then return nil, r end
    create t = json.decode(r)
    return bot.msg.send(t.id, text)
end
bot.msg.edit = function(a, b, c, d)
    if a == bot.msg then a, b, c, d = b, c, d, nil end
    create r, code = rest("PATCH", "/channels/" .. a .. "/messages/" .. b, { "content": c })
    if r == nil then return nil, code end
    if code == 200 then return true end
    return nil, r
end
bot.msg.delete = function(a, b, c)
    if a == bot.msg then a, b = b, c end
    create r, code = rest("DELETE", "/channels/" .. a .. "/messages/" .. b, nil)
    if r == nil then return nil, code end
    if code == 204 then return true end
    return nil, r
end

-- newest message in a channel right now (text, author).
-- non-blocking: call again later for newer ones. In a command,
-- the channel can be omitted (uses where the command came from).
bot.msg.last = function(a, b)
    if a == bot.msg then a, b = b, nil end
    create channel = a
    if channel == nil then
        if B.cur != nil and B.cur.channel != nil then channel = B.cur.channel
        else return nil, "need a channel (or call inside a command)" end
    end
    create cid = resolve_channel(channel)
    if cid == nil then return nil, "unknown channel" end
    create list, e = fetch_history(cid, 1)
    if list == nil then return nil, e end
    if list:len() == 0 then return nil, "no messages" end
    create m = list[0]
    return m.content, m.author.username
end

-- newest text from a user (text, author). Channel optional: omitted
-- means the command's channel inside a command, all channels otherwise.
-- With no args at all inside a command: the invoker's latest there.
bot.msg.lastby = function(a, b, c)
    if a == bot.msg then a, b, c = b, c, nil end
    create name, channel = a, b
    if name == nil then
        if B.cur != nil then name = B.cur.author
        else return nil, "need a name (or call inside a command)" end
    end
    if channel == nil and B.cur != nil then channel = B.cur.channel end
    if channel != nil then
        create cid = resolve_channel(channel)
        if cid == nil then return nil, "unknown channel" end
        create list, e = fetch_history(cid, 50)
        if list == nil then return nil, e end
        repeat m, i in list do
            if m.author != nil and (m.author.username == name or m.author.id == name) then
                return m.content, m.author.username
            end
        end
        return nil, "not found"
    end
    create found = nil
    repeat m, i in B.recent do
        if m.author == name or m.uid == name then found = m end
    end
    if found == nil then return nil, "not found" end
    return found.content, found.author
end

-- who sent exactly this text (name, id). Channel optional: omitted
-- means the command's channel inside a command, all channels otherwise.
bot.msg.sender = function(a, b, c)
    if a == bot.msg then a, b, c = b, c, nil end
    create text, channel = a, b
    if text == nil then return nil, "need a text" end
    if channel == nil and B.cur != nil then channel = B.cur.channel end
    if channel != nil then
        create cid = resolve_channel(channel)
        if cid == nil then return nil, "unknown channel" end
        create list, e = fetch_history(cid, 50)
        if list == nil then return nil, e end
        repeat m, i in list do
            if m.content == text and m.author != nil then
                return m.author.username, m.author.id
            end
        end
        return nil, "not found"
    end
    create found = nil
    repeat m, i in B.recent do
        if m.content == text then found = m end
    end
    if found == nil then return nil, "not found" end
    return found.author, found.uid
end

bot.send = function(a, b, c)
    if a == bot then a, b, c = b, c, nil end
    if b == nil then return bot.msg.send(a) end
    return bot.msg.send(a, b)
end
bot.dm = function(a, b, c)
    if a == bot then a, b, c = b, c, nil end
    return bot.msg.dm(a, b)
end

bot.dm = function(a, b, c)
    if a == bot then a, b, c = b, c, nil end
    return bot.msg.dm(a, b)
end

-- ================= embeds (Python: discord.Embed) =================
bot.embed = {}

-- color: decimal number or "0x..."/"#..." string
create function embed_color(c)
    if c == nil then return nil end
    if type(c) == "number" then return c end
    if type(c) != "string" then return nil end
    create s = c
    if string.sub(s, 1, 2) == "0x" then s = string.sub(s, 3)
    elseif string.sub(s, 1, 1) == "#" then s = string.sub(s, 2) end
    return tonumber(s, 16)
end

create EMB_MT = { "__index": bot.embed }

-- constructor: create e = bot.embed:create({...}) (fresh object each call)
bot.embed.create = function(a, b)
    create init = b
    if a != bot.embed then init = a end
    if init == nil then init = {} end
    create e = setmetatable({}, EMB_MT)
    e._fields = []
    e._buttons = []
    e._selects = []
    if init.title != nil then e._title = init.title end
    if init.description != nil then e._description = init.description end
    if init.color != nil then e._color = embed_color(init.color) end
    return e
end

-- Python: embed.add_field(name=, value=, inline=)
bot.embed.add_field = function(a, b)
    if a == bot.embed then a = b end
    if a == nil or a._fields == nil then return nil, "not an embed" end
    create f = b or {}
    if f.name == nil or f.value == nil then return nil, "need name + value" end
    if a._fields:len() >= 25 then return nil, "too many fields (25 max)" end
    create jf = { "name": f.name, "value": f.value }
    if f.inline then jf.inline = true end
    a._fields:append(jf)
    return true
end

-- Python: embed.set_footer(text=) / set_author(name=) / set_thumbnail(url=) / set_image(url=)
-- each also takes a plain string shortcut
bot.embed.set_footer = function(a, b)
    if a == bot.embed then a = b end
    if a == nil or a._fields == nil then return nil, "not an embed" end
    create t = b
    if type(t) == "string" then t = { "text": t } end
    if t == nil or t.text == nil then return nil, "need text" end
    a._footer = t.text
    return true
end

bot.embed.set_author = function(a, b)
    if a == bot.embed then a = b end
    if a == nil or a._fields == nil then return nil, "not an embed" end
    create t = b
    if type(t) == "string" then t = { "name": t } end
    if t == nil or t.name == nil then return nil, "need name" end
    a._author = t.name
    if t.icon_url != nil then a._authoricon = t.icon_url end
    return true
end

bot.embed.set_thumbnail = function(a, b)
    if a == bot.embed then a = b end
    if a == nil or a._fields == nil then return nil, "not an embed" end
    create t = b
    if type(t) == "string" then t = { "url": t } end
    if t == nil or t.url == nil then return nil, "need url" end
    a._thumb = t.url
    return true
end

bot.embed.set_image = function(a, b)
    if a == bot.embed then a = b end
    if a == nil or a._fields == nil then return nil, "not an embed" end
    create t = b
    if type(t) == "string" then t = { "url": t } end
    if t == nil or t.url == nil then return nil, "need url" end
    a._image = t.url
    return true
end

create function embed_json(e)
    create o = {}
    if e._title != nil then o.title = e._title end
    if e._description != nil then o.description = e._description end
    if e._color != nil then o.color = e._color end
    if e._fields != nil and e._fields:len() > 0 then
        create fl = []
        repeat f, i in e._fields do
            create jf = { "name": f.name, "value": f.value }
            if f.inline then jf.inline = true end
            fl:append(jf)
        end
        o.fields = fl
    end
    if e._footer != nil then o.footer = { "text": e._footer } end
    if e._author != nil then
        o.author = { "name": e._author }
        if e._authoricon != nil then o.author.icon_url = e._authoricon end
    end
    if e._thumb != nil then o.thumbnail = { "url": e._thumb } end
    if e._image != nil then o.image = { "url": e._image } end
    return o
end

-- buttons of one embed -> action rows (5 per row), then one row per
-- select menu; 5 rows max per message.
create function embed_rows(btns, sels)
    create rows = []
    create row = nil
    create n = 0
    repeat b, i in btns do
        if rows:len() >= 5 then break end
        if n % 5 == 0 then
            row = { "type": 1, "components": [] }
            rows:append(row)
        end
        create jb = { "type": 2, "style": b.style or 1, "label": b.label }
        if b.style == 5 then
            jb.url = b.url
        else
            jb.custom_id = b.id
            if b.disabled then jb.disabled = true end
        end
        row.components:append(jb)
        n = n + 1
    end
    if sels != nil then
        repeat s, i in sels do
            if rows:len() >= 5 then break end
            create js = { "type": 1, "components": [{ "type": 3, "custom_id": s.id, "options": s.options }] }
            if s.holder != nil then js.components[0].placeholder = s.holder end
            rows:append(js)
        end
    end
    return rows
end

-- send the embed: e:send() in a command (origin place, incl. interactions),
-- e:send(channel) or e:send(channel, text) anywhere. Buttons linked via
-- buttons:new(..., embed) ride along. Returns true, message id (REST path).
bot.embed.send = function(a, b, c)
    if a == bot.embed then return nil, "not an embed" end
    create e, channel, text = a, b, c
    if e == nil or e._fields == nil then return nil, "not an embed" end
    create payload = { "embeds": [embed_json(e)] }
    create rows = embed_rows(e._buttons, e._selects)
    if rows:len() > 0 then payload.components = rows end
    if text != nil then payload.content = text end
    if channel == nil then
        if B.cur != nil and B.cur.kind == "int" then
            return interaction_send(payload)
        end
        if B.cur != nil then channel = B.cur.channel end
    end
    if channel == nil then return nil, "no channel in context" end
    create cid = resolve_channel(channel)
    if cid == nil then return nil, "unknown channel" end
    create r, code = rest("POST", "/channels/" .. cid .. "/messages", payload)
    if r == nil then return nil, code end
    if code == 200 or code == 201 then
        create t = json.decode(r)
        return true, t.id
    end
    return nil, r
end

-- ================= buttons (Python: discord.ui View/Button) =================
-- bot.buttons is a method namespace; button data lives on the embeds it is
-- linked to (plus a global registry for click/disable by id).
bot.buttons = {}

-- default custom_id from label (spaces -> _)
create function button_id(label)
    create s = tostring(label)
    create o = ""
    create i = 1
    while i <= string.len(s) do
        create c = string.sub(s, i, i)
        if c == " " then o = o + "_" else o = o + c end
        i = i + 1
    end
    return o
end

create function button_by_id(cid)
    repeat e, i in B.btns do
        if e.btn != nil and e.btn.id == cid then return e.btn end
    end
    return nil
end

-- new(label, embed?, id?, style?) or new({...}, embed?).
-- style: 1 blue, 2 grey, 3 green, 4 red, 5 link (needs url, no callback).
bot.buttons.new = function(a, b, c, d, e)
    if a == bot.buttons then a, b, c, d, e = b, c, d, e, nil end
    create label, emb, id, style, extra = a, b, c, d, nil
    if type(label) == "table" then
        create t = label
        label = t.label
        if id == nil then id = t.id end
        if style == nil then style = t.style end
        if t.disabled then extra = { "disabled": true } end
        if t.url != nil then extra = { "disabled": t.disabled, "url": t.url } end
    else
        extra = e
    end
    if label == nil then return nil, "need a label" end
    if id == nil then id = button_id(label) end
    if style == nil then style = 1 end
    create url = nil
    if type(extra) == "string" then url = extra
    elseif extra != nil and extra.url != nil then url = extra.url end
    if style == 5 and url == nil then
        return nil, "link buttons (style 5) need a url"
    end
    if style != 5 and url != nil then
        return nil, "only link buttons (style 5) take a url"
    end
    create btn = { "label": label, "id": id, "style": style, "url": url, "disabled": false }
    if type(extra) == "table" and extra.disabled then btn.disabled = true end
    B.btns:append({ "btn": btn, "embed": emb })
    if emb != nil then
        if emb._buttons == nil then return nil, "not an embed" end
        emb._buttons:append(btn)
    end
    return true
end

bot.buttons.disable = function(a, b)
    if a == bot.buttons then a = b end
    create n = 0
    repeat e, i in B.btns do
        if e.btn.id == a or e.btn.label == a then
            e.btn.disabled = true
            n = n + 1
        end
    end
    return n > 0
end

bot.buttons.enable = function(a, b)
    if a == bot.buttons then a = b end
    create n = 0
    repeat e, i in B.btns do
        if e.btn.id == a or e.btn.label == a then
            e.btn.disabled = false
            n = n + 1
        end
    end
    return n > 0
end

-- block until this button (id or label) is clicked; returns true + clicker.
-- (LUC's stand-in for Python's await view.wait()/callback.)
bot.buttons.click = function(a, b)
    if a == bot.buttons then a = b end
    create id = a
    if id == nil then return nil, "need a button id" end
    while true do
        create ev = wait_ev(B.intq)
        if ev.kind == "comp" and ev.ctype == 2 and ev.cid != nil then
            create known = button_by_id(ev.cid)
            if ev.cid == id or (known != nil and known.label == id) then
                B.cur = { "kind": "int", "iid": ev.id, "itoken": ev.token,
                          "channel": ev.channel, "author": ev.author }
                return true, ev.author
            end
        end
        B.intq:append(ev)
        task.wait(0.01)
    end
end

-- ================= select menus (Python: discord.ui Select) =================
-- bot.select is a method namespace; menus live on the embeds they attach to.
bot.select = {}

-- new(id, embed, options?, placeholder?) — options: [{label=, value=, description=?}].
-- single-select (1 pick); the embed is required (menus ride along on send).
bot.select.new = function(a, b, c, d)
    if a == bot.select then a, b, c, d = b, c, d, nil end
    create id, emb, opts, ph = a, b, c, d
    if id == nil then return nil, "need an id" end
    if emb == nil or emb._selects == nil then return nil, "need an embed" end
    if opts == nil then opts = [] end
    create sopts = []
    repeat o, i in opts do
        if sopts:len() >= 25 then break end
        if o == nil or o.label == nil or o.value == nil then
            return nil, "options need label + value"
        end
        create jo = { "label": o.label, "value": o.value }
        if o.description != nil then jo.description = o.description end
        sopts:append(jo)
    end
    if sopts:len() == 0 then return nil, "need at least 1 option" end
    emb._selects:append({ "id": id, "options": sopts, "holder": ph })
    return true
end

-- block until this menu is used; returns the picked value + who picked.
bot.select.choose = function(a, b)
    if a == bot.select then a = b end
    create id = a
    if id == nil then return nil, "need a select id" end
    while true do
        create ev = wait_ev(B.intq)
        if ev.kind == "comp" and ev.ctype == 3 and ev.cid == id then
            B.cur = { "kind": "int", "iid": ev.id, "itoken": ev.token,
                      "channel": ev.channel, "author": ev.author }
            create v = nil
            if ev.values != nil and ev.values:len() > 0 then v = ev.values[0] end
            return v, ev.author
        end
        B.intq:append(ev)
        task.wait(0.01)
    end
end

bot.slash = {}
bot.slash.new = function(a, b, c, d)
    if a == bot.slash then a, b, c, d = b, c, d, nil end
    create bb = { "name": a, "description": a, "type": 1 }
    create scope = b
    -- "global" (or "gobal" typo, or nil) = global command;
    -- "guild" + guild id = guild-only command
    if scope == nil or scope == "global" or scope == "gobal" then scope = nil end
    B.pending:append({ "b": bb, "scope": scope, "guild": c })
    flush_pending()
    return true
end
bot.slash.slash = function(a, b)
    if a == bot.slash then a = b end
    create name = a
    while true do
        create ev = wait_ev(B.intq)
        if ev.name == name then
            create aname = nil
            if ev.uid != nil and B.members[ev.uid] != nil then
                aname = B.members[ev.uid].name
            end
            B.cur = { "kind": "int", "iid": ev.id, "itoken": ev.token,
                      "channel": ev.channel, "author": aname, "app": ev.app }
            return true
        end
        B.intq:append(ev)
        task.wait(0.01)
    end
end

-- pause switch: bot:on() reads state, "bot":stop() pauses, "bot":on(true) resumes
bot.on = function(a, b)
    if a == bot then a = b end
    if a != nil then
        if a then B.paused = false else B.paused = true end
    end
    return not B.paused
end
bot.stop = function(a)
    B.paused = true
    return true
end

bot.me = function(a)
    create r, code = rest("GET", "/users/@me", nil)
    if r == nil or code != 200 then return nil, code end
    create t = json.decode(r)
    return { "name": t.username, "id": t.id }
end
bot.channel = function(a, b)
    if a == bot then a = b end
    create c = B.channels[a]
    if c == nil then return nil end
    return { "name": c.name, "id": a }
end
bot.guild = function(a, b)
    if a == bot then a = b end
    create g = B.guilds[a]
    if g == nil then return nil end
    return { "name": g.name, "id": a }
end

return bot
